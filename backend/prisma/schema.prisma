model Transcript {
  id                   String            @id @default(cuid())
  meetingId            String            @unique
  meeting              Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// Merged dialog turns: DialogTurn[] = { speaker, text, startSec, endSec }[]. Null пока MergeWorker не завершил.
  turns                Json?
  /// Optional room-chat messages, если INCLUDE_ROOM_CHAT_IN_AI=true. RoomChatMessage[].
  roomChat             Json?
  totalWords           Int?
  totalDurationSeconds Int?
  /// S3-ключ merged-транскрипта (S3-пайплайн competitor-parity). NULL пока не готов.
  mergedS3Url          String?
  /// S3-ключ cleaned-транскрипта (фаза D cleaning). NULL = ещё не запускали.
  cleanedS3Url         String?
  /// Статус cleaning-пайплайна: 'pending'|'ready'|'failed'|'not_started' (NULL='not_started').
  cleaningStatus       String?
