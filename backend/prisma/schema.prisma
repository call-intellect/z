  expired
}

// ──────────────────────────── knowledge-core: ingest (Фаза 1) ────────────────────────────

enum SourceType {
  meeting
  chat
  phone_call
  bot
  email
  web_form
  external
}

enum DataClass {
  public
  internal
  sensitive
  private
}

enum RawEventProcessingStatus {
