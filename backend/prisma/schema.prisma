// ──────────────────────────── knowledge-core: graph (Фаза 3) ────────────────────────────

/// Тип типизированной связи между блоками. См. plans/tz/2026-05-10-knowledge-core-tz.md §Фаза 3.
enum IdeaBlockLinkType {
  develops
  contradicts
  causes
  consequences_of
  shares_topic
  shares_entity
  question_answered_by
}

/// Тип типизированной связи между сущностями. С Фазы 0 — также все
/// бизнес-связи каркаса компании (Person↔Role↔Department, Process↔Role,
/// Strategy↔Goal и т.д.). См. plans/tz/2026-05-21-phase-0a-data-model-and-graph-infra.md §4.4.
enum EntityLinkType {
  // ── существующие knowledge-core связи Entity↔Entity (Фаза 3) ──
  works_at
  belongs_to
  part_of
  opposes
  depends_on
  mentions_with

  // ── Фаза 0: Person ↔ Role ↔ Department ↔ Skill ──
  /// Person -> Role; временной интервал в validFrom/validTo.
  executes_role
  /// Person -> Department.
  member_of
  /// Role -> JobDescription.
  described_by
  /// JobDescription -> Document (или Process -> Document, см. produces).
  derived_from
  /// Role -> Skill (требование).
  requires_skill
  /// Person -> Skill (наблюдается).
  has_skill

  // ── Фаза 0: каркас 5 уровней (группа Б) ──
  /// Mission -> Strategy.
  realized_by
  /// Strategy -> Goal; Goal -> Goal (декомпозиция).
  decomposes_into
  /// Goal -> Metric; Process -> Metric.
  measured_by
  /// Strategy -> Process.
  executed_by
  /// Process -> ProcessStep.
  has_step
  /// Process -> Role / Person; Role -> Process (Role is_responsible_for).
  owned_by
  /// Process -> Tool.
  lives_in
  /// Process -> Document.
  produces
  /// Process -> Event / Meeting.
  triggered_by
  /// Regulation -> Process.
  regulates
  /// Policy -> Process / Role / любая сущность.
  constrains
  /// Regulation(category=standard) -> ArtifactType (строковый идентификатор в properties.artifactType).
  applies_to
  /// Role -> Process (зеркало owned_by для дискриминации направления).
  is_responsible_for

  // ── Фаза 0: RACI (UI назначения — Фаза γ) ──
  responsible_for
  accountable_for
  consulted_on
  informed_about
}

/// Кто создал связь:
///   - linker: block-linker.worker (на canonical-блок).
///   - reframing: ночной reframing.cron (рефлексия графа).
///   - manual: пользователь через UI (не в MVP, но поле зафиксировано сразу).
enum LinkCreatedBy {
  linker
  reframing
  manual
}

/// Состояние связи: active = живая, archived = архив (понижен confidence или
/// сброшен ночным reframing).
enum LinkStatus {
  active
  archived
}

// ──────────────────────────── knowledge-core: theme (Фаза 4) ────────────────────────────

/// Состояние темы:
///   - active       — обнаружена кластерером, видна в UI и поиске.
///   - archived     — устарела или неактуальна (после reframing).
///   - merged_into  — слита в другую тему (mergedIntoId указывает целевую).
enum ThemeStatus {
  active
  archived
  merged_into
}

/// Динамика темы — заполняется reframing'ом по дельте новых блоков:
///   growing / stable / declining.
enum ThemeDynamic {
  growing
  stable
  declining
}

/// 12 веток компании (M-07 delivery). Для отнесения темы к крупному блоку
/// бизнеса. Опциональна — LLM может вернуть `null`, если ветка не очевидна.
enum ThemeBranch {
  strategy
  clients
  sales
  marketing
  product
  operations
  team
  finance
  technology
  production
  partnerships
  legal
}

// ──────────────────────────── knowledge-core: goals (Фаза 9) ────────────────────────────

/// Состояние цели:
///   - active     — активная, ежедневно оценивается воркером.
///   - paused     — owner временно приостановил мониторинг (не оценивается).
///   - achieved   — цель достигнута (закрыта успешно).
///   - abandoned  — цель брошена (soft-delete через archivedAt).
enum GoalStatus {
  active
  paused
  achieved
  abandoned
}

/// Источник связи Goal ↔ Theme:
///   - manual — owner вручную привязал тему через UI.
///   - ai     — предложено strategic-alignment.suggester (vNext).
enum GoalThemeSource {
  manual
  ai
}

// ──────────────────────────── Фаза 0: каркас компании (группа А, видимая) ────────────────────────────

/// Горизонт цели/стратегии/миссии (см. ontology §11.6). Используется и для
/// Goal (расширение), и для Mission/Strategy (Фаза 0, группа Б).
enum GoalHorizon {
  strategic
  annual
  quarterly
  monthly
  sprint
}

/// Тип документа в Document-модели (Фаза 0).
enum DocumentKind {
  pdf
  docx
  markdown
  /// Создаётся из text.adapter (фронт /dump → POST /api/v1/dumps).
  text
  other
}

/// Статус document-ingest pipeline.
enum DocumentStatus {
  uploaded          // только что POSTнут
  parsing           // парсер работает
  parsed            // парсер завершил
  blocks_extracted  // BlockExtractionService отработал
  failed
}

/// Статус сборки карты должности (Фаза 0d, RoleProfileAgent).
enum RoleProfileStatus {
  forming    // данных <N блоков идей с role_relevant=true
  ready      // summaryCache заполнен
  stale      // прошло >24ч с lastBuildAt + есть новые данные
  error      // LLM упал, нужна ручная проверка
}

// ──────────────────────────── Фаза 0: каркас компании (группа Б, без UI в Фазе 0) ────────────────────────────

/// Категория регламента (см. ontology §10 «Уровень 3»).
enum RegulationCategory {
  regulation
  standard
}

/// Статус процесса/регламента/политики.
enum ProcessStatus {
  active
  deprecated
  archived
}

enum PolicySeverity {
  advisory    // рекомендация
  mandatory   // обязательно
  blocking    // нарушение блокирует процесс
}

enum ToolKind {
  software
  hardware
  template
  document
  service
  other
}

enum MetricValueType {
  count
  ratio
  duration_seconds
  money
  other
}

enum DecisionStatus {
  active
  rolled_back
  superseded
}

// ──────────────────────────── models ────────────────────────────

model User {
  id                 String           @id @default(cuid())
  externalId         String?          @unique
  email              String
  name               String
  role               UserRole         @default(user)
  /// Флаг владельца продукта Z (super-admin Z-Admin раздела). См. orgs-and-rbac.md.
  /// На уровне БД — независим от `role` и `Membership`. Включается вручную DBA / seed'ом.
  isSuperAdmin       Boolean          @default(false)
  signupSource       UserSignupSource @default(crossmark)
  // argon2id (standalone) или bcrypt (admin local login). Опционально для Crossmark-провижененных юзеров.
  passwordHash       String?
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  lastSeenAt         DateTime?
  deletedAt          DateTime?

  meetings             Meeting[]
  sessions             UserSession[]
  verificationTokens   UserVerificationToken[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  destinations         IntegrationDestination[]
  tags                 Tag[]
  tasks                Task[]
  chatMessages         MeetingChatMessage[]
  userTemplates        UserTemplate[]
  exports              Export[]
  meetingShares        MeetingShare[]
  highlightShares      HighlightShare[]
  meetingHighlights    MeetingHighlight[]
  quotaCounters        UserQuotaCounter[]
  auditLog             AuditLog[]
  apiAccessLog         ApiAccessLog[]
  cards                Card[]
  ownedOrgs            Org[]                    @relation("OrgOwner")
  memberships          Membership[]
  invitedMemberships   Membership[]             @relation("MembershipInvitedBy")
  createdInvitations   OrgInvitation[]          @relation("OrgInvitationInvitedBy")
  acceptedInvitations  OrgInvitation[]          @relation("OrgInvitationAcceptedBy")
  superAdminAccessLogs SuperAdminAccessLog[]    @relation("SuperAdminAccessLog")
  goalsCreated         Goal[]                   @relation("GoalCreatedBy")
  /// Фаза 0a — Person-аватары пользователя в Org'ах (после accept'а приглашений).
  persons              Person[]                 @relation("UserPersons")
  // ── SBA α-1 — Conversational Channels Foundation ──
  channelBindings      ChannelBinding[]
  notifications        Notification[]           @relation("NotificationRecipient")

  // ── Фаза A.1 — Prompt Registry ──
  createdPromptTemplates  PromptTemplate[]        @relation("PromptTemplateCreatedBy")
  createdPromptVersions   PromptTemplateVersion[] @relation("PromptTemplateVersionCreatedBy")
  createdPromptExperiments PromptExperiment[]     @relation("PromptExperimentCreatedBy")
  aiResultFeedback        AiResultFeedback[]     @relation("AiResultFeedbackUser")
  // ── Фаза A.4 — Audit log переключений LlmTaskRoute ──
  llmTaskRouteChanges     LlmTaskRouteChange[]    @relation("LlmTaskRouteChangeBy")

  @@unique([email, signupSource])
  @@index([email])
  @@index([deletedAt])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  userAgent String?   @db.Text
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model UserVerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  purpose   VerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Meeting {
  id               String        @id // ULID, генерится сервисом
  title            String
  type             MeetingType
  customPrompt     String?       @db.Text
  /// tenant: Org, в которой принадлежит встреча. NULL только для legacy-данных
  /// до backfill-fase0. После backfill становится NOT NULL отдельным push'ом.
  tenantId         String?
  tenant           Org?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id])
  cardId           String?
  card             Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  roomName         String        @unique // равен id
  status           MeetingStatus @default(scheduled)
  startedAt        DateTime?
  endedAt          DateTime?
  failureReason    String?
  durationMs       Int?
  recapVersion     Int           @default(1)
  chaptersStatus   AiStepStatus  @default(none)
  tasksStatus      AiStepStatus  @default(none)
  embeddingsStatus AiStepStatus  @default(none)
  /// Фаза 5 knowledge-core: статус v2-агентов (Tasks/Chapters/Summary над IdeaBlock).
  /// NULL = не запускался; 'queued'/'processing'/'ready'/'partial'/'failed'.
  /// Хранится строкой (а не enum'ом), чтобы было легко расширить без миграции.
  analyzeV2Status      String?
  /// Когда v2-агент завершил работу (последний раз).
  analyzeV2GeneratedAt DateTime?
  /// Текст ошибки на failed/partial. Multi-line, агент пишет короткую сводку.
  analyzeV2Error       String?       @db.Text
  /// Автоматически вести запись при старте встречи. Если true — запись стартует
  /// при подключении хоста; ручное управление записью в комнате недоступно.
  recordByDefault  Boolean       @default(true)
  /// Статус расчёта поведенческих метрик (воркер ai.behavior-metrics).
  /// NULL = не запускался; 'pending'|'ready'|'failed'|'low_confidence'.
  behaviorMetricsStatus String?
  /// Статус AI-оценки качества встречи (воркер ai.quality-score).
  /// NULL = не запускался; 'pending'|'ready'|'failed'|'disabled'.
  qualityScoreStatus    String?
  createdAt        DateTime      @default(now())
  deletedAt        DateTime?

  participants     Participant[]
  recording        Recording?
  transcript       Transcript?
  aiResult         AiResult?
  /// Фаза B — one-to-one с MeetingBehaviorMetrics (метрики поведения участников).
  behaviorMetrics  MeetingBehaviorMetrics?
  /// Фаза C — one-to-one с MeetingQualityScore (AI-оценка качества).
  qualityScore     MeetingQualityScore?
  events           MeetingEvent[]
  tasks            Task[]
  chapters         MeetingChapter[]
  highlights       MeetingHighlight[]
  shares           MeetingShare[]
  transcriptChunks MeetingTranscriptChunk[]
  chatMessages     MeetingChatMessage[]
  roomMessages     MeetingRoomMessage[]
  meetingTags      MeetingTag[]
  /// Фаза 0a — Decision'ы, источник которых эта встреча (Фаза 0b extraction).
  decisions        Decision[]               @relation("DecisionSourceMeeting")
  /// Фаза E — дополнительные («custom») AI-отчёты, сгенерированные по выбранным
  /// шаблонам поверх той же встречи. Primary-отчёт остаётся в `aiResult`
  /// (one-to-one). См. plans/tz/2026-05-21-phase-E-multi-report-per-meeting.md.
  customReports    MeetingReport[]

  @@index([ownerId, createdAt])
  @@index([status, endedAt])
  @@index([deletedAt])
  @@index([cardId, createdAt])
  @@index([tenantId])
}

model Participant {
  id               String          @id @default(cuid())
  meetingId        String
  meeting          Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  livekitIdentity  String
  name             String
  role             ParticipantRole
  isRegisteredUser Boolean         @default(false)
  userId           String?
  deviceCount      Int             @default(1)
  joinedAt         DateTime?
  leftAt           DateTime?

  audioTrack   AudioTrack?
  roomMessages MeetingRoomMessage[]
  /// Фаза B — поведенческие метрики, рассчитанные для этого участника
  /// (one-to-many: один участник может фигурировать в нескольких MeetingBehaviorMetrics,
  /// если идёт регенерация и старая запись осталась — но обычно одна).
  behaviorEntries MeetingParticipantBehavior[]

  @@unique([meetingId, livekitIdentity])
  @@index([meetingId])
}

model Recording {
  id                String          @id @default(cuid())
  meetingId         String          @unique
  meeting           Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  mainVideoUrl      String?
  compositeEgressId String?
  status            RecordingStatus @default(not_started)
  retentionDays     Int
  expiresAt         DateTime
  archivedAt        DateTime?
  deletedAt         DateTime?
  bytesTotal        BigInt?
  durationSeconds   Int?

  audioTracks AudioTrack[]
  actions     RecordingAction[]

  @@index([expiresAt, status])
}

model AudioTrack {
  id              String       @id @default(cuid())
  recordingId     String
  recording       Recording    @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  participantId   String?      @unique
  participant     Participant? @relation(fields: [participantId], references: [id])
  participantName String
  livekitIdentity String
  trackId         String
  trackEgressId   String?
  audioUrl        String
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  bytes           BigInt?

  @@index([recordingId])
}

model Transcript {
  id                   String            @id @default(cuid())
  meetingId            String            @unique
  meeting              Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// Merged dialog turns: DialogTurn[] = { speaker, text, startSec, endSec }[]. Null пока MergeWorker не завершил.
  turns                Json?
  /// Optional room-chat messages, если INCLUDE_ROOM_CHAT_IN_AI=true. RoomChatMessage[].
  roomChat             Json?
  totalWords           Int?
  totalDurationSeconds Int?
  /// S3-ключ merged-транскрипта (S3-пайплайн competitor-parity). NULL пока не готов.
  mergedS3Url          String?
  /// S3-ключ cleaned-транскрипта (фаза D cleaning). NULL = ещё не запускали.
  cleanedS3Url         String?
  /// Статус cleaning-пайплайна: 'pending'|'ready'|'failed'|'not_started' (NULL='not_started').
  cleaningStatus       String?
  createdAt            DateTime          @default(now())
  tracks               TranscriptTrack[]
}

/// Per-participant transcript data, сохраняется TranscribeWorker'ом вместо S3 JSON.
model TranscriptTrack {
  id              String     @id @default(cuid())
  transcriptId    String
  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  livekitIdentity String
  speakerName     String
  participantId   String?
  trackStartedAt  DateTime
  baseStartedAt   DateTime
  transcriptText  String     @db.Text
  durationSeconds Float
  /// Array<{ word: string; startMs: number; endMs: number }>
  words           Json

  @@index([transcriptId])
}

model AiResult {
  id             String      @id @default(cuid())
  meetingId      String      @unique
  meeting        Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingType    MeetingType
  summary        String      @db.Text
  structuredData Json?
  customOutputMd String?     @db.Text
  followUpEmail  String?     @db.Text
  /// @deprecated после Phase 3 ai-workspace новые задачи пишутся в `Task`. Оставлено до миграции существующих записей через `backend/scripts/migrate-ai-tasks.ts`.
  tasks          Json?
  modelUsed      String
  /// Фаза 5 knowledge-core: альтернативная сводка, сгенерированная
  /// `meeting-analyze-v2.worker` поверх IdeaBlock'ов встречи. Не перезаписывает
  /// `summary`, чтобы UI оставался на legacy до решения владельца про A/B.
  summaryV2            String?   @db.Text
  /// `<provider>:<model>` модели, которая сгенерила `summaryV2`.
  summaryV2Model       String?
  /// Когда сгенерирован `summaryV2`.
  summaryV2GeneratedAt DateTime?
  /// Фаза A.1 — какой версией шаблона промпта (`PromptTemplateVersion`) сгенерирован основной отчёт
  /// (structuredData / customOutputMd). NULL = `code_fallback` (промпт пришёл из встроенного кода
  /// `ai/services/prompts/type-*.ts`), что нормально при пустой БД или ошибке резолва.
  promptTemplateVersionId String?
  promptTemplateVersion   PromptTemplateVersion? @relation("from_prompt_version", fields: [promptTemplateVersionId], references: [id], onDelete: SetNull)
  /// Фаза A.1 — группа A/B-эксперимента, если резолвер попал в активный `PromptExperiment`.
  /// 'A' | 'B' | NULL. NULL = вне эксперимента.
  experimentGroup String?
  /// Фаза A.3 — обратная связь пользователей по этому AI-результату (👍/👎).
  feedback                AiResultFeedback[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([promptTemplateVersionId])
}

model AiUsageLog {
  id              String   @id @default(cuid())
  /// tenant — Org, на которую списывается стоимость. NULL до backfill,
  /// после Шага 1 backfill становится NOT NULL для не-системных вызовов.
  tenantId        String?
  tenant          Org?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  meetingId       String?
  userId          String?
  agentType       String
  taskType        String?
  jobId           String?
  model           String
  provider        String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  /// Кэшированные input-токены (prompt cache hit) — учитываются в costUsd по cachedPer1M.
  cachedTokens    Int      @default(0)
  reasoningTokens Int?
  costUsd         Decimal  @db.Decimal(10, 6)
  /// `durationMs` = latency end-to-end вызова. Поле оставлено как есть.
  durationMs      Int
  success         Boolean
  errorText       String?  @db.Text
  /// Указатель на источник (откуда пришёл вызов) для drill-down в Z-Admin.
  /// Пример: { type: 'meeting', id: 'mtg_01HX...' }, { type: 'card', id: 'crd_...' }, { type: 'block', id: '...' }.
  sourceRef       Json?
  /// Для A/B-экспериментов LlmTaskRoute.experiment: 'A' | 'B'. NULL = вне эксперимента.
  experimentGroup String?
  /// Z-Admin Фаза 7: превью отправленного промпта (system + user, конкатенация),
  /// truncate до 8KB. Заполняется LlmRouter'ом при каждом успешном вызове.
  /// Для исторических записей до Фазы 7 — null. Используется в drill-down.
  requestPreview  String?  @db.Text
  /// Z-Admin Фаза 7: превью ответа модели (text), truncate до 8KB.
  responsePreview String?  @db.Text
  /// Фаза A.1 (заведено заранее под A.4) — фактически использованный уровень цепочки моделей:
  /// 'primary' | 'secondary' | 'tertiary'. NULL = legacy записи до A.4 или одноуровневая цепочка.
  tier            String?
  /// Фаза A.1 (заведено заранее под A.4) — причина срабатывания fallback'а на secondary/tertiary,
  /// например: 'primary_timeout' | 'primary_error' | 'primary_rate_limit' | 'secondary_*' | NULL.
  fallbackReason  String?
  createdAt       DateTime @default(now())

  @@index([meetingId])
  @@index([createdAt])
  @@index([userId, taskType, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, taskType, createdAt])
}

