enum LlmRouteTier {
  primary
  secondary
  tertiary
}

model LlmTaskRoute {
  id                String        @id @default(cuid())
  /// NULL = глобальный дефолт, заданный super_admin (Z-Admin).
  /// Не-NULL = override на конкретную Org (Z-Admin Фаза 7).
  tenantId          String?
  tenant            Org?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskType          String
  /// Legacy (до A.4): JSON-массив { provider, model? } — fallback chain в одной записи.
  /// После A.4 запись = ОДИН провайдер + tier + priority (см. поля ниже). Legacy-форма
  /// остаётся работать, пока для taskType нет ни одной записи с `tier IS NOT NULL`.
  /// Routing решает: если есть tier'ы — собирает цепочку по ним; иначе использует
  /// legacy JSON. Это обратная совместимость.
  providers         Json?
  isActive          Boolean       @default(true)
  /// Фаза A.4 — уровень в цепочке: primary / secondary / tertiary.
  /// NULL = legacy-запись (старая модель). NOT NULL = нормализованная запись.
  tier              LlmRouteTier?
  /// Фаза A.4 — порядок внутри одного tier'а (0 = первый кандидат). Только если tier NOT NULL.
  priority          Int           @default(0)
  /// Фаза A.4 — фактический провайдер для нормализованной записи (если tier NOT NULL).
  /// Совпадает с одним из ALL_PROVIDERS (`deepseek` / `openai-via-proxy` / …).
  providerName      String?
  /// Фаза A.4 — конкретная модель в рамках провайдера (например `deepseek-v4-flash`).
  /// NULL = провайдер выбирает default.
  model             String?
  /// SBA α-10 wave 2 (2026-05-23) — опц. FK на нормализованные LlmProvider/LlmModel.
  /// Параллельны providerName/model (строки) для backward-compat.
  providerId        String?
  modelId           String?
  /// Фаза A.4 — был ли маршрут вручную отредактирован админом. Используется в
  /// идемпотентном seed'е: если true — seed не перезаписывает запись.
  editedByAdmin     Boolean       @default(false)
  /// A/B-эксперимент legacy: { enabled: bool, modelA: string, modelB: string,
  ///                    splitPercent: number, startedAt: ISO, endsAt: ISO }.
  /// Новые A/B-эксперименты per-agent — через модель `LlmModelExperiment`.
  experiment        Json?
  /// Фаза 11 knowledge-core: минимальный класс данных, который маршрут
  /// поддерживает. NULL трактуется как 'internal'. LlmRouter фильтрует
  /// провайдеров по `provider.maxDataClass >= max(dataClass, requiredDataClass)`.
  /// Если ни один провайдер не подходит — `NoEligibleProviderError` +
  /// метрика `core_data_class_violations_total`.
  requiredDataClass DataClass?
  /// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 6.5 — заморозка версии модели.
  /// Текстовая пометка вида «закреплено на deepseek-v4-pro версии 2026-04-15;
  /// перед обновлением — прогнать golden-набор skill-trait-detect-golden».
  /// Прокси DeepSeek не поддерживает версионные slug-и, поэтому заморозка —
  /// через комментарий + snapshot-тест на seed-script.
  pinnedVersionNote String?       @db.Text
  /// Agents v2 Фаза C2 (2026-05-30) — GEPA evolution gate.
  /// Если false — `gepa-optimize.cron` пропускает этот route, A/B-кандидаты
  /// не создаются. Используется чтобы заблокировать эволюцию руками админа
  /// для критичных prompt'ов (например, billing/compliance). Default true.
  /// См. plans/tz/2026-05-29-agents-v2-umbrella.md §C2.
  evolutionEnabled  Boolean       @default(true)
  /// Agents v2 Фаза C2 — текст prompt'а, который заменяет system prompt при
  /// вызове LLM (если задан). Заполняется GEPA после promotion или вручную
  /// админом. NULL = используется код-fallback prompt из call-site.
  promptOverride    String?       @db.Text
  updatedAt         DateTime      @updatedAt

  /// Legacy unique: (taskType, tenantId) — для записей БЕЗ tier (одна запись на taskType).
  /// Сохраняем для обратной совместимости. Записи с tier живут отдельно — для них
  /// уникальность держится по (taskType, tenantId, tier, providerName).
  @@unique([taskType, tenantId, tier, providerName], name: "task_tenant_tier_provider_unique")
  @@index([tenantId])
  @@index([taskType, tier, priority])
}

/// Фаза A.4 — audit log переключений маршрутов в `/admin/ai-models`.
/// На каждый switch-primary / add-provider / remove-provider / start-ab / stop-ab — запись.
/// Используется в `<TaskTypeDetailsCard />` для отображения истории и в API
/// `GET /admin/ai-models/:taskType/history`.
model LlmTaskRouteChange {
  id          String        @id @default(cuid())
  /// NULL = глобальное изменение (только super_admin); иначе org-scoped.
  tenantId    String?
  taskType    String
  /// Tier, который менялся. NULL для удалений где tier не определён.
  tier        LlmRouteTier?
  /// Один из: 'switched_primary' | 'added_provider' | 'removed_provider' |
  /// 'started_ab' | 'stopped_ab' | 'reset_to_default'.
  changeType  String
  /// Snapshot цепочки до изменения (массив { tier, providerName, model, priority }).
  before      Json
  /// Snapshot цепочки после изменения.
  after       Json
  changedById String
  changedBy   User          @relation("LlmTaskRouteChangeBy", fields: [changedById], references: [id], onDelete: NoAction)
  /// Обязательно для switch-primary (по DoD §7.4).
  reason      String?
  createdAt   DateTime      @default(now())

  @@index([taskType, createdAt])
  @@index([changedById, createdAt])
  @@index([tenantId, taskType, createdAt])
}

/// Фаза A.4 — A/B-эксперимент per-agent (по моделям, а не по промптам).
/// Параллельная сущность к `PromptExperiment` (которая про шаблоны промптов).
model LlmModelExperiment {
  id              String    @id @default(cuid())
  /// NULL = глобальный (только super_admin); иначе org-scoped.
  tenantId        String?
  taskType        String
  /// Текущий primary (контрольная группа).
  controlModel    String
  controlProvider String
  /// Тестируемая модель (вариант).
  variantModel    String
  variantProvider String
  /// 0..100 — доля трафика на variant (sticky-allocation по hash(meetingId)).
  splitPercent    Int
  /// 'draft' | 'running' | 'stopped' | 'completed'.
  status          String    @default("draft")
  startedAt       DateTime?
  endsAt          DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  notes           String?

  @@index([tenantId, taskType, status])
  @@index([status, startedAt])
}

// ──────────────────────────── ai-workspace: audit / quotas / api access ────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Org?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resourceId String?
  metadata   Json?
  ipHash     String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
}

/// Pulse Wave 4 §4.1 — журнал согласий 152-ФЗ на обработку данных сотрудника.
/// Append-only: каждое новое согласие/отзыв = новая строка. Текущее состояние
/// согласия по dataType — последняя запись (max(createdAt)).
model ConsentLog {
  id            String   @id @default(cuid())
  tenantId      String
  personId      String
  /// Тип согласия: 'checkin_processing' | 'risk_analysis' | 'card_visible_to_manager'.
  dataType      String   @db.VarChar(60)
  /// true = дано, false = отозвано.
  consented     Boolean
  /// Версия текста согласия (для аудита изменений политики, например при правке копий).
  policyVersion String   @default("v1") @db.VarChar(10)
  /// IP hashed (через `IpHashingService`, daily-rotated salt). Для аудита, не для отождествления.
  ipHash        String?
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now())

  org    Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId, dataType, createdAt])
  @@index([tenantId, createdAt])
}

/// Pulse Wave 4 §4.2 — журнал просмотров pulse-карточки сотрудника
/// (audit log для `/me/privacy/access-log`). Пишется interceptor'ом на
/// `/api/v1/persons/:id/{pulse|knowledge-profile|skill-profile|appointments|contributions}`.
/// Не пишет, если viewer и владелец карточки — один и тот же User.
model KnowledgeAccessLog {
  id              String   @id @default(cuid())
  tenantId        String
  /// userId того, кто открыл карточку.
  viewerUserId    String
  /// personId, чью карточку открыли.
  viewedPersonId  String
  /// Раздел: 'pulse' | 'knowledge_profile' | 'skill_profile' | 'appointments' | 'contributions'.
  sectionAccessed String   @db.VarChar(60)
  ipHash          String?
  accessedAt      DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, viewedPersonId, accessedAt])
  @@index([tenantId, viewerUserId, accessedAt])
}

model ApiAccessLog {
  id         String   @id @default(cuid())
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  route      String
  status     Int
  durationMs Int?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model UserQuotaCounter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotaName   String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, quotaName, windowStart])
  @@index([userId, quotaName])
}

// ──────────────────────────── cards: CRM-структура встреч ────────────────────────────

model Card {
  id             String  @id @default(cuid())
  /// tenant: Org, к которой принадлежит карточка. После backfill — NOT NULL.
  tenantId       String?
  tenant         Org?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  ownerId        String
  owner          User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  // 'client' | 'deal' | 'project' | 'topic' | 'custom' | 'vendor'.
  // 'vendor' добавлен в SBA α-3 (поставщики, см. модель Vendor).
  // Хранится строкой (а не enum'ом), чтобы можно было добавлять виды без миграций.
  kind           String  @default("client")
  color          String  @default("#5EEAD4")
  icon           String?
  description    String? @db.Text

  // Один опциональный primary-контакт. Несколько — vNext через CardContact.
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Knowledge-core (Фаза 4): primary-сущность карточки + связанные сущности +
  // опциональная ссылка на Theme, из которой пользователь сохранил карточку
  // через `POST /themes/:id/save-as-card`.
  entityId         String?
  entity           Entity?  @relation("CardEntity", fields: [entityId], references: [id], onDelete: SetNull)
  relatedEntityIds String[] @default([])
  bornFromThemeId  String?
  bornFromTheme    Theme?   @relation("CardBornFromTheme", fields: [bornFromThemeId], references: [id], onDelete: SetNull)

  pinned     Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  // AI rollup-кэш (заполняется card-rollup.worker'ом).
  summaryCache     String?   @db.Text
  summaryUpdatedAt DateTime?

  // Knowledge-core (Фаза 4): топ-N тем, связанных с карточкой через её блоки.
  // Заполняется card-rollup-v2.worker'ом — кэш для быстрого рендера UI.
  cachedTopThemeIds String[] @default([])

  // SBA α-6 — контракт специалиста §5.2 зонтичного.
  // Заполняются Specialist 3.4 при rollup'е.
  /// Блоки-источники последнего rollup'а (для citations в chat-v2).
  sourceBlockIds       String[]     @default([])
  /// confidence последнего LLM-rollup'а [0..1]. Используется CurationService.triage().
  confidence           Decimal?     @db.Decimal(4, 3)
  /// KC-Temporal W2.2 (2026-05-25) — калиброванная confidence (Platt).
  calibratedConfidence Decimal?     @db.Decimal(4, 3)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass.
  /// NB: у Card нет поля `dataClass` напрямую — audit описывает класс,
  /// применённый при rollup'е (для трассировки compliance).
  dataClassAudit       Json?
  /// FK на текущую опубликованную версию CardVersion (α-4). Заполняется после auto-triage.
  currentVersionId     String?
  currentVersion       CardVersion? @relation("CardCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// Person.id, кому Card «присваивается» как subject. Для последующей сборки SkillProfile (γ-1).
  personSubjectIds     String[]     @default([])
  /// Когда карточка последний раз подтверждалась (auto после успешного rollup'а
  /// или вручную). Используется stale-detection из α-4 и probe `card.outdated_summary`.
  lastConfirmedAt      DateTime?

  // Денормализация для сортировки списка без JOIN.
  meetingCount  Int       @default(0)
  lastMeetingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings       Meeting[]
  chatMessages   MeetingChatMessage[]
  /// Sprints (2026-05-27) — проекты-спринты, привязанные к этой карточке клиента
  /// (Project.customerCardId). См. plans/tz/2026-05-27-sprints.md §1.1.
  scopedProjects Project[]            @relation("ProjectCustomerCard")

  @@unique([ownerId, name])
  @@index([ownerId, lastMeetingAt])
  @@index([ownerId, archivedAt])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([entityId])
  @@index([bornFromThemeId])
  @@index([currentVersionId])
  @@index([tenantId, lastConfirmedAt])
}

// ──────────────────────────── orgs / RBAC / invitations (Фаза 0 knowledge-core) ────────────────────────────

/// Org — организация-клиент. Любой ресурс (встреча, карточка, задача и т.д.)
/// принадлежит ровно одной Org через поле tenantId.
///
/// При регистрации создаётся персональный Org с owner=User. Member'ов добавляет
/// owner через OrgInvitation. visibilityMode определяет, видят ли manager-ы
/// чужие ресурсы внутри Org.
model Org {
  id                           String            @id @default(cuid())
  name                         String
  slug                         String            @unique
  ownerId                      String
  owner                        User              @relation("OrgOwner", fields: [ownerId], references: [id])
  visibilityMode               OrgVisibilityMode @default(open)
  /// Тариф — placeholder для Фазы 12. На Фазе 0 все Org = basic.
  tier                         OrgTier           @default(basic)
  /// Карта тумблеров воркеров для Org. {} = все включены. Воркеры читают
  /// org.workersEnabled[workerName] !== false. Управляется из Org-Admin (Фаза 7).
  /// Структура: { "block-ingest": false, "block-distill": true, ... }.
  workersEnabled               Json              @default("{}")
  /// Окно (в днях) для strategic-alignment воркера (Фаза 9). По умолчанию 30,
  /// валидация в API: 7..90.
  strategicAlignmentWindowDays Int               @default(30)
  /// Фаза D — Очистка транскрипта (sub-TZ 2026-05-21-phase-D-transcript-cleaning §4).
  /// Если true — после завершения `ai.merge` автоматически ставится job в `ai.transcript-clean`.
  /// По умолчанию false — Org включает руками, оценив бюджет на LLM-refine (~$0.05 за 100 мин).
  /// Поле живёт на Org для простоты (отдельной модели OrgSettings в проекте сейчас нет).
  transcriptCleaningAuto       Boolean           @default(false)
  /// Фаза C — типы встреч, для которых AI-оценка качества НЕ рассчитывается
  /// (sub-TZ C §4). Управляется через `PATCH /org/settings/quality-score`
  /// owner/admin'ом Org. Пустой массив = считать для всех типов. Поле живёт
  /// на Org по консистентности с `transcriptCleaningAuto` (отдельной OrgSettings
  /// в проекте нет).
  qualityScoreDisabledForTypes MeetingType[]     @default([])
  /// SBA β-8.1 — IANA-таймзона организации. Используется в
  /// `operations-weekly-digest.cron` для определения «понедельник 08:00
  /// локального времени» при отправке недельной сводки. Default
  /// 'Europe/Moscow' (соответствует поведению других модулей, см.
  /// `local-date.ts:DEFAULT_TIMEZONE`).
  timezone                     String?           @default("Europe/Moscow")
  createdAt                    DateTime          @default(now())
  deletedAt                    DateTime?

  // ── Онбординг v2 (2026-05-29) — Блок A (квалификатор) ──
  /// «Сколько вас в команде?» (Экран 2). Значения: "1-5"|"6-20"|"21-50"|"51-200"|"201-500"|"500+".
  teamSize           String?   @db.VarChar(20)
  /// «Ваша отрасль» (Экран 3). Значения: software|services|manufacturing|retail|construction|finance|education|other.
  /// Используется для шаблонов отделов и должностей на шагах B2/B3 онбординга.
  industry           String?   @db.VarChar(60)
  /// «Что болит?» (Экран 4). Массив constId из painPoints-словаря.
  painPoints         String[]
  /// «Чем сейчас пользуетесь?» (Экран 5). Массив constId из currentStack-словаря.
  currentStack       String[]
  /// «Чем планируете пользоваться у нас?» (Экран 6). Массив constId из plannedFeatures-словаря.
  plannedFeatures    String[]
  /// Когда owner завершил Блок A (ставится при POST /welcome/complete).
  welcomeCompletedAt DateTime?

  /// Pulse Wave 4 §4.3 — региональный режим. 'ru' (по умолчанию, приоритет 152-ФЗ),
  /// 'eu' (приоритет EU AI Act, voice features скрыты), 'other'.
  region String? @default("ru") @db.VarChar(10)

  // ── Онбординг v2 (2026-05-29) — Блок B (прогресс setup-тура) ──
