{
  "title": "Z — AI pipeline",
  "uid": "z-ai-pipeline",
  "schemaVersion": 38,
  "editable": true,
  "tags": ["z", "ai"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "stage",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(ai_pipeline_duration_seconds_bucket, stage)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(ai_pipeline_duration_seconds_bucket, model)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "AI duration p50/p95 by stage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, stage) (rate(ai_pipeline_duration_seconds_bucket{stage=~\"$stage\", model=~\"$model\"}[5m])))",
          "legendFormat": "p50 {{stage}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(ai_pipeline_duration_seconds_bucket{stage=~\"$stage\", model=~\"$model\"}[5m])))",
          "legendFormat": "p95 {{stage}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AI cost ($/hour)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(ai_cost_usd_total[1h]) * 3600",
          "legendFormat": "$/hour"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AI cost total (24h, $)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "increase(ai_cost_usd_total[24h])",
          "legendFormat": "$24h"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top expensive meetings (Postgres datasource — AiUsageLog)",
      "datasource": { "type": "postgres", "uid": "postgres-z" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "description": "Требует настроенный Postgres-datasource Grafana с алиасом `postgres-z` (read-only пользователь к z_main). Если его нет — панель пуста.",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT meeting_id, sum(cost_usd) AS total_usd, count(*) AS calls FROM ai_usage_log WHERE created_at > now() - interval '24 hours' GROUP BY meeting_id ORDER BY total_usd DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM fallback events (rate, by provider)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(llm_fallback_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    }
  ]
}
