  s3
}

// ──────────────────────────── knowledge-core: graph (Фаза 3) ────────────────────────────

/// Тип типизированной связи между блоками. См. plans/tz/2026-05-10-knowledge-core-tz.md §Фаза 3.
enum IdeaBlockLinkType {
  develops
  contradicts
  causes
  consequences_of
  shares_topic
  shares_entity
  question_answered_by
}

/// Тип типизированной связи между сущностями.
enum EntityLinkType {
  works_at
  belongs_to
  part_of
  opposes
  depends_on
  mentions_with
}

/// Кто создал связь:
///   - linker: block-linker.worker (на canonical-блок).
///   - reframing: ночной reframing.cron (рефлексия графа).
///   - manual: пользователь через UI (не в MVP, но поле зафиксировано сразу).
enum LinkCreatedBy {
  linker
  reframing
  manual
}

/// Состояние связи: active = живая, archived = архив (понижен confidence или
/// сброшен ночным reframing).
enum LinkStatus {
  active
  archived
}

// ──────────────────────────── knowledge-core: theme (Фаза 4) ────────────────────────────

/// Состояние темы:
///   - active       — обнаружена кластерером, видна в UI и поиске.
///   - archived     — устарела или неактуальна (после reframing).
///   - merged_into  — слита в другую тему (mergedIntoId указывает целевую).
enum ThemeStatus {
  active
  archived
  merged_into
}

/// Динамика темы — заполняется reframing'ом по дельте новых блоков:
///   growing / stable / declining.
enum ThemeDynamic {
  growing
  stable
  declining
}

/// 12 веток компании (M-07 delivery). Для отнесения темы к крупному блоку
/// бизнеса. Опциональна — LLM может вернуть `null`, если ветка не очевидна.
enum ThemeBranch {
  strategy
  clients
  sales
  marketing
  product
  operations
  team
  finance
  technology
  production
  partnerships
  legal
}

// ──────────────────────────── knowledge-core: goals (Фаза 9) ────────────────────────────

/// Состояние цели:
///   - active     — активная, ежедневно оценивается воркером.
///   - paused     — owner временно приостановил мониторинг (не оценивается).
///   - achieved   — цель достигнута (закрыта успешно).
///   - abandoned  — цель брошена (soft-delete через archivedAt).
enum GoalStatus {
  active
  paused
  achieved
  abandoned
}

/// Источник связи Goal ↔ Theme:
///   - manual — owner вручную привязал тему через UI.
///   - ai     — предложено strategic-alignment.suggester (vNext).
enum GoalThemeSource {
  manual
  ai
}

// ──────────────────────────── models ────────────────────────────

model User {
  id                 String           @id @default(cuid())
  externalId         String?          @unique
  email              String
  name               String
  role               UserRole         @default(user)
  /// Флаг владельца продукта Z (super-admin Z-Admin раздела). См. orgs-and-rbac.md.
  /// На уровне БД — независим от `role` и `Membership`. Включается вручную DBA / seed'ом.
  isSuperAdmin       Boolean          @default(false)
  signupSource       UserSignupSource @default(crossmark)
  // argon2id (standalone) или bcrypt (admin local login). Опционально для Crossmark-провижененных юзеров.
  passwordHash       String?
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  lastSeenAt         DateTime?
  deletedAt          DateTime?

  meetings             Meeting[]
  sessions             UserSession[]
  verificationTokens   UserVerificationToken[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  destinations         IntegrationDestination[]
  tags                 Tag[]
  tasks                Task[]
  chatMessages         MeetingChatMessage[]
  userTemplates        UserTemplate[]
  exports              Export[]
  meetingShares        MeetingShare[]
  highlightShares      HighlightShare[]
  meetingHighlights    MeetingHighlight[]
  quotaCounters        UserQuotaCounter[]
  auditLog             AuditLog[]
  apiAccessLog         ApiAccessLog[]
  cards                Card[]
  ownedOrgs            Org[]                    @relation("OrgOwner")
  memberships          Membership[]
  invitedMemberships   Membership[]             @relation("MembershipInvitedBy")
  createdInvitations   OrgInvitation[]          @relation("OrgInvitationInvitedBy")
  acceptedInvitations  OrgInvitation[]          @relation("OrgInvitationAcceptedBy")
  superAdminAccessLogs SuperAdminAccessLog[]    @relation("SuperAdminAccessLog")
  goalsCreated         Goal[]                   @relation("GoalCreatedBy")

  @@unique([email, signupSource])
  @@index([email])
  @@index([deletedAt])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  userAgent String?   @db.Text
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model UserVerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  purpose   VerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Meeting {
  id               String        @id // ULID, генерится сервисом
  title            String
  type             MeetingType
  customPrompt     String?       @db.Text
  /// tenant: Org, в которой принадлежит встреча. NULL только для legacy-данных
  /// до backfill-fase0. После backfill становится NOT NULL отдельным push'ом.
  tenantId         String?
  tenant           Org?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id])
  cardId           String?
  card             Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  roomName         String        @unique // равен id
  status           MeetingStatus @default(scheduled)
  startedAt        DateTime?
  endedAt          DateTime?
  failureReason    String?
  durationMs       Int?
  recapVersion     Int           @default(1)
  chaptersStatus   AiStepStatus  @default(none)
  tasksStatus      AiStepStatus  @default(none)
  embeddingsStatus AiStepStatus  @default(none)
  /// Фаза 5 knowledge-core: статус v2-агентов (Tasks/Chapters/Summary над IdeaBlock).
  /// NULL = не запускался; 'queued'/'processing'/'ready'/'partial'/'failed'.
  /// Хранится строкой (а не enum'ом), чтобы было легко расширить без миграции.
  analyzeV2Status      String?
  /// Когда v2-агент завершил работу (последний раз).
  analyzeV2GeneratedAt DateTime?
  /// Текст ошибки на failed/partial. Multi-line, агент пишет короткую сводку.
  analyzeV2Error       String?       @db.Text
  createdAt        DateTime      @default(now())
  deletedAt        DateTime?

  participants     Participant[]
  recording        Recording?
  transcript       Transcript?
  aiResult         AiResult?
  events           MeetingEvent[]
  tasks            Task[]
  chapters         MeetingChapter[]
  highlights       MeetingHighlight[]
  shares           MeetingShare[]
  transcriptChunks MeetingTranscriptChunk[]
  chatMessages     MeetingChatMessage[]
  roomMessages     MeetingRoomMessage[]
  meetingTags      MeetingTag[]

  @@index([ownerId, createdAt])
  @@index([status, endedAt])
  @@index([deletedAt])
  @@index([cardId, createdAt])
  @@index([tenantId])
}

model Participant {
  id               String          @id @default(cuid())
  meetingId        String
  meeting          Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  livekitIdentity  String
  name             String
  role             ParticipantRole
  isRegisteredUser Boolean         @default(false)
  userId           String?
  deviceCount      Int             @default(1)
  joinedAt         DateTime?
  leftAt           DateTime?

  audioTrack   AudioTrack?
  roomMessages MeetingRoomMessage[]

  @@unique([meetingId, livekitIdentity])
  @@index([meetingId])
}

model Recording {
  id                String          @id @default(cuid())
  meetingId         String          @unique
  meeting           Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  mainVideoUrl      String?
  compositeEgressId String?
  status            RecordingStatus @default(not_started)
  retentionDays     Int
  expiresAt         DateTime
  archivedAt        DateTime?
  deletedAt         DateTime?
  bytesTotal        BigInt?
  durationSeconds   Int?

  audioTracks AudioTrack[]
  actions     RecordingAction[]

  @@index([expiresAt, status])
}

model AudioTrack {
  id              String       @id @default(cuid())
  recordingId     String
  recording       Recording    @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  participantId   String?      @unique
  participant     Participant? @relation(fields: [participantId], references: [id])
  participantName String
  livekitIdentity String
  trackId         String
  trackEgressId   String?
  audioUrl        String
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  bytes           BigInt?

  @@index([recordingId])
}

model Transcript {
  id                   String   @id @default(cuid())
  meetingId            String   @unique
  meeting              Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  rawIndexS3Url        String
  mergedS3Url          String?
  totalWords           Int?
  totalDurationSeconds Int?
  createdAt            DateTime @default(now())
}

model AiResult {
  id             String      @id @default(cuid())
  meetingId      String      @unique
  meeting        Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingType    MeetingType
  summary        String      @db.Text
  structuredData Json?
  customOutputMd String?     @db.Text
  followUpEmail  String?     @db.Text
  /// @deprecated после Phase 3 ai-workspace новые задачи пишутся в `Task`. Оставлено до миграции существующих записей через `backend/scripts/migrate-ai-tasks.ts`.
  tasks          Json?
  modelUsed      String
  /// Фаза 5 knowledge-core: альтернативная сводка, сгенерированная
  /// `meeting-analyze-v2.worker` поверх IdeaBlock'ов встречи. Не перезаписывает
  /// `summary`, чтобы UI оставался на legacy до решения владельца про A/B.
  summaryV2            String?   @db.Text
  /// `<provider>:<model>` модели, которая сгенерила `summaryV2`.
  summaryV2Model       String?
  /// Когда сгенерирован `summaryV2`.
  summaryV2GeneratedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model AiUsageLog {
  id              String   @id @default(cuid())
  /// tenant — Org, на которую списывается стоимость. NULL до backfill,
  /// после Шага 1 backfill становится NOT NULL для не-системных вызовов.
  tenantId        String?
  tenant          Org?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  meetingId       String?
  userId          String?
  agentType       String
  taskType        String?
  jobId           String?
  model           String
  provider        String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  /// Кэшированные input-токены (prompt cache hit) — учитываются в costUsd по cachedPer1M.
  cachedTokens    Int      @default(0)
  reasoningTokens Int?
  costUsd         Decimal  @db.Decimal(10, 6)
  /// `durationMs` = latency end-to-end вызова. Поле оставлено как есть.
  durationMs      Int
  success         Boolean
  errorText       String?  @db.Text
  /// Указатель на источник (откуда пришёл вызов) для drill-down в Z-Admin.
  /// Пример: { type: 'meeting', id: 'mtg_01HX...' }, { type: 'card', id: 'crd_...' }, { type: 'block', id: '...' }.
  sourceRef       Json?
  /// Для A/B-экспериментов LlmTaskRoute.experiment: 'A' | 'B'. NULL = вне эксперимента.
  experimentGroup String?
  /// Z-Admin Фаза 7: превью отправленного промпта (system + user, конкатенация),
  /// truncate до 8KB. Заполняется LlmRouter'ом при каждом успешном вызове.
  /// Для исторических записей до Фазы 7 — null. Используется в drill-down.
  requestPreview  String?  @db.Text
  /// Z-Admin Фаза 7: превью ответа модели (text), truncate до 8KB.
  responsePreview String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([meetingId])
  @@index([createdAt])
  @@index([userId, taskType, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, taskType, createdAt])
}

model IntegrationKey {
  id          String    @id @default(cuid())
  partnerName String
  keyHash     String    @unique
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([revokedAt])
}

model WebhookSeenEvent {
  eventId    String   @id
  eventType  String
  receivedAt DateTime @default(now())
}

model CrossmarkIdempotency {
  key          String   @id
  responseHash String
  responseBody Json
  httpStatus   Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model MeetingEvent {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  eventType  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([meetingId, receivedAt])
}

model RecordingAction {
  id          String    @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  action      String
  actor       String
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([recordingId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}

// ──────────────────────────── ai-workspace: tasks / chapters / highlights ────────────────────────────

model Task {
  id              String     @id @default(cuid())
  /// tenant: Org, к которой принадлежит задача. После backfill — NOT NULL.
  tenantId        String?
  tenant          Org?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingId       String
  meeting         Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?    @db.Text
  status          TaskStatus @default(open)
  assigneeRaw     String?
  assigneeUserId  String?
  dueDate         DateTime?
  sourceStartMs   Int?
  sourceEndMs     Int?
  sourceQuote     String?    @db.Text
  confidence      Float?
  createdManually Boolean    @default(false)
  /// Фаза 5 knowledge-core: какие IdeaBlock'и породили задачу (для drill-down).
  /// Пустой массив = legacy задача, не связана с блоками.
  evidenceBlockIds String[]   @default([])
  /// Фаза 5: метка генератора. NULL = legacy `tasks-extract.worker`,
  /// 'v2' = `meeting-analyze-v2.worker` (knowledge-core поверх блоков).
  /// Используется для A/B-сравнения и для последующего скимаринга legacy.
  extractorVersion String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, status])
  @@index([meetingId])
  @@index([dueDate])
  @@index([tenantId])
}

model MeetingChapter {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Org?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  startMs   Int
  endMs     Int
  title     String
  summary   String?  @db.Text
  order     Int
  /// Фаза 5 knowledge-core: какие IdeaBlock'и относятся к этой главе.
  /// Используется в UI для подсказок «откуда взято».
  evidenceBlockIds String[] @default([])
  /// Фаза 5: метка генератора. NULL = legacy `chapters.worker`,
  /// 'v2' = `meeting-analyze-v2.worker` (knowledge-core поверх блоков).
  extractorVersion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId, order])
  @@index([tenantId])
}

model MeetingHighlight {
  id             String       @id @default(cuid())
  tenantId       String?
  tenant         Org?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingId      String
  meeting        Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  startMs        Int
  endMs          Int
  title          String
  description    String?
  renderedMp4Key String?
  renderStatus   RenderStatus @default(none)
  renderError    String?      @db.Text
  /// Фаза 5 knowledge-core: ссылка на породивший IdeaBlock (если highlight
  /// сгенерирован поверх блоков). NULL для ручных и legacy-highlight'ов.
  evidenceBlockId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shares HighlightShare[]

  @@index([meetingId])
  @@index([tenantId])
}

// ──────────────────────────── ai-workspace: shares ────────────────────────────

model MeetingShare {
  id              String             @id @default(cuid())
  token           String             @unique
  meetingId       String
  meeting         Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  allowVideo      Boolean            @default(false)
  allowTranscript Boolean            @default(false)
  allowTasks      Boolean            @default(true)
  allowChapters   Boolean            @default(true)
  allowChat       Boolean            @default(false)
  expiresAt       DateTime
  revokedAt       DateTime?
  viewCount       Int                @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime           @default(now())
  views           MeetingShareView[]

  @@index([meetingId])
  @@index([expiresAt])
}

model MeetingShareView {
  id        String       @id @default(cuid())
  shareId   String
  share     MeetingShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  ipHash    String
  userAgent String?      @db.Text
  referrer  String?
  viewedAt  DateTime     @default(now())

  @@index([shareId, viewedAt])
}

model HighlightShare {
  id           String           @id @default(cuid())
  token        String           @unique
  highlightId  String
  highlight    MeetingHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  viewCount    Int              @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime         @default(now())

  @@index([highlightId])
}

// ──────────────────────────── ai-workspace: tags ────────────────────────────

model Tag {
  id        String       @id @default(cuid())
  tenantId  String?
  tenant    Org?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String       @default("#888888")
  createdAt DateTime     @default(now())
  meetings  MeetingTag[]

  @@unique([userId, name])
  @@index([userId])
  @@index([tenantId])
}

model MeetingTag {
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([meetingId, tagId])
  @@index([tagId])
}

// ──────────────────────────── ai-workspace: chat + RAG ────────────────────────────

model MeetingChatMessage {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Org?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String   @db.Text
  citations Json?
  tokensIn  Int?
  tokensOut Int?
  modelUsed String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([meetingId, createdAt])
  @@index([cardId, createdAt])
  @@index([tenantId, createdAt])
}

// In-meeting room chat (LiveKit DataChannel → backend mirror).
// Сообщения участников во время встречи: фронт отправляет одновременно через
// LiveKit DataChannel (realtime) и POST'ом сюда (persistence). Идемпотентность
// по `clientMessageId`, сгенерированному фронтом (ulid).
// Денормализуем `authorName` / `authorIdentity` — Participant может уйти
// вместе с soft-delete, а сообщение остаётся читаемым.
model MeetingRoomMessage {
  id              String       @id @default(cuid())
  meetingId       String
  meeting         Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participantId   String?
  participant     Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  authorName      String
  authorIdentity  String
  content         String       @db.Text
  clientMessageId String       @unique
  sentAt          DateTime     @default(now())

  @@index([meetingId, sentAt])
}

/// @deprecated knowledge-core Фаза 1: будет заменён IdeaBlock в Фазе 2, удалён в Фазе 6 после chat-v2. Не использовать в новом коде.
model MeetingTranscriptChunk {
  id        String                       @id @default(cuid())
  meetingId String
  meeting   Meeting                      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  startMs   Int
  endMs     Int
  text      String                       @db.Text
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())

  @@unique([meetingId, startMs, endMs])
  @@index([meetingId])
  @@index([userId])
}

// ──────────────────────────── ai-workspace: api / webhooks / destinations ────────────────────────────

model ApiKey {
  id         String        @id @default(cuid())
  /// Может быть null для глобальных system-ключей (super_admin, integration tools).
  tenantId   String?
  tenant     Org?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  hashedKey  String        @unique
  prefix     String
  scopes     ApiKeyScope[]
  /// Тип ключа (knowledge-core Фаза 10):
  ///   - 'api'    — Public API (создаётся через UI, prefix `z_`).
  ///   - 'ingest' — per-Org webhook-ingest (внешние адаптеры, prefix `zik_`).
  /// Хранится строкой, а не enum'ом, чтобы можно было расширить без миграции.
  scope      String        @default("api")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  apiAccessLog ApiAccessLog[]

  @@index([userId])
  @@index([tenantId])
  @@index([prefix])
}

model WebhookSubscription {
  id              String        @id @default(cuid())
  /// Может быть null для глобальных подписок super_admin (Z-Admin Фаза 7).
  tenantId        String?
  tenant          Org?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  url             String
  secretEncrypted String
  secretPrefix    String
  events          String[]
  status          WebhookStatus @default(active)
  lastDeliveryAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([tenantId])
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  eventId        String              @unique
  payload        Json
  attempts       Int                 @default(0)
  lastStatus     Int?
  lastResponse   String?             @db.Text
  status         DeliveryStatus      @default(pending)
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId, createdAt])
  @@index([nextAttemptAt])
}

model IntegrationDestination {
  id        String          @id @default(cuid())
  /// Может быть null для глобальных destination'ов super_admin.
  tenantId  String?
  tenant    Org?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DestinationType
  name      String
  config    Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([tenantId])
}

// ──────────────────────────── ai-workspace: export / templates / routing ────────────────────────────

model Export {
  id          String       @id @default(cuid())
  tenantId    String?
  tenant      Org?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ExportType
  meetingIds  String[]
  options     Json
  s3Key       String?
  status      ExportStatus @default(queued)
  error       String?      @db.Text
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([tenantId])
}

model UserTemplate {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  basedOnType    MeetingType?
  prompt         String?      @db.Text
  sectionsConfig String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
}

model LlmTaskRoute {
  id         String   @id @default(cuid())
  /// NULL = глобальный дефолт, заданный super_admin (Z-Admin).
  /// Не-NULL = override на конкретную Org (Z-Admin Фаза 7).
  tenantId   String?
  tenant     Org?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskType   String
  providers  Json
  isActive   Boolean  @default(true)
  /// A/B-эксперимент: { enabled: bool, modelA: string, modelB: string,
  ///                    splitPercent: number, startedAt: ISO, endsAt: ISO }.
  /// При enabled=true LlmRouter рандомно выбирает A/B и пишет experimentGroup в AiUsageLog.
  experiment Json?
  /// Фаза 11 knowledge-core: минимальный класс данных, который маршрут
  /// поддерживает. NULL трактуется как 'internal'. LlmRouter фильтрует
  /// провайдеров по `provider.maxDataClass >= max(dataClass, requiredDataClass)`.
  /// Если ни один провайдер не подходит — `NoEligibleProviderError` +
  /// метрика `core_data_class_violations_total`.
  requiredDataClass DataClass?
  updatedAt  DateTime @updatedAt

  @@unique([taskType, tenantId])
  @@index([tenantId])
}

// ──────────────────────────── ai-workspace: audit / quotas / api access ────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Org?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resourceId String?
  metadata   Json?
  ipHash     String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
}

model ApiAccessLog {
  id         String   @id @default(cuid())
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  route      String
  status     Int
  durationMs Int?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model UserQuotaCounter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotaName   String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, quotaName, windowStart])
  @@index([userId, quotaName])
}

// ──────────────────────────── cards: CRM-структура встреч ────────────────────────────

model Card {
  id          String  @id @default(cuid())
  /// tenant: Org, к которой принадлежит карточка. После backfill — NOT NULL.
  tenantId    String?
  tenant      Org?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  // 'client' | 'deal' | 'project' | 'topic' | 'custom'.
  // Хранится строкой (а не enum'ом), чтобы можно было добавлять виды без миграций.
  kind        String  @default("client")
  color       String  @default("#5EEAD4")
  icon        String?
  description String? @db.Text

  // Один опциональный primary-контакт. Несколько — vNext через CardContact.
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Knowledge-core (Фаза 4): primary-сущность карточки + связанные сущности +
  // опциональная ссылка на Theme, из которой пользователь сохранил карточку
  // через `POST /themes/:id/save-as-card`.
  entityId         String?
  entity           Entity?  @relation("CardEntity", fields: [entityId], references: [id], onDelete: SetNull)
  relatedEntityIds String[] @default([])
  bornFromThemeId  String?
  bornFromTheme    Theme?   @relation("CardBornFromTheme", fields: [bornFromThemeId], references: [id], onDelete: SetNull)

  pinned     Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  // AI rollup-кэш (заполняется card-rollup.worker'ом).
  summaryCache     String?   @db.Text
  summaryUpdatedAt DateTime?

  // Knowledge-core (Фаза 4): топ-N тем, связанных с карточкой через её блоки.
  // Заполняется card-rollup-v2.worker'ом — кэш для быстрого рендера UI.
  cachedTopThemeIds String[] @default([])

  // Денормализация для сортировки списка без JOIN.
  meetingCount  Int       @default(0)
  lastMeetingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings     Meeting[]
  chatMessages MeetingChatMessage[]

  @@unique([ownerId, name])
  @@index([ownerId, lastMeetingAt])
  @@index([ownerId, archivedAt])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([entityId])
  @@index([bornFromThemeId])
}

// ──────────────────────────── orgs / RBAC / invitations (Фаза 0 knowledge-core) ────────────────────────────

/// Org — организация-клиент. Любой ресурс (встреча, карточка, задача и т.д.)
/// принадлежит ровно одной Org через поле tenantId.
///
/// При регистрации создаётся персональный Org с owner=User. Member'ов добавляет
/// owner через OrgInvitation. visibilityMode определяет, видят ли manager-ы
/// чужие ресурсы внутри Org.
model Org {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  ownerId        String
  owner          User              @relation("OrgOwner", fields: [ownerId], references: [id])
  visibilityMode OrgVisibilityMode @default(open)
  /// Тариф — placeholder для Фазы 12. На Фазе 0 все Org = basic.
  tier           OrgTier           @default(basic)
  /// Карта тумблеров воркеров для Org. {} = все включены. Воркеры читают
  /// org.workersEnabled[workerName] !== false. Управляется из Org-Admin (Фаза 7).
  /// Структура: { "block-ingest": false, "block-distill": true, ... }.
  workersEnabled Json              @default("{}")
  /// Окно (в днях) для strategic-alignment воркера (Фаза 9). По умолчанию 30,
  /// валидация в API: 7..90.
  strategicAlignmentWindowDays Int @default(30)
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  memberships  Membership[]
  invitations  OrgInvitation[]
  meetings     Meeting[]
  cards        Card[]
  tasks        Task[]
  chapters     MeetingChapter[]
  highlights   MeetingHighlight[]
  chatMessages MeetingChatMessage[]
  tags         Tag[]
  apiKeys      ApiKey[]
  webhookSubs  WebhookSubscription[]
  destinations IntegrationDestination[]
  exports      Export[]
  llmRoutes    LlmTaskRoute[]
  auditLogs    AuditLog[]
  aiUsageLogs  AiUsageLog[]
  sources      Source[]
  rawEvents    RawEvent[]
  ideaBlocks   IdeaBlock[]
  entities     Entity[]
  blockLinks   IdeaBlockLink[]
  entityLinks  EntityLink[]
  themes       Theme[]
  goals        Goal[]
  goalAlignmentSnapshots GoalAlignmentSnapshot[]
  retentionPolicy OrgRetentionPolicy?
  entitlement OrgEntitlement?

  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id        String         @id @default(cuid())
  orgId     String
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MembershipRole
  /// Кто пригласил/добавил. Для owner-а первичной Org = NULL.
  invitedBy String?
  inviter   User?          @relation("MembershipInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  joinedAt  DateTime       @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
}

model OrgInvitation {
  id               String              @id @default(cuid())
  orgId            String
  org              Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email            String
  role             MembershipRole
  /// Случайный nanoid(40); хранится как plaintext (короткоживущий + одноразовый).
  token            String              @unique
  status           OrgInvitationStatus @default(pending)
  invitedBy        String
  inviter          User                @relation("OrgInvitationInvitedBy", fields: [invitedBy], references: [id])
  createdAt        DateTime            @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?               @relation("OrgInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([email, status])
  @@index([expiresAt])
}

// ──────────────────────────── llm-prices (Фаза 0 knowledge-core) ────────────────────────────

/// Версионируемая прайс-карта моделей. При расчёте `costUsd` LlmRouter сначала
/// смотрит сюда (актуальная запись по provider+model+effectiveFrom<=now AND
/// (effectiveTo IS NULL OR effectiveTo>now)), фолбэк на MODEL_PRICES в коде.
///
/// Цены — стоимость за 1 миллион токенов в указанной валюте.
model LlmModelPrice {
  id                         String    @id @default(cuid())
  provider                   String
  model                      String
  inputCostPerMillionTokens  Decimal   @db.Decimal(10, 6)
  outputCostPerMillionTokens Decimal   @db.Decimal(10, 6)
  /// Цена за 1M кэшированных входных токенов (prompt cache hit). 0 — не поддерживается.
  cachedCostPerMillionTokens Decimal   @default(0) @db.Decimal(10, 6)
  currency                   String    @default("USD")
  effectiveFrom              DateTime  @default(now())
  effectiveTo                DateTime?
  createdAt                  DateTime  @default(now())

  @@index([provider, model, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

// ──────────────────────────── knowledge-core: Source / RawEvent (Фаза 1) ────────────────────────────

/// Справочник подключённых источников Org (meeting, chat, email, …).
/// Дефолтный `Source(type=meeting, name='Встречи Z')` создаётся автоматически
/// при создании Org. Управление источниками из UI — Фаза 10.
model Source {
  id        String     @id @default(cuid())
  tenantId  String
  type      SourceType
  name      String
  config    Json?
  dataClass DataClass  @default(internal)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org       Org        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEvents RawEvent[]

  @@unique([tenantId, type, name])
  @@index([tenantId, isActive])
}

/// Иммутабельная запись сырого события из любого источника. Главный entry-point
/// в knowledge-core. На Фазе 2 над ней появится `block-ingest.worker`.
model RawEvent {
  id               String                   @id @default(cuid())
  tenantId         String
  sourceId         String
  sourceType       SourceType
  /// Если null — событие без внешнего ID, дедуп по checksum.
  sourceExternalId String?
  /// sha256(sourceId + ':' + (sourceExternalId ?? payloadChecksum) + ':' + occurredAtIso)
  idempotencyKey   String                   @unique
  occurredAt       DateTime
  receivedAt       DateTime                 @default(now())
  payloadStorage   RawEventPayloadStorage   @default(inline)
  /// null если payloadStorage = s3
  payload          Json?
  /// не null если payloadStorage = s3
  payloadS3Key     String?
  /// sha256 от исходного payload (всегда, для верификации).
  payloadChecksum  String
  payloadSizeBytes Int
  dataClass        DataClass                @default(internal)
  processingStatus RawEventProcessingStatus @default(received)
  /// Текст ошибки при processingStatus = failed.
  processingError  String?                  @db.Text
  /// Когда последний раз обработался ingest pipeline (Фаза 2).
  processedAt      DateTime?

  org      Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source   Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  evidence IdeaBlockEvidence[]

  @@index([tenantId, sourceId, occurredAt])
  @@index([tenantId, processingStatus])
}

// ──────────────────────────── knowledge-core: IdeaBlock + Entity (Фаза 2) ────────────────────────────

/// IdeaBlock — единица знания «вопрос ↔ доверенный ответ».
/// Извлекается block-ingest.worker'ом из RawEvent, дедуплицируется
/// block-distill.worker'ом по эмбеддингам и LLM-арбитру.
///
/// Поля name / criticalQuestion / trustedAnswer индексируются ts_vector'ом
/// (см. postgres-init.sql) для гибридного поиска. embedding (vector(1536))
/// — для семантического поиска через HNSW.
///
/// status:
///   - draft: только что извлечён, не прошёл distill
///   - canonical: основной блок, остальные похожие через mergedIntoId → его id
///   - merged_into: блок-дубликат, его mergedIntoId указывает на canonical
///   - archived: устарел / явно скрыт
model IdeaBlock {
  id               String                       @id @default(cuid())
  tenantId         String
  name             String
  criticalQuestion String                       @db.Text
  trustedAnswer    String                       @db.Text
  tags             String[]                     @default([])
  signalType       SignalType
  confidence       Decimal                      @default(0.5) @db.Decimal(4, 3)
  dataClass        DataClass                    @default(internal)
  embedding        Unsupported("vector(1536)")?
  status           IdeaBlockStatus              @default(draft)
  mergedIntoId     String?
  evidenceCount    Int                          @default(0)
  /// Динамический рейтинг: пересчитывается ретеншеном; влияет на ранжирование в поиске.
  dynamicScore     Decimal                      @default(1.0) @db.Decimal(8, 4)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  org        Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto IdeaBlock?          @relation("BlockMerges", fields: [mergedIntoId], references: [id])
  mergedFrom IdeaBlock[]         @relation("BlockMerges")
  evidence   IdeaBlockEvidence[]
  entities   IdeaBlockEntity[]
  linksFrom  IdeaBlockLink[]     @relation("BlockLinkFrom")
  linksTo    IdeaBlockLink[]     @relation("BlockLinkTo")
  themes     ThemeIdeaBlock[]

  @@index([tenantId, status])
  @@index([tenantId, signalType])
  @@index([tenantId, mergedIntoId])
}

/// IdeaBlockEvidence — link block ↔ конкретный фрагмент RawEvent с цитатой.
/// Один блок может иметь много свидетельств из разных встреч/чатов/звонков.
/// quote — текстовая цитата, startMs/endMs — таймкоды (если применимо к источнику).
model IdeaBlockEvidence {
  id              String     @id @default(cuid())
  blockId         String
  rawEventId      String
  sourceType      SourceType
  sourceTimestamp DateTime?
  quote           String     @db.Text
  startMs         Int?
  endMs           Int?
  createdAt       DateTime   @default(now())

  block    IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rawEvent RawEvent  @relation(fields: [rawEventId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@index([rawEventId])
}

/// Entity — сущность (клиент, человек, проект, продукт, тема, локация, custom).
/// Используется в IdeaBlockEntity (M:M с блоками) и в knowledge-core search.
/// canonicalName уникален в рамках tenant + type через приложение (не индексом —
/// возможны исторические дубликаты до прохода entity-merge-arbiter).
model Entity {
  id            String                       @id @default(cuid())
  tenantId      String
  type          EntityType
  canonicalName String
  aliases       String[]                     @default([])
  mergedIntoId  String?
  mentionsCount Int                          @default(0)
  embedding     Unsupported("vector(1536)")?
  metadata      Json?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  org           Org               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto    Entity?           @relation("EntityMerges", fields: [mergedIntoId], references: [id])
  mergedFrom    Entity[]          @relation("EntityMerges")
  blockMentions IdeaBlockEntity[]
  linksFrom     EntityLink[]      @relation("EntityLinkFrom")
  linksTo       EntityLink[]      @relation("EntityLinkTo")
  themes        ThemeEntity[]
  cards         Card[]            @relation("CardEntity")

  @@index([tenantId, type])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, canonicalName])
}

/// IdeaBlockEntity — M:M связь block ↔ entity с ролью и контекстом упоминания.
/// role — subject (главное действующее), object (на что направлено), mentioned (вскользь).
model IdeaBlockEntity {
  blockId        String
  entityId       String
  mentionContext String              @db.Text
  role           IdeaBlockEntityRole @default(mentioned)
  createdAt      DateTime            @default(now())

  block  IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([blockId, entityId])
  @@index([entityId])
}

/// IdeaBlockLink — типизированная связь между двумя IdeaBlock.
/// Создаётся `block-linker.worker` (KNN top-K кандидатов + LLM-арбитр)
/// или `reframing.cron` (рефлексия графа). 7 типов связей —
/// см. enum `IdeaBlockLinkType`.
///
/// Дедупликация: уникальная пара (fromBlockId, toBlockId, relationType).
/// Идемпотентный upsert при повторных проходах линкера.
model IdeaBlockLink {
  id           String            @id @default(cuid())
  tenantId     String
  fromBlockId  String
  toBlockId    String
  relationType IdeaBlockLinkType
  confidence   Decimal           @db.Decimal(4, 3)
  explanation  String            @db.Text
  createdBy    LinkCreatedBy
  status       LinkStatus        @default(active)
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11). Если не null — связь скрыта в UI.
  deletedAt    DateTime?
  /// userId, инициировавший удаление через Org-Admin. Для аудита.
  deletedBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  org       Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBlock IdeaBlock @relation("BlockLinkFrom", fields: [fromBlockId], references: [id], onDelete: Cascade)
  toBlock   IdeaBlock @relation("BlockLinkTo", fields: [toBlockId], references: [id], onDelete: Cascade)

  @@unique([fromBlockId, toBlockId, relationType])
  @@index([tenantId, status])
  @@index([fromBlockId, status])
  @@index([toBlockId, status])
  @@index([tenantId, deletedAt])
}

/// EntityLink — типизированная связь между двумя Entity.
/// Создаётся `entity-graph-builder.cron` (раз в час) на основе пар сущностей,
/// часто упомянутых в одних и тех же блоках. 6 типов связей —
/// см. enum `EntityLinkType`.
model EntityLink {
  id           String         @id @default(cuid())
  tenantId     String
  fromEntityId String
  toEntityId   String
  relationType EntityLinkType
  confidence   Decimal        @db.Decimal(4, 3)
  explanation  String         @db.Text
  createdBy    LinkCreatedBy
  status       LinkStatus     @default(active)
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11).
  deletedAt    DateTime?
  /// userId, инициировавший удаление через Org-Admin.
  deletedBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  org        Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromEntity Entity @relation("EntityLinkFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity @relation("EntityLinkTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relationType])
  @@index([tenantId, status])
  @@index([fromEntityId, status])
  @@index([toEntityId, status])
  @@index([tenantId, deletedAt])
}

// ──────────────────────────── knowledge-core: Theme (Фаза 4) ────────────────────────────

/// Theme — AI-кластер блоков. Создаётся `theme-clusterer.cron` (KNN-greedy
/// по эмбеддингам блоков + LLM-классификатор имени/ветки). Никогда не
/// создаётся пользователем вручную: если пользователь хочет «свою тему» —
/// он жмёт `POST /themes/:id/save-as-card` и получает Card с kind='topic'.
///
/// branch — одна из 12 веток компании (delivery M-07). Опциональна: LLM
/// может вернуть `null`, если ветка не определилась.
///
/// embedding(1536) — эмбеддинг от `name + ' ' + description`, для поиска
/// связанных тем и для UI-фильтров.
model Theme {
  id           String                       @id @default(cuid())
  tenantId     String
  name         String
  description  String                       @db.Text
  weight       Decimal                      @default(0.5) @db.Decimal(4, 3)
  dynamic      ThemeDynamic                 @default(stable)
  confidence   Decimal                      @default(0.5) @db.Decimal(4, 3)
  status       ThemeStatus                  @default(active)
  mergedIntoId String?
  branch       ThemeBranch?
  embedding    Unsupported("vector(1536)")?
  lastSignalAt DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  org        Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto Theme?           @relation("ThemeMerges", fields: [mergedIntoId], references: [id])
  mergedFrom Theme[]          @relation("ThemeMerges")
  blocks     ThemeIdeaBlock[]
  entities   ThemeEntity[]
  cards      Card[]           @relation("CardBornFromTheme")
  goalLinks  GoalTheme[]

  @@index([tenantId, status])
  @@index([tenantId, branch])
  @@index([tenantId, mergedIntoId])
}

/// ThemeIdeaBlock — M:M связь Theme ↔ IdeaBlock.
/// weight — мера принадлежности блока к теме (1.0 для seed-кластера, ниже
/// для дополнительно «прибившихся» блоков в reframing).
model ThemeIdeaBlock {
  themeId   String
  blockId   String
  weight    Decimal  @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime @default(now())

  theme Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  block IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([themeId, blockId])
  @@index([blockId])
}

/// ThemeEntity — denormalized связь Theme ↔ Entity (через блоки темы).
/// Заполняется кластерером и поддерживается reframing'ом для быстрых фильтров
/// «темы про этого клиента / этот продукт».
model ThemeEntity {
  themeId       String
  entityId      String
  mentionsCount Int      @default(0)
  createdAt     DateTime @default(now())

  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([themeId, entityId])
  @@index([entityId])
}

// ──────────────────────────── Z-Admin: SuperAdminAccessLog (Фаза 7) ────────────────────────────

/// Лог drill-down действий super_admin (Z-Admin Фаза 7).
/// Любое чтение/запись super_admin'а в данные конкретной Org пишется сюда
/// для compliance. На Фазе 7 — только запись, ежемесячный email-отчёт vNext.
///
/// Глобальная таблица (нет tenantId на уровне модели — `accessedTenantId`
/// указывает, к какой Org обращался super_admin; null = глобальный уровень).
model SuperAdminAccessLog {
  id               String   @id @default(cuid())
  superAdminUserId String
  superAdmin       User     @relation("SuperAdminAccessLog", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  /// NULL = действие на глобальном уровне (без конкретной Org).
  accessedTenantId String?
  route            String
  method           String
  params           Json?
  createdAt        DateTime @default(now())

  @@index([superAdminUserId, createdAt])
  @@index([accessedTenantId, createdAt])
}

// ──────────────────────────── knowledge-core: goals (Фаза 9) ────────────────────────────

/// Цель компании (Фаза 9 knowledge-core).
/// Создаётся owner Org вручную. Связь с Theme — M:M (GoalTheme).
/// Ежесуточно strategic-alignment.worker оценивает движение к цели.
model Goal {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String       @db.Text
  /// Опциональный дедлайн. Используется как контекст для LLM-судьи.
  targetDate   DateTime?
  status       GoalStatus   @default(active)
  /// Вес в среднем "Согласованность стратегии" (Фаза 8 dashboard). Default 1.0.
  weight       Decimal      @default(1.0) @db.Decimal(4, 3)
  createdById  String
  createdBy    User         @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?
  /// Кэш последнего snapshot для быстрого чтения списка целей без JOIN'а.
  /// Обновляется воркером после каждого расчёта.
  cachedAlignment      Int?      /// 0..100, NULL = ещё не считалось.
  cachedAlignmentAt    DateTime?
  cachedAlignmentDelta Int?      /// разница со снапшотом 24h назад, для подсветки падений.
  cachedSnapshotId     String?   /// FK на последний GoalAlignmentSnapshot.

  themes    GoalTheme[]
  snapshots GoalAlignmentSnapshot[]

  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
}

/// M:M между Goal и Theme. На старте — ручная привязка от owner;
/// AI-предложения добавляются с source='ai' в vNext.
model GoalTheme {
  goalId    String
  themeId   String
  /// Источник связи: manual (owner добавил) | ai (предложено suggester'ом).
  source    GoalThemeSource @default(manual)
  /// Вес (1.0 — основная, ниже — частично связанная). По умолчанию 1.0.
  weight    Decimal         @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime        @default(now())

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([goalId, themeId])
  @@index([themeId])
}

/// Суточный снапшот «движения к цели» от strategic-alignment.worker.
/// Используется для timeline'а и вычисления delta.
model GoalAlignmentSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  goalId       String
  /// 0..100 — оценка движения за окно (default 30 дней).
  score        Int
  /// Разница со снапшотом 24h назад (для подсветки падений). NULL для первого.
  delta        Int?
  /// 1-3 предложения объяснения от LLM.
  explanation  String   @db.Text
  /// Структура: { pro: ['…'], contra: ['…'] } — по 3-5 пунктов.
  signals      Json
  /// Какое окно использовалось (в днях).
  windowDays   Int      @default(30)
  /// Сколько связанных тем участвовало в оценке.
  themesCount  Int
  /// Сколько блоков LLM проанализировал.
  blocksCount  Int
  /// AiUsageLog.id (для drill-down в Z-Admin). FK не делаем — может быть очищен ретеншеном.
  aiUsageLogId String?
  /// Если delta <= -15 и score <= 60 — alertPending=true.
  alertPending Boolean  @default(false)
  createdAt    DateTime @default(now())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tenant Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, alertPending])
}

// ──────────────────────────── knowledge-core: retention (Фаза 11) ────────────────────────────

/// OrgRetentionPolicy — конфиг ретеншена per-Org для knowledge-core/152-ФЗ
/// (Фаза 11). Создаётся seed'ом или lazy upsert'ом в RetentionPolicyService.
///
/// Поля — длительности в днях:
///   - rawEventDays: 7 лет (2555) — дефолт под 152-ФЗ; ниже 30 нельзя установить.
///   - archivedBlockDays: 365 — сколько живёт IdeaBlock.status='archived' до hard-delete.
///   - chatMessageDays: 90 — MeetingChatMessage.
///   - auditLogDays: 730 — AuditLog (compliance).
///
/// archivedBlockAction:
///   - 'archive_then_delete' (default) — блок без evidence уходит в archived,
///     а через archivedBlockDays — hard-delete.
///   - 'keep_forever' — архив остаётся всегда (нет hard-delete по retention).
///
/// lastSweepAt — когда последний раз RetentionService.processAll проходил по Org.
model OrgRetentionPolicy {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  org                 Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEventDays        Int       @default(2555)
  archivedBlockDays   Int       @default(365)
  chatMessageDays     Int       @default(90)
  auditLogDays        Int       @default(730)
  archivedBlockAction String    @default("archive_then_delete")
  lastSweepAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ──────────────────────────── knowledge-core: entitlements (Фаза 12) ────────────────────────────

/// OrgEntitlement — per-Org конфиг тарифа и override'ов фич/квот (Фаза 12).
///
/// `tier` — строка ('tier_basic' | 'tier_pro' | 'tier_enterprise'), не enum.
/// Причина: бизнес может ввести четвёртый/пятый тариф без миграции.
/// Реестр тарифов (features/quotas) — статический в коде (TierConfigRegistry).
///
/// `featureOverrides` / `quotaOverrides` — JSON-карты для исключений.
/// Пример: `{"feature.theme": true}` даст enterprise-фичу одной Org бесплатно.
///
/// `notes` — ручной комментарий super_admin'а (для audit-trail в UI).
///
/// На MVP backfill сидит `tier_pro` по умолчанию (см. seed-entitlements.ts).
model OrgEntitlement {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  org              Org      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier             String   @default("tier_pro")
  featureOverrides Json?
  quotaOverrides   Json?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
