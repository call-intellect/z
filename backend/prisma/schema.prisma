  name           String?
  role           String?
  linkedPersonId String?
  linkMode       ChatboxMemberLinkMode @default(none)
  raw            Json?
  syncedAt       DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

