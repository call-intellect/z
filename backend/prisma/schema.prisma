/// TrustTier — Action Center A1 «лестница доверия» (2026-06-02). Метка доверия
/// версии карточки (CardVersion):
///   - human       — версия создана/подтверждена человеком-куратором (decide).
///   - auto        — авто-канонизация некритического типа (high confidence, без conflict).
///   - provisional — провизорная канонизация критического типа AI-судьёй
///                   (3-голосовый debate-консенсус accept). Подлежит аудит-выборке.
enum TrustTier {
  auto
  provisional
  human
}

/// CurationDecisionType — тип решения куратора по карточке.
///   - mark_as_misleading: SBA γ-1 — post-hoc пометка карточки специалиста (Skill traits)
///     как «неверная» direct manager'ом / admin'ом. Skill не проходит pre-approval (auto-canonical),
///     поэтому неверные traits лечатся только постфактум.
///   - merge_categories: SBA α-4 wave 2 — куратор сливает 2 SkillTraitCategory в одну
///     (целевая категория — `payload.targetCategoryId`, исходная — `payload.sourceCategoryId`).
///     Используется γ-1 Specialist для очистки дублей категорий.
///   - escalate: SBA α-4 wave 2 — карточка передаётся следующему куратору
///     (`payload.escalateToUserId`). CurationItem остаётся в статусе `pending`
///     и переназначается через `candidateCuratorIds`.
enum CurationDecisionType {
  approve
  reject
  approve_with_edits
  split
  merge
  supersede
  mark_as_misleading
  merge_categories
  escalate
}

