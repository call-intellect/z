/// ChatBox: сообщение. Зеркало.
model ChatboxMessage {
  id                 String             @id @default(cuid())
  tenantId           String
  chatId             String
  sessionId          String?
  externalId         String
  senderType         ChatboxSenderType
  senderExternalId   String?
  senderName         String?
  contentType        ChatboxContentType @default(TEXT)
  text               String?            @db.Text
  imageUrl           String?            @db.Text
  fileUrl            String?            @db.Text
  audioUrl           String?            @db.Text
  videoUrl           String?            @db.Text
  externalCreatedAt  DateTime
  isOutboundFromKora Boolean            @default(false)
  raw                Json?
  createdAt          DateTime           @default(now())

  org  Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat ChatboxChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, chatId, externalCreatedAt])
  @@index([tenantId, sessionId])
}

/// Bitrix24: конфиг подключения портала к org Коры.
/// plans/tz/2026-06-09-bitrix24-integration-install.md.
///
/// Натуральный ключ — `memberId` (один портал Bitrix24 = одна запись). `tenantId`
/// nullable: при установке из Маркета (ONAPPINSTALL) запись создаётся в статусе
/// `pending` ДО привязки к org — её делает claim из iframe-handler. При OAuth-
/// коннекте из Коры `tenantId` известен сразу (из подписанного state).
///
/// Инвариант приватности: токены (`*Enc`, AES-256-GCM через CryptoService)
/// НИКОГДА не возвращаются plain в API — наружу только `hasTokens`.
/// Уникальность «одна connected на org» обеспечивается на уровне сервиса.
model BitrixIntegration {
  id                  String                  @id @default(cuid())
  /// member_id портала Bitrix24 (стабильный, не зависит от домена).
  memberId            String                  @unique
  /// Привязанная org Коры. null пока статус `pending` (установка из Маркета).
  tenantId            String?
  /// Домен портала, напр. `acme.bitrix24.ru`.
  portalDomain        String
  /// REST-эндпоинт портала из OAuth-ответа (для вызовов API), напр.
  /// `https://acme.bitrix24.ru/rest/`.
  clientEndpoint      String?
  /// REST-эндпоинт сервера авторизации (`https://oauth.bitrix.info/rest/`).
  serverEndpoint      String?
  /// Выданные scope (comma-separated), как вернул OAuth.
  scope               String?
  /// AES-256-GCM. Никогда не возвращается plain в API.
  accessTokenEnc      String                  @db.Text
  /// AES-256-GCM. Живёт 180 дней; обновляется при refresh.
  refreshTokenEnc     String                  @db.Text
  /// application_token из ONAPPINSTALL — для проверки подлинности входящих
  /// событий (особенно ONAPPUNINSTALL, где авторизации уже нет). AES-256-GCM.
  applicationTokenEnc String?                 @db.Text
  /// Момент протухания access_token (now + expires_in). null → считать протухшим.
  accessExpiresAt     DateTime?
  status              BitrixIntegrationStatus @default(pending)
  lastError           String?                 @db.Text
  lastConnectedAt     DateTime?
  /// Источник: AI-анализ IM-диалогов включён по умолчанию (ТЗ 2026-06-17).
  analysisEnabled       Boolean   @default(true)
  /// Источник: отметки последних синков (как у ChatBox).
  lastFullSyncAt        DateTime?
  lastIncrementalSyncAt DateTime?
  /// Ф4b — курсор дельта-синка CRM (по DATE_MODIFY): берём изменения с этого
  /// момента. null → первый синк тянет за CRM_BACKFILL_DAYS (7 дней).
  lastCrmSyncAt         DateTime?
  /// Ф4b — до какого дня (UTC, начало дня) уже построены посуточные CRM-дайджесты.
  /// null → бэкафилл дайджестов за последние CRM_BACKFILL_DAYS закрытых дней.
  lastCrmDigestAt       DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  org Org? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

// ─── Bitrix24-источник: зеркала IM-чатов + CRM (ТЗ 2026-06-17) ───────────────

