  /// evaluator (promote/archive shadow skills). См. plans/tz/.../umbrella.md §C1.
  practiceSkills PracticeSkill[] @relation("PracticeSkillTenant")
  skillUsages    SkillUsage[]    @relation("SkillUsageTenant")

  // ── Agents v2 Фаза C2 (2026-05-30) — GEPA prompt evolution ──
  /// PromptCandidate — кандидаты на эволюцию prompt'а, найденные GEPA.
  /// tenantId=null = global candidate. Per-Org candidate'ы — tenantId NOT NULL.
  /// См. plans/tz/2026-05-29-agents-v2-umbrella.md §C2.
  promptCandidates PromptCandidate[]

  // ── Pulse Wave 4 §4.1-4.2 — Compliance (152-ФЗ) + audit log карточки ──
  consentLogs                ConsentLog[]
  knowledgeAccessLogs        KnowledgeAccessLog[]
  // Pulse Wave 4 §4.6 — снапшоты прогнозов Forecaster агента.
  forecastSnapshots          ForecastSnapshot[]
  // Pulse Wave 6 — 5 новых snapshot-моделей (C1 batch).
  knowledgeRiskSnapshots     KnowledgeRiskSnapshot[]
  recurringTopics            RecurringTopic[]
  promiseNetworkSnapshots    PromiseNetworkSnapshot[]
  personGoalContributions    PersonGoalContribution[]
  knowledgeVelocitySnapshots KnowledgeVelocitySnapshot[]

  // ── Smart Tables (см. plans/tz/2026-05-31-smart-tables.md Фаза 0) ──
  tables Table[]

  // ── ChatBox-интеграция (plans/tz/2026-06-05-chatbox-integration.md Фаза 1) ──
  chatboxIntegration    ChatboxIntegration?
  chatboxChannels       ChatboxChannel[]
  chatboxCustomers      ChatboxCustomer[]
  chatboxChannelClients ChatboxChannelClient[]
  chatboxMembers        ChatboxMember[]
  chatboxChats          ChatboxChat[]
  chatboxChatSessions   ChatboxChatSession[]
  chatboxMessages       ChatboxMessage[]

  // ── Bitrix24-интеграция (plans/tz/2026-06-09-bitrix24-integration-install.md) ──
  bitrixIntegrations BitrixIntegration[]
  // ── Bitrix24-источник: синк IM + CRM (plans/tz/2026-06-17-bitrix24-source-sync.md) ──
  bitrixUsers          BitrixUser[]
  bitrixDialogs        BitrixDialog[]
  bitrixDialogSessions BitrixDialogSession[]
  bitrixMessages       BitrixMessage[]
  bitrixContacts       BitrixContact[]
  bitrixCompanies      BitrixCompany[]
  bitrixDeals          BitrixDeal[]
  bitrixLeads          BitrixLead[]
  bitrixCrmNotes       BitrixCrmNote[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id        String         @id @default(cuid())
  orgId     String
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MembershipRole
  /// Кто пригласил/добавил. Для owner-а первичной Org = NULL.
  invitedBy String?
  inviter   User?          @relation("MembershipInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  /// Фаза 0a §10 — линковка с бизнес-Person, заполняется при accept'е
  /// приглашения. NULL для legacy memberships (до Фазы 0).
  personId  String?
  person    Person?        @relation("MembershipPerson", fields: [personId], references: [id], onDelete: SetNull)
  joinedAt  DateTime       @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
  @@index([personId])
}

/// ТЗ 2026-05-25 §9 (clone-respond эволюция) — гранты доступа к клонам.
///
/// Под флагом `CLONE_V2_ENABLED=true` это ЕДИНСТВЕННЫЙ источник правды о
/// доступе к person/role-клону: галочка либо стоит, либо нет. Без флага
/// логика старая (носитель, manager, admin). См. RbacService.canAccessPersonClone /
/// canAccessRoleClone.
///
/// Создание/удаление — admin-эндпоинты `/api/v1/admin/clones/access-grants/*`
/// (отдельная подзадача). Скрипт первичной миграции грантов —
/// `backend/scripts/patch-migrate-clone-access.ts` (заглушка на этом этапе).
model CloneAccessGrant {
  id              String   @id @default(cuid())
  tenantId        String
  /// Пользователь, получающий право спрашивать клона.
  grantedToUserId String
  /// 'person' (person-scope, по personId) или 'role' (role-scope, по roleId).
  cloneType       String
  /// personId или roleId — без формального FK (двойная природа), валидируется на уровне сервиса.
  cloneRefId      String
  /// Кто выдал галочку (admin Org).
  grantedById     String
  grantedAt       DateTime @default(now())

  /// ТЗ 2026-05-26 — soft-revoke. Запись не удаляется, чтобы остался audit-trail.
  /// audit В15 (2026-05-29): при re-grant та же row UPDATE'ом «воскрешается»
  /// (revokedAt=null, revokedBy=null, grantedById/At=новые). id гранта
  /// остаётся стабильным — это важно для логов CloneAccessAudit и внешних ссылок.
  revokedAt DateTime?
  revokedBy String?

  /// ТЗ 2026-05-26 — опциональный срок действия. Из UI на старте всегда null
  /// (UI с date-picker появится позже). При expiresAt <= now() грант считается
  /// неактивным (см. RbacService.isGrantActive / canAccess*Clone).
  expiresAt DateTime?

  tenant         Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  grantedTo      User    @relation("CloneAccessGrant_grantedTo", fields: [grantedToUserId], references: [id], onDelete: Cascade)
  grantedBy      User    @relation("CloneAccessGrant_grantedBy", fields: [grantedById], references: [id])
  revokedByU     User?   @relation("CloneAccessGrant_revokedBy", fields: [revokedBy], references: [id])

  @@unique([tenantId, grantedToUserId, cloneType, cloneRefId])
  @@index([tenantId, grantedToUserId])
  @@index([tenantId, cloneType, cloneRefId])
  @@index([revokedAt])
  @@index([expiresAt])
}

/// Группа доступа к знаниям (Ф2 knowledge-access). kind=department ССЫЛАЕТСЯ на
/// существующий Department (refId=departmentId — оргдерево НЕ дублируем);
/// leadership/council — закрытые «верхние» группы (синглтоны на Org, refId=null);
/// personal — личный сейф (refId=personId).
enum KnowledgeGroupKind {
  department
  leadership
  council
  personal
  support // закрытый контур техподдержки (синглтон per вендор-Org, refId=null) — TZ support-desk
}

model KnowledgeGroup {
  id         String                 @id @default(cuid())
  tenantId   String
  kind       KnowledgeGroupKind
  refId      String? /// departmentId | personId | null
  name       String                 @db.VarChar(200)
  /// Закрытая группа: видна ТОЛЬКО прямым членам, НЕ через матрицу отделов (вертикаль).
  isClosed   Boolean                @default(false)
  createdAt  DateTime               @default(now())
  org        Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members    KnowledgeGroupMember[]
  blockLinks IdeaBlockAccess[]

  @@unique([tenantId, kind, refId])
  @@index([tenantId, kind])
}

model KnowledgeGroupMember {
  groupId   String
  personId  String
  source    String         @db.VarChar(10) /// 'auto' (из должности) | 'manual' (override)
  createdAt DateTime       @default(now())
  group     KnowledgeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, personId])
  @@index([personId])
}

/// M:N блок ↔ группа. Блок может быть и «логистика», и «совет» одновременно.
model IdeaBlockAccess {
  blockId   String
  groupId   String
  via       String         @db.VarChar(12) /// 'department' (горизонталь) | 'closed' (вертикаль)
  createdAt DateTime       @default(now())
  block     IdeaBlock      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  group     KnowledgeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([blockId, groupId])
  @@index([groupId])
}

/// Направленная матрица «отдел-субъект видит отдел-объект». Образец — DepartmentDomainLink.
model GroupVisibilityPolicy {
  id             String   @id @default(cuid())
  tenantId       String
  subjectGroupId String
  visibleGroupId String
  createdAt      DateTime @default(now())
  org            Org      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([subjectGroupId, visibleGroupId])
  @@index([tenantId, subjectGroupId])
}

model OrgInvitation {
  id                 String              @id @default(cuid())
  orgId              String
  org                Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// β-9 (2026-05-25): email теперь опционален. Для линейного персонала без
  /// почты директор копирует ссылку приглашения и пересылает руками
  /// (через `linkCode` или magic-link URL из `manualShareUrl` ответа).
  email              String?
  role               MembershipRole
  /// Случайный nanoid(40); хранится как plaintext (короткоживущий + одноразовый).
  token              String              @unique
  status             OrgInvitationStatus @default(pending)
  invitedBy          String
  inviter            User                @relation("OrgInvitationInvitedBy", fields: [invitedBy], references: [id])
  /// Фаза 0a §10 — линковка с бизнес-Person. Опц.; при создании приглашения
  /// из wizard'а или /structure?tab=persons backend заранее создаёт Person
  /// и сохраняет ссылку здесь, чтобы при accept'е заполнить Person.userId.
  personId           String?
  person             Person?             @relation("OrgInvitationPerson", fields: [personId], references: [id], onDelete: SetNull)
  /// β-9 (2026-05-25) — одноразовый код для прямой привязки Telegram-бота
  /// из письма приглашения (deep-link `https://t.me/<bot>?start=<linkCode>`).
  /// Hex(12) от `ConversationalLinkCodeService`, дублируется в Redis для горячего
  /// пути бота. NULL для legacy-приглашений без β-9 интеграции.
  linkCode           String?             @unique
  linkCodeUsedAt     DateTime?
  /// β-9 (2026-05-25) — sha256 magic-link-токена (по аналогии с
  /// `UserVerificationToken.tokenHash`). Прожигается при первом клике по
  /// magic-link в письме → создаётся `User` + `Membership`, открывается сессия
  /// без пароля. NULL для legacy-приглашений.
  magicTokenHash     String?             @unique
  magicTokenUsedAt   DateTime?
  /// β-10 (2026-05-27) — sha256(tempPassword), сгенерированного при создании
  /// приглашения и отправленного в письме как одноразовый пароль для входа.
  /// При acceptViaMagicLink этот хеш используется как passwordHash нового User
  /// → mustChangePassword=true. NULL для legacy-приглашений до β-10.
  tempPasswordHash   String?
  /// β-9 (2026-05-25) — когда крон `org-invitation-reminders` отправил
  /// напоминание сотруднику (на 7-й день после `createdAt`). NULL = не отправляли.
  reminderSentAt     DateTime?
  /// β-9 (2026-05-25) — когда крон уведомил директора, что сотрудник так и
  /// не принял (на 14-й день, в день истечения). NULL = не уведомляли.
  directorNotifiedAt DateTime?
  createdAt          DateTime            @default(now())
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedByUserId   String?
  acceptedByUser     User?               @relation("OrgInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@index([personId])
}

/// ТЗ «Команда + доступы» Фаза 5 — персональный override доступа сотрудника
/// поверх дефолта роли/тарифа. effect='allow' открывает, 'deny' закрывает.
/// Только небиллинговые «что человек видит» оси (память/панели/граф/чат).
model EmployeeCapabilityOverride {
  id              String    @id @default(cuid())
  tenantId        String
  grantedToUserId String
  capability      String
  effect          String
  expiresAt       DateTime?
  grantedById     String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedBy       String?

  org       Org  @relation("OrgEmployeeCapabilityOverrides", fields: [tenantId], references: [id], onDelete: Cascade)
  grantedTo User @relation("ECO_grantedTo", fields: [grantedToUserId], references: [id], onDelete: Cascade)
  grantedBy User @relation("ECO_grantedBy", fields: [grantedById], references: [id])

  @@unique([tenantId, grantedToUserId, capability])
  @@index([tenantId, grantedToUserId])
}

// ──────────────────────────── llm-prices (Фаза 0 knowledge-core) ────────────────────────────

/// Версионируемая прайс-карта моделей. При расчёте `costUsd` LlmRouter сначала
/// смотрит сюда (актуальная запись по provider+model+effectiveFrom<=now AND
/// (effectiveTo IS NULL OR effectiveTo>now)), фолбэк на MODEL_PRICES в коде.
///
/// Цены — стоимость за 1 миллион токенов в указанной валюте.
model LlmModelPrice {
  id                               String    @id @default(cuid())
  provider                         String
  model                            String
  /// SBA α-10 wave 2 (2026-05-23) — опц. FK на LlmModel (новый реестр).
  /// Старые `provider`/`model` (строки) остаются для backward-compat.
  modelId                          String?
  inputCostPerMillionTokens        Decimal   @db.Decimal(10, 6)
  outputCostPerMillionTokens       Decimal   @db.Decimal(10, 6)
  /// Цена за 1M кэшированных входных токенов (prompt cache hit). 0 — не поддерживается.
  cachedCostPerMillionTokens       Decimal   @default(0) @db.Decimal(10, 6)
  /// SBA α-10 wave 2 — цена за 1M токенов write-cache (для Anthropic prompt cache create).
  inputCachedWritePerMillionTokens Decimal?  @db.Decimal(10, 6)
  /// SBA α-10 wave 2 — snapshot курса валюты к USD на момент применения цены
  /// (для исторических AiUsageLog.costRub вычислений без re-query CurrencyRate).
  currencyRateToUsdSnapshot        Decimal?  @db.Decimal(12, 6)
  currency                         String    @default("USD")
  effectiveFrom                    DateTime  @default(now())
  effectiveTo                      DateTime?
  /// Кто внёс изменение цены (для аудита админ-действий).
  changedByUserId                  String?
  createdAt                        DateTime  @default(now())

  modelRef  LlmModel? @relation("LlmModelPriceModel", fields: [modelId], references: [id], onDelete: SetNull)
  changedBy User?     @relation("LlmModelPriceChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([provider, model, effectiveFrom])
  @@index([modelId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

// ──────────────────────────── SBA α-10 wave 2 — Admin LLM + Unit Economics ────────────────────────────

/// LlmProvider — реестр провайдеров LLM (deepseek, openai-proxy, ollama,
/// anthropic, minimax, …). Управляется из админки `/admin/llm/providers`.
///
/// Один provider может иметь несколько LlmModel. Adapter (как вызывать API)
/// определяется через `protocolKind` — мapping в LlmProtocolAdapterRegistry
/// (5 типов: openai-chat / openai-responses / anthropic-messages / ollama-native /
/// custom-http).
model LlmProvider {
  id               String    @id @default(cuid())
  /// Уникальное короткое имя (slug): 'deepseek', 'openai-proxy', 'ollama',
  /// 'anthropic', 'minimax'. Использовалось в коде до α-10 как `provider` string —
  /// сохраняем стабильным для backward-compat.
  name             String    @unique @db.VarChar(60)
  /// Человекочитаемое имя для UI.
  displayName      String    @db.VarChar(120)
  /// Базовый endpoint API.
  baseUrl          String    @db.VarChar(500)
  /// Тип протокола: 'openai-chat' | 'openai-responses' | 'anthropic-messages' |
  /// 'ollama-native' | 'custom-http'.
  protocolKind     String    @db.VarChar(40)
  /// Капабилити: 'sensitive' = поддерживает private data; 'public' = только публичные данные.
  /// Влияет на маршрутизацию dataClass через LlmRouterService.
  capability       String    @default("public") @db.VarChar(20)
  /// Зашифрованный AES-256-GCM API-ключ (формат gcm:v1:...). NULL для self-hosted (Ollama).
  apiKeyEncrypted  String?   @db.Text
  /// Дополнительные headers (например, Anthropic-Version). JSON.
  defaultHeaders   Json?
  /// Глобальный rate limit (RPS) для самозащиты. NULL = без лимита.
  globalRps        Int?
  /// Активен ли провайдер для маршрутизации.
  isActive         Boolean   @default(true)
  /// Последний результат smoke-теста.
  lastSmokeAt      DateTime?
  lastSmokeSuccess Boolean?
  lastSmokeError   String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  models LlmModel[]

  @@index([isActive, protocolKind])
  @@map("llm_providers")
}

/// LlmModel — конкретная модель LLM в реестре (gpt-5.4-flash, deepseek-v4-pro,
/// qwen3.5:9b, …). Привязана к LlmProvider.
///
/// Используется в LlmTaskRoute.modelId, LlmModelPrice.modelId, LlmModelExperiment.
model LlmModel {
  id               String    @id @default(cuid())
  providerId       String
  /// Идентификатор модели в API (string передаётся в запросе).
  modelKey         String    @db.VarChar(120)
  /// Человекочитаемое имя для UI.
  displayName      String    @db.VarChar(200)
  /// Контекстное окно (in tokens).
  contextWindow    Int?
  /// Поддерживаются ли json_schema / tool calls. JSON-карта capabilities.
  capabilitiesJson Json?
  /// Категория для UI: 'flagship' | 'fast' | 'reasoning' | 'embedding' | 'experimental'.
  category         String?   @db.VarChar(40)
  /// Активна ли модель для маршрутизации.
  isActive         Boolean   @default(true)
  /// Verified — прошла smoke-тест. NULL = не проверялась.
  verifiedAt       DateTime?
  /// Заметка о статусе (например «timeout в KIE при медиане > 30s»).
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  provider LlmProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  prices   LlmModelPrice[] @relation("LlmModelPriceModel")

  @@unique([providerId, modelKey])
  @@index([providerId, isActive])
  @@index([category])
  @@map("llm_models")
}

/// AiCostDaily — дневная агрегация затрат AI по (tenant × taskType × provider × model).
/// Наполняется DailyCostAggregatorCron из AiUsageLog. Хранит сумму costRub/costUsd
/// для быстрых дашбордов без скана миллионов AiUsageLog.
model AiCostDaily {
  id             String   @id @default(cuid())
  tenantId       String
  date           DateTime @db.Date
  taskType       String   @db.VarChar(80)
  provider       String   @db.VarChar(60)
  model          String   @db.VarChar(120)
  /// Сколько вызовов было за день.
  callsCount     Int      @default(0)
  /// Сколько успешных (без fallbackReason).
  callsSuccess   Int      @default(0)
  /// Сумма затрат в USD (по snapshot из LlmModelPrice).
  costUsd        Decimal  @default(0) @db.Decimal(14, 6)
  /// Сумма затрат в RUB (по snapshot currencyRateToUsdSnapshot).
  costRub        Decimal  @default(0) @db.Decimal(14, 4)
  /// Сумма input/output/cached токенов.
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  cachedTokens   Int      @default(0)
  /// Когда последний раз пересчитывалась эта строка (для idempotency cron).
  recalculatedAt DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, taskType, provider, model])
  @@index([tenantId, date])
  @@index([date, taskType])
  @@map("ai_cost_daily")
}

/// OrgBudgetCap — бюджетные лимиты per Org на AI-расходы. Используется
/// BudgetAlertCron для уведомлений Org-owner'у при превышении % лимита.
model OrgBudgetCap {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  /// Месячный лимит в RUB. NULL = без лимита.
  monthlyCapRub      Decimal?  @db.Decimal(14, 2)
  /// Hard-cap или soft-cap (только alert).
  capKind            String    @default("soft") @db.VarChar(10)
  /// Пороги для alert'ов в % (например, [50, 80, 95]).
  alertThresholds    Int[]     @default([50, 80, 95])
  /// Когда был последний alert (для дедупликации).
  lastAlertAt        DateTime?
  /// Какой порог триггерил последний alert (для предотвращения повторов на тот же %).
  lastAlertThreshold Int?
  /// Кто установил лимит.
  setByUserId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org   Org   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setBy User? @relation("OrgBudgetCapSetBy", fields: [setByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("org_budget_caps")
}

/// CurrencyRate — курс валют. Поддерживается CurrencyRateSyncCron из ЦБ РФ
/// (https://www.cbr-xml-daily.ru). Используется LlmModelPrice/AiUsageLog для
/// пересчёта USD → RUB.
model CurrencyRate {
  id            String   @id @default(cuid())
  /// Базовая валюта (всегда 'USD' в текущей реализации).
  baseCurrency  String   @db.VarChar(3)
  /// Котируемая валюта ('RUB', 'EUR', 'CNY', …).
  quoteCurrency String   @db.VarChar(3)
  /// Курс: 1 baseCurrency = `rate` quoteCurrency.
  rate          Decimal  @db.Decimal(14, 6)
  /// Источник: 'cbr' | 'manual' | 'ecb' | …
  source        String   @default("cbr") @db.VarChar(20)
  /// Дата котировки (на конец дня).
  rateDate      DateTime @db.Date
  /// Когда скриптовали в БД.
  fetchedAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, rateDate, source])
  @@index([rateDate])
  @@map("currency_rates")
}

// ──────────────────────────── knowledge-core: Source / RawEvent (Фаза 1) ────────────────────────────

/// Справочник подключённых источников Org (meeting, chat, email, …).
/// Дефолтный `Source(type=meeting, name='Встречи Z')` создаётся автоматически
/// при создании Org. Управление источниками из UI — Фаза 10.
model Source {
  id        String     @id @default(cuid())
  tenantId  String
  type      SourceType
  name      String
  config    Json?
  dataClass DataClass  @default(internal)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org       Org        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEvents RawEvent[]

  @@unique([tenantId, type, name])
  @@index([tenantId, isActive])
}

/// Иммутабельная запись сырого события из любого источника. Главный entry-point
/// в knowledge-core. На Фазе 2 над ней появится `block-ingest.worker`.
model RawEvent {
  id               String                   @id @default(cuid())
  tenantId         String
  sourceId         String
  sourceType       SourceType
  /// Если null — событие без внешнего ID, дедуп по checksum.
  sourceExternalId String?
  /// sha256(sourceId + ':' + (sourceExternalId ?? payloadChecksum) + ':' + occurredAtIso)
  idempotencyKey   String                   @unique
  occurredAt       DateTime
  receivedAt       DateTime                 @default(now())
  payloadStorage   RawEventPayloadStorage   @default(inline)
  /// null если payloadStorage = s3
  payload          Json?
  /// не null если payloadStorage = s3
  payloadS3Key     String?
  /// sha256 от исходного payload (всегда, для верификации).
  payloadChecksum  String
  payloadSizeBytes Int
  dataClass        DataClass                @default(internal)
  processingStatus RawEventProcessingStatus @default(received)
  /// Текст ошибки при processingStatus = failed.
  processingError  String?                  @db.Text
  /// Когда последний раз обработался ingest pipeline (Фаза 2).
  processedAt      DateTime?

  org      Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source   Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  evidence IdeaBlockEvidence[]

  @@index([tenantId, sourceId, occurredAt])
  @@index([tenantId, processingStatus])
}

// ──────────────────────────── knowledge-core: IdeaBlock + Entity (Фаза 2) ────────────────────────────

/// IdeaBlock — единица знания «вопрос ↔ доверенный ответ».
/// Извлекается block-ingest.worker'ом из RawEvent, дедуплицируется
/// block-distill.worker'ом по эмбеддингам и LLM-арбитру.
///
/// Поля name / criticalQuestion / trustedAnswer индексируются ts_vector'ом
/// (см. postgres-init.sql) для гибридного поиска. embedding (vector(1536))
/// — для семантического поиска через HNSW.
///
/// status:
///   - draft: только что извлечён, не прошёл distill
///   - canonical: основной блок, остальные похожие через mergedIntoId → его id
///   - merged_into: блок-дубликат, его mergedIntoId указывает на canonical
///   - archived: устарел / явно скрыт
model IdeaBlock {
  id                          String                       @id @default(cuid())
  tenantId                    String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource              String?
  name                        String
  criticalQuestion            String                       @db.Text
  trustedAnswer               String                       @db.Text
  tags                        String[]                     @default([])
  signalType                  SignalType
  confidence                  Decimal                      @default(0.5) @db.Decimal(4, 3)
  dataClass                   DataClass                    @default(internal)
  embedding                   Unsupported("vector(1536)")?
  status                      IdeaBlockStatus              @default(draft)
  mergedIntoId                String?
  evidenceCount               Int                          @default(0)
  /// Динамический рейтинг: пересчитывается ретеншеном; влияет на ранжирование в поиске.
  dynamicScore                Decimal                      @default(1.0) @db.Decimal(8, 4)
  /// Фаза 2 «отчёт→граф» (ТЗ 2026-06-11-report-to-graph-phase2). Первичный
  /// источник факта на УРОВНЕ блока (evidence может быть мульти-source):
  /// 'transcript' (дословный, первичный) | 'report' (выжимка отчёта, вторичный).
  /// null = исторические блоки → трактуются как 'transcript'. Детерминированный
  /// machine-guard провенанса: ГАРД B в block-distill (транскрипт всегда
  /// побеждает report при дедупе), ГАРД A в block-ingest (cap confidence report).
  primarySource               String?                      @db.VarChar(16)
  /// Фаза 0b — пометка role-relevance из BlockExtractionService.
  /// Если true и roleId != null — блок учитывается RoleProfileAgent'ом (Фаза 0d).
  roleRelevant                Boolean                      @default(false)
  /// Опц. связь блока с Role (бизнес-должность). NULL — общий блок.
  roleId                      String?
  /// SBA β-8.2 — поля «Хранителя обещаний». Заполняются ТОЛЬКО для
  /// блоков с signalType='commitment'. Для остальных типов всегда NULL.
  ///
  /// `commitmentDueDate` — срок исполнения (00:00 UTC соответствующей даты).
  /// Извлекается из текста промптом `block-distill` (`commitmentDueDateGuess`).
  /// Если не извлечён — backfill-скрипт ставит `createdAt + 5 рабочих дней`.
  commitmentDueDate           DateTime?
  /// 'open' | 'asked' | 'fulfilled' | 'missed' | 'cancelled' | 'superseded'.
  commitmentStatus            String?                      @db.VarChar(20)
  /// Адресат обещания (Person той же Org). NULL если не извлечён.
  commitmentRecipientPersonId String?
  /// ТЗ-D (2026-06-05) — АВТОР обещания (кто дал слово), Person той же Org.
  /// Заполняется ТОЛЬКО для блоков signalType='commitment'. Для остальных
  /// типов всегда NULL. В отличие от commitmentRecipientPersonId (fuzzy по
  /// имени от LLM), автор заполняется ДЕТЕРМИНИРОВАННО по identity спикера
  /// сегмента (speakerParticipantId) или payload.userId — резолвер
  /// EntityResolutionService.resolveSubjectPersonId. NULL если identity не
  /// разрешилась. Атрибуция БЕЗ LLM — prompt-cache сохранён.
  commitmentAuthorPersonId    String?
  /// Когда последний раз ушёл probe «выполнил ли?».
  commitmentAskedAt           DateTime?
  /// Когда эскалировали при молчании (probe ушёл COO + owner).
  commitmentEscalatedAt       DateTime?
  /// KC-Temporal W1.1 (2026-05-25) — bi-temporal оси факта.
  /// `validFrom` — когда факт стал верен в реальности (default — самый
  /// ранний `IdeaBlockEvidence.sourceTimestamp`, иначе `createdAt`).
  /// Заполняется при persist в block-ingest.worker'е (при `BITEMPORAL_ENABLED=true`).
  validFrom                   DateTime?
  /// KC-Temporal W1.1 — когда факт перестал быть верен (null = до сих пор).
  /// Выставляется `FactSupersedeService` при `supersedes`-вердикте.
  validUntil                  DateTime?
  /// KC-Temporal W1.1 — когда система узнала о факте.
  /// Default now(); для backfill — равно `createdAt`.
  recordedAt                  DateTime                     @default(now())
  /// KC-Temporal W1.1 — когда система пометила факт устаревшим (supersede).
  supersededAt                DateTime?
  /// KC-Temporal W1.1 — id нового блока, который заменил этот.
  supersededById              String?
  /// KC-Temporal W1.4 (2026-05-25) — спан-уровневые свидетельства.
  /// Структура: `Array<{ field, refId?, evidenceId, startMs, endMs }>`.
  /// `field ∈ {'name'|'criticalQuestion'|'trustedAnswer'|'mentionedEntity'}`.
  /// Best-effort; отсутствие не ломает рендер.
  propertySpans               Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  org                 Org                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto          IdeaBlock?           @relation("BlockMerges", fields: [mergedIntoId], references: [id])
  mergedFrom          IdeaBlock[]          @relation("BlockMerges")
  /// KC-Temporal W1.1 — supersede chain (новый блок → старый).
  supersedes          IdeaBlock?           @relation("IdeaBlockSupersedes", fields: [supersededById], references: [id])
  supersedeChain      IdeaBlock[]          @relation("IdeaBlockSupersedes")
  evidence            IdeaBlockEvidence[]
  entities            IdeaBlockEntity[]
  linksFrom           IdeaBlockLink[]      @relation("BlockLinkFrom")
  linksTo             IdeaBlockLink[]      @relation("BlockLinkTo")
  themes              ThemeIdeaBlock[]
  /// Decision-сущности, созданные параллельно этому блоку (idempotent по
  /// sourceIdeaBlockId; Фаза 0b §I.66 зонтичного ТЗ).
  decisions           Decision[]
  /// Фаза 0d — link на Role-бизнес-должность для RoleProfileAgent.
  role                Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// SBA α-3 wave 3 — axis-метки (who/functional/contextual/temporal),
  /// проставленные AxisClassifierService после router.dispatch.
  /// См. plans/tz/2026-05-23-sba-alpha-3-wave3-axis-classifier-full.md.
  axisLabels          IdeaBlockAxisLabel[]
  /// SBA β-8.2 — адресат обещания (для блоков signalType='commitment').
  commitmentRecipient Person?              @relation("CommitmentRecipient", fields: [commitmentRecipientPersonId], references: [id], onDelete: SetNull)
  /// ТЗ-D — автор обещания (для блоков signalType='commitment').
  commitmentAuthor    Person?              @relation("CommitmentAuthor", fields: [commitmentAuthorPersonId], references: [id], onDelete: SetNull)
  /// Ф2 knowledge-access — группы доступа блока (m:n). Пусто = открыт всем (дефолт).
  blockAccess         IdeaBlockAccess[]

  @@index([tenantId, status])
  @@index([tenantId, signalType])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, roleRelevant, roleId])
  /// SBA β-8.2 — выборка «висящих обещаний к сроку» (cron Хранителя обещаний).
  @@index([tenantId, signalType, commitmentStatus, commitmentDueDate])
  /// SBA β-8.2 — личный кабинет «Мои обещания» (по personId через
  /// `Person.userId`, фильтр по статусу).
  @@index([tenantId, signalType, commitmentStatus])
  /// KC-Temporal W1.1 — частые запросы «активные сейчас» (validUntil IS NULL).
  @@index([tenantId, validUntil])
  /// KC-Temporal W1.1 — снапшот «активные блоки данного signalType».
  @@index([tenantId, signalType, validUntil])
  /// ТЗ-D — выборка «обещания, данные человеком» (план-факт по автору).
  @@index([tenantId, commitmentAuthorPersonId])
  /// ТЗ-D — план-факт за неделю: автор × статус × срок.
  @@index([tenantId, signalType, commitmentAuthorPersonId, commitmentDueDate])
}

/// IdeaBlockAxisLabel — fan-out IdeaBlock по 4 осям знания
/// (who / functional / contextual / temporal). Источник §α-3 wave 3 sub-ТЗ.
///
/// Идемпотентность: уникальный составной ключ (tenantId, blockId, axis, label) —
/// AxisClassifierService использует upsert, повторные классификации не дублируют
/// записи. `source` ∈ {'static' | 'llm' | 'manual'} — для аудита и качества.
/// `label` — динамическая строка: entityId / domain-slug / 'temporal:<period>'.
model IdeaBlockAxisLabel {
  id         String   @id @default(cuid())
  tenantId   String
  blockId    String
  axis       AxisType
  /// Динамический ключ: entityId (для who/contextual), FunctionalDomain.slug
  /// (для functional) или 'temporal:<period>' (для temporal).
  label      String   @db.VarChar(200)
  confidence Decimal  @db.Decimal(4, 3)
  /// 'static' (по уже разрешённым entities/доменам), 'llm' (классификатор),
  /// 'manual' (admin-override).
  source     String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  block  IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tenant Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, blockId, axis, label])
  @@index([tenantId, blockId])
  @@index([tenantId, axis, label])
  @@index([axis, label])
}

/// IdeaBlockEvidence — link block ↔ конкретный фрагмент RawEvent с цитатой.
/// Один блок может иметь много свидетельств из разных встреч/чатов/звонков.
/// quote — текстовая цитата, startMs/endMs — таймкоды (если применимо к источнику).
model IdeaBlockEvidence {
  id                      String     @id @default(cuid())
  blockId                 String
  rawEventId              String
  sourceType              SourceType
  sourceTimestamp         DateTime?
  quote                   String     @db.Text
  startMs                 Int?
  endMs                   Int?
  sourceMessageExternalId String?
  createdAt               DateTime   @default(now())

  block    IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rawEvent RawEvent  @relation(fields: [rawEventId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@index([rawEventId])
}

/// Entity — сущность (клиент, человек, проект, продукт, тема, локация, custom).
/// Используется в IdeaBlockEntity (M:M с блоками) и в knowledge-core search.
/// canonicalName уникален в рамках tenant + type через приложение (не индексом —
/// возможны исторические дубликаты до прохода entity-merge-arbiter).
///
/// KC-Temporal W3.4 (2026-05-25) — «Strong IDs»: поля inn/ogrn/email/phone/domain
/// используются для дедупа БЕЗ LLM в рамках Org. Уникальность гарантируется
/// partial unique indices в `backend/scripts/postgres-init.sql` (Prisma
/// `@@unique` не поддерживает WHERE-условия, а делать full-unique нельзя —
/// большинство сущностей не имеют этих идентификаторов).
model Entity {
  id             String                       @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  type           EntityType
  canonicalName  String
  aliases        String[]                     @default([])
  mergedIntoId   String?
  mentionsCount  Int                          @default(0)
  embedding      Unsupported("vector(1536)")?
  metadata       Json?
  /// KC-Temporal W3.4 — strong-IDs (ИНН/ОГРН/email/phone/domain).
  /// Все nullable; partial unique через postgres-init.sql.
  inn            String?                      @db.VarChar(20)
  ogrn           String?                      @db.VarChar(20)
  email          String?                      @db.VarChar(320)
  phone          String?                      @db.VarChar(40)
  domain         String?                      @db.VarChar(253)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  org           Org               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto    Entity?           @relation("EntityMerges", fields: [mergedIntoId], references: [id])
  mergedFrom    Entity[]          @relation("EntityMerges")
  blockMentions IdeaBlockEntity[]
  // ↓ С Фазы 0 EntityLink — полиморфная модель без FK на Entity. Обратные
  //   relations убраны; для поиска связей используется
  //   EntityLink.findMany({ where: { fromEntityId, fromType: 'entity' } })
  //   или GraphService.getNeighbors. См. EntityLink выше.
  themes        ThemeEntity[]
  cards         Card[]            @relation("CardEntity")
  /// Линковка Person → Entity (Фаза 0b §8.3): Entity{type=person} может быть
  /// связана с Prisma-моделью Person через EntityResolutionService.
  persons       Person[]

  /// SBA α-3 — обратные связи новых моделей категории A.
  vendor                Vendor?                @relation("VendorEntity")
  event                 Event?                 @relation("EventEntity")
  goal                  Goal?                  @relation("GoalEntity")
  document              Document?              @relation("DocumentEntity")
  market                Market?                @relation("MarketEntity")
  orgUnit               OrgUnit?               @relation("OrgUnitEntity")
  /// SBA α-8 wave 2 — линковка с Role.
  role                  Role?                  @relation("RoleEntity")
  /// SBA α-9 wave 2 — линковка с Department.
  department            Department?            @relation("DepartmentEntity")
  /// TZ-1 Фаза 1 (daily-value-engine) — дневные снимки риска клиента
  /// (только для Entity{type=customer}).
  customerRiskSnapshots CustomerRiskSnapshot[] @relation("CustomerRiskSnapshotEntity")

  @@index([tenantId, type])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, canonicalName])
}

// ──────────────────────────── SBA α-3 — категория A: Vendor / Event ────────────────────────────

/// Vendor — поставщик (категория A онтологии, SBA α-3). С `entityId` строго
/// привязан к Entity{type=vendor} для участия в графе знаний.
///
/// Дедупликация: приоритет `metadata.inn` (юридическое лицо), fallback на
/// `name`. Реализация в `EntityResolutionService.findOrCreateVendorEntity`.
model Vendor {
  id                String         @id @default(cuid())
  tenantId          String
  /// Связка с Entity{type=vendor}. Уникальна (1:1).
  entityId          String         @unique
  entity            Entity         @relation("VendorEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org               Org            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String         @db.VarChar(300)
  inn               String?        @db.VarChar(20)
  segment           VendorSegment?
  status            VendorStatus   @default(active)
  /// User.id ответственного со стороны компании. NULL — не назначен.
  responsibleUserId String?
  /// Document.id'ы договоров (опц.). FK не делаем — мягкая ссылка, чтобы не
  /// каскадить delete документа на Vendor.
  contractIds       String[]       @default([])
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  /// Sprints (2026-05-27) — проекты-спринты, привязанные к этому поставщику
  /// (Project.vendorId). См. plans/tz/2026-05-27-sprints.md §1.1.
  scopedProjects Project[] @relation("ProjectVendor")

  @@index([tenantId, status])
  @@index([tenantId, segment])
  @@index([tenantId, deletedAt])
}

/// Event — событие графа знаний (категория A, SBA α-3). Объединяет встречи,
/// инциденты, релизы, переходы и milestone'ы под единой типизацией для
/// специалистов Слоя 3 (3-3-decisions, 3-5-insights).
///
/// Дедупликация: `(tenantId, title, startAt within ±1 day)`. Реализация в
/// `EntityResolutionService.findOrCreateEventEntity`.
model Event {
  id                    String    @id @default(cuid())
  tenantId              String
  /// Связка с Entity{type=event}.
  entityId              String    @unique
  entity                Entity    @relation("EventEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org                   Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind                  EventKind @default(other)
  title                 String    @db.VarChar(300)
  startAt               DateTime
  endAt                 DateTime?
  durationMin           Int?
  location              String?   @db.VarChar(300)
  /// Person.id участников (мягкая ссылка, без FK — каскад не нужен).
  /// Legacy-поле от AI-pipeline. Calendar MVP использует EventParticipant.
  participantsPersonIds String[]  @default([])
  /// Meeting.id, если событие отражает реальную видеовстречу LiveKit.
  relatedMeetingId      String?
  outcomeSummary        String?   @db.Text
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  // ── Calendar MVP (2026-05-25) — расширения для пользовательского календаря ──
  /// Организатор события. NULL для AI-сгенерированных событий из транскриптов
  /// (legacy путь через EntityResolutionService.findOrCreateOrLinkEventEntity).
  /// REQUIRED для событий, созданных через POST /api/v1/events.
  ownerId          String?
  owner            User?           @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  description      String?         @db.Text
  /// true → событие на весь день (startAt = 00:00 локальной TZ, endAt = 00:00 след. дня).
  allDay           Boolean         @default(false)
  /// IANA timezone организатора (например, "Europe/Moscow").
  timezone         String          @default("Europe/Moscow") @db.VarChar(64)
  /// calendar-master (2026-06-18) Ф6 — формат встречи. true → онлайн:
  /// создаётся LiveKit-комната. По умолчанию false (офлайн / нейтральная
  /// запись в календарь, без видео). Отделено от kind (тип события) — Р1-A.
  online           Boolean         @default(false)
  /// calendar-master (2026-06-18) Ф5 — контрагент/клиент встречи
  /// («Александр, молочный завод»): с кем и какая компания. НЕ путать с
  /// location (физическое место проведения) — это бизнес-контекст «о ком/о чём».
  counterparty     String?         @db.VarChar(300)
  /// RFC-5545 RRULE для повторяющихся событий. В MVP — только пресеты
  /// (FREQ=DAILY|WEEKLY|MONTHLY|YEARLY[;BYDAY=...]). Полный парсер — Фаза 3.
  rrule            String?
  status           EventStatus     @default(confirmed)
  visibility       EventVisibility @default(company)
  /// Источник синхронизации (для будущей 2-way OAuth, Фаза 3).
  externalProvider String?         @db.VarChar(40)
  externalEventId  String?         @db.VarChar(200)
  /// Опц. привязка к Project трекера (для per-project Calendar view).
  projectId        String?

  participants EventParticipant[]
  reminders    EventReminder[]

  @@index([tenantId, startAt])
  @@index([tenantId, kind])
  @@index([tenantId, deletedAt])
  @@index([tenantId, ownerId, startAt])
  @@index([tenantId, projectId, startAt])
  @@index([externalProvider, externalEventId])
}

/// EventParticipant — участник события (Calendar MVP 2026-05-25).
/// Один из (userId, personId) обязательно заполнен. userId — для приглашённых
/// пользователей платформы; personId — для external контактов (Person).
model EventParticipant {
  id        String               @id @default(cuid())
  eventId   String
  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                @relation("EventParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  personId  String?
  person    Person?              @relation("EventParticipantPerson", fields: [personId], references: [id], onDelete: Cascade)
  role      EventParticipantRole @default(required)
  rsvp      RsvpStatus           @default(pending)
  rsvpAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([eventId])
  @@index([userId, rsvp])
  @@index([personId])
}

/// EventReminder — напоминание по событию (Calendar MVP 2026-05-25).
/// Sweep'ит EventReminderSchedulerCron каждую минуту: где
/// `sentAt IS NULL AND event.startAt - offsetMin*60s <= now`.
/// userId=NULL → отправляется всем участникам.
model EventReminder {
  id        String          @id @default(cuid())
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offsetMin Int
  channel   ReminderChannel
  userId    String?
  sentAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([eventId])
  @@index([sentAt, eventId])
}

/// Market — рынок как сущность графа знаний (категория A, SBA α-3 wave 2).
/// Ось CONTEXTUAL онтологии Кора v2: «где играем» (география × индустрия).
/// Источник для β-7 Brand Voice (per-market принципы), α-9 Company Foundation
/// (target markets), δ-1 Orchestrator.
///
/// Дедупликация: `(tenantId, name)` через приложение
/// (`EntityResolutionService.findOrCreateMarketEntity`, реализуется в α-3 wave 3).
model Market {
  id          String    @id @default(cuid())
  tenantId    String
  /// Связка с Entity{type=market}. Уникальна (1:1).
  entityId    String    @unique
  entity      Entity    @relation("MarketEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org         Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(300)
  /// Географический scope (например «РФ», «СНГ», «Europe»). NULL — global.
  geography   String?   @db.VarChar(120)
  /// Индустрия / вертикаль (например «retail», «fintech», «edtech»).
  industry    String?   @db.VarChar(120)
  /// Краткое описание сегмента в этом рынке.
  description String?   @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, geography])
  @@index([tenantId, industry])
  @@index([tenantId, deletedAt])
}

/// OrgUnit — структурное подразделение / команда / гильдия (категория A,
/// SBA α-3 wave 2). Ось WHO онтологии Кора v2 на уровне коллектива.
///
/// Отличие от Department: Department — типизированный официальный отдел в
/// орг-структуре (Phase 0a). OrgUnit — более общая абстракция для любой
/// рабочей единицы: cross-functional team, гильдия архитекторов, временный
/// project office, BizDev-pod. Может иметь parentDepartmentId на Department.
model OrgUnit {
  id                 String    @id @default(cuid())
  tenantId           String
  /// Связка с Entity{type=org_unit}. Уникальна (1:1).
  entityId           String    @unique
  entity             Entity    @relation("OrgUnitEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org                Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String    @db.VarChar(300)
  /// Тип единицы: 'department' (формальный отдел) | 'team' (команда) |
  /// 'guild' (гильдия по специализации) | 'project_office' (временный) |
  /// 'committee' (комитет). Строкой, чтобы расширять без миграций.
  unitKind           String    @db.VarChar(40)
  /// Опц. ссылка на формальный Department (если OrgUnit — это пере-обёртка над ним).
  parentDepartmentId String?
  /// User.id лидера команды. NULL — не назначен.
  leadUserId         String?
  /// Person.id участников (мягкая ссылка, без FK).
  memberPersonIds    String[]  @default([])
  description        String?   @db.Text
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([tenantId, unitKind])
  @@index([tenantId, parentDepartmentId])
  @@index([tenantId, deletedAt])
}

// ──────────────────────────── SBA α-4 — Layer 4 Curation Foundation ────────────────────────────

/// CurationItem — запись в очереди проверки карточки специалиста (см.
/// plans/tz/2026-05-21-sba-alpha-4-layer4-curation-foundation.md §4).
///
/// `proposedPayload` — что специалист предлагает канонизировать. Применяется
/// после `decide`'а; до этого карточка не становится canonical.
///
/// `candidateCuratorIds` — кандидаты-кураторы, выбранные CuratorRoutingService
/// (после `decide`'а — `assignedToUserId` указывает на финального ревьюера).
///
/// `triageReason` — JSON, например `{ confidence: 0.72, conflictIds: ['cf_1'],
/// criticalType: false, reason: 'low_confidence' }`. Используется UI для
/// объяснения «почему сюда попала».
model CurationItem {
  id                  String             @id @default(cuid())
  tenantId            String
  /// Тип карточки специалиста: 'regulation' | 'process' | 'decision' | 'insight'
  /// | 'idea' | 'knowledge_profile' | ... (см. §3.6 зонтичного и sub-TZ Слоя 3).
  resourceType        String             @db.VarChar(80)
  resourceId          String             @db.VarChar(80)
  level               CurationLevel
  triageReason        Json
  proposedPayload     Json
  status              CurationItemStatus @default(pending)
  /// User.id куратора, реально принявшего решение (заполняется при decide).
  assignedToUserId    String?
  /// Список User.id'ов потенциальных кураторов (из CuratorRoutingService).
  /// Любой из них может принять решение через decide.
  candidateCuratorIds String[]           @default([])
  createdAt           DateTime           @default(now())
  decidedAt           DateTime?
  expiresAt           DateTime?

  org        Org                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?              @relation("CurationItemAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  decisions  CurationDecision[]
  versions   CardVersion[]

  @@index([tenantId, status])
  @@index([tenantId, level, status])
  @@index([assignedToUserId, status])
  @@index([resourceType, resourceId])
  @@index([expiresAt])
}

/// CurationDecision — решение куратора по CurationItem.
///
/// `payload` — изменения для approve_with_edits / split / merge / supersede
/// (что записываем в новую CardVersion). Для reject — пустой объект.
///
/// `reasoning` — обязателен для `deep` review и для resolution-связанных
/// решений (проверка в CurationService.decide).
model CurationDecision {
  id             String               @id @default(cuid())
  curationItemId String
  decisionType   CurationDecisionType
  payload        Json                 @default("{}")
  reasoning      String?              @db.Text
  reviewerUserId String
  createdAt      DateTime             @default(now())

  curationItem CurationItem @relation(fields: [curationItemId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("CurationDecisionReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([curationItemId])
  @@index([reviewerUserId])
}

/// PendingActionSnooze — generic «отложить» для агрегатора Action Center B0
/// (2026-06-02). Любой источник «требует действия» (curation / conflict /
/// intake / probe) может быть временно скрыт из feed'а пользователя до
/// `snoozedUntil`. Источник правды о snooze — здесь (а не в самих
/// resource-таблицах), чтобы PendingActionsProvider'ы оставались read-only.
///
/// Уникальность по (tenantId, userId, source, resourceId): один пользователь
/// откладывает конкретный item один раз (повторный snooze — upsert, обновляет
/// `snoozedUntil`).
model PendingActionSnooze {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  source       String   @db.VarChar(40)
  resourceType String   @db.VarChar(80)
  resourceId   String   @db.VarChar(80)
  snoozedUntil DateTime
  createdAt    DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, source, resourceId])
  @@index([tenantId, userId, snoozedUntil])
}

/// ConflictItem — first-class сущность для конфликтов карточек.
///
/// Источник:
///   - Авто: `IdeaBlockLink.relationType='contradicts'` с high confidence
///     (block-linker.worker → ConflictService.report).
///   - Специалистом Слоя 3 при обнаружении конкурирующей карточки.
///   - Вручную из UI.
///
/// `evidence` — JSON со ссылками на блоки/факты-источники конфликта:
/// `{ blockIds: ['...'], links: [{ id, relationType }], notes: '...' }`.
///
/// `evolvingMeta` — обязателен для `resolution='evolving'`: `{
/// existingValidUntil: ISO, newValidFrom: ISO }`.
model ConflictItem {
  id               String              @id @default(cuid())
  tenantId         String
  resourceType     String              @db.VarChar(80)
  existingId       String              @db.VarChar(80)
  newId            String              @db.VarChar(80)
  evidence         Json
  /// Тип отношения, который породил конфликт ('contradicts' | 'duplicates' |
  /// 'supersedes' | ...). Хранится как строка (а не enum IdeaBlockLinkType),
  /// потому что не все источники конфликта — от block-linker'а.
  relationType     String              @db.VarChar(40)
  /// Кто/что инициировал создание ConflictItem ('block-linker' | 'specialist' |
  /// 'manual' | ...).
  detectedBy       String              @db.VarChar(40)
  status           ConflictStatus      @default(open)
  resolution       ConflictResolution?
  evolvingMeta     Json?
  resolvedByUserId String?
  resolvedAt       DateTime?
  reasoning        String?             @db.Text
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (max от участников
  /// конфликта; evolving + admin-resolve → sensitive по §4 floors).
  dataClassAudit   Json?
  /// Редизайн Ф4 (2026-06-13) — авто-протухание открытого конфликта: после
  /// `expiresAt` sweep-крон (CurationItemLifecycleCron) переводит open →
  /// dismissed («авто-закрыт по сроку»), чтобы очередь решений не копилась
  /// вечно. TTL вычисляется при создании (createdAt + cfg TTL). null —
  /// бессрочный (легаси-записи до миграции).
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())

  org        Org   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ConflictItemResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, resourceType, status])
  @@index([resourceType, existingId])
  @@index([resourceType, newId])
  @@index([tenantId, status, expiresAt])
}

/// CardVersion — общая таблица версий для всех типов карточек специалистов
/// (Regulation, Decision, Process, KnowledgeProfile, Idea, ...).
///
/// Решение по §13.1 sub-TZ: общая таблица, чтобы не дублировать историю
/// в каждом модуле. Поиск версий: `WHERE resourceType=? AND resourceId=?`.
///
/// `payload` — полный snapshot карточки на момент создания версии. Может
/// быть большим — см. §13.4: на α-4 без ограничений, мониторим размер.
///
/// `changeReason` — `'initial' | 'approve' | 'approve_with_edits' | 'merge' |
/// 'supersede' | 'evolving' | 'stale-confirm' | ...`.
model CardVersion {
  id                 String    @id @default(cuid())
  tenantId           String
  resourceType       String    @db.VarChar(80)
  resourceId         String    @db.VarChar(80)
  version            Int
  previousVersionId  String?
  payload            Json
  changeReason       String?   @db.VarChar(40)
  /// User.id автора правки. NULL — auto (triage с auto-canonical, stale-cron).
  createdByUserId    String?
  /// Опц. CurationDecision, в результате которого создалась эта версия.
  curationDecisionId String?
  /// Опц. CurationItem (связан через decision; денормализация для быстрой
  /// фильтрации без JOIN'а через CurationDecision).
  curationItemId     String?
  /// Action Center A1 «лестница доверия» (2026-06-02) — метка доверия версии.
  /// human (default, обратносовместимо) / auto / provisional. См. enum TrustTier.
  trustTier          TrustTier @default(human)
  createdAt          DateTime  @default(now())

  org                  Org           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy            User?         @relation("CardVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  previousVersion      CardVersion?  @relation("CardVersionPrevious", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions         CardVersion[] @relation("CardVersionPrevious")
  curationItem         CurationItem? @relation(fields: [curationItemId], references: [id], onDelete: SetNull)
  /// SBA α-6 — обратное relation для Card.currentVersionId.
  cardsAsCurrent       Card[]        @relation("CardCurrentVersion")
  /// SBA α-7 — обратные relations для Process / Regulation / Policy.currentVersionId.
  /// Используется Specialist 3.1 для отметки `currentVersionId = approvedVersion.id`
  /// после triage'а (см. sub-TZ §4, §5).
  processesAsCurrent   Process[]     @relation("ProcessCurrentVersion")
  regulationsAsCurrent Regulation[]  @relation("RegulationCurrentVersion")
  instructionCurrent   Instruction[] @relation("InstructionCurrentVersion")
  policiesAsCurrent    Policy[]      @relation("PolicyCurrentVersion")
  /// SBA β-3 — обратное relation для Decision.currentVersionId.
  decisionsAsCurrent   Decision[]    @relation("DecisionCurrentVersion")
  /// SBA β-4 — обратное relation для Insight.currentVersionId.
  insightsAsCurrent    Insight[]     @relation("InsightCurrentVersion")
  /// SBA β-5 — обратное relation для Idea.currentVersionId.
  ideasAsCurrent       Idea[]        @relation("IdeaCurrentVersion")

  @@unique([resourceType, resourceId, version])
  @@index([tenantId, resourceType])
  @@index([resourceType, resourceId])
  @@index([curationItemId])
  /// A1 — фильтрация версий по уровню доверия (аудит провизорных/авто).
  @@index([tenantId, trustTier])
}

/// CuratorAssignment — гибкое назначение кураторов per-ResourceType (см.
/// sub-TZ §3.6).
///
/// `resourceType` = '*' — wildcard на все типы карточек.
/// `criteria` — опционально доп. фильтр: `{ tag: 'enterprise', kind: 'process' }`.
/// Если null — assignment применяется ко всем карточкам данного resourceType.
///
/// `curatorUserIds` — кандидаты-кураторы. Не пустой массив на нормальной
/// конфигурации. Несколько ID — round-robin / любой по политике sub-TZ.
///
/// `level` = null — assignment применяется к light И deep.
model CuratorAssignment {
  id             String         @id @default(cuid())
  tenantId       String
  resourceType   String         @db.VarChar(80)
  criteria       Json?
  curatorUserIds String[]       @default([])
  level          CurationLevel?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resourceType])
}

/// CompletenessSlot — SBA α-4 wave 2.
/// First-class «незаполненный слот» нормативной карточки. Один слот = одно
/// обязательное (или опц.) поле/связь для конкретного типа карточки. Сканер
/// `CompletenessScannerCron` создаёт / обновляет слоты для 4 типов карточек:
///   - `regulation`  (поля statement / ownerPersonId / scope, …)
///   - `process`     (ownerRoleId / inputs / outputs / metrics, шагов > 0, …)
///   - `role`        (missionStatement / responsibilityElements > 0, …)
///   - `company_profile` (mission / vision / strategy / displayName)
///
/// Слот считается «заполненным» — `filledAt IS NOT NULL`. Закрывается либо
/// автоматически (повторный проход сканера обнаружил данные), либо вручную
/// (`POST /curation/completeness-slots/:id/mark-filled`).
///
/// `probeAttempts` / `lastProbedAt` — для будущего CompletenessProbeCron
/// (γ-фаза): не дёргать получателя слишком часто.
model CompletenessSlot {
  id             String    @id @default(cuid())
  tenantId       String
  /// Тип родительской карточки: 'regulation' | 'process' | 'role' | 'company_profile'.
  parentCardType String    @db.VarChar(40)
  parentCardId   String    @db.VarChar(80)
  /// Имя слота — машинно-читаемое (например 'statement', 'owner_person', 'mission').
  slotName       String    @db.VarChar(80)
  /// Тип слота: 'required' (блокирует completeness=1.0) | 'optional' (bonus до 0.1).
  slotKind       String    @db.VarChar(20)
  filledAt       DateTime?
  filledByUserId String?
  lastProbedAt   DateTime?
  probeAttempts  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, parentCardType, parentCardId, slotName])
  @@index([tenantId, parentCardType, parentCardId])
  @@index([tenantId, filledAt])
  @@map("completeness_slots")
}

/// IdeaBlockEntity — M:M связь block ↔ entity с ролью и контекстом упоминания.
/// role — subject (главное действующее), object (на что направлено), mentioned (вскользь).
model IdeaBlockEntity {
  blockId        String
  entityId       String
  mentionContext String              @db.Text
  role           IdeaBlockEntityRole @default(mentioned)
  createdAt      DateTime            @default(now())

  block  IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([blockId, entityId])
  @@index([entityId])
}

/// IdeaBlockLink — типизированная связь между двумя IdeaBlock.
/// Создаётся `block-linker.worker` (KNN top-K кандидатов + LLM-арбитр)
/// или `reframing.cron` (рефлексия графа). 7 типов связей —
/// см. enum `IdeaBlockLinkType`.
///
/// Дедупликация: уникальная пара (fromBlockId, toBlockId, relationType).
/// Идемпотентный upsert при повторных проходах линкера.
model IdeaBlockLink {
  id           String            @id @default(cuid())
  tenantId     String
  fromBlockId  String
  toBlockId    String
  relationType IdeaBlockLinkType
  confidence   Decimal           @db.Decimal(4, 3)
  explanation  String            @db.Text
  createdBy    LinkCreatedBy
  status       LinkStatus        @default(active)
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11). Если не null — связь скрыта в UI.
  deletedAt    DateTime?
  /// userId, инициировавший удаление через Org-Admin. Для аудита.
  deletedBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  /// Agents v2 Фаза A1 (2026-05-30) — Bi-temporal edges.
  /// Когда факт связи стал валиден. NULL для legacy / связей без явного
  /// временного указателя в исходных блоках. Backfill: validFrom = createdAt.
  /// См. plans/tz/2026-05-29-agents-v2-umbrella.md §A1.
  validFrom    DateTime?         @db.Timestamptz
  /// Agents v2 Фаза A1 — когда связь перестала быть валидной. NULL =
  /// открытый интервал (действует до сих пор). TemporalConflictService
  /// проставляет NOW() при детектировании противоречащей связи.
  validUntil   DateTime?         @db.Timestamptz

  org       Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBlock IdeaBlock @relation("BlockLinkFrom", fields: [fromBlockId], references: [id], onDelete: Cascade)
  toBlock   IdeaBlock @relation("BlockLinkTo", fields: [toBlockId], references: [id], onDelete: Cascade)

  @@unique([fromBlockId, toBlockId, relationType])
  @@index([tenantId, status])
  @@index([fromBlockId, status])
  @@index([toBlockId, status])
  @@index([tenantId, deletedAt])
  /// Agents v2 Фаза A1 — retrieval-фильтр под BI_TEMPORAL_EDGES_ENABLED.
  @@index([fromBlockId, validFrom, validUntil])
  @@index([toBlockId, validFrom, validUntil])
}

/// EntityLink — типизированная связь между двумя узлами графа.
///
/// До Фазы 0 — только Entity↔Entity (knowledge-core, создаётся
/// `entity-graph-builder.cron` раз в час). С Фазы 0 — единая полиморфная
/// модель рёбер для ВСЕХ бизнес-связей Z (см.
/// plans/tz/2026-05-21-phase-0a-data-model-and-graph-infra.md §4.4).
///
/// `fromType` / `toType` — discriminator типа узла. NULL = legacy запись
/// до Фазы 0 (читается как `entity`). Backfill — `backend/scripts/backfill-entity-link-types.ts`.
///
/// FK на Entity убраны: новые связи могут ссылаться на Role, Person, Process,
/// Document и т.д. — таблицы, которые не Entity. Каскадное удаление узла
/// чистит рёбра через `GraphService.removeNode` (см. 0a.2).
///
/// Двойная запись Postgres EntityLink + AGE `z_graph` — единственная точка
/// записи через `GraphService.addEdge` (см.
/// `second-brain/02_architecture/code-pitfalls.md` «Cypher только через GraphService»).
model EntityLink {
  id             String         @id @default(cuid())
  tenantId       String
  /// id источника. До Фазы 0 — всегда `Entity.id`. С Фазы 0 — id любой
  /// бизнес-сущности (см. fromType).
  fromEntityId   String
  /// id цели. До Фазы 0 — всегда `Entity.id`. С Фазы 0 — id любой
  /// бизнес-сущности (см. toType).
  toEntityId     String
  /// Discriminator типа источника. NULL = legacy (`entity`).
  /// Возможные значения см. `NodeType` в `backend/src/common/graph/graph.types.ts`.
  fromType       String?        @db.VarChar(50)
  /// Discriminator типа цели. NULL = legacy (`entity`).
  toType         String?        @db.VarChar(50)
  relationType   EntityLinkType
  confidence     Decimal        @db.Decimal(4, 3)
  explanation    String         @db.Text
  createdBy      LinkCreatedBy
  status         LinkStatus     @default(active)
  /// Временной интервал жизни связи (для bi-temporal в Фазе α; в Фазе 0 —
  /// используется для `executes_role` Person→Role).
  validFrom      DateTime       @default(now())
  /// DEPRECATED (KC-Temporal W1.1): оставлено для legacy-кода. Новые
  /// записи должны использовать `validUntil` (см. ниже). Backfill-скрипт
  /// `patch-bitemporal-backfill.ts` переносит значение в `validUntil`.
  validTo        DateTime?
  /// KC-Temporal W1.1 (2026-05-25) — bi-temporal «когда связь перестала
  /// быть верной». null = действует до сих пор. Новые ребра пишутся сюда;
  /// `validTo` оставлен только для чтения legacy-данных.
  validUntil     DateTime?
  /// KC-Temporal W1.1 — когда система узнала о ребре. Default now();
  /// для backfill — равно `createdAt`.
  recordedAt     DateTime       @default(now())
  /// Произвольные свойства связи (cosine score, RACI-флаги, observed_at и т.д.).
  properties     Json           @default("{}")
  /// KC-Temporal W3.1 (2026-05-25) — семантически богатые rich-edge атрибуты,
  /// извлекаемые LLM (`entity-graph-builder`): `{role: 'CEO', share: 0.5,
  /// since: '2022-01', intensity: 0.8, ...}`. Семантически отличается от
  /// `properties` (там — технические метрики: cosine score / RACI-флаги).
  /// NULL — атрибутов нет. При update merge'ится плоско (новые ключи +
  /// перезапись существующих) — см. `EntityLinkService.upsertRichEdge`.
  attributes     Json?
  /// KC-Temporal W3.1 (2026-05-25) — IdeaBlock-источники, на основе которых
  /// LLM построил это ребро. При повторном upsert (другой батч блоков
  /// подтвердил то же ребро) — union. Используется для трассировки и
  /// `confidence`-калибровки. GIN-индекс для поиска «какие рёбра поддерживает
  /// этот блок».
  sourceBlockIds String[]       @default([])
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11).
  deletedAt      DateTime?
  /// userId, инициировавший удаление через Org-Admin.
  deletedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite unique с учётом fromType/toType: одна и та же пара id может
  // быть одновременно entity→entity и (с Фазы 0) role→person с тем же
  // relationType. Включаем fromType/toType в ключ для однозначности.
  @@unique([fromEntityId, fromType, toEntityId, toType, relationType])
  @@index([tenantId, status])
  @@index([tenantId, fromEntityId, fromType])
  @@index([tenantId, toEntityId, toType])
  @@index([tenantId, relationType, validFrom])
  @@index([tenantId, deletedAt])
  /// KC-Temporal W1.1 — выборка активных рёбер (validUntil IS NULL).
  @@index([tenantId, validUntil])
  /// Agents v2 Фаза A1 (2026-05-30) — bi-temporal retrieval-фильтр edges
  /// под BI_TEMPORAL_EDGES_ENABLED. См. plans/tz/2026-05-29-agents-v2-umbrella.md §A1.
  @@index([fromEntityId, validFrom, validUntil])
  @@index([toEntityId, validFrom, validUntil])
}

// ──────────────────────────── knowledge-core: Theme (Фаза 4) ────────────────────────────

/// Theme — AI-кластер блоков. Создаётся `theme-clusterer.cron` (KNN-greedy
/// по эмбеддингам блоков + LLM-классификатор имени/ветки). Никогда не
/// создаётся пользователем вручную: если пользователь хочет «свою тему» —
/// он жмёт `POST /themes/:id/save-as-card` и получает Card с kind='topic'.
///
/// branch — одна из 12 веток компании (delivery M-07). Опциональна: LLM
/// может вернуть `null`, если ветка не определилась.
///
/// embedding(1536) — эмбеддинг от `name + ' ' + description`, для поиска
/// связанных тем и для UI-фильтров.
model Theme {
  id             String                       @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  name           String
  description    String                       @db.Text
  weight         Decimal                      @default(0.5) @db.Decimal(4, 3)
  dynamic        ThemeDynamic                 @default(stable)
  confidence     Decimal                      @default(0.5) @db.Decimal(4, 3)
  status         ThemeStatus                  @default(active)
  mergedIntoId   String?
  branch         ThemeBranch?
  embedding      Unsupported("vector(1536)")?
  lastSignalAt   DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  org        Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto Theme?           @relation("ThemeMerges", fields: [mergedIntoId], references: [id])
  mergedFrom Theme[]          @relation("ThemeMerges")
  blocks     ThemeIdeaBlock[]
  entities   ThemeEntity[]
  cards      Card[]           @relation("CardBornFromTheme")
  goalLinks  GoalTheme[]
  /// ТЗ-4 Ф1 — документы, привязанные к этой теме (Document.attachedThemeId).
  documents  Document[]       @relation("DocumentTheme")

  @@index([tenantId, status])
  @@index([tenantId, branch])
  @@index([tenantId, mergedIntoId])
}

/// ThemeIdeaBlock — M:M связь Theme ↔ IdeaBlock.
/// weight — мера принадлежности блока к теме (1.0 для seed-кластера, ниже
/// для дополнительно «прибившихся» блоков в reframing).
model ThemeIdeaBlock {
  themeId   String
  blockId   String
  weight    Decimal  @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime @default(now())

  theme Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  block IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([themeId, blockId])
  @@index([blockId])
}

/// ThemeEntity — denormalized связь Theme ↔ Entity (через блоки темы).
/// Заполняется кластерером и поддерживается reframing'ом для быстрых фильтров
/// «темы про этого клиента / этот продукт».
model ThemeEntity {
  themeId       String
  entityId      String
  mentionsCount Int      @default(0)
  createdAt     DateTime @default(now())

  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([themeId, entityId])
  @@index([entityId])
}

// ──────────────────────────── Z-Admin: SuperAdminAccessLog (Фаза 7) ────────────────────────────

/// Лог drill-down действий super_admin (Z-Admin Фаза 7).
/// Любое чтение/запись super_admin'а в данные конкретной Org пишется сюда
/// для compliance. На Фазе 7 — только запись, ежемесячный email-отчёт vNext.
///
/// Глобальная таблица (нет tenantId на уровне модели — `accessedTenantId`
/// указывает, к какой Org обращался super_admin; null = глобальный уровень).
model SuperAdminAccessLog {
  id               String   @id @default(cuid())
  superAdminUserId String
  superAdmin       User     @relation("SuperAdminAccessLog", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  /// NULL = действие на глобальном уровне (без конкретной Org).
  accessedTenantId String?
  route            String
  method           String
  params           Json?
  /// Обязательна для severity high/destructive операций (admin-redesign Фаза 0).
  reason           String?
  createdAt        DateTime @default(now())

  @@index([superAdminUserId, createdAt])
  @@index([accessedTenantId, createdAt])
}

// ──────────────────────────── knowledge-core: goals (Фаза 9) ────────────────────────────

/// Цель компании (Фаза 9 knowledge-core).
/// Создаётся owner Org вручную. Связь с Theme — M:M (GoalTheme).
/// Ежесуточно strategic-alignment.worker оценивает движение к цели.
model Goal {
  id                      String      @id @default(cuid())
  tenantId                String
  tenant                  Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource          String?
  name                    String
  description             String      @db.Text
  /// Опциональный дедлайн. Используется как контекст для LLM-судьи.
  targetDate              DateTime?
  status                  GoalStatus  @default(active)
  /// Вес в среднем "Согласованность стратегии" (Фаза 8 dashboard). Default 1.0.
  weight                  Decimal     @default(1.0) @db.Decimal(4, 3)
  /// Фаза 0a §11.6 — горизонт цели для декомпозиции strategic→annual→…→sprint.
  /// Default quarterly — типичная цель компании.
  horizon                 GoalHorizon @default(quarterly)
  /// ТЗ-B (2026-06-05) — флаг «главная цель компании» = «север» компаса Вектора.
  /// Одна primary на tenant гарантируется PARTIAL UNIQUE index в
  /// postgres-init.sql (`goal_primary_unique` WHERE "isPrimary" = true) —
  /// Prisma `@@unique` не поддерживает WHERE. Снятие/выставление флага —
  /// в UI целей (ТЗ-F). Default false. Якорь Вектора цели (решение Р1).
  isPrimary               Boolean     @default(false)
  /// Фаза 0a §11.6 — декомпозиция целей. Self-relation; UI появится в Фазе γ.
  parentGoalId            String?
  parent                  Goal?       @relation("GoalDecomposition", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children                Goal[]      @relation("GoalDecomposition")
  /// SBA β-8 (2026-05-23) — флаг каскадного провала. Выставляется
  /// `GoalCascadeService`, когда parent-Goal перешёл в `abandoned`
  /// (трактуется как «missed»). При следующем UI-рендере подсвечиваем
  /// ребёнка отдельной плашкой «попал под каскад из родителя».
  cascadeMissed           Boolean     @default(false)
  /// Если cascadeMissed=true — id того parent'а, который запустил каскад.
  cascadeMissedFromGoalId String?
  /// Когда каскад был отмечен. Для аудита и для возможного «снять флаг»
  /// в UI после ручного решения owner'а.
  cascadeMissedAt         DateTime?
  createdById             String
  createdBy               User        @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// ТЗ-F (2026-06-05) — назначенный ответственный за цель (Person).
  /// nullable: цель может быть без ответственного. Паттерн как Process/Regulation/
  /// Policy.ownerPersonId. onDelete:SetNull — удаление Person не роняет цель.
  ownerPersonId           String?
  ownerPerson             Person?     @relation("GoalOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  /// ТЗ-F Ф2/C-3 (2026-06-05) — кэш числа блоков последнего snapshot для
  /// «светофора уверенности» в СПИСКЕ целей (без JOIN на snapshots).
  /// Обновляется тем же tx.goal.update, что и cachedAlignment. NULL = не считалось.
  cachedBlocksCount       Int?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  archivedAt              DateTime?
  /// Кэш последнего snapshot для быстрого чтения списка целей без JOIN'а.
  /// Обновляется воркером после каждого расчёта.
  cachedAlignment         Int? /// 0..100, NULL = ещё не считалось.
  cachedAlignmentAt       DateTime?
  cachedAlignmentDelta    Int? /// разница со снапшотом 24h назад, для подсветки падений.
  cachedSnapshotId        String? /// FK на последний GoalAlignmentSnapshot.

  /// SBA α-3 — линковка с Entity{type=goal} для графа знаний. Заполняется
  /// patch-backfill-entity-id-goal.ts и поддерживается knowledge-core.
  entityId String? @unique
  entity   Entity? @relation("GoalEntity", fields: [entityId], references: [id], onDelete: SetNull)

  themes    GoalTheme[]
  snapshots GoalAlignmentSnapshot[]

  /// Tracker Phase 1 (2026-05-24) — задачи трекера, привязанные к этой цели
  /// через `Issue.goalId`. См. plans/tz/2026-05-23-tracker-phase-1-models-api.md.
  linkedIssues Issue[] @relation("IssueGoal")

  /// Goals OKR v2 (2026-06-02) — источник появления цели. 'manual' (owner завёл) | 'ai' (специалист 3-14 добыл).
  source         GoalSource         @default(manual)
  /// Жизненный цикл предложения: suggested (AI-кандидат, виден но отличим) | active (официальная) | dismissed (отклонён человеком). Ручная цель → active сразу.
  promotionState GoalPromotionState @default(active)
  /// Статус движения для пульса (вычисляется авто, правится руками). Отдельная ось от status (жизненного цикла).
  progressStatus GoalProgressStatus @default(on_track)
  /// ТЗ-2 Ф6.A (daily-value-dashboards) — MoSCoW-приоритет для портфеля целей.
  /// NULL = не классифицировано (корзина 'none'). Проставляется владельцем через
  /// PATCH /api/v1/goals/:id/priority; AI не перетирает.
  priority       GoalPriority?
  /// Провенанс: блоки графа, из которых добыта цель. GIN-индекс — в postgres-init.sql. Пусто для ручных.
  sourceBlockIds String[]           @default([])
  /// Уверенность извлечения 0..1 (для AI). NULL для ручных.
  confidence     Decimal?           @db.Decimal(4, 3)
  /// Набор имён полей, «прибитых» ручной правкой — AI их не перетирает (M0).
  manualOverride Json               @default("{}")
  /// bitemporal (паттерн Decision/IdeaBlock) — для «передумали через 2 дня».
  validFrom      DateTime?
  validUntil     DateTime?
  recordedAt     DateTime           @default(now())
  supersededById String?
  supersedes     Goal?              @relation("GoalSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedeChain Goal[]             @relation("GoalSupersedes")

  /// Ф5 (TZ 2026-06-16) — pgvector embedding цели (text-embedding-3-small, 1536).
  /// Генерируется goal-embed.worker. HNSW-индекс — в postgres-init.sql (Prisma не умеет).
  embedding     Unsupported("vector(1536)")?
  embeddingHash String?

  keyResults   GoalKeyResult[]
  linkedIdeas  Idea[]          @relation("IdeaGoal")
  linkedCycles Cycle[]         @relation("CyclePrimaryGoal")

  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
  @@index([tenantId, horizon])
  @@index([tenantId, parentGoalId])
  @@index([tenantId, promotionState])
  @@index([tenantId, validUntil])
  @@index([tenantId, ownerPersonId])
  /// ТЗ-B (2026-06-05) — дешёвый findFirst(where isPrimary) для «севера» компаса.
  @@index([tenantId, isPrimary])
}

/// ТЗ-2 Ф6.A (daily-value-dashboards) — недельный снимок здоровья портфеля
/// целей компании. Cron `@Cron('0 5 * * 1')` (понедельник 05:00) считает
/// `healthScore` (0..100) по распределению `progressStatus` живых целей,
/// разрез по MoSCoW-приоритету (byPriorityJson) и upsert'ит снимок per
/// (tenantId, dateLocal). Дельта к прошлой неделе берётся из предыдущего снимка.
/// Идемпотентно — `@@unique([tenantId, dateLocal])`.
model PortfolioHealthSnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  /// День снимка YYYY-MM-DD (МСК). Уникален в паре с tenantId.
  dateLocal      String   @db.VarChar(10)
  /// Интегральный балл здоровья портфеля 0..100.
  healthScore    Int
  /// Разрез по progressStatus: { on_track, at_risk, stalled, achieved, dropped } → count.
  byStatusJson   Json
  /// Разрез по MoSCoW: { must, should, could, wont, none } → { count, achievedCount, achievedPercent }.
  byPriorityJson Json
  /// Сколько живых целей участвовало в расчёте.
  goalsCount     Int      @default(0)
  snapshotAt     DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dateLocal])
  @@index([tenantId, snapshotAt(sort: Desc)])
  @@map("portfolio_health_snapshot")
}

/// M:M между Goal и Theme. На старте — ручная привязка от owner;
/// AI-предложения добавляются с source='ai' в vNext.
model GoalTheme {
  goalId    String
  themeId   String
  /// Источник связи: manual (owner добавил) | ai (предложено suggester'ом).
  source    GoalThemeSource @default(manual)
  /// Вес (1.0 — основная, ниже — частично связанная). По умолчанию 1.0.
  weight    Decimal         @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime        @default(now())

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([goalId, themeId])
  @@index([themeId])
}

/// Суточный снапшот «движения к цели» от strategic-alignment.worker.
/// Используется для timeline'а и вычисления delta.
model GoalAlignmentSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  goalId       String
  /// 0..100 — оценка движения за окно (default 30 дней).
  score        Int
  /// Разница со снапшотом 24h назад (для подсветки падений). NULL для первого.
  delta        Int?
  /// 1-3 предложения объяснения от LLM.
  explanation  String   @db.Text
  /// Структура: { pro: ['…'], contra: ['…'] } — по 3-5 пунктов.
  signals      Json
  /// Какое окно использовалось (в днях).
  windowDays   Int      @default(30)
  /// Сколько связанных тем участвовало в оценке.
  themesCount  Int
  /// Сколько блоков LLM проанализировал.
  blocksCount  Int
  /// AiUsageLog.id (для drill-down в Z-Admin). FK не делаем — может быть очищен ретеншеном.
  aiUsageLogId String?
  /// Если delta <= -15 и score <= 60 — alertPending=true.
  alertPending Boolean  @default(false)
  createdAt    DateTime @default(now())

  goal           Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tenant         Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  @@index([goalId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, alertPending])
}

// ──────────────────────────── Goals OKR v2 (2026-06-02) ────────────────────────────

/// Goals OKR v2 — измеримый ключевой результат (Key Result), 0..N на цель.
/// Текущее значение кэшируется в `currentValue`, история — в GoalKeyResultCheckpoint
/// (идиома как GoalAlignmentSnapshot / PersonGoalContribution).
model GoalKeyResult {
  id             String                    @id @default(cuid())
  tenantId       String
  goalId         String
  goal           Goal                      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Текст результата («Провести встречи с клиентами»).
  name           String
  /// Единица измерения («встреч», «%», «₽»). NULL — без числа (тогда это веха в Goal, не KR).
  unit           String?
  startValue     Decimal                   @db.Decimal(18, 4)
  targetValue    Decimal                   @db.Decimal(18, 4)
  /// Текущее значение — обновляется авто из источника или руками.
  currentValue   Decimal                   @default(0) @db.Decimal(18, 4)
  /// Откуда тянуть currentValue авто.
  sourceKind     GoalKrSourceKind          @default(manual)
  /// Параметры источника (например {meetingType, since} или {entityId}). JSON.
  sourceConfig   Json                      @default("{}")
  source         GoalSource                @default(manual)
  manualOverride Json                      @default("{}")
  createdById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  checkpoints    GoalKeyResultCheckpoint[]

  @@index([tenantId, goalId])
  @@index([goalId])
}

/// Goals OKR v2 — неизменяемая история значений KR (для тренда пульса).
model GoalKeyResultCheckpoint {
  id          String        @id @default(cuid())
  tenantId    String
  keyResultId String
  keyResult   GoalKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  value       Decimal       @db.Decimal(18, 4)
  /// Кто/что записал: 'auto' (источник) | 'manual'.
  recordedBy  String        @default("auto")
  note        String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([keyResultId, createdAt])
  @@index([tenantId, createdAt])
}

/// Goals OKR v2 (Фаза 4) — еженедельный «пульс целей». Клон DailyOperationsDigest.
///
/// `GoalsPulseService.generate` собирает счётчики целей по progressStatus за
/// прошедшую неделю и одним LLM-вызовом `goals-pulse-summarize` собирает
/// связный markdown-нарратив (4-6 разделов + shortSummary).
///
/// Идемпотентность — `@@unique([tenantId, isoWeek])`. Cron `goals-pulse`
/// (@Cron('0 6 * * 1') = пн 09:00 МСК) не создаёт второй дайджест за неделю.
///
/// `deliveredAt` — отметка доставки ролям owner/coo (NULL — не доставлено
/// или тумблер `goals.pulse.deliver_to_telegram` выключен).
model WeeklyGoalsPulseDigest {
  id             String    @id @default(cuid())
  tenantId       String
  /// ISO-неделя YYYY-WXX (МСК), ЗА которую сделан пульс.
  isoWeek        String    @db.VarChar(10)
  /// Связный текст пульса от LLM. Markdown. При неудаче LLM — «сухой» вариант.
  bodyMarkdown   String    @db.Text
  /// Счётчики по progressStatus + провенанс: { achieved, on_track, at_risk, stalled, dropped, total, newThisWeek }.
  metricsJson    Json
  /// Идентификатор маршрута/модели LLM (`prompt-v1+<model>`). NULL при сухом fallback.
  llmTaskRouteId String?
  /// Кратко — для Telegram-рассылки и блока на главной.
  shortSummary   String?   @db.Text
  /// Доставка прошла. NULL — ещё не доставлено или выключено.
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  tenant         Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  @@unique([tenantId, isoWeek])
  @@index([tenantId, isoWeek])
  @@map("weekly_goals_pulse_digests")
}

// ──────────────────────────── knowledge-core: retention (Фаза 11) ────────────────────────────

/// OrgRetentionPolicy — конфиг ретеншена per-Org для knowledge-core/152-ФЗ
/// (Фаза 11). Создаётся seed'ом или lazy upsert'ом в RetentionPolicyService.
///
/// Поля — длительности в днях:
///   - rawEventDays: 7 лет (2555) — дефолт под 152-ФЗ; ниже 30 нельзя установить.
///   - archivedBlockDays: 365 — сколько живёт IdeaBlock.status='archived' до hard-delete.
///   - chatMessageDays: 90 — MeetingChatMessage.
///   - auditLogDays: 730 — AuditLog (compliance).
///
/// archivedBlockAction:
///   - 'archive_then_delete' (default) — блок без evidence уходит в archived,
///     а через archivedBlockDays — hard-delete.
///   - 'keep_forever' — архив остаётся всегда (нет hard-delete по retention).
///
/// lastSweepAt — когда последний раз RetentionService.processAll проходил по Org.
model OrgRetentionPolicy {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  org                 Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEventDays        Int       @default(2555)
  archivedBlockDays   Int       @default(365)
  chatMessageDays     Int       @default(90)
  auditLogDays        Int       @default(730)
  archivedBlockAction String    @default("archive_then_delete")
  lastSweepAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ──────────────────────────── knowledge-core: entitlements (Фаза 12) ────────────────────────────

/// OrgEntitlement — per-Org конфиг тарифа и override'ов фич/квот (Фаза 12).
///
/// `tier` — строка ('tier_basic' | 'tier_pro' | 'tier_enterprise'), не enum.
/// Причина: бизнес может ввести четвёртый/пятый тариф без миграции.
/// Реестр тарифов (features/quotas) — статический в коде (TierConfigRegistry).
///
/// `featureOverrides` / `quotaOverrides` — JSON-карты для исключений.
/// Пример: `{"feature.theme": true}` даст enterprise-фичу одной Org бесплатно.
///
/// `notes` — ручной комментарий super_admin'а (для audit-trail в UI).
///
/// На MVP backfill сидит `tier_pro` по умолчанию (см. seed-entitlements.ts).
model OrgEntitlement {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  org              Org      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier             String   @default("tier_pro")
  featureOverrides Json?
  quotaOverrides   Json?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════════════════
// Фаза 0 — каркас компании (см. plans/tz/2026-05-21-phase-0-roles-and-onboarding.md)
// ════════════════════════════════════════════════════════════════════════════
//
// Группа А (с UI в Фазе 0):
//   Department, Role, Person, PersonRole, JobDescription, Skill, Document, RoleProfile.
//
// Группа Б (без UI в Фазе 0, наполняется extraction'ом):
//   Mission, Vision, Strategy, Process, ProcessStep, Regulation, Policy,
//   Tool, Metric, Decision. См. ниже после группы А.
//
// Conventions: id = cuid(); tenantId (НЕ orgId, для консистентности с
// существующими моделями); все @relation на tenant идут через Org.
// Membership.role (owner/admin/manager) ≠ бизнес-Role (должность в компании
// клиента) — это две разные сущности. См. README в second-brain.

// ──────────────────────────── группа А: структура компании ────────────────────────────

/// Department — отдел компании клиента (Фаза 0).
/// Поле `parentDepartmentId` — иерархия в схеме, UI в Фазе 0 плоский (γ
/// добавит дерево). См. зонтичный ТЗ §2 «Не входит».
model Department {
  id                 String    @id @default(cuid())
  tenantId           String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource     String?
  name               String    @db.VarChar(200)
  parentDepartmentId String?
  /// SBA α-9 wave 2 (2026-05-23) — расширение Department для Company Foundation.
  /// Краткое описание миссии отдела (1-2 предложения).
  missionStatement   String?   @db.Text
  /// 0..1 — насколько полно у отдела заполнены: roles, processes, regulations.
  /// Рассчитывается MaturityScorerCron.
  completeness       Decimal?  @db.Decimal(4, 3)
  /// Опц. линковка с Entity{type=org_unit} (для участия в графе знаний).
  entityId           String?   @unique
  /// IdeaBlock-источники последнего извлечения отдела (provenance).
  sourceBlockIds     String[]  @default([])
  /// Confidence от extraction-LLM (для агентских записей).
  confidence         Decimal?  @db.Decimal(4, 3)
  /// ТЗ 2026-05-25 «clone-reliability-hardening» Фаза 3 — глава отдела.
  /// Person.id главы отдела; probe-уведомления об аномалиях профиля клона
  /// сначала идут ему, и только при NULL — fallback к admin'ам.
  headPersonId       String?
  /// Pulse Wave 3 §3.1 — снапшот здоровья команды от Team-Health-Analyzer cron.
  /// Структура: { factors: {manager_support: 'low'|'medium'|'high',
  /// workload_fairness, communication, time_pressure, role_clarity},
  /// summary: string, generatedAt: ISO, provenance: { sourceIds: string[] } }.
  /// NULL до первого прогона cron'а.
  healthSummaryJson  Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// Soft-delete: cohabits с уникальностью (orgId, name) благодаря включению deletedAt в @@unique.
  deletedAt          DateTime?

  org                       Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent                    Department?            @relation("DepartmentParent", fields: [parentDepartmentId], references: [id])
  children                  Department[]           @relation("DepartmentParent")
  entity                    Entity?                @relation("DepartmentEntity", fields: [entityId], references: [id], onDelete: SetNull)
  /// ТЗ 2026-05-25 Фаза 3 — глава отдела (см. headPersonId).
  headPerson                Person?                @relation("DepartmentHead", fields: [headPersonId], references: [id], onDelete: SetNull)
  roles                     Role[]
  persons                   Person[]               @relation("PersonPrimaryDepartment")
  /// SBA α-8 wave 3 — Appointment[] (current/historical назначения в отделе).
  appointments              Appointment[]
  /// SBA α-8 wave 3 — Metric'ы, привязанные к этому отделу (KPI).
  attachedMetrics           Metric[]               @relation("MetricToDepartment")
  /// SBA α-8 wave 2 — обратная связь Interaction.
  interactionsAsCounterpart Interaction[]          @relation("InteractionCounterpartDept")
  /// SBA α-9 wave 2 — m:n с FunctionalDomain.
  domainLinks               DepartmentDomainLink[]
  /// Sprints (2026-05-27) — проекты-спринты, привязанные к этому отделу
  /// (Project.departmentId). См. plans/tz/2026-05-27-sprints.md §1.1.
  scopedProjects            Project[]              @relation("ProjectDepartment")

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@index([tenantId, parentDepartmentId])
  @@index([tenantId, headPersonId])
  @@map("departments")
}

/// Role — должность в компании клиента (бизнес-сущность).
/// **НЕ ПУТАТЬ** с `Membership.role` (owner/admin/manager) — это права доступа
/// в Z. `Role` (эта модель) — бизнес-должность ("Менеджер по продажам", "QA Engineer").
model Role {
  id               String    @id @default(cuid())
  tenantId         String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource   String?
  name             String    @db.VarChar(200)
  departmentId     String?
  /// Свободные теги для поиска и фильтрации.
  tags             String[]  @default([])
  /// SBA α-8 wave 2 (2026-05-23) — расширение Role Map.
  /// Краткое описание миссии должности (1-2 предложения).
  missionStatement String?   @db.Text
  /// Зрелость роли: 0..1, рассчитывается MaturityScorerCron как
  /// произведение completeness × #observations × age. NULL до первого подсчёта.
  maturityScore    Decimal?  @db.Decimal(4, 3)
  /// Опц. линковка с Entity{type=role} (если нужна для графа знаний).
  entityId         String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  org               Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        Department?      @relation(fields: [departmentId], references: [id])
  entity            Entity?          @relation("RoleEntity", fields: [entityId], references: [id], onDelete: SetNull)
  jobDescriptions   JobDescription[]
  roleProfile       RoleProfile?
  personRoles       PersonRole[]
  /// SBA α-8 wave 3 — Appointment[] (replacement для PersonRole).
  appointments      Appointment[]
  /// SBA α-8 wave 3 — Metric'ы, привязанные к этой роли (KPI).
  attachedMetrics   Metric[]         @relation("MetricToRole")
  /// IdeaBlock-и с пометкой role_relevant=true для RoleProfileAgent (Фаза 0d).
  ideaBlocks        IdeaBlock[]
  /// Документы, явно загруженные на эту должность через wizard или /structure.
  attachedDocuments Document[]       @relation("DocumentAttachedRole")
  /// Процессы, owner которых — эта роль (Фаза 0b, наполняется extraction'ом).
  ownedProcesses    Process[]        @relation("ProcessOwnerRole")

  /// SBA α-7 wave 2 — обратные связи новых моделей.
  ownedProcessTemplates     ProcessTemplate[]       @relation("ProcessTemplateOwnerRole")
  decisionPointsAsDecider   DecisionPoint[]         @relation("DecisionPointDecider")
  handoffsFrom              ProcessHandoff[]        @relation("HandoffFromRole")
  handoffsTo                ProcessHandoff[]        @relation("HandoffToRole")
  /// SBA α-8 wave 2 — Role Map нормализованные таблицы.
  responsibilityElements    ResponsibilityElement[]
  authorityBoundaries       AuthorityBoundary[]     @relation("AuthorityBoundaryRole")
  approvedBoundaries        AuthorityBoundary[]     @relation("AuthorityBoundaryApprover")
  requiredKnowledge         RequiredKnowledge[]
  decisionPolicies          DecisionPolicy[]
  interactions              Interaction[]           @relation("InteractionRole")
  interactionsAsCounterpart Interaction[]           @relation("InteractionCounterpartRole")

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId, departmentId])
  @@map("roles")
}

/// Person — сотрудник компании клиента (Фаза 0).
///
/// Отличие от Entity{type=person}: `Entity` — это упоминание персоны в графе
/// знаний (knowledge-core); `Person` — это сущность ЛК со связями с
/// Role/Department/User. `Person.entityId` — линковка, заполняется
/// EntityResolutionService (Фаза 0b §8.3).
///
/// `userId` NULL до accept'а приглашения. Membership создаётся атомарно с
/// `Person.userId = currentUserId` в `POST /api/v1/orgs/:orgId/invitations/:token/accept`.
model Person {
  id                          String             @id @default(cuid())
  tenantId                    String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource              String?
  /// NULL до accept'а приглашения. После accept'а — атомарно линкуется с User.
  userId                      String?
  name                        String             @db.VarChar(200)
  email                       String             @db.VarChar(320)
  /// Основной отдел для UI; для графовых связей `member_of` — через PersonRole.
  primaryDepartmentId         String?
  /// Линковка с Entity{type=person} (см. EntityResolutionService, Фаза 0b §8.3).
  entityId                    String?
  /// SBA α-3 (2026-05-21) §4.3 — отношение Person ↔ Org. По умолчанию
  /// `external` (создан как контакт); patch-script проставит `employee`
  /// тем, у кого есть активный Membership.
  relationship                PersonRelationship @default(external)
  /// SBA β-2 (2026-05-21) — Knowledge Clone (Specialist 3.2). Структурированный
  /// кеш «что человек знает / опыт / типовые ответы по областям».
  /// Заполняется воркером `knowledge-clone-rebuild`. См. sub-TZ §4.
  knowledgeProfile            Json?
  /// SBA β-2 — момент последней успешной пересборки `knowledgeProfile`.
  lastProfileBuildAt          DateTime?
  /// SBA β-2 — версия профиля (инкремент при каждой успешной пересборке).
  profileBuildVersion         Int                @default(0)
  /// SBA β-8 (2026-05-23) — таймзона пользователя в формате IANA
  /// (например, "Europe/Moscow", "Asia/Yekaterinburg"). Используется
  /// `DailyCheckInPromptCron` для определения локального утра/вечера.
  /// Default `Europe/Moscow` — для NULL-ов проставляется
  /// `patch-person-timezone-default.ts`. Person может править через
  /// `/me/settings` (когда появится UI).
  timezone                    String?            @default("Europe/Moscow") @db.VarChar(64)
  /// calendar-master (2026-06-18) Ф4 — рабочий профиль человека (когда он
  /// работает). NULL/[] = брать дефолт из AdminSetting (work_hours_default_*).
  /// Источник правды для find_free_slot и расчёта «сегодня/рабочее время».
  workStartHour               Int?
  workEndHour                 Int?
  /// Рабочие дни недели: 0=вс, 1=пн … 6=сб. [] (пусто) = брать дефолт.
  workingDays                 Int[]              @default([])
  /// Pulse Wave 3 §3.3 — сводный engagement score от Engagement-Scorer cron.
  /// Decimal(4,3): 0..1, нормированный к личному baseline.
  /// NULL до первого прогона cron'а.
  engagementScore             Decimal?           @db.Decimal(4, 3)
  /// Pulse Wave 3 §3.3 — когда последний раз пересчитывали engagement.
  engagementScoreAt           DateTime?
  /// Pulse Wave 3 §3.7 — рекомендации HR-Recommender (5 типов).
  /// Структура: { recommendations: Array<{type:
  /// 'praise'|'compensation_review'|'workload_check'|'development'|'urgent_talk',
  /// text: string, signals: string[], confidence: number}>, generatedAt: ISO }.
  /// NULL до первого weekly-прогона cron'а.
  hrSuggestionsJson           Json?
  /// Pulse Wave 4 §4.5 — активные risk-флаги (Burnout-Risk-Detector cron).
  /// Структура: { flags: Array<{type: string, severity: 'low'|'medium'|'high',
  /// baseline: number, current: number, explanation: string}>, generatedAt: ISO }.
  /// НЕ агрегируется в одну цифру — только список активных сигналов. NULL до
  /// первого прогона cron'а.
  riskFlagsJson               Json?
  /// Pulse Wave 4 §4.1 — opt-in 152-ФЗ на расширенную аналитику (sentiment, risk-signals).
  /// Без opt-in карточка показывает только базовые данные, без AI-выводов.
  /// Источник правды — последние записи `ConsentLog`; это поле — денормализация
  /// для быстрых guard'ов и фильтров (ставится `ConsentService.recordConsent`).
  analyticsOptIn              Boolean            @default(false)
  /// Pulse Wave 4 §4.1 — когда дано последнее «полное» согласие.
  analyticsOptInAt            DateTime?
  /// TZ-1 Фаза 0 (daily-value-engine) — состояние кампании привязки канала
  /// (Telegram-бот). NULL = ещё не приглашали, 'invited' = отправлено первое
  /// приглашение, 'reminded' = отправлено напоминание, 'bound' = есть verified
  /// telegram-binding. Управляется `ChannelBindingCampaignCron`.
  channelBindingCampaignState String?            @db.VarChar(20)
  /// TZ-1 Фаза 0 — когда отправлено первое приглашение привязать канал.
  channelBindingInvitedAt     DateTime?
  /// ТЗ-5 Ф1 (meeting-upload-diarization) — компания/работодатель Person
  /// (для внешних контактов и обогащения карточки). NULL = неизвестно.
  company                     String?            @db.VarChar(200)
  /// ТЗ-5 Ф1 — должность Person (для обогащения карточки при разметке
  /// спикеров загруженной встречи). NULL = неизвестно.
  jobTitle                    String?            @db.VarChar(200)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  deletedAt                   DateTime?

  org                         Org                                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                        User?                              @relation("UserPersons", fields: [userId], references: [id], onDelete: SetNull)
  primaryDepartment           Department?                        @relation("PersonPrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  entity                      Entity?                            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  personRoles                 PersonRole[]
  /// SBA α-8 wave 3 — Appointment[] (replacement для PersonRole).
  appointments                Appointment[]
  uploadedDocuments           Document[]                         @relation("DocumentUploader")
  decisionsMade               Decision[]                         @relation("DecisionDecidedBy")
  ownedProcesses              Process[]                          @relation("ProcessOwnerPerson")
  /// ТЗ-F (2026-06-05) — Person как ответственный за цель (Goal.ownerPersonId).
  ownedGoals                  Goal[]                             @relation("GoalOwnerPerson")
  /// SBA α-7 — Person как owner регламента / политики (см. sub-TZ §4, §6).
  ownedRegulations            Regulation[]                       @relation("RegulationOwnerPerson")
  instructionsOwned           Instruction[]                      @relation("InstructionOwnerPerson")
  ownedPolicies               Policy[]                           @relation("PolicyOwnerPerson")
  /// SBA α-7 wave 2 — Person как owner ProcessTemplate.
  ownedProcessTemplates       ProcessTemplate[]                  @relation("ProcessTemplateOwnerPerson")
  memberships                 Membership[]                       @relation("MembershipPerson")
  invitations                 OrgInvitation[]                    @relation("OrgInvitationPerson")
  /// SBA γ-1 — Specialist 3.7 (SkillProfile). 1:1 — у одного Person ровно один профиль.
  skillProfile                SkillProfile?                      @relation("SkillProfilePerson")
  /// SBA β-8 — DailyCheckIn записи сотрудника.
  dailyCheckIns               DailyCheckIn[]                     @relation("DailyCheckInPerson")
  personLeaves                PersonLeave[]
  /// SBA β-8.2 — обратная связь для обещаний, адресованных этому человеку
  /// (`IdeaBlock.commitmentRecipientPersonId`).
  commitmentsToMe             IdeaBlock[]                        @relation("CommitmentRecipient")
  /// ТЗ-D — обещания, ДАННЫЕ этим человеком (автор).
  commitmentsAuthored         IdeaBlock[]                        @relation("CommitmentAuthor")
  /// ТЗ 2026-05-25 Фаза 3 — отделы, где этот Person — глава.
  headOfDepartments           Department[]                       @relation("DepartmentHead")
  /// Calendar MVP (2026-05-25) — участие как Person (external контакт).
  eventParticipations         EventParticipant[]                 @relation("EventParticipantPerson")
  participantsAsPerson        Participant[]                      @relation("ParticipantPerson")
  /// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 4 — Семантический
  /// индекс категорий профиля знаний (для запросов «кто разбирается в X»).
  knowledgeCategoryEmbeddings PersonKnowledgeCategoryEmbedding[]
  /// Sprints (2026-05-27) — проекты-спринты, привязанные к этому сотруднику
  /// как subject (Project.subjectPersonId). См. plans/tz/2026-05-27-sprints.md §1.1.
  scopedProjects              Project[]                          @relation("ProjectSubjectPerson")
  /// Pulse Wave 3 §3.3 — историческая лента engagement-снапшотов для тренда.
  engagementSnapshots         PersonEngagementSnapshot[]
  /// Pulse Wave 4 §4.1 — лог согласий 152-ФЗ (per dataType, append-only).
  consentLogs                 ConsentLog[]
  /// TZ-1 Фаза 0 (daily-value-engine) — дневной бюджет уведомлений per-person.
  notificationBudgetLedgers   NotificationBudgetLedger[]
  /// TZ-1 Фаза 1 (daily-value-engine) — снимки риска клиентов, где этот Person
  /// ответственный менеджер (CustomerRiskSnapshot.responsiblePersonId).
  customerRiskSnapshots       CustomerRiskSnapshot[]             @relation("CustomerRiskSnapshotResponsible")
  /// TZ-1 Фаза 2 (daily-value-engine) — персональные дневные брифы «Твой день».
  personalDailyBriefs         PersonalDailyBrief[]               @relation("PersonalDailyBriefPerson")
  /// TZ-1 Фаза 3.A (daily-value-engine) — кластеры блокеров, где этот Person
  /// ответственный (BlockerSynthesis.responsiblePersonId).
  blockerSyntheses            BlockerSynthesis[]                 @relation("BlockerSynthesisResponsible")
  /// TZ-1 Фаза 4.C (daily-value-engine) — снимки знание-под-риском, где этот
  /// Person — соло-эксперт под риском ухода (KnowledgeAtRiskSnapshot.soleExpertPersonId).
  knowledgeAtRiskSnapshots    KnowledgeAtRiskSnapshot[]          @relation("KnowledgeAtRiskSoleExpert")
  /// ТЗ-5 Ф1 (meeting-upload-diarization) — спикеры загруженных встреч,
  /// сопоставленные с этим Person (assignment=employee).
  uploadSpeakers              MeetingUploadSpeaker[]

  @@unique([tenantId, email, deletedAt])
  @@index([tenantId, userId])
  @@index([tenantId, primaryDepartmentId])
  @@index([tenantId, entityId])
  @@map("persons")
}

/// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 4 — Семантический индекс
/// категорий профиля знаний для запросов «кто разбирается в X».
/// Тонкий индекс над JSON Person.knowledgeProfile.categories[]:
/// дублирует name+confidence + кладёт embedding для векторного поиска.
model PersonKnowledgeCategoryEmbedding {
  id                  String                       @id @default(cuid())
  tenantId            String
  personId            String
  /// = knowledgeProfile.categories[].name (для отображения).
  categoryName        String                       @db.VarChar(200)
  /// 'low' | 'medium' | 'high' — копия, чтобы фильтровать без чтения JSON.
  confidence          String                       @db.VarChar(16)
  embedding           Unsupported("vector(1536)")?
  builtAt             DateTime                     @default(now())
  /// = Person.profileBuildVersion на момент построения этого embedding.
  profileBuildVersion Int

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, confidence])
  @@index([personId])
  @@map("person_knowledge_category_embeddings")
}

/// @deprecated SBA α-8 wave 3 (2026-05-23) — use `Appointment`.
/// PersonRole оставлена для legacy consumers и backward-compat;
/// `PersonsService` через feature-flag USE_APPOINTMENT_FOR_PERSON_ROLES
/// читает Appointment (по умолчанию false до flip'а в prod). Удаление —
/// отдельный sub-ТЗ через 1 месяц после прод-миграции.
///
/// PersonRole — many-to-many Person ↔ Role с временным интервалом.
/// Зеркало AGE-ребра `executes_role` (Фаза 0a). Открытая роль = validTo IS NULL.
/// Закрытие старой роли при переназначении: validTo = now() + создание новой записи.
model PersonRole {
  id        String    @id @default(cuid())
  tenantId  String
  personId  String
  roleId    String
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())

  org    Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([personId, roleId, validFrom])
  @@index([tenantId, roleId])
  @@index([tenantId, personId])
  @@index([tenantId, validTo])
  @@map("person_roles")
}

/// SBA α-8 wave 3 (2026-05-23) — Appointment.
///
/// Replacement for `PersonRole` с расширенными полями (departmentId,
/// loadPercent, status). Создаётся вручную через `/api/v1/appointments`
/// или агентом `appointment-detector` (опционально, флаг
/// APPOINTMENT_DETECTOR_ENABLED). Для backward-compat PersonRole
/// сохраняется; PersonsService читает Appointment если
/// USE_APPOINTMENT_FOR_PERSON_ROLES=true. См. sub-ТЗ
/// plans/tz/2026-05-23-sba-alpha-8-wave3-appointment-kpi.md.
///
/// status: 'active' | 'former' | 'acting'
///   active  — действующее назначение (validTo IS NULL).
///   former  — историческое (validTo < now()).
///   acting  — временное «исполняющий обязанности» (admin выставляет руками).
model Appointment {
  id             String    @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  personId       String
  roleId         String
  departmentId   String?
  loadPercent    Int       @default(100)
  status         String    @default("active") @db.VarChar(20)
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  /// IdeaBlock-источники назначения (provenance для агентских записей).
  sourceBlockIds String[]  @default([])
  /// Confidence от агента-извлекателя (1.0 для ручных).
  confidence     Decimal   @default(1.0) @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org        Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person     Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, personId, roleId, validFrom])
  @@index([tenantId, personId, status])
  @@index([tenantId, roleId, status])
  @@index([tenantId, departmentId, status])
  @@map("appointments")
}

/// JobDescription — declared-форма должности (что прописано в инструкции,
/// в отличие от observed-картины в RoleProfile).
model JobDescription {
  id               String    @id @default(cuid())
  tenantId         String
  roleId           String
  contentMd        String    @db.Text
  sourceDocumentId String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  org            Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([tenantId, roleId])
  @@map("job_descriptions")
}

/// Skill — переиспользуемая компетенция (одна Skill — много Role/Person).
model Skill {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    @db.VarChar(200)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@map("skills")
}

/// Document — загруженный файл (PDF / DOCX / Markdown / text). Фаза 0b.
///
/// inline ≤ 10 MiB кладётся в `inlineContent`; больше — в S3 (`s3Key`).
/// `parsedText` заполняется `document.adapter` / `text.adapter` (Фаза 0b).
/// `attachedRoleId` — если документ привязан к конкретной должности (из
/// wizard step-4 или `/structure?tab=roles → Загрузить должностную`).
model Document {
  id             String         @id @default(cuid())
  tenantId       String
  /// Person.id (НЕ User.id) — кто загрузил.
  uploaderId     String
  kind           DocumentKind
  name           String         @db.VarChar(500)
  mimeType       String         @db.VarChar(100)
  /// S3-ключ; null если используется inlineContent (file ≤ 10 MiB).
  s3Key          String?        @db.VarChar(500)
  /// Inline-байты; null если использован S3.
  inlineContent  Bytes?
  originalSize   Int
  /// Заполняется парсером (Фаза 0b).
  parsedText     String?        @db.Text
  pageCount      Int?
  pageOffsets    Int[]          @default([])
  /// Если status=failed — текст ошибки парсера.
  parseError     String?        @db.Text
  status         DocumentStatus @default(uploaded)
  /// Если документ привязан к Role — wizard step-4 или /structure → Загрузить должностную.
  attachedRoleId String?

  /// ТЗ-4 Ф1 — смысловой тип документа (регламент/политика/инструкция/…). null =
  /// не классифицирован вручную; подсказка хранится в `suggestedDocType`.
  docType           DocumentType?
  /// ТЗ-4 Ф1 — привязка документа к теме графа знаний (опц.).
  attachedThemeId   String?
  attachedTheme     Theme?        @relation("DocumentTheme", fields: [attachedThemeId], references: [id], onDelete: SetNull)
  /// ТЗ-4 Ф1 — привязка документа к проекту трекера (опц.).
  attachedProjectId String?
  attachedProject   Project?      @relation("DocumentProject", fields: [attachedProjectId], references: [id], onDelete: SetNull)
  /// ТЗ-4 Ф1 — хэш содержимого для дедупликации повторных загрузок.
  contentHash       String?
  /// ТЗ-4 Ф1 — предложенный классификатором смысловой тип (до подтверждения пользователем).
  suggestedDocType  DocumentType?
  /// ТЗ-4 Ф1 — предложенная классификатором тема (Theme.id) до подтверждения.
  suggestedThemeId  String?
  /// ТЗ-4 Ф1 — id batch-импорта (массовая загрузка); группирует документы одной операции.
  importBatchId     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// SBA α-3 — линковка с Entity{type=document} для графа знаний. Заполняется
  /// patch-backfill-entity-id-document.ts.
  entityId String? @unique
  entity   Entity? @relation("DocumentEntity", fields: [entityId], references: [id], onDelete: SetNull)

  /// SBA β-7 — multi-faceted назначение документа. Один документ может одновременно
  /// быть «опорным материалом процесса» (use_in_process), «генерационным
  /// шаблоном» (use_for_generation), «справочным» (reference) и/или «корпусом
  /// бренда» (brand_corpus). Префиксы — open enum: значения валидируются на
  /// API-уровне в `DocumentUseCasesController`, чтобы расширение новыми use-case
  /// не требовало миграций. Backfill дефолтного значения 'reference' — через
  /// `backend/scripts/patch-document-use-cases-default.ts`.
  useCases String[] @default([])

  org             Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader        Person           @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  attachedRole    Role?            @relation("DocumentAttachedRole", fields: [attachedRoleId], references: [id], onDelete: SetNull)
  jobDescriptions JobDescription[]

  @@index([tenantId, status])
  @@index([tenantId, uploaderId])
  @@index([tenantId, attachedRoleId])
  @@index([tenantId, docType])
  @@index([tenantId, contentHash])
  @@index([tenantId, attachedThemeId])
  @@index([importBatchId])
  @@map("documents")
}

/// ТЗ-4 Ф7 — batch-импорт документов (ZIP-архив → N Document'ов).
///
/// Создаётся синхронно в `POST /api/v1/documents/import-zip` (status=pending),
/// затем `DocumentImportWorker` (очередь `core.document-import`) распаковывает
/// архив и для каждой поддерживаемой записи создаёт `Document` с
/// `importBatchId = <этот id>`. Прогресс пишется в `doneFiles`/`failedFiles`,
/// ошибки по конкретным записям — в `errorLog` (массив `{file, error}`).
///
/// ZIP хранится так же, как Document (inline ≤ inlineThreshold, иначе S3),
/// чтобы воркер мог его прочитать. После обработки байты остаются как audit-
/// артефакт (retention — отдельной фазой).
model DocumentImport {
  id          String               @id @default(cuid())
  tenantId    String
  source      DocumentImportSource
  status      DocumentImportStatus @default(pending)
  totalFiles  Int                  @default(0)
  doneFiles   Int                  @default(0)
  failedFiles Int                  @default(0)
  /// Лог ошибок по записям: [{ file: string, error: string }]. null — ошибок нет.
  errorLog    Json?
  /// Person.id (НЕ User.id) — кто инициировал импорт.
  createdById String

  /// Batch-атрибуция, применяемая ко всем созданным Document'ам (опц.).
  attachedThemeId   String?
  attachedProjectId String?
  docType           DocumentType?

  /// S3-ключ архива; null если использован `zipInline`.
  zipS3Key  String? @db.VarChar(500)
  /// Inline-байты архива; null если использован S3.
  zipInline Bytes?
  /// Размер архива в байтах (для логов/лимитов).
  zipSize   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("document_import")
}

/// SBA β-7 — BrandVoiceProfile. 1:1 на Org-запись «голоса бренда».
///
///   - `toneJson` — мерные оси тона: { formal, technical, casual, energetic, ... }
///     в диапазоне 0..1. До 10 dimensions. Структура валидируется в сервисе.
///   - `valuesJson` — ценности бренда: Array<{ value, weight 0..1,
///     exampleBlockIds }>.
///   - `taboosJson` — табу-фразы: Array<{ phrase, alternative?, reason }>.
///   - `exampleArtifactIds` — Document.id'ы (useCases includes 'brand_corpus'),
///     которые послужили опорой.
///   - `completeness` — 0..1, доля заполненных секций (tone, values, taboos,
///     examples).
///   - `builderAgentVersion` — версия экстрактора (для воспроизводимости).
///
/// Daily-cron `brand-voice-extractor.cron` пересобирает профиль из brand_corpus
/// документов + brand_principle блоков. Профиль extract'ится только при
/// ≥ BRAND_VOICE_MIN_CORPUS_SIZE документов в корпусе.
model BrandVoiceProfile {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  toneJson            Json?
  valuesJson          Json?
  taboosJson          Json?
  exampleArtifactIds  String[]  @default([])
  version             Int       @default(1)
  lastBuiltAt         DateTime?
  builderAgentVersion String?   @db.VarChar(40)
  completeness        Decimal   @default(0) @db.Decimal(4, 3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("brand_voice_profiles")
}

/// RoleProfile — материализованный кеш "карта должности" (observed-форма).
/// Один RoleProfile на Role. Создаётся автоматически при создании Role
/// (через RolesService); наполняется RoleProfileAgent (Фаза 0d).
model RoleProfile {
  id                  String            @id @default(cuid())
  tenantId            String
  roleId              String            @unique
  /// `{ responsibilities[], skills[], decision_patterns[], common_pitfalls[], style_profile }`.
  /// Schema валидируется zod'ом в `role-profile.service.ts` (Фаза 0d).
  /// SBA α-8 wave 2: summaryCache остаётся как быстрый JSON-кеш для UI;
  /// канонические данные живут в нормализованных таблицах ResponsibilityElement /
  /// AuthorityBoundary / RequiredKnowledge / DecisionPolicy / Interaction.
  summaryCache        Json              @default("{}")
  status              RoleProfileStatus @default(forming)
  lastBuildAt         DateTime?
  /// Инкрементируется при каждой успешной пересборке. Используется в
  /// idempotency-key BullMQ ('role-profile:${roleId}:${buildVersion}').
  buildVersion        Int               @default(0)
  /// SBA α-8 wave 2 (2026-05-23) — метаданные сборки.
  /// Когда RoleProfileAgent последний раз построил профиль (отличается от
  /// `updatedAt` — последнее изменение записи, например ручная правка summaryCache).
  builtAt             DateTime?
  /// Версия билдера (для воспроизводимости и поэтапного re-build).
  builderAgentVersion String?           @db.VarChar(40)
  /// Сколько IdeaBlock-наблюдений использовалось для последнего билда.
  observationCount    Int               @default(0)
  /// 0..1 — насколько полно заполнены 9 слотов профиля. NULL до первого билда.
  completeness        Decimal?          @db.Decimal(4, 3)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  org  Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("role_profiles")
}

// ──────────────────────────── SBA α-8 wave 2 — Role Map нормализованные таблицы ────────────────────────────

/// ResponsibilityElement — элемент ответственности роли (Кора v2 §α-8).
/// Самореференция через parentId позволяет иерархию outcome → function →
/// activity. На верхнем уровне — outcome (что должно случиться), глубже —
/// function (какую работу делает), листья — activity (конкретные действия).
model ResponsibilityElement {
  id             String    @id @default(cuid())
  tenantId       String
  roleId         String
  parentId       String?
  /// kind: 'outcome' | 'function' | 'activity'. Строкой для расширения.
  kind           String    @db.VarChar(20)
  /// Краткое название элемента (1-7 слов).
  name           String    @db.VarChar(300)
  /// Полное описание (что/зачем/как измеряется).
  description    String?   @db.Text
  /// Порядок отображения в карте роли.
  order          Int       @default(0)
  /// IdeaBlock-источники последнего извлечения (provenance).
  sourceBlockIds String[]  @default([])
  /// Confidence от RoleProfileAgent (0..1).
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org             Org                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            Role                    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  parent          ResponsibilityElement?  @relation("ResponsibilityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        ResponsibilityElement[] @relation("ResponsibilityHierarchy")
  /// SBA α-8 wave 3 — Metric'ы, привязанные к этому элементу ответственности (KPI).
  attachedMetrics Metric[]

  @@index([tenantId, roleId])
  @@index([tenantId, roleId, kind])
  @@index([parentId])
  @@map("responsibility_elements")
}

/// AuthorityBoundary — границы полномочий должности: «что разрешено» и «что
/// требует согласования». Используется в γ-2 Concierge и β-3 Decisions для
/// validate «может ли этот человек принять X решение».
model AuthorityBoundary {
  id             String    @id @default(cuid())
  tenantId       String
  roleId         String
  /// kind: 'allowed' | 'requires_approval' | 'forbidden'.
  kind           String    @db.VarChar(40)
  /// Что разрешено/запрещено (бизнес-описание).
  scope          String    @db.Text
  /// Если requires_approval — кто approver (roleId).
  approverRoleId String?
  /// Пороги (например, бюджет в рублях). JSON для гибкости.
  thresholdsJson Json?
  sourceBlockIds String[]  @default([])
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org          Org   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role  @relation("AuthorityBoundaryRole", fields: [roleId], references: [id], onDelete: Cascade)
  approverRole Role? @relation("AuthorityBoundaryApprover", fields: [approverRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId, roleId])
  @@index([tenantId, kind])
  @@map("authority_boundaries")
}

/// RequiredKnowledge — что должен знать человек на этой должности (γ-1 SkillProfile
/// сверяется с этим для gap-detection). Различает «обязательно» и «желательно».
model RequiredKnowledge {
  id             String    @id @default(cuid())
  tenantId       String
  roleId         String
  /// Тема знания (например «SQL», «техника продаж SPIN», «бюджетирование»).
  topic          String    @db.VarChar(300)
  description    String?   @db.Text
  /// 'mandatory' | 'preferred' | 'nice_to_have'.
  importance     String    @db.VarChar(20)
  /// Уровень владения: 'beginner' | 'intermediate' | 'expert'.
  expectedLevel  String?   @db.VarChar(20)
  sourceBlockIds String[]  @default([])
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org  Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId, roleId])
  @@index([tenantId, roleId, importance])
  @@map("required_knowledge")
}

/// DecisionPolicy — правило принятия решения, привязанное к роли. Когда β-3
/// Specialist Decisions фиксирует решение, он может ссылаться на эту policy
/// через Decision.appliedPolicyId — для аудита соответствия.
model DecisionPolicy {
  id                   String    @id @default(cuid())
  tenantId             String
  roleId               String
  /// Краткое имя политики (например «лимит на скидку», «утверждение KP > 500к»).
  name                 String    @db.VarChar(300)
  /// Условия применения (когда срабатывает).
  conditionDescription String?   @db.Text
  /// Что делать (как принимать решение).
  ruleDescription      String    @db.Text
  /// Опц. ссылка на Regulation, формализующий эту политику.
  regulationId         String?
  sourceBlockIds       String[]  @default([])
  confidence           Decimal?  @db.Decimal(4, 3)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  org                Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role               Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  regulation         Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  /// SBA β-3 доделка: Decisions, применившие эту политику.
  appliedToDecisions Decision[]  @relation("DecisionAppliedPolicy")

  @@index([tenantId, roleId])
  @@map("decision_policies")
}

/// Interaction — типовое взаимодействие роли с другими ролями / отделами /
/// внешними участниками. Используется в γ-3 CrossFunctional для построения
/// карты handoff'ов и в β-8 для PersonalRelation patterns.
model Interaction {
  id                      String    @id @default(cuid())
  tenantId                String
  roleId                  String
  /// С кем взаимодействует: ровно одно из них заполнено.
  counterpartRoleId       String?
  counterpartDepartmentId String?
  /// Free-text если counterpart — внешний (клиент, поставщик, регулятор).
  counterpartExternal     String?   @db.VarChar(300)
  /// Тип взаимодействия: 'reports_to' | 'collaborates_with' | 'delegates_to' |
  /// 'receives_handoff_from' | 'escalates_to' | 'customer_facing' | …
  kind                    String    @db.VarChar(40)
  /// Частота: 'daily' | 'weekly' | 'monthly' | 'ad_hoc'.
  frequency               String?   @db.VarChar(20)
  description             String?   @db.Text
  sourceBlockIds          String[]  @default([])
  confidence              Decimal?  @db.Decimal(4, 3)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  org                   Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                  Role        @relation("InteractionRole", fields: [roleId], references: [id], onDelete: Cascade)
  counterpartRole       Role?       @relation("InteractionCounterpartRole", fields: [counterpartRoleId], references: [id], onDelete: SetNull)
  counterpartDepartment Department? @relation("InteractionCounterpartDept", fields: [counterpartDepartmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, roleId])
  @@index([tenantId, counterpartRoleId])
  @@index([tenantId, kind])
  @@map("interactions")
}

// ──────────────────────────── группа Б: каркас 5 уровней (без UI в Фазе 0) ────────────────────────────

/// Mission — «зачем» компании (Фаза 0a, группа Б). UI в Фазе γ.
/// Наполняется UI-формой в γ; в Фазе 0 поле существует, extraction отключен
/// флагом `EXTRACTION_ENABLE_TOP_LEVEL=false` (зонтичный ТЗ §6 решение #11).
model Mission {
  id         String      @id @default(cuid())
  tenantId   String
  contentMd  String      @db.Text
  markets    Json?
  bets       Json?
  horizon    GoalHorizon @default(strategic)
  targetDate DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("missions")
}

/// Vision — образ будущего компании (Фаза 0a, группа Б). UI в Фазе γ.
model Vision {
  id           String    @id @default(cuid())
  tenantId     String
  contentMd    String    @db.Text
  horizonYears Int?
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("visions")
}

/// Strategy — стратегия (рынки + ставки) (Фаза 0a, группа Б). UI в Фазе γ.
model Strategy {
  id         String      @id @default(cuid())
  tenantId   String
  contentMd  String      @db.Text
  markets    Json        @default("[]")
  bets       Json        @default("[]")
  horizon    GoalHorizon @default(strategic)
  targetDate DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("strategies")
}

// ──────────────────────────── SBA α-9 wave 2 — Company Foundation ────────────────────────────

/// CompanyProfile — единая 1:1 запись о компании (Org). Заменяет тройку
/// Mission/Vision/Strategy: контент остаётся в JSON-полях для гибкости (UI в γ),
/// но точкой правды становится этот профиль.
///
/// Старые модели Mission/Vision/Strategy остаются для backward-compat
/// (deprecated). Миграция данных — patch-script в α-9 wave 3.
model CompanyProfile {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource     String?
  /// Краткое имя компании (для UI).
  displayName        String?   @db.VarChar(300)
  /// Миссия: { contentMd, horizon, targetDate? }. JSON для упрощения миграции
  /// из Mission и расширения новыми полями без alter table.
  missionJson        Json?
  /// Видение: { contentMd, horizonYears, targetDate? }.
  visionJson         Json?
  /// Стратегия: { contentMd, markets[], bets[], horizon, targetDate? }.
  strategyJson       Json?
  /// Target markets (Market.id[]) — для δ-1 Orchestrator и β-7 BrandVoice.
  targetMarketIds    String[]  @default([])
  /// Уровень зрелости (0..1) — рассчитывается MaturityScorerCron как
  /// взвешенное completeness по 8 базовым FunctionalDomain'ам.
  maturityScore      Decimal?  @db.Decimal(4, 3)
  /// Когда последний раз пересчитывался maturityScore.
  lastMaturityCalcAt DateTime?
  /// Краткое описание стадии (early-stage / growth / scale / enterprise).
  stage              String?   @db.VarChar(40)
  sourceBlockIds     String[]  @default([])
  /// Confidence от extraction-LLM (для агентского билда из встреч).
  confidence         Decimal?  @db.Decimal(4, 3)
  /// Краткое описание «чем компания занимается»: { contentMd, generatedAt }.
  summaryJson        Json?
  /// true → summary закреплён владельцем; авто-компилятор НЕ перетирает.
  summaryPinned      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("company_profiles")
}

/// FunctionalDomain — функциональная область деятельности компании
/// (Маркетинг, Продажи, Разработка, HR, Финансы, …). Дерево через parentDomainId.
/// Авто-расширяется domain-expander.cron при обнаружении unmatched тем.
///
/// Используется как ось FUNCTIONAL в AxisClassifierService (α-3 wave 3) и
/// для MaturityScorerCron (взвешенное completeness по доменам).
model FunctionalDomain {
  id             String    @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  parentDomainId String?
  name           String    @db.VarChar(200)
  /// Краткое описание области.
  description    String?   @db.Text
  /// Иконка для UI (lucide icon name).
  iconName       String?   @db.VarChar(60)
  /// `slug` — нормализованный идентификатор для запросов (`sales`, `r-and-d`).
  slug           String    @db.VarChar(80)
  /// Системные дефолтные домены (seed) vs пользовательские (auto-expanded).
  isSystem       Boolean   @default(false)
  /// 0..1 — насколько у компании прокачана эта область (по объёму извлечённых
  /// знаний / процессов / решений в этом домене).
  completeness   Decimal?  @db.Decimal(4, 3)
  /// Порядок отображения.
  order          Int       @default(0)
  /// Confidence для auto-expanded доменов (от LLM-классификатора).
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org             Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          FunctionalDomain?      @relation("FunctionalDomainHierarchy", fields: [parentDomainId], references: [id], onDelete: SetNull)
  children        FunctionalDomain[]     @relation("FunctionalDomainHierarchy")
  departmentLinks DepartmentDomainLink[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentDomainId])
  @@index([tenantId, isSystem])
  @@map("functional_domains")
}

/// DepartmentDomainLink — m:n связь Department ↔ FunctionalDomain.
/// Один отдел может покрывать несколько доменов (HR-отдел: «найм» + «обучение»);
/// один домен может быть распределён между несколькими отделами (BizDev в Sales
/// и в Marketing).
model DepartmentDomainLink {
  id            String   @id @default(cuid())
  tenantId      String
  departmentId  String
  domainId      String
  /// Какая доля domain-активности приходится на этот отдел (0..1). Сумма по
  /// всем отделам для одного домена должна быть ~1; на расхождения реагирует
  /// MaturityScorerCron.
  coverageRatio Decimal? @db.Decimal(4, 3)
  /// 'primary' (главный owner) | 'secondary' | 'supporting'.
  role          String   @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org        Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  domain     FunctionalDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([departmentId, domainId])
  @@index([tenantId, domainId])
  @@index([tenantId, departmentId])
  @@map("department_domain_links")
}

/// Process — бизнес-процесс компании (Фаза 0a, группа Б). UI в Фазе γ.
///
/// Наполняется BlockExtractionService (Фаза 0b) с дедупом через
/// EntityResolutionService. `confidence` — точность LLM-классификации;
/// `ambiguousTypes` — если LLM колебалась (например, Process vs Regulation),
/// сохраняем оба варианта для CuratorAgent в Фазе δ.
model Process {
  id                 String                       @id @default(cuid())
  tenantId           String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource     String?
  name               String                       @db.VarChar(300)
  description        String?                      @db.Text
  ownerRoleId        String?
  ownerPersonId      String?
  triggerDescription String?                      @db.Text
  slaMinutes         Int?
  status             ProcessStatus                @default(active)
  /// 0..1 — confidence от extraction-LLM (Фаза 0b §6.2).
  confidence         Float?
  /// Если LLM колеблется (Process vs Regulation/Policy) — список альтернатив.
  ambiguousTypes     String[]                     @default([])
  /// SBA α-7 — расширение Фазы 0b (in-place, без новой таблицы Regulation.kind).
  /// `entityId` — связка с графом (опц., создаётся, когда специалист 3.1 канонизирует процесс).
  entityId           String?                      @unique
  /// `scope` — область действия: 'org' | 'department:<id>' | 'role:<id>' | 'project:<id>'.
  scope              String?                      @db.VarChar(120)
  /// `currentVersionId` → CardVersion, последняя одобренная триажем версия.
  currentVersionId   String?
  /// `sourceBlockIds[]` — IdeaBlock-источники последнего извлечения / merge'а.
  sourceBlockIds     String[]                     @default([])
  /// `personSubjectIds[]` — Person'ы, которым процесс присвоен как subject (для γ-1 SkillProfile).
  personSubjectIds   String[]                     @default([])
  dataClass          DataClass                    @default(internal)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (policyVersion + sources).
  dataClassAudit     Json?
  /// Эмбеддинг (name + первый абзац description) — для KNN-дедупа в Specialist31Service.
  embedding          Unsupported("vector(1536)")?
  /// Когда последний раз процесс подтверждался (auto после canonical или вручную куратором).
  lastConfirmedAt    DateTime?
  /// SBA α-7 — структурированный ввод/вывод процесса (см. sub-TZ §4).
  /// `inputs/outputs/metricsJson` — JSON-массивы / объекты, заполняются LLM
  /// `process-steps-extract` или вручную через `POST /regulations/:id/edit` (γ).
  /// `metricsJson` намеренно НЕ называется `metrics`, чтобы не конфликтовать с
  /// доменной моделью `Metric` (отдельная Phase 0b сущность).
  inputs             Json?
  outputs            Json?
  metricsJson        Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  deletedAt          DateTime?
  deletedById        String?

  /// SBA α-7 wave 2 (2026-05-23) — instance может ссылаться на canonical template.
  templateId String?

  org            Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerRole      Role?            @relation("ProcessOwnerRole", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  ownerPerson    Person?          @relation("ProcessOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  steps          ProcessStep[]
  /// SBA α-7 — связь с CardVersion (текущая активная версия).
  currentVersion CardVersion?     @relation("ProcessCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// SBA α-7 wave 2 — опц. библиотечный template, из которого instance создан.
  template       ProcessTemplate? @relation("ProcessFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  /// Уникальность гарантируется EntityResolutionService + cosine + LLM-arbiter (0b §8).
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, ownerRoleId])
  @@index([tenantId, scope])
  @@index([tenantId, templateId])
  @@index([currentVersionId])
  @@index([tenantId, deletedAt])
  @@map("processes")
}

/// ProcessTemplate — библиотечный шаблон процесса (SBA α-7).
///
/// Решение «template vs instance»: существующий `Process` остаётся как
/// runtime-instance конкретного процесса компании; `ProcessTemplate` — это
/// канонический шаблон (например, «стандартный sales cycle», «hire process»).
/// `Process.templateId` — опц. ссылка из instance на template.
///
/// Источники: специалист 3.1 Regulations извлекает template'ы из документов
/// и встреч; куратор апрувит публикацию в библиотеку.
model ProcessTemplate {
  id                   String                       @id @default(cuid())
  tenantId             String
  name                 String                       @db.VarChar(300)
  summary              String?                      @db.Text
  /// Категория шаблона: 'hire' | 'sales' | 'incident' | 'onboarding' | 'release' | 'custom'.
  /// Строкой, чтобы расширять без миграций.
  category             String?                      @db.VarChar(60)
  /// Где применяется: 'org' | 'department:<id>' | 'role:<id>'.
  scope                String?                      @db.VarChar(120)
  status               ProcessStatus                @default(active)
  /// Последняя одобренная версия (Editor → Curator → publish).
  currentVersionId     String?
  ownerRoleId          String?
  ownerPersonId        String?
  /// IdeaBlock-источники последнего обновления template (provenance).
  sourceBlockIds       String[]                     @default([])
  dataClass            DataClass                    @default(internal)
  embedding            Unsupported("vector(1536)")?
  lastConfirmedAt      DateTime?
  metadata             Json?
  /// SBA γ-3 — флаг «сквозного» процесса (cross-functional). Auto-computed
  /// детектором: `crossFunctionalScore = unique_departments / total_steps >= threshold`.
  isCrossFunctional    Boolean                      @default(false)
  /// SBA γ-3 — числовая метрика «сквозности» (0..1). NULL до первого расчёта.
  crossFunctionalScore Decimal?                     @db.Decimal(4, 3)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?

  org                            Org                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentVersion                 ProcessTemplateVersion?         @relation("TemplateCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions                       ProcessTemplateVersion[]        @relation("TemplateVersions")
  ownerRole                      Role?                           @relation("ProcessTemplateOwnerRole", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  ownerPerson                    Person?                         @relation("ProcessTemplateOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  instances                      Process[]                       @relation("ProcessFromTemplate")
  decisionPoints                 DecisionPoint[]
  handoffsFrom                   ProcessHandoff[]                @relation("HandoffFromTemplate")
  handoffsTo                     ProcessHandoff[]                @relation("HandoffToTemplate")
  /// SBA γ-3 — отчёты «process_friction» по этому шаблону.
  crossFunctionalFrictionReports CrossFunctionalFrictionReport[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, scope])
  @@index([tenantId, isCrossFunctional])
  @@map("process_templates")
}

/// SBA γ-3 — CrossFunctionalFrictionReport. Сворачивает `process_friction`
/// блоки + ProcessHandoff с slaViolations в единый отчёт по cross-functional
/// процессу. Создаётся cron'ом (daily 05:00) и при manual resolve обновляется.
model CrossFunctionalFrictionReport {
  id                    String    @id @default(cuid())
  tenantId              String
  processTemplateId     String
  /// Severity: 'low' | 'medium' | 'high' — текстом, чтобы расширять без миграций.
  severity              String    @db.VarChar(20)
  /// Человекочитаемое описание friction (что именно тормозит и где).
  description           String    @db.Text
  /// Источники: IdeaBlock-id'ы с signalType='process_friction'.
  sourceBlockIds        String[]  @default([])
  /// Какие отделы вовлечены (Department.id[]) — для UI-визуализации.
  involvedDepartmentIds String[]  @default([])
  /// Рекомендованное действие (LLM-summary или manual). Опц.
  recommendedAction     String?   @db.Text
  /// Когда закрыли отчёт. NULL → активный.
  resolvedAt            DateTime?
  /// Кто закрыл (User.id).
  resolvedByUserId      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org             Org             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processTemplate ProcessTemplate @relation(fields: [processTemplateId], references: [id], onDelete: Cascade)

  @@index([tenantId, severity, resolvedAt])
  @@index([tenantId, processTemplateId])
  @@map("cross_functional_friction_reports")
}

/// ProcessTemplateVersion — версионируемый snapshot шаблона. Содержит полное
/// определение (шаги + decision points + handoffs) в JSON. Версии иммутабельны
/// после публикации; обновление = новая версия.
model ProcessTemplateVersion {
  id             String    @id @default(cuid())
  tenantId       String
  templateId     String
  /// Версия: монотонно возрастающее целое от 1 на template.
  version        Int
  /// Полное определение версии: { steps: [...], decisionPoints: [...], handoffs: [...] }.
  definitionJson Json
  /// Кто опубликовал.
  publishedById  String?
  publishedAt    DateTime?
  /// Источник: 'manual' | 'agent' (auto-extracted by Specialist 3.1) | 'imported'.
  source         String    @db.VarChar(40)
  /// Краткие changelog/diff'ы к предыдущей версии.
  changeNote     String?   @db.Text
  createdAt      DateTime  @default(now())

  org         Org               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template    ProcessTemplate   @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentOf   ProcessTemplate[] @relation("TemplateCurrentVersion")
  publishedBy User?             @relation("ProcessTemplateVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([templateId, version])
  @@index([tenantId, templateId])
  @@map("process_template_versions")
}

/// DecisionPoint — точка принятия решения внутри процесса. Связана с конкретным
/// `ProcessTemplate` (или с `ProcessStep` в legacy instance — поле опц.).
/// Используется специалистом 3.3 Decisions для cross-link «принятое решение в
/// рамках этого DecisionPoint».
model DecisionPoint {
  id              String   @id @default(cuid())
  tenantId        String
  templateId      String?
  /// Опц. ссылка на legacy ProcessStep (если решение зафиксировано в инстансе).
  processStepId   String?
  name            String   @db.VarChar(300)
  /// Условие, по которому проходит ветвление (естественный язык + опц. JSON).
  condition       String?  @db.Text
  /// Возможные ветви: [{name, description, leadsToStepId?}, …].
  branchesJson    Json
  /// Опц. дефолтная Role/Person, принимающая решение в этой точке.
  decidedByRoleId String?
  /// Порядок в process flow.
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      ProcessTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  processStep   ProcessStep?     @relation(fields: [processStepId], references: [id], onDelete: Cascade)
  decidedByRole Role?            @relation("DecisionPointDecider", fields: [decidedByRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId, templateId])
  @@index([tenantId, processStepId])
  @@map("decision_points")
}

/// ProcessHandoff — передача результата между процессами / шагами / ролями.
/// Используется специалистом γ-3 CrossFunctional Process для трекинга
/// межотдельных handoff'ов.
model ProcessHandoff {
  id                 String   @id @default(cuid())
  tenantId           String
  /// Опц. ссылки на источник передачи (template ИЛИ конкретный шаг).
  fromTemplateId     String?
  fromProcessStepId  String?
  fromRoleId         String?
  /// Опц. ссылки на получателя.
  toTemplateId       String?
  toProcessStepId    String?
  toRoleId           String?
  /// Тип handoff'а: 'document' | 'data' | 'decision' | 'physical' | 'notification'.
  kind               String   @db.VarChar(40)
  /// Что именно передаётся (артефакт, событие, документ).
  payloadDescription String?  @db.Text
  /// Ожидаемое SLA передачи (в часах).
  expectedSlaHours   Int?
  /// Зафиксированные конфликты handoff'а (через γ-3 process-friction signals).
  knownFrictionCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org             Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromTemplate    ProcessTemplate? @relation("HandoffFromTemplate", fields: [fromTemplateId], references: [id], onDelete: Cascade)
  toTemplate      ProcessTemplate? @relation("HandoffToTemplate", fields: [toTemplateId], references: [id], onDelete: Cascade)
  fromProcessStep ProcessStep?     @relation("HandoffFromStep", fields: [fromProcessStepId], references: [id], onDelete: SetNull)
  toProcessStep   ProcessStep?     @relation("HandoffToStep", fields: [toProcessStepId], references: [id], onDelete: SetNull)
  fromRole        Role?            @relation("HandoffFromRole", fields: [fromRoleId], references: [id], onDelete: SetNull)
  toRole          Role?            @relation("HandoffToRole", fields: [toRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind])
  @@index([tenantId, fromTemplateId])
  @@index([tenantId, toTemplateId])
  @@index([tenantId, fromRoleId])
  @@index([tenantId, toRoleId])
  @@map("process_handoffs")
}

/// ProcessStep — шаг процесса (Фаза 0a, группа Б).
model ProcessStep {
  id             String   @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  processId      String
  name           String   @db.VarChar(300)
  order          Int
  description    String?  @db.Text
  slaMinutes     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org            Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  process        Process          @relation(fields: [processId], references: [id], onDelete: Cascade)
  /// SBA α-7 wave 2 — обратные связи DecisionPoint и ProcessHandoff.
  decisionPoints DecisionPoint[]
  handoffsFrom   ProcessHandoff[] @relation("HandoffFromStep")
  handoffsTo     ProcessHandoff[] @relation("HandoffToStep")

  @@unique([processId, order])
  @@index([tenantId, processId])
  @@map("process_steps")
}

/// Regulation — регламент / стандарт (Фаза 0a, группа Б).
/// `category=standard` через AGE-ребро `applies_to` ссылается на тип
/// артефакта (строка, динамическая онтология — γ).
model Regulation {
  id               String                       @id @default(cuid())
  tenantId         String
  name             String                       @db.VarChar(300)
  contentMd        String                       @db.Text
  category         RegulationCategory           @default(regulation)
  status           ProcessStatus                @default(active)
  version          Int                          @default(1)
  confidence       Float?
  /// SBA α-7 — расширение Фазы 0b (in-place; см. sub-TZ §14.3).
  /// `entityId` — связка с графом.
  entityId         String?                      @unique
  /// `statement` — структурированная суть регламента / стандарта.
  /// Альтернатива `contentMd` (markdown остаётся для отображения, statement —
  /// для дедупа / chat-v2 retrieval). На α-7 заполняется LLM `regulation-extract`.
  statement        String?                      @db.Text
  /// `scope` — область действия: 'org' | 'department:<id>' | 'role:<id>' | 'project:<id>'.
  scope            String?                      @db.VarChar(120)
  /// FK на Person — назначенный ответственный за регламент.
  ownerPersonId    String?
  /// Self-relation для версионирования (новая запись «заменяет» старую).
  supersedesId     String?
  /// FK на CardVersion (последняя активная версия после triage).
  currentVersionId String?
  /// `sourceBlockIds[]` — IdeaBlock-источники последнего извлечения.
  sourceBlockIds   String[]                     @default([])
  /// Денорм-снимок провенанса для рендера списков без join.
  previewQuote     String?                      @db.Text
  /// { evidenceId, blockId, sourceType, sourceExternalId, startMs?, deepLink, attribution }
  previewSourceRef Json?
  /// `personSubjectIds[]` — Person'ы, которым регламент присвоен как subject (для γ-1 SkillProfile).
  personSubjectIds String[]                     @default([])
  dataClass        DataClass                    @default(internal)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (policyVersion + sources).
  dataClassAudit   Json?
  /// Эмбеддинг (name + statement) — для KNN-дедупа.
  embedding        Unsupported("vector(1536)")?
  lastConfirmedAt  DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  deletedAt        DateTime?
  deletedById      String?

  org              Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerPerson      Person?          @relation("RegulationOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  supersedes       Regulation?      @relation("RegulationSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     Regulation[]     @relation("RegulationSupersedes")
  currentVersion   CardVersion?     @relation("RegulationCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// SBA α-8 wave 2 — обратная связь DecisionPolicy.
  decisionPolicies DecisionPolicy[]

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([tenantId, scope])
  @@index([tenantId, ownerPersonId])
  @@index([currentVersionId])
  @@index([tenantId, deletedAt])
  @@map("regulations")
}

/// Instruction — first-class сущность «Инструкция»: пошаговое руководство для ОДНОЙ роли
/// (Волна 6 A10). Зеркалит Regulation, но с признаком single-role `forRole`.
model Instruction {
  id               String                       @id @default(cuid())
  tenantId         String
  name             String                       @db.VarChar(300)
  contentMd        String                       @db.Text
  status           ProcessStatus                @default(active)
  version          Int                          @default(1)
  confidence       Float?
  /// `forRole` — роль-владелец инструкции (single-role признак).
  forRole          String?                      @db.VarChar(120)
  /// `entityId` — связка с графом.
  entityId         String?                      @unique
  /// `statement` — структурированная суть инструкции (альтернатива contentMd для дедупа / retrieval).
  statement        String?                      @db.Text
  /// `scope` — область действия: 'org' | 'department:<id>' | 'role:<id>' | 'project:<id>'.
  scope            String?                      @db.VarChar(120)
  /// FK на Person — назначенный ответственный за инструкцию.
  ownerPersonId    String?
  /// Self-relation для версионирования (новая запись «заменяет» старую).
  supersedesId     String?
  /// FK на CardVersion (последняя активная версия после triage).
  currentVersionId String?
  /// `sourceBlockIds[]` — IdeaBlock-источники последнего извлечения.
  sourceBlockIds   String[]                     @default([])
  /// `personSubjectIds[]` — Person'ы, которым инструкция присвоена как subject.
  personSubjectIds String[]                     @default([])
  dataClass        DataClass                    @default(internal)
  /// audit-trail вычисления dataClass (policyVersion + sources).
  dataClassAudit   Json?
  /// Эмбеддинг (name + statement) — для KNN-дедупа.
  embedding        Unsupported("vector(1536)")?
  lastConfirmedAt  DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  deletedAt        DateTime?
  deletedById      String?

  org              Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerPerson      Person?          @relation("InstructionOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  supersedes       Instruction?     @relation("InstructionSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     Instruction[]    @relation("InstructionSupersedes")
  currentVersion   CardVersion?     @relation("InstructionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, forRole])
  @@index([tenantId, ownerPersonId])
  @@index([currentVersionId])
  @@index([tenantId, deletedAt])
  @@map("instructions")
}

/// Policy — политика (Фаза 0a, группа Б). UI в Фазе α-7.
model Policy {
  id               String                       @id @default(cuid())
  tenantId         String
  name             String                       @db.VarChar(300)
  contentMd        String                       @db.Text
  severity         PolicySeverity               @default(advisory)
  status           ProcessStatus                @default(active)
