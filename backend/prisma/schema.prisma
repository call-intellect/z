  tenantId      String
  externalId    String // dialog_id (chatXXX или userId)
  type          BitrixDialogType @default(chat)
  title         String?
  lastMessageAt DateTime?
  messageCount  Int              @default(0)
  /// Накопительное саммари разговора (ТЗ 2026-06-17): обновляется на закрытие
  /// каждой сессии-дня; компактный «живой» контекст без полной истории.
  rollingSummary   String?   @db.Text
  rollingSummaryAt DateTime?
  raw           Json?
  syncedAt      DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  org      Org                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions BitrixDialogSession[]
  messages BitrixMessage[]

  @@unique([tenantId, externalId])
  @@index([tenantId, lastMessageAt])
}

/// Сессия (временно́е окно) IM-диалога для анализа. Аналог ChatboxChatSession.
model BitrixDialogSession {
  id             String                     @id @default(cuid())
  tenantId       String
  dialogId       String
  seq            Int
  startedAt      DateTime
  endedAt        DateTime?
  messageCount   Int                        @default(0)
  analysisStatus BitrixDialogAnalysisStatus @default(pending)
  summary        String?                    @db.Text
  rawEventId     String?
  analyzedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  org    Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dialog BitrixDialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dialogId, seq])
  @@index([tenantId, analysisStatus])
}

/// Сообщение IM-диалога Bitrix. Аналог ChatboxMessage.
model BitrixMessage {
  id                String    @id @default(cuid())
  tenantId          String
  dialogId          String
  sessionId         String?
  externalId        String // message ID
  authorExternalId  String? // Bitrix user ID автора
  authorName        String?
  text              String?   @db.Text
  externalCreatedAt DateTime
  raw               Json?
  createdAt         DateTime  @default(now())

  org    Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dialog BitrixDialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, dialogId, externalCreatedAt])
  @@index([tenantId, sessionId])
}

/// Зеркало CRM-контакта Bitrix. Мост в knowledge-core — Ф4.
model BitrixContact {
  id         String   @id @default(cuid())
  tenantId   String
  externalId String
  name       String?
  email      String?
  phone      String?
  /// Ф4b — DATE_MODIFY из Bitrix (для дельты и посуточного дайджеста).
  modifiedAt DateTime?
  raw        Json?
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, modifiedAt])
}

/// Зеркало CRM-компании Bitrix.
model BitrixCompany {
  id         String   @id @default(cuid())
  tenantId   String
  externalId String
  title      String?
  modifiedAt DateTime?
  raw        Json?
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, modifiedAt])
}

/// Зеркало CRM-сделки Bitrix.
model BitrixDeal {
  id         String   @id @default(cuid())
  tenantId   String
  externalId String
  title      String?
  stageId    String?
  modifiedAt DateTime?
  raw        Json?
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, modifiedAt])
}

/// Зеркало CRM-лида Bitrix (crm.lead.list). ТЗ 2026-06-17.
model BitrixLead {
  id         String   @id @default(cuid())
  tenantId   String
  externalId String
  title      String?
  name       String?
  statusId   String?
  modifiedAt DateTime?
  raw        Json?
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, modifiedAt])
}

/// Заметка/активность CRM Bitrix (crm.timeline.comment / crm.activity). ТЗ 2026-06-17.
/// `kind` различает источник; `entityType`/`entityId` — к какой CRM-сущности привязана.
model BitrixCrmNote {
  id         String    @id @default(cuid())
  tenantId   String
  kind       String // 'comment' | 'activity'
  externalId String
  entityType String? // 'deal' | 'contact' | 'company' | 'lead'
  entityId   String?
  authorId   String? // Bitrix user id
  text       String?   @db.Text
  occurredAt DateTime?
  raw        Json?
  syncedAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, externalId])
  @@index([tenantId, occurredAt])
}
