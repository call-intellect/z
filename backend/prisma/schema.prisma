// Z — Prisma schema
// Источник: plans/tz/2026-05-08-mvp-fullstack-tz.md §1.3
//          plans/tz/2026-05-09-standalone-product.md
//          plans/tz/2026-05-09-ai-meeting-workspace.md
// Правило: ТОЛЬКО `prisma db push`. Никаких `prisma migrate*`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7: connection URL вынесен из schema.
  //   - CLI (db push / studio) берёт url из prisma.config.ts
  //   - рантайм — через driver adapter (PrismaPg) в PrismaService
  extensions = [pgvector(map: "vector")]
}

