model Meeting {
  id                    String        @id // ULID, генерится сервисом
  title                 String
  type                  MeetingType
  customPrompt          String?       @db.Text
  /// tenant: Org, которой принадлежит встреча. CRIT-3 (2026-05-23):
  /// переведено в NOT NULL после backfill-orgs-fase0 +
  /// tighten-meeting-tenant-not-null. Все legacy-NULL заполнены personal-Org
  /// владельца через `scripts/backfill-orgs-fase0.ts`.
  tenantId              String
  tenant                Org           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId               String
  owner                 User          @relation(fields: [ownerId], references: [id])
  cardId                String?
  card                  Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  roomName              String        @unique // равен id
  status                MeetingStatus @default(scheduled)
  startedAt             DateTime?
  endedAt               DateTime?
  failureReason         String?
  durationMs            Int?
  recapVersion          Int           @default(1)
  chaptersStatus        AiStepStatus  @default(none)
  tasksStatus           AiStepStatus  @default(none)
  embeddingsStatus      AiStepStatus  @default(none)
  /// Фаза 5 knowledge-core: статус v2-агентов (Tasks/Chapters/Summary над IdeaBlock).
  /// NULL = не запускался; 'queued'/'processing'/'ready'/'partial'/'failed'.
  /// Хранится строкой (а не enum'ом), чтобы было легко расширить без миграции.
  analyzeV2Status       String?
  /// Когда v2-агент завершил работу (последний раз).
  analyzeV2GeneratedAt  DateTime?
  /// Текст ошибки на failed/partial. Multi-line, агент пишет короткую сводку.
  analyzeV2Error        String?       @db.Text
  /// 2026-05-25 meeting-report-fast (ТЗ plans/tz/2026-05-25-meeting-report-split-from-block-ingest.md):
  /// статус «быстрого» отчёта пользователю (один LLM-вызов поверх сырого транскрипта).
  /// NULL = не запускался; 'processing'|'ready'|'failed'|'partial'.
  /// Независим от analyzeV2Status — два pipeline работают параллельно.
  reportFastStatus      String?
  /// Текст ошибки на failed/partial для `meeting-report-fast`.
  reportFastError       String?       @db.Text
  /// Когда `meeting-report-fast` завершил работу (последний раз).
  reportFastGeneratedAt DateTime?
  /// 2026-05-25 quality_score целиком из meeting-report-fast (ТЗ
  /// plans/tz/2026-05-25-meeting-report-split-from-block-ingest.md, ответ из
  /// прозрачного блока «quality_score»). Json-объект формы:
  /// `{ overallScore, categories: { preparation, structure, clarity, outcomes,
  /// engagement }, recommendations: Array<{ text, severity, category }>,
  /// strengths: string[] }`. Структуру задаёт `meeting-report-fast.prompt.ts`.
  /// Поле названо `reportFastQualityScore`, потому что относится именно к
  /// fast-цепочке; relation `qualityScore` ниже зарезервирован за отдельным
  /// воркером `ai.quality-score` (модель `MeetingQualityScore`). В Admin
  /// API/UI поле отдаётся под ключом `qualityScore`.
  reportFastQualityScore Json?
  /// Автоматически вести запись при старте встречи. Если true — запись стартует
  /// при подключении хоста; ручное управление записью в комнате недоступно.
  recordByDefault       Boolean       @default(true)
  /// Статус расчёта поведенческих метрик (воркер ai.behavior-metrics).
  /// NULL = не запускался; 'pending'|'ready'|'failed'|'low_confidence'.
  behaviorMetricsStatus String?
  /// Статус AI-оценки качества встречи (воркер ai.quality-score).
  /// NULL = не запускался; 'pending'|'ready'|'failed'|'disabled'.
  qualityScoreStatus    String?
  createdAt             DateTime      @default(now())
  deletedAt             DateTime?

  participants     Participant[]
  recording        Recording?
  transcript       Transcript?
  aiResult         AiResult?
  /// Фаза B — one-to-one с MeetingBehaviorMetrics (метрики поведения участников).
  behaviorMetrics  MeetingBehaviorMetrics?
  /// Фаза C — one-to-one с MeetingQualityScore (AI-оценка качества).
  qualityScore     MeetingQualityScore?
  events           MeetingEvent[]
  tasks            Task[]
  chapters         MeetingChapter[]
  highlights       MeetingHighlight[]
  shares           MeetingShare[]
  transcriptChunks MeetingTranscriptChunk[]
  chatMessages     MeetingChatMessage[]
  roomMessages     MeetingRoomMessage[]
  meetingTags      MeetingTag[]
  /// Фаза 0a — Decision'ы, источник которых эта встреча (Фаза 0b extraction).
  decisions        Decision[]               @relation("DecisionSourceMeeting")
  /// Фаза E — дополнительные («custom») AI-отчёты, сгенерированные по выбранным
  /// шаблонам поверх той же встречи. Primary-отчёт остаётся в `aiResult`
  /// (one-to-one). См. plans/tz/2026-05-21-phase-E-multi-report-per-meeting.md.
  customReports    MeetingReport[]

  /// Tracker Phase 1 (2026-05-24) — встреча могла быть запущена из задачи трекера.
  /// См. plans/tz/2026-05-23-tracker-phase-1-models-api.md (endpoint `POST /issues/:id/start-meeting`).
  /// NULL для встреч, не связанных с задачей.
  linkedIssueId String?
  linkedIssue   Issue?  @relation("MeetingLinkedIssue", fields: [linkedIssueId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([status, endedAt])
  @@index([deletedAt])
  @@index([cardId, createdAt])
  @@index([tenantId])
  @@index([linkedIssueId])
}

model Participant {
  id               String          @id @default(cuid())
