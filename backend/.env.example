# Runtime
NODE_ENV=
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=

# Redis
REDIS_URL=

# Auth (cookies + JWT)
JWT_SESSION_SECRET=
JWT_DEEP_LINK_SECRET=
COOKIE_DOMAIN=
PUBLIC_FRONTEND_URL=
SESSION_TTL_SECONDS=86400
DEEP_LINK_TTL_SECONDS=900

# LiveKit
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=

# TURN (builtin | external)
TURN_MODE=builtin
TURN_HOST=
TURN_PORT=
TURN_USERNAME=
TURN_PASSWORD=
TURN_TLS=true

# S3 (Selectel в prod, MinIO в dev)
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGNED_TTL_SECONDS=3600

# AI: Anthropic (основной LLM)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_USE_PROXY=false
ANTHROPIC_PROXY_URL=https://proxy.agent-lia.ru

# AI: Vox (ASR)
VOX_API_URL=https://vox.agent-lia.ru
VOX_API_TOKEN=
VOX_MODEL=v3_rnnt
VOX_LANGUAGE=ru
VOX_PUNCTUATION_MODE=pro

# AI: OpenAI (fallback / proxy совместимый)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# AI: DeepSeek
DEEPSEEK_API_KEY=

# AI: MiniMax (anthropic-совместимый эндпоинт)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# AI: GRSAI
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsaiapi.com

# AI: Kie
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai

# AI: общий прокси
PROXY_BASE_URL=https://proxy.agent-lia.ru/v1
PROXY_PREFIX=myFeedproxy3128

# Crossmark integration
CROSSMARK_HMAC_TIMESTAMP_WINDOW_SECONDS=300

# Retention
DEFAULT_RETENTION_DAYS=30
RETENTION_CRON=0 * * * *

# Idle meeting cron
IDLE_MEETING_TIMEOUT_MINUTES=15
IDLE_MEETING_CRON=*/1 * * * *

# Quotas / safety
MAX_PARTICIPANTS_PER_MEETING=10
MAX_MEETING_DURATION_HOURS=8

# Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_SESSION_TTL_SECONDS=43200

# ============================================================
# Standalone-product (2026-05-09): аккаунты + почта
# ============================================================

# Узкий cookie-домен для standalone-логина. Опц — fallback на COOKIE_DOMAIN.
COOKIE_STANDALONE_DOMAIN=

# Argon2id параметры (OWASP defaults для 2024).
ARGON_MEMORY_KB=19456
ARGON_ITERATIONS=2
ARGON_PARALLELISM=1

# SMTP (mail.hosting.reg.ru). Заполнить логин/пароль для prod.
MAIL_HOST=mail.hosting.reg.ru
MAIL_PORT=465
MAIL_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@crossmark.ru
MAIL_FROM_NAME=Z
# В dev/test поставить true — письма не отправляются, логируются в Pino.
MAIL_DRY_RUN=false

# ============================================================
# AI Meeting Workspace (2026-05-09)
# ============================================================

# Embeddings для cross-meeting RAG (text-embedding-3-small по умолчанию).
EMBEDDING_PROVIDER=openai-via-proxy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_PROXY_API_KEY=
OPENAI_PROXY_EMBEDDINGS_URL=https://proxy.agent-lia.ru/v1/embeddings
EMBEDDING_FALLBACK_LOCAL_URL=
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CHUNK_TARGET_TOKENS=400
EMBEDDING_CHUNK_OVERLAP_TOKENS=50

# Outgoing webhooks: 32 байта (256 бит) в base64 для AES-GCM-256.
# Сгенерировать: openssl rand -base64 32
WEBHOOK_SECRETS_ENCRYPTION_KEY=
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
# CSV whitelist хостов для webhook-доставки (пусто = все, кроме приватных CIDR).
WEBHOOK_EGRESS_ALLOWED_HOSTS=

# Retention extras (дни).
SOFT_DELETE_GRACE_DAYS=30
WEBHOOK_DELIVERY_RETENTION_DAYS=30
SHARE_VIEW_RETENTION_DAYS=90
API_ACCESS_LOG_RETENTION_DAYS=30

# Лимиты ai-workspace.
CLIP_MAX_DURATION_SECONDS=300
EXPORT_ZIP_MAX_MEETINGS=100
EXPORT_ZIP_MAX_SIZE_BYTES=21474836480

MAX_API_KEYS_PER_USER=10
MAX_WEBHOOK_SUBSCRIPTIONS_PER_USER=20
MAX_DESTINATIONS_PER_USER=20
MAX_TAGS_PER_USER=50
MAX_USER_TEMPLATES_PER_USER=20

MAX_CHAT_REQUESTS_PER_DAY=200
MAX_CHAT_TOKENS_PER_DAY=2000000
MAX_RENDER_JOBS_PER_HOUR=10
MAX_BULK_EXPORTS_PER_DAY=5
MAX_REGENERATE_PER_MEETING_PER_DAY=5
MAX_MEETINGS_CREATED_PER_DAY_VIA_API=100
MAX_EMBEDDING_TOKENS_PER_MONTH_PER_USER=10000000

MAX_HIGHLIGHTS_PER_MEETING=50
MAX_BULK_OPERATION_IDS=200
MAX_CHAT_MESSAGE_CHARS=8000

# Daily-rotated salt для anti-cheat подсчёта view (ipHash). Хранить в secret-storage.
IP_HASH_DAILY_SALT=

# Шеринг (длительность ссылок).
SHARE_TOKEN_LENGTH_BYTES=24
SHARE_DEFAULT_EXPIRATION_DAYS=7
SHARE_ALLOWED_EXPIRATION_DAYS=1,7,14

# In-meeting room chat (meeting-room-chat ��)
MAX_ROOM_MESSAGE_CHARS=2000

# AI pipeline feature flags
INCLUDE_ROOM_CHAT_IN_AI=true

# ── Tracker (Sprint 1 — D-1.1) ──────────────────────────────────────────────
# Параметры tracker-модуля. См. backend/src/common/config/env.schema.ts
# (TrackerSchema) и backend/README.md → секция «ENV / Конфигурация».
WEBHOOK_HMAC_PREFIX=kora_wh_
TRACKER_INGEST_QUEUE=core.raw-events
IDEMPOTENCY_KEY_TTL_SECONDS=86400
TRACKER_WEBHOOK_MAX_RETRIES=5
TRACKER_WEBHOOK_RETRY_BACKOFF_INITIAL_MS=60000
