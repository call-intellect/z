// ──────────────────────────── ai-workspace: tasks / chapters / highlights ────────────────────────────

model Task {
  id               String     @id @default(cuid())
  /// tenant: Org, к которой принадлежит задача. После backfill — NOT NULL.
  tenantId         String?
  tenant           Org?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// D5 (ТЗ 2026-06-11 chatbox-tasks): задача может быть из переписки, не только
  /// из встречи → nullable. FK сохраняется (теперь nullable). Backfill: существующие → sourceType='meeting'.
  meetingId        String?
  meeting          Meeting?   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// meeting | chatbox (расширяемо строкой, не enum).
  sourceType       String     @default("meeting")
  /// ChatboxChatSession.id — если задача из переписки.
  sourceChatSessionId String?
  /// ChatboxChat.id (денорм, для drill-down/ссылки на чат).
  sourceChatId     String?
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?    @db.Text
  status           TaskStatus @default(open)
  assigneeRaw      String?
  /// ТЗ 2026-05-25 hard-participant-identification: жёсткая связь с User,
  /// заполняется AI-pipeline (через resolve по participants встречи).
  /// onDelete=SetNull: при удалении User'а assigneeUserId сбрасывается,
  /// но Task остаётся (assigneeRaw сохраняет историческую строку).
  assigneeUserId   String?
  assignee         User?      @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  dueDate          DateTime?
  sourceStartMs    Int?
  sourceEndMs      Int?
  sourceQuote      String?    @db.Text
  confidence       Float?
  createdManually  Boolean    @default(false)
  /// Фаза 5 knowledge-core: какие IdeaBlock'и породили задачу (для drill-down).
  /// Пустой массив = legacy задача, не связана с блоками.
  evidenceBlockIds String[]   @default([])
  /// Денорм deepLink/attribution провенанса (Task уже несёт sourceQuote/sourceStartMs).
  previewSourceRef Json?
  /// Фаза 5: метка генератора. NULL = legacy `tasks-extract.worker`,
  /// 'v2' = `meeting-analyze-v2.worker` (knowledge-core поверх блоков).
  /// Используется для A/B-сравнения и для последующего скимаринга legacy.
  extractorVersion String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  /// D5/Р-2 — дополнительные источники задачи (межисточниковый дедуп).
  sources          TaskSource[]

  @@index([userId, status])
  @@index([meetingId])
  @@index([dueDate])
  @@index([tenantId])
  /// Индекс для фильтра «мои задачи» по assigneeUserId.
  @@index([assigneeUserId])
  @@index([tenantId, sourceType])
  @@index([sourceChatSessionId])
}

/// D5/Р-2 (ТЗ 2026-06-11 chatbox-tasks) — дополнительные источники задачи.
/// Первичный источник остаётся на Task.*; сюда пишем КАЖДУЮ привязку при
/// межисточниковом дедупе (след не теряем). Идемпотентность — @@unique.
model TaskSource {
  id          String   @id @default(cuid())
  tenantId    String
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId     String?
  issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  /// meeting | chatbox
  sourceType  String
  /// meetingId | chatSessionId
  sourceRefId String
  /// ChatboxChat.id (денорм, опц.)
  chatId      String?
  /// фрагмент-доказательство из источника
  quote       String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([taskId, sourceType, sourceRefId])
  @@unique([issueId, sourceType, sourceRefId])
  @@index([tenantId, sourceType, sourceRefId])
  @@index([tenantId, issueId])
}

model MeetingChapter {
