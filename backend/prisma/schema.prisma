  @@unique([tenantId, name])
  @@index([tenantId, severity])
  @@index([tenantId, status])
  @@index([tenantId, scope])
  @@index([tenantId, ownerPersonId])
  @@index([currentVersionId])
  @@index([tenantId, deletedAt])
  @@map("policies")
}

/// Tool — инструмент / система / шаблон (Фаза 0a, группа Б).
model Tool {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   @db.VarChar(200)
  kind        ToolKind @default(software)
  externalUrl String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tools")
}

/// Metric — метрика (Фаза 0a, группа Б).
model Metric {
  id          String          @id @default(cuid())
  tenantId    String
  name        String          @db.VarChar(200)
  description String?         @db.Text
  unit        String          @db.VarChar(50)
  target      Float?
  valueType   MetricValueType @default(count)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  /// SBA α-8 wave 3 (2026-05-23) — KPI расширение Metric.
  /// Metric становится KPI, когда заполнен хотя бы один из `attachedTo*Id`.
  /// См. sub-ТЗ plans/tz/2026-05-23-sba-alpha-8-wave3-appointment-kpi.md §5.
  attachedToResponsibilityElementId String?
  attachedToRoleId                  String?
  attachedToDepartmentId            String?
  /// Текущее значение KPI (последнее измерение). Обновляется через PATCH /kpi/:id/measurement.
  currentValue                      Decimal?  @db.Decimal(18, 4)
  /// Единица текущего значения (может отличаться от `unit` базы, например % vs шт.).
  currentValueUnit                  String?   @db.VarChar(50)
  /// Когда последний раз обновляли currentValue.
  lastMeasuredAt                    DateTime?
  /// Периодичность обновления: 'daily' | 'weekly' | 'monthly' | 'quarterly' | 'adhoc'.
  frequency                         String?   @db.VarChar(20)

  org                   Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SBA α-8 wave 3 — KPI relations.
  responsibilityElement ResponsibilityElement? @relation(fields: [attachedToResponsibilityElementId], references: [id], onDelete: SetNull)
  attachedRole          Role?                  @relation("MetricToRole", fields: [attachedToRoleId], references: [id], onDelete: SetNull)
  attachedDepartment    Department?            @relation("MetricToDepartment", fields: [attachedToDepartmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId])
  /// SBA α-8 wave 3 — KPI lookup-индексы.
  @@index([tenantId, attachedToRoleId])
  @@index([tenantId, attachedToDepartmentId])
  @@index([tenantId, attachedToResponsibilityElementId])
  @@map("metrics")
}

/// Decision — решение, принятое в компании.
///
/// Фаза 0a (legacy): простая запись со `text`, `decidedByPersonId`, `sourceIdeaBlockId`.
///
/// SBA β-3 — расширение in-place до полноценного «реестра решений» с rationale,
/// alternatives, supersede-цепочками, evolving-конфликтами и probe-triggers.
/// См. plans/tz/2026-05-21-sba-beta-3-specialist-3-3-decisions.md §4.
///
/// Все новые Decision'ы создаются специалистом 3.3 (decision-detector worker)
/// со `statement` (структурированная суть решения), `rationale` (почему),
/// `alternatives` (рассмотренные варианты), `decidedByPersonIds[]` (авторы),
/// `affectsEntityIds[]` (Project/Customer/Vendor/Product на которые влияет),
/// `supersedesId` (если новая версия старого), `validFrom/validUntil` (для
/// evolving-резолюции).
///
/// Legacy-поля (text, decidedByPersonId, sourceMeetingId, sourceIdeaBlockId)
/// оставлены nullable для обратной совместимости. Новые Decision'ы пишут
/// `statement` (а `text` дублирует первые 1000 символов для legacy-чтения).
model Decision {
  id             String  @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  // ── legacy Фазы 0a (оставлены для совместимости; в β-3 необязательны) ──
  /// @deprecated SBA β-3: используй `statement`. Заполняется автоматически
  /// для обратной совместимости (первые 1000 символов из `statement`).
  text              String? @db.Text
  /// Legacy: один decidedByPerson. В β-3 — `decidedByPersonIds[]` (массив).
  decidedByPersonId String?
  /// Legacy: один источник встречи. В β-3 — берём из sourceBlockIds + RawEvent.
  sourceMeetingId   String?
  /// Legacy: один блок-источник. В β-3 — `sourceBlockIds[]` (массив).
  sourceIdeaBlockId String? @unique

  // ── SBA β-3 — Specialist 3.3 (Decisions Registry) ──
  /// Связка с графом (создаётся при canonical). Уникален — один Entity на Decision.
  entityId           String?                      @unique
  /// Структурированная суть решения. Главное поле для дедупа и retrieval'а.
  statement          String?                      @db.Text
  /// Почему так решили — главный источник для Skill (γ-1) и Insights (β-4).
  rationale          String?                      @db.Text
  /// Json-массив рассмотренных альтернатив: [{ option: '...', reasonRejected: '...' }, ...].
  /// Решение по §14.2: массив Json пока, отдельная таблица — γ+.
  alternatives       Json?
  /// Авторы решения (Person.id[]). Решение по §14.1: массив с GIN, join-таблица — γ+.
  decidedByPersonIds String[]                     @default([])
  /// Когда решение было принято (отдельно от createdAt — может быть исторический import).
  decidedAt          DateTime?
  /// Срок исполнения. probe `decision.overdue` если deadline < now AND status NOT IN
  /// ('implemented','cancelled').
  deadline           DateTime?
  /// Self-relation supersede: если этот Decision — новая версия старого.
  supersedesId       String?
  /// Entities (Customer/Project/Vendor/Product/Process), на которые влияет решение.
  /// Массив с GIN — §14.1 (миграция в join-таблицу γ+).
  affectsEntityIds   String[]                     @default([])
  /// IdeaBlock'и, на которых построено решение.
  sourceBlockIds     String[]                     @default([])
  /// Денорм-снимок провенанса для рендера списков без join (образец Task.sourceQuote).
  previewQuote       String?                      @db.Text
  /// { evidenceId, blockId, sourceType, sourceExternalId, startMs?, deepLink, attribution }
  previewSourceRef   Json?
  /// Person'ы, упомянутые в блоках как subject (для γ-1 SkillProfile).
  personSubjectIds   String[]                     @default([])
  /// Уверенность извлечения [0..1] (Decimal(4,3) — 3 знака после точки).
  confidence         Decimal?                     @db.Decimal(4, 3)
  /// Класс данных. Default 'sensitive' — решения чаще всего стратегические.
  dataClass          DataClass                    @default(sensitive)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (policyVersion + sources).
  /// Заполняется Specialist 3.3 в enforce-режиме; читается snapshot-cron'ом.
  dataClassAudit     Json?
  /// Последняя активная CardVersion (после triage).
  currentVersionId   String?
  /// Эмбеддинг (statement + rationale preview) — для KNN-дедупа.
  embedding          Unsupported("vector(1536)")?
  /// Для evolving: с какого момента решение действительно.
  validFrom          DateTime?
  /// Для evolving: до какого момента (если superseded — заполняется в момент supersede).
  validUntil         DateTime?
  /// Фактические результаты (заполняется ретроспективно).
  /// probe `decision.outcome_unknown` если implemented + null + > 3 мес.
  actualOutcomes     String?                      @db.Text
  /// SBA β-3 доделка (2026-05-23): FK на DecisionPolicy (α-8 wave 2).
  /// Если решение применяет конкретную политику — ссылка для аудита соответствия.
  appliedPolicyId    String?

  status          DecisionStatus @default(approved)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Когда решение последний раз подтверждали (актуально, не устарело).
  lastConfirmedAt DateTime?
  /// Pulse Wave 1 §1.2 (2026-05-30) — счётчик «сколько раз решение
  /// поднималось» (создание + каждое последующее упоминание detect'нутое
  /// specialist-3-3 как verdict='merge'). Default 1 (само создание).
  raisedCount     Int            @default(1)
  /// Pulse Wave 1 §1.2 — последний раз когда решение было упомянуто.
  /// При создании = createdAt; при verdict='merge' = momentum merge'а.
  lastRaisedAt    DateTime?
  /// Pulse Wave 6 §6.8 — Bezos two-way door classification:
  /// 'type-1' = необратимое (large investments, hiring senior, public
  /// commitments); 'type-2' = обратимое.
  /// Считается `DecisionHygieneScorerWorker` (`dashboard.decision-hygiene`)
  /// на каждое новое Decision. NULL до прогона. Хранится строкой —
  /// при расширении словаря не потребует миграции.
  reversibility   String?
  /// Когда `DecisionHygieneScorerWorker` последний раз проставил
  /// `reversibility`.
  reversibilityAt DateTime?

  /// TZ-1 Фаза 3.B (daily-value-engine) — денормализованный счётчик связанных
  /// задач (строк DecisionTaskLink). Обновляется backfill'ом и воркером.
  /// 0 + actualOutcomes IS NULL + старше N дней → контролёр помечает 'stalled'.
  linkedTaskCount         Int       @default(0)
  /// TZ-1 Фаза 3.B — статус внедрения: 'not_started'|'in_progress'|'done'|
  /// 'stalled'. NULL до первого прогона контролёра.
  implementationStatus    String?   @db.VarChar(24)
  /// TZ-1 Фаза 3.B — когда контролёр (`DecisionImplementationCron`) последний
  /// раз проверял внедрение решения.
  implementationCheckedAt DateTime?

  deletedAt       DateTime?
  deletedById     String?

  org             Org                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decidedBy       Person?            @relation("DecisionDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: SetNull)
  sourceMeeting   Meeting?           @relation("DecisionSourceMeeting", fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  sourceIdeaBlock IdeaBlock?         @relation(fields: [sourceIdeaBlockId], references: [id], onDelete: SetNull)
  // SBA β-3: self-relation supersede + CardVersion-current.
  supersedes      Decision?          @relation("DecisionSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    Decision[]         @relation("DecisionSupersedes")
  currentVersion  CardVersion?       @relation("DecisionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  appliedPolicy   DecisionPolicy?    @relation("DecisionAppliedPolicy", fields: [appliedPolicyId], references: [id], onDelete: SetNull)
  /// TZ-1 Фаза 3.B — связи решение↔задача (join DecisionTaskLink).
  taskLinks       DecisionTaskLink[] @relation("DecisionTaskLinkDecision")
  /// ТЗ idea-vs-decision (2026-06-20) — идеи, повышенные в это решение (realized_as).
  realizedFromIdeas Idea[]           @relation("IdeaRealizedAsDecision")

  @@index([tenantId, status])
  @@index([tenantId, decidedAt])
  @@index([tenantId, decidedByPersonId])
  // SBA β-3 — для overdue probe.
  @@index([tenantId, deadline])
  // SBA β-3 — для supersede-chain lookup.
  @@index([supersedesId])
  // SBA β-3 — для currentVersionId.
  @@index([currentVersionId])
  @@index([tenantId, deletedAt])
  @@map("decisions")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA β-4 — Specialist 3.5 (Insights Radar)
// Источник: plans/tz/2026-05-21-sba-beta-4-specialist-3-5-insights.md §4
//
// Idea: повторяющиеся pain/risk/churn_risk/objection блоки кластеризуются в
// Insight (KNN cosine). Динамика считается по rolling-окнам (7d vs 30d).
// Linking с Decision: «эта проблема — следствие решения X» (relatedDecisionIds[]).
// ─────────────────────────────────────────────────────────────────────────
model Insight {
  id             String  @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  /// Опциональная связка с графом (создаётся при canonical). Уникален.
  entityId       String? @unique

  /// Тип сигнала. Сопоставляется с signalType блоков-источников.
  kind      InsightKind
  /// Суть сигнала одной строкой («Клиенты жалуются на медленную загрузку отчётов»).
  statement String          @db.Text
  /// Острота сигнала. severity='critical' → triage с заведомо низкой confidence
  /// (force deep review).
  severity  InsightSeverity @default(medium)

  /// Частота упоминаний за окно (нормализованная 0..1; считает Specialist35Service.recalcMetrics).
  frequencyScore Decimal        @default(0) @db.Decimal(6, 3)
  /// Сырое значение ratio 7d_count / 30d_avg_weekly. > spike-порога → spike.
  dynamicScore   Decimal        @default(0) @db.Decimal(6, 3)
  /// Текстовая метка динамики (для UI и сортировки радара).
  dynamicLabel   InsightDynamic @default(stable)

  /// Entities (Customer/Project/Vendor/Product/Process/...) на которые влияет сигнал.
  affectedEntityIds  String[] @default([])
  /// Decision'ы, которые могли спровоцировать сигнал (linking через LLM и
  /// существующий IdeaBlockLink.relationType='consequences_of').
  relatedDecisionIds String[] @default([])
  /// Текстовый план реагирования (в β-4 — текст; структурируем в γ+).
  mitigationPlan     String?  @db.Text
  /// SBA β-4 доделка (2026-05-23): категория первопричины (LLM ставит,
  /// curator подтверждает). Строкой для гибкости. Примеры:
  /// 'process_gap' | 'tooling' | 'role_skill' | 'communication' | 'priority' |
  /// 'resource_constraint' | 'external' | 'unknown'.
  /// Используется в δ-2 ProactiveWatcher для приоритизации alert'ов и в
  /// γ-2 Concierge для агрегации «частые причины проблем».
  causeCategory      String?  @db.VarChar(40)

  /// Первое и последнее упоминание (для probe.no_mitigation_plan по age > 7d).
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())

  /// Статус карточки.
  status InsightStatus @default(active)

  /// IdeaBlock'и, на которых построен сигнал.
  sourceBlockIds   String[]                     @default([])
  /// Person'ы, упомянутые в блоках как subject (например, кто жаловался).
  personSubjectIds String[]                     @default([])
  /// Уверенность extraction [0..1] (Decimal(4,3)).
  confidence       Decimal                      @default(0.5) @db.Decimal(4, 3)
  /// Класс данных. Default 'internal' (sub-ТЗ — Insight чаще про процесс,
  /// чем про конкретного человека).
  dataClass        DataClass                    @default(internal)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (policyVersion + sources).
  /// Заполняется Specialist 3.5 в enforce-режиме; читается snapshot-cron'ом.
  dataClassAudit   Json?
  /// Последняя активная CardVersion (после triage).
  currentVersionId String?
  /// Эмбеддинг (statement) — для KNN-кластеризации.
  embedding        Unsupported("vector(1536)")?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Когда последний раз подтверждали актуальность.
  lastConfirmedAt DateTime?

  org            Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentVersion CardVersion? @relation("InsightCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  // SBA β-4 — частые фильтры радара.
  @@index([tenantId, status, severity])
  @@index([tenantId, kind])
  @@index([tenantId, dynamicLabel])
  @@index([tenantId, lastObservedAt])
  // SBA β-4 wave 2 (2026-05-23) — фильтр виджета «Топ-5» Director Dashboard
  // и master-detail радара по категории первопричины.
  @@index([tenantId, causeCategory])
  // SBA β-4 — для currentVersionId.
  @@index([currentVersionId])
  @@map("insights")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA β-5 — Specialist 3.6 (Ideas Collector) + Layer 6 (Probe-Agent)
// Источник: plans/tz/2026-05-21-sba-beta-5-specialist-3-6-ideas-and-layer6-probe.md
//
// Idea: блоки signalType ∈ {idea, feature_request} кластеризуются в Idea
// (kind='internal' если предложил сотрудник, 'client_request' — если клиент).
// Cosine-KNN дедуп. Кластеры идей (IdeaCluster) — следующий уровень
// группировки смежных идей.
// ─────────────────────────────────────────────────────────────────────────

/// Вид идеи. `internal` — предложение сотрудника. `client_request` — запрос
/// клиента / партнёра, извлечённый из встречи / переписки.
enum IdeaKind {
  internal
  client_request
}

/// Статус Idea. Lifecycle: captured → in_discussion → accepted → in_progress →
/// shipped. Альтернативные исходы: rejected (отказались), archived (автор
/// withdrew или нерелевантно).
enum IdeaStatus {
  captured
  in_discussion
  accepted
  in_progress
  shipped
  rejected
  archived
}

/// Статус ProbeEvent. `pending` — создано, ждёт dispatcher'а. `dispatched` —
/// отправлено через ConversationalService. `dropped_dedup` / `dropped_rate_limit`
/// / `dropped_cold_start` — отброшено по соответствующей причине. `expired` —
/// истёк срок жизни (probe.expiresAt в прошлом).
enum ProbeStatus {
  pending
  dispatched
  dropped_dedup
  dropped_rate_limit
  expired
  dropped_cold_start
  /// W4.3 — outbound canEmit заблокировал доставку (и in_app fallback тоже rejected).
  /// Видно в `/admin/policy/dataclass` → «История нарушений».
  dropped_dataclass_gate
  /// Probe Фаза 3 — deferrable-probe сверх бюджета отложен в батч-дайджест
  /// (вместо dropped_rate_limit). ProbeDigestCron соберёт и пометит dispatched.
  queued_digest
  /// Probe Фаза 4 — повод закрылся сам между suggest и dispatch (recheck
  /// предикатом PROBE_REASON_RECHECK показал, что пробел уже не актуален).
  suppressed_stale
  /// W2 autonomy (2026-06-12) — гейт ценности: priority ниже крутилки
  /// `probe.minValuePriority` → вопрос не задаётся (audit-запись).
  dropped_low_value
  /// W2 autonomy (2026-06-12) — NUDGE-политика (§9.2): напоминание-NUDGE
  /// не пингует сразу, а уходит ежедневным батч-дайджестом (ProbeDigestCron).
  /// Отличие от queued_digest (rate-limit) — для аудита источника отложки.
  routed_to_digest
}

/// Idea — карточка идеи / запроса. SBA β-5 §4.1.
///
/// Аггрегирует supporter'ов (Person — сотрудники, Customer — клиенты) через
/// JSON-массив `supporters`. `weight` — композитный score:
/// `supporterCount * 1.0 + recency_factor * 0.5 + specificity_factor (0.5..1)`.
///
/// Closing loop: при изменении `status` (через REST API) специалист эмитит
/// EventEmitter событие 'idea.status_changed' → handler уведомляет supporter'ов.
model Idea {
  id                    String                       @id @default(cuid())
  tenantId              String
  /// Опц. связка с графом (создаётся при canonical). Уникален.
  entityId              String?                      @unique
  kind                  IdeaKind
  statement             String                       @db.Text
  rationale             String?                      @db.Text
  weight                Decimal                      @default(0) @db.Decimal(6, 3)
  supporterCount        Int                          @default(1)
  /// JSON-массив supporter'ов: `[{ kind: 'person'|'customer', entityId,
  /// firstSupportedAt: ISO, blockId? }, ...]`.
  supporters            Json                         @default("[]")
  firstProposedAt       DateTime                     @default(now())
  lastDiscussedAt       DateTime                     @default(now())
  status                IdeaStatus                   @default(captured)
  statusChangedAt       DateTime?
  statusChangedByUserId String?
  statusReason          String?                      @db.Text
  clusterId             String?
  sourceBlockIds        String[]                     @default([])
  personSubjectIds      String[]                     @default([])
  confidence            Decimal                      @default(0.5) @db.Decimal(4, 3)
  dataClass             DataClass                    @default(internal)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (policyVersion + sources).
  dataClassAudit        Json?
  currentVersionId      String?
  embedding             Unsupported("vector(1536)")?
  /// Author User.id — кто первый запостил блок-источник (если идея от
  /// сотрудника). NULL — клиентская идея или не определилось.
  createdByUserId       String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  /// Goals OKR v2 (2026-06-02) — гипотеза, двигающая цель (развилка 2).
  goalId String?
  goal   Goal?   @relation("IdeaGoal", fields: [goalId], references: [id], onDelete: SetNull)

  /// ТЗ idea-vs-decision (2026-06-20, форма 5a) — идея повышена в это решение
  /// (realized_as) при акте принятия/сверке. NULL — ещё не реализована.
  realizedAsDecisionId String?
  realizedAs           Decision? @relation("IdeaRealizedAsDecision", fields: [realizedAsDecisionId], references: [id], onDelete: SetNull)

  org            Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cluster        IdeaCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  currentVersion CardVersion? @relation("IdeaCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, kind])
  @@index([tenantId, weight])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, clusterId])
  @@index([currentVersionId])
  @@index([tenantId, goalId])
  @@index([tenantId, realizedAsDecisionId])
  @@map("ideas")
}

/// IdeaCluster — кластер смежных идей (как Theme для блоков). SBA β-5 §4.1.
///
/// Кластеризация через `idea-clusterer.cron`: KNN cosine на embedding'е
/// existing IdeaCluster'ов; на miss — LLM-арбитр (`idea-cluster-merge`).
/// Минимальный размер — `IDEA_MIN_SUPPORTERS_FOR_CLUSTER` (default 2).
model IdeaCluster {
  id            String                       @id @default(cuid())
  tenantId      String
  name          String
  description   String?                      @db.Text
  ideaIds       String[]                     @default([])
  clusterWeight Decimal                      @default(0) @db.Decimal(6, 3)
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  org   Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ideas Idea[]

  @@index([tenantId])
  @@map("idea_clusters")
}

/// ProbeEvent — запись очереди Probe-Agent (Слой 6). SBA β-5 §4.2.
///
/// Создаётся `ProbeService.suggest(...)` — внутренний API для специалистов
/// Слоя 3. После dedup / rate-limit / cold-start checks попадает в БД с
/// `status='pending'` и job в `core.probe-events`. Dispatcher выбирает
/// recipient'а, формулирует вопрос через LLM `probe-formulate`, отправляет
/// через `ConversationalService.sendNotification(eventType='probe.question')`.
///
/// `contentHash` — sha256(reason + JSON.stringify(payload.contextIds)) для
/// дедупа (Redis-кеш TTL=72h + DB-уникальность хеша в рамках tenant).
model ProbeEvent {
  id                       String      @id @default(cuid())
  tenantId                 String
  emittedByService         String      @db.VarChar(80)
  reason                   String      @db.VarChar(100)
  payload                  Json
  recipientCandidates      String[]    @default([])
  selectedRecipientId      String?
  status                   ProbeStatus @default(pending)
  dispatchedNotificationId String?
  contentHash              String      @db.VarChar(80)
  priority                 Int         @default(50)
  createdAt                DateTime    @default(now())
  dispatchedAt             DateTime?
  expiresAt                DateTime?
  notBeforeAt              DateTime?
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass probe-payload'а
  /// (для compliance — мы храним вопрос-предложение, иногда чувствительный).
  dataClassAudit           Json?

  /// Ф4 (2026-06-17) — эмбеддинг сформулированного/исходного вопроса для
  /// семантического дедупа близких по смыслу probe (а не только точного content-hash).
  questionEmbedding Unsupported("vector(1536)")?

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, emittedByService])
  @@index([contentHash])
  @@map("probe_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Фаза A.1 — Prompt Registry
// Источник: plans/tz/2026-05-21-phase-A-prompt-registry-admin.md §4
//
// Идея: все 9 системных промптов AI-отчёта (по типам встреч) + tasks /
// chapters / follow-up / card-rollup переезжают в БД как `PromptTemplate`
// с версионированием через `PromptTemplateVersion`. Файлы
// `backend/src/modules/ai/services/prompts/type-*.ts` остаются в коде
// как fallback и НЕ удаляются. Резолв и выбор источника промпта живёт
// в `PromptResolverService`.
// ─────────────────────────────────────────────────────────────────────────

/// Шаблон промпта AI-отчёта. Может быть системным (поставляется с Z) или
/// созданным Org-Admin'ом. В рамках Org `key` уникален; для system orgId=null
/// и `key` уникален глобально.
///
/// `activeVersionId` ссылается на текущую активную `PromptTemplateVersion`.
/// Менять активную версию — через `POST /admin/prompt-templates/:id/activate-version/:versionId`
/// (см. A.2). В A.1 endpoint'ов нет — только модель + seed.
model PromptTemplate {
  id              String               @id @default(cuid())
  scope           PromptTemplateScope
  /// NULL для scope='system'; обязателен для scope='org' (валидируется в сервисе).
  orgId           String?
  /// Уникальный slug, e.g. 'type-sales', 'tasks-default', 'custom-sales-deep-dive'.
  key             String
  name            String
  description     String?              @db.Text
  /// Если задан — шаблон используется только для этого типа встречи.
  /// NULL = универсальный (например, tasks/chapters/follow-up для всех типов).
  meetingType     MeetingType?
  /// Legacy LLM taskType: 'summary' | 'tasks' | 'chapters' | 'follow-up' | 'card-rollup'.
  /// Хранится как String, чтобы расширяться без миграций enum'а.
  taskType        String
  status          PromptTemplateStatus @default(draft)
  /// Текущая активная версия (FK на PromptTemplateVersion). NULL до первого save.
  activeVersionId String?              @unique
  /// Флаг safe-seed: true = шаблон редактировался админом, при повторном запуске seed'а
  /// не перезаписываем содержимое. Защита от потери ручных правок (skill `safe-seed-rules`).
  editedByAdmin   Boolean              @default(false)
  createdById     String
  createdBy       User                 @relation("PromptTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  org            Org?                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions       PromptTemplateVersion[] @relation("PromptTemplateVersions")
  activeVersion  PromptTemplateVersion?  @relation("PromptTemplateActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  /// Фаза E — дополнительные («custom») отчёты встреч, созданные по этому шаблону.
  /// onDelete=Restrict на стороне MeetingReport: история отчётов жива даже после
  /// архивирования шаблона.
  meetingReports MeetingReport[]         @relation("MeetingReportTemplate")

  @@unique([orgId, key])
  @@index([scope, status])
  @@index([orgId, status])
  @@index([taskType, meetingType, status])
}

/// Версия шаблона промпта. На каждое «Сохранить как новую версию» в UI A.2
/// создаётся новая запись. История версий используется для отката и
/// сравнения через diff в UI.
model PromptTemplateVersion {
  id            String   @id @default(cuid())
  templateId    String
  /// Целочисленный номер версии (1, 2, 3...). Уникален в рамках шаблона.
  versionNumber Int
  /// Общая часть промпта (шапка system-message).
  systemPrompt  String   @db.Text
  /// Ожидаемая JSON-схема ответа (для structured-вывода через tool_use).
  /// Может включать `properties`, `required` — формат совместим с LlmTool.input_schema.
  outputSchema  Json
  /// Имя tool'а, который будет передан LLM при вызове (например, 'extract_sales').
  /// Используется для парсинга `toolCalls[].name` в analyze.worker. NULL = вызов без tool_use.
  toolName      String?
  createdById   String
  createdBy     User     @relation("PromptTemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  /// Свободный changelog от автора версии (см. ТЗ A §4.1).
  notes         String?  @db.Text

  template       PromptTemplate          @relation("PromptTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  asActiveOf     PromptTemplate?         @relation("PromptTemplateActiveVersion")
  sections       PromptTemplateSection[]
  aiResults      AiResult[]              @relation("from_prompt_version")
  experimentsAsA PromptExperiment[]      @relation("experiment_a")
  experimentsAsB PromptExperiment[]      @relation("experiment_b")
  /// Фаза E — snapshot этой версии в MeetingReport: какая именно версия была
  /// использована при генерации (для воспроизводимости/диффа).
  meetingReports MeetingReport[]         @relation("MeetingReportVersion")

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

/// Раздел отчёта в рамках версии шаблона. До 30 разделов на версию
/// (валидируется в сервисе). В A.1 секции создаются seed'ом из существующих
/// type-*.ts: каждое поле SCHEMA = одна секция с outputType.
model PromptTemplateSection {
  id          String  @id @default(cuid())
  versionId   String
  /// Порядковый номер 1..30. Уникален в рамках версии.
  order       Int
  /// Slug секции для маппинга на ключ в JSON-ответе LLM.
  key         String
  title       String
  /// Инструкция LLM «что писать в этой секции».
  instruction String  @db.Text
  /// 'text' | 'bullet_list' | 'table' | 'json_object'. Хранится как String для расширяемости.
  outputType  String
  required    Boolean @default(true)
  /// Опциональный лимит maxTokens на секцию (см. валидатор в A.2).
  maxTokens   Int?

  version PromptTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@unique([versionId, order])
  @@index([versionId])
}

/// A/B-эксперимент между двумя версиями шаблонов. Реализация A.3.
/// В A.1 модель заводится только для FK-целостности и future-proof'а — резолвер
/// уже умеет читать experimentGroup, но активных экспериментов в A.1 не будет.
model PromptExperiment {
  id           String    @id @default(cuid())
  /// NULL = эксперимент системного шаблона (только super_admin); иначе Org-эксперимент.
  orgId        String?
  /// Версия A (control).
  templateAId  String
  /// Версия B (variant).
  templateBId  String
  /// Доля трафика на B, 0..100.
  splitPercent Int
  /// 'draft' | 'running' | 'stopped' | 'completed'.
  status       String    @default("draft")
  startedAt    DateTime?
  endsAt       DateTime?
  createdById  String
  createdBy    User      @relation("PromptExperimentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  notes        String?   @db.Text

  org       Org?                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateA PromptTemplateVersion @relation("experiment_a", fields: [templateAId], references: [id], onDelete: Restrict)
  templateB PromptTemplateVersion @relation("experiment_b", fields: [templateBId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@index([status])
}

/// Реакция пользователя (👍/👎) на AI-результат встречи. Заполняется
/// эндпоинтом A.3 `POST /api/v1/meetings/:meetingId/result/feedback`.
/// В A.1 модель заводится только для FK-целостности; UI/endpoint появляется в A.3.
model AiResultFeedback {
  id         String   @id @default(cuid())
  aiResultId String
  userId     String
  /// 'positive' | 'negative'.
  reaction   String
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  aiResult AiResult @relation(fields: [aiResultId], references: [id], onDelete: Cascade)
  user     User     @relation("AiResultFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([aiResultId, userId])
  @@index([aiResultId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Фаза E — несколько AI-отчётов на одну встречу
// ─────────────────────────────────────────────────────────────────────────
// Источник: plans/tz/2026-05-21-phase-E-multi-report-per-meeting.md §4.
//
// Primary-отчёт (`AiResult`, под `Meeting.type`) остаётся как есть. `MeetingReport`
// хранит «дополнительные» отчёты, генерируемые on-demand по выбранному шаблону.
// Partial unique index `(meeting_id, prompt_template_id) WHERE status IN
// ('pending','running')` создаётся вручную через apply-postgres-init.sql —
// Prisma partial unique не поддерживает.

enum MeetingReportStatus {
  pending
  running
  ready
  failed
  archived
}

/// Дополнительный («custom») AI-отчёт встречи. Генерируется воркером
/// `ai.custom-report` по выбранному `PromptTemplate` + `PromptTemplateVersion`.
/// Снимок версии шаблона хранится в `promptTemplateVersionId` для
/// воспроизводимости: если шаблон позже изменили или архивировали — отчёт всё
/// равно показывает то, что было в момент генерации.
model MeetingReport {
  id                      String @id @default(cuid())
  meetingId               String
  /// tenant: Org, в которой принадлежит отчёт. Дублирует `meeting.tenantId`,
  /// чтобы admin-выборки/аудит не делали join.
  tenantId                String
  promptTemplateId        String
  promptTemplateVersionId String

  /// 'primary' | 'additional'. В рамках E все записи — 'additional';
  /// primary-отчёт показывается из `AiResult` синтетически. Колонка введена
  /// сразу, чтобы при будущей миграции primary в `MeetingReport` ничего не
  /// ломать в API-контракте.
  kind  String @default("additional")
  /// Снимок `PromptTemplate.name` в момент генерации (защита от ребрендинга
  /// шаблона позже).
  title String

  status        MeetingReportStatus @default(pending)
  /// JSON-вывод LLM по `PromptTemplateVersion.outputSchema`. NULL пока не ready.
  output        Json?
  /// Фактическая стоимость в USD (precision 4 знака после запятой).
  llmCostUsd    Decimal?            @db.Decimal(10, 4)
  llmDurationMs Int?
  errorMessage  String?

  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  /// Soft-delete: при DELETE выставляем `status='archived'` + `deletedAt=now()`.
  deletedAt   DateTime?

  meeting               Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  promptTemplate        PromptTemplate        @relation("MeetingReportTemplate", fields: [promptTemplateId], references: [id], onDelete: Restrict)
  promptTemplateVersion PromptTemplateVersion @relation("MeetingReportVersion", fields: [promptTemplateVersionId], references: [id], onDelete: Restrict)

  @@index([meetingId, status])
  @@index([meetingId, deletedAt])
  @@index([tenantId, createdAt])
  @@index([promptTemplateId])
  @@index([promptTemplateVersionId])
}

// ─────────────────────────────────────────────────────────────────────────
// SBA α-1 — Conversational Channels Foundation
// ─────────────────────────────────────────────────────────────────────────
// Источник: plans/tz/2026-05-21-sba-alpha-1-channels-foundation.md
//
// Двунаправленный омниканальный слой общения с человеком. InApp + Email
// — фундамент α-1. Telegram/MAX добавляются в β-1 расширением `ChannelKind`
// без правки моделей.

/// Тип канала. На α-1: `in_app`, `email_smtp`, `email_imap`. На β-1
/// добавляются `telegram_bot`, `max_bot`. На γ+: `slack`, `mattermost`,
/// `vk_messenger`, `whatsapp_business`, `web_push`, `voice_via_asr`.
enum ChannelKind {
  in_app
  email_smtp
  email_imap
  telegram_bot
  max_bot
}

/// Направление канала. Большинство каналов — bidirectional. Outbound-only
/// (`email_smtp`) есть; inbound-only (`email_imap`) появится с β-1.
enum ChannelDirection {
  inbound_only
  outbound_only
  bidirectional
}

enum ChannelStatus {
  active
  disabled
  broken
  /// β-9 (2026-05-25) — kill-switch для глобального Telegram-канала
  /// (только для строки с `tenantId IS NULL`). Главный администратор Z
  /// выключает бота для всех клиентов одной кнопкой в `/admin/system/telegram-bot`.
  global_disabled
}

/// Жизненный цикл `Notification`.
/// `queued` → `sent_partial` (часть доставок ушла, часть в очереди) →
/// `delivered` (хотя бы один канал доставил) → `read` (хотя бы один отметил
/// прочитанным) → `responded` (получен ответ). `failed` — ни одна доставка
/// не прошла, retry'и исчерпаны.
enum NotificationStatus {
  queued
  sent_partial
  delivered
  read
  responded
  failed
}

/// Статус ожидания ответа на probe-нотификацию. Для не-probe (например,
/// `curation.pending` без явного respond-flow) — `null`.
enum NotificationResponseStatus {
  pending
  answered
  dismissed
  expired
}

/// Статус одной попытки доставки в конкретный `ChannelBinding`. Отдельный
/// enum от webhook'ового `DeliveryStatus`, потому что семантика другая
/// (read/responded состояния значимы для conversational, не для webhook).
enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  read
  responded
  failed
}

/// Channel — настроенный per-Org канал общения.
///
/// Конкретные секреты (botToken, IMAP password и т.п.) лежат в `config`
/// в зашифрованном виде через `CryptoService.encrypt(...)`. Для `in_app`
/// `config` пустой (`{}`). Для `email_smtp` — переиспользуем общий SMTP
/// из `cfg.mail` (per-Org переопределение появится позже), но запись
/// в `Channel` всё равно нужна, чтобы маршрутизатор знал, что Org
/// разрешила email-доставку.
model Channel {
  id           String           @id @default(cuid())
  /// β-9 (2026-05-25): nullable для глобальных каналов (один на всю платформу,
  /// прим. — глобальный Telegram-бот @kora_bot). Per-tenant строки сохраняют
  /// `tenantId` как раньше. Ровно одна глобальная строка на `kind` гарантируется
  /// partial unique index'ом `channels_global_unique` в `postgres-init.sql`
  /// (Prisma не поддерживает partial unique декларативно). Postgres трактует
  /// `NULL != NULL`, поэтому `@@unique([tenantId, kind])` ниже остаётся
  /// корректным для per-tenant пары и не мешает глобальной NULL-строке.
  tenantId     String?
  kind         ChannelKind
  direction    ChannelDirection
  /// Зашифрованные секреты (botToken, etc). Для `in_app` = `{}`.
  config       Json             @default("{}")
  status       ChannelStatus    @default(active)
  /// Верхний потолок класса данных, который разрешено отправлять в этот
  /// канал. `internal` по умолчанию — `sensitive`/`private` не уходят
  /// во внешние каналы без явного апгрейда настройки.
  maxDataClass DataClass        @default(internal)
  brokenReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  org      Org?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings ChannelBinding[]

  @@unique([tenantId, kind])
  @@index([tenantId, kind])
  @@index([tenantId, status])
  @@map("channels")
}

/// ChannelBinding — привязка конкретного пользователя к конкретному каналу.
/// Для `in_app` `externalId = userId` (равенство сохраняется ради
/// единообразия). Для `email_smtp/imap` — email. Для `telegram_bot/max_bot`
/// — внешний user_id мессенджера (после verify через одноразовый код).
model ChannelBinding {
  id           String    @id @default(cuid())
  userId       String
  channelId    String
  /// Внешний идентификатор адресата: userId (in_app), email
  /// (email_smtp/imap), tg/max user_id (β-1). Уникален на канал.
  externalId   String
  /// Preferences пользователя per-binding: quiet hours, rate limits,
  /// фильтры eventType. См. ChannelBindingPreferences (zod-схема).
  preferences  Json      @default("{}")
  /// W4.3 (KC-Temporal) — потолок чувствительности per-binding (per-user-per-channel).
  /// Заполняется пользователем в `/me/channels` («макс. чувствительность»:
  /// public / internal / sensitive). `private` через UI недоступен — личные
  /// факты доставляются только в `in_app` и только subject'у. Эффективный
  /// потолок = `min(Channel.maxDataClass, ChannelBinding.maxDataClass)`.
  maxDataClass DataClass @default(internal)
  linkedAt     DateTime  @default(now())
  /// Заполняется после проверки кода/верификации. Для in_app — равен
  /// `linkedAt` (auto-verified).
  verifiedAt   DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([channelId, externalId])
  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@map("channel_bindings")
}

/// Notification — событие, адресованное пользователю, доставляемое через
/// один или несколько `ChannelBinding`. Логическая единица — пожизненна,
/// `NotificationDelivery` — попытка доставки в конкретный канал.
///
/// `payload.schemaVersion`/`payload.body` — фактическая структура зависит
/// от `eventType`. Валидация — в `ConversationalService.sendNotification`
/// через `NotificationEventPayloadRegistry`.
model Notification {
  id              String                      @id @default(cuid())
  tenantId        String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource  String?
  recipientUserId String
  /// Тип события, например `probe.question`, `curation.pending`,
  /// `idea.status_changed`. На α-1 — `probe.question`, `curation.pending`,
  /// `system.message`. Расширяется потребителями (α-4, β-5).
  eventType       String
  payload         Json
  dataClass       DataClass                   @default(internal)
  /// Опц. ссылка на исходный `IdeaBlock` (для probe'а на блок).
  contextBlockId  String?
  /// Опц. ссылка на карточку специалиста (Card, Decision, Regulation, ...).
  contextCardId   String?
  status          NotificationStatus          @default(queued)
  responseStatus  NotificationResponseStatus?
  responsePayload Json?
  expiresAt       DateTime?
  /// TZ-1 Фаза 0 (daily-value-engine) — приоритет уведомления для дневного
  /// бюджета. 1 = критично/важно (обходит бюджет и тихие часы), 2 = обычное
  /// (учитывается в дневном лимите). Default 2.
  priorityTier    Int?                        @default(2)
  createdAt       DateTime                    @default(now())
  respondedAt     DateTime?

  org        Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient  User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([tenantId, recipientUserId, status])
  @@index([tenantId, eventType, status])
  @@index([recipientUserId, status])
  @@index([expiresAt])
  @@map("notifications")
}

/// NotificationDelivery — одна попытка доставки в конкретный
/// `ChannelBinding`. На один `Notification` может быть несколько
/// доставок (по числу выбранных routing'ом каналов).
model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  channelBindingId  String
  status            NotificationDeliveryStatus @default(queued)
  /// Внешний id сообщения (smtp messageId, telegram message_id, …).
  externalMessageId String?
  errorReason       String?
  /// Сколько раз пробовали отправить (для retry-логики worker'а).
  attempts          Int                        @default(0)
  attemptedAt       DateTime                   @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  respondedAt       DateTime?

  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channelBinding ChannelBinding @relation(fields: [channelBindingId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channelBindingId, status])
  @@map("notification_deliveries")
}

// ──────────────────────────── SBA β-8 — Daily check-in (2026-05-23) ────────────────────────────

/// ТЗ 2026-05-29 telegram-self-initiated-checkins — откуда пришла запись чек-ина.
/// `cron_prompted` — ответ на DailyCheckInPromptCron (исторический default).
/// `self_initiated` — сотрудник сам написал боту план/отчёт без cron-приглашения.
/// `manual` — создан вручную через `/me/check-ins POST` или admin-UI.
enum DailyCheckInSource {
  cron_prompted
  self_initiated
  manual
  meeting
  bitrix
  chatbox
  email
  phone_call
}

/// DailyCheckIn — утренний / вечерний чек-ин сотрудника.
/// Источник: plans/tz/2026-05-23-sba-beta-8-personal-relation-coo-checkin.md §5.
///
/// `kind`: 'morning' — план на день; 'evening' — что сделано + блокеры.
/// `dateLocal` — YYYY-MM-DD по локальной TZ Person'а (Person.timezone, default
/// 'Europe/Moscow'). Уникален с (tenantId, personId, kind) — anti-spam:
/// одна и та же пара (person, день, тип) не может быть продублирована.
///
/// `plansJson` / `donesJson` / `blockersJson` — массивы
/// Array<{ text, sourceBlockId?, priority? }>; формат хранится как Json,
/// чтобы можно было быстро расширить без миграции (priority/severity
/// эволюционируют).
///
/// `notificationId` — ссылка на исходный `Notification(eventType='checkin.prompt')`,
/// если чек-ин создан в ответ на cron-проб. Manual create (через POST
/// `/me/check-ins`) — NULL.
///
/// `parseConfidence` — уверенность LLM-парсера при автозаполнении из текста
/// ответа. < 0.6 → плейсхолдер `pendingCuration=true` (поле `curatorReview`),
/// raw текст ответа уезжает в `rawResponseText`. >= 0.6 → данные считаются
/// канонизированными.
model DailyCheckIn {
  id              String    @id @default(cuid())
  tenantId        String
  personId        String
  /// 'morning' | 'evening' — литералы строкой, чтобы не плодить enum
  /// под две конкретные строки (см. style schema для simple enums-as-string).
  kind            String    @db.VarChar(16)
  /// YYYY-MM-DD по локальной TZ Person'а.
  dateLocal       String    @db.VarChar(10)
  /// Массив plans: Array<{ text, sourceBlockId?, priority? }>. NULL до ответа.
  plansJson       Json?
  /// Массив сделанного: Array<{ text, sourceBlockId?, evidenceLink? }>.
  donesJson       Json?
  /// Массив блокеров: Array<{ text, severity? ∈ {low|medium|high}, ownerHint? }>.
  blockersJson    Json?
  /// id исходной нотификации (cron probe). NULL для manual create.
  notificationId  String?
  /// Сырой текст ответа пользователя (если есть). Для аудита и curator review.
  rawResponseText String?   @db.Text
  /// 0..1 — уверенность LLM-парсера `checkin-parse`. NULL если нет ответа.
  parseConfidence Decimal?  @db.Decimal(4, 3)
  /// True если LLM-парсер не уверен (parseConfidence < 0.6) — нужен curator
  /// review. Соответствующие чек-ины поднимаются в `CurationItem` (будущая
  /// интеграция; пока только флаг, чтобы UI мог показать «требует проверки»).
  curatorReview   Boolean   @default(false)
  /// Заполнен в момент, когда пользователь прислал ответ или manual create
  /// прошёл успешно. NULL = чек-ин «пустой» (cron поставил, но человек не
  /// ответил до конца суток).
  completedAt     DateTime?

  /// ТЗ 2026-05-29 — источник чек-ина: cron / самоинициировано / manual.
  source DailyCheckInSource @default(cron_prompted)

  /// Вклады в чек-ин по источникам (audit + merge): Array<{ source, at, rank }>.
  /// Победитель содержимого — максимальный rank (ТЗ Ф4 sourceRank).
  sourceContributions Json?

  /// SBA β-8.1 — настроение чек-ина (определяет LLM по тексту вечернего
  /// ответа). 'green' | 'yellow' | 'red'. NULL = анализ ещё не запускался
  /// или модель упала. Видимость поля — только для роли coo/owner/admin
  /// (фильтр в DTO-маппере; не показывается сотруднику в /me/check-ins).
  sentiment             String?   @db.VarChar(10)
  /// Короткое обоснование от LLM («почему зелёный/жёлтый/красный»). Для
  /// прозрачности перед админом.
  sentimentRationale    String?   @db.Text
  /// Версия промпта/модели, которой определили настроение. Формат свободный
  /// (например, `prompt-v1+deepseek-chat`).
  sentimentVersion      String?   @db.VarChar(120)
  /// Когда настроение было проставлено (после анализа).
  sentimentDeterminedAt DateTime?

  /// Pulse Wave 3 §3.5 — качество рефлексии от Reflection-Quality-Scorer.
  /// Decimal(4,3): 0..1 (среднее по 3 осям: depth + concreteness + variety).
  /// NULL до прогона анализатора. Заполняется hourly-batch cron'ом.
  qualityScore Decimal? @db.Decimal(4, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person         Person  @relation("DailyCheckInPerson", fields: [personId], references: [id], onDelete: Cascade)
  tenant         Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  @@unique([tenantId, personId, kind, dateLocal])
  @@index([tenantId, personId, dateLocal])
  @@index([tenantId, kind, dateLocal])
  @@index([tenantId, curatorReview])
  /// SBA β-8.1 — индекс для виджета «Температура команды».
  @@index([tenantId, sentiment, dateLocal])
  @@map("daily_check_ins")
}

/// TZ-1 Фаза 0 (daily-value-engine) — дневной бюджет push-уведомлений на
/// одного Person'а в его локальном дне. Гарантирует, что человека не
/// заваливают пушами: при достижении лимита (`notifications.daily_budget.
/// per_person`, default 5) не-критические push-доставки откладываются (в
/// in_app они всё равно видны). Учёт — атомарный upsert по
/// `(tenantId, personId, dateLocal)`.
model NotificationBudgetLedger {
  id         String    @id @default(cuid())
  tenantId   String
  personId   String
  /// YYYY-MM-DD по локальной TZ Person'а.
  dateLocal  String    @db.VarChar(10)
  /// Сколько push-уведомлений уже потрачено за этот локальный день.
  sentCount  Int       @default(0)
  lastSentAt DateTime?
  /// Разбивка потраченного по eventType: { "checkin.prompt": 2, ... }.
  byTrigger  Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personId, dateLocal])
  @@index([tenantId, dateLocal])
  @@map("notification_budget_ledger")
}

/// TZ-1 Фаза 1 (daily-value-engine) — дневной снимок риска клиента.
///
/// Дневной агент `CustomerRiskRadarCron` группирует IdeaBlock'и
/// signalType ∈ {churn_risk, objection, pain, feature_request} по
/// Entity{type=customer} (через IdeaBlockEntity), копит за окно (default 14
/// дней) и ранжирует по money-риску. Веса/пороги/окно — AdminSetting, не код.
///
/// Идемпотентность — `@@unique([tenantId, customerEntityId, dateLocal])`:
/// повторный прогон за тот же день перезаписывает снимок (upsert).
model CustomerRiskSnapshot {
  id                  String    @id @default(cuid())
  tenantId            String
  /// Entity{type=customer}.id — клиент, по которому считается риск.
  customerEntityId    String
  /// YYYY-MM-DD (МСК) — день снимка.
  dateLocal           String    @db.VarChar(10)
  /// { churn_risk, objection, pain, feature_request } — счётчики за окно.
  signalCounts        Json
  /// Размер окна накопления в днях (на момент снимка; из AdminSetting).
  windowDays          Int       @default(14)
  /// Взвешенная сумма сигналов: churn_risk*w1 + objection*w2 + pain*w3 +
  /// feature_request*w4. Веса — AdminSetting.
  riskScore           Decimal   @db.Decimal(8, 4)
  /// 'critical' | 'warning' | 'ok' — по порогам critical/warning (AdminSetting).
  riskLevel           String    @db.VarChar(16)
  /// До 20 IdeaBlock.id-источников (для drill-down).
  topBlockIdsJson     Json
  /// Ответственный менеджер (Person той же Org). NULL если не резолвится по
  /// сделке/Project.customerCardId→owner. НЕ выдумываем.
  responsiblePersonId String?
  /// Когда отправлен push ответственному менеджеру (NULL — не отправляли).
  deliveredManagerAt  DateTime?
  snapshotAt          DateTime  @default(now())

  org            Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerEntity Entity  @relation("CustomerRiskSnapshotEntity", fields: [customerEntityId], references: [id], onDelete: Cascade)
  responsible    Person? @relation("CustomerRiskSnapshotResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)

  @@unique([tenantId, customerEntityId, dateLocal])
  @@index([tenantId, riskLevel, snapshotAt(sort: Desc)])
  @@index([tenantId, responsiblePersonId])
  @@map("customer_risk_snapshot")
}

/// TZ-1 Фаза 2 (daily-value-engine) — идемпотентный снимок персонального
/// дневного брифа «Твой день» per-person/день.
///
/// `PersonalDailyBriefCron` (`@Cron('0 * * * *')`) утром по локальной TZ Person'а
/// синтезирует бриф (задачи/обещания/блокеры/что-обещали-тебе/подсказка/
/// skill-помощь) → upsert по `@@unique([tenantId, personId, dateLocal])` →
/// push через дневной бюджет Ф0 (priorityTier 2). `payloadJson` — структурный
/// payload (SQL+шаблон, LLM только на «1 подсказку дня»). `deliveredAt` —
/// момент push, `openedAt` — клик пользователя (единый паттерн «доставлено vs
/// открыто», как у дайджестов).
model PersonalDailyBrief {
  id          String    @id @default(cuid())
  tenantId    String
  personId    String
  /// YYYY-MM-DD по локальной TZ Person'а — день брифа.
  dateLocal   String    @db.VarChar(10)
  /// Структурный payload брифа (задачи/обещания/блокеры/что-обещали-тебе/
  /// подсказка/skill-помощь). Контракт — `PersonalDailyBriefPayload`.
  payloadJson Json
  /// Когда отправлен push сотруднику (NULL — не отправляли).
  deliveredAt DateTime?
  /// Когда сотрудник открыл бриф (NULL — не открывал).
  openedAt    DateTime?
  createdAt   DateTime  @default(now())

  org    Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation("PersonalDailyBriefPerson", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personId, dateLocal])
  @@index([tenantId, dateLocal])
  @@map("personal_daily_brief")
}

/// TZ-1 Фаза 5 (daily-value-engine) — месячный снимок «что Кора сделала за
/// месяц» (value-recap). Витрина владельцу (инструмент продления) на ТВЁРДЫХ
/// данных: ведущая ось «снятая рутина» (счётчики из БД) + второй слой «команда
/// лучше» (soft-цифры с плашкой «оценка» + знаменателем).
///
/// `ValueRecapCron` (`@Cron('0 7 1 * *')`, 1-е число месяца) обходит Org →
/// `ValueRecapService.build` → upsert по `@@unique([tenantId, periodYm])`
/// (идемпотентно) → push-first владельцу/COO (Telegram/email через бюджет Ф0,
/// eventType `operations.monthly_recap`). `deliveredAt` — момент push,
/// `openedAt` — клик владельца (drill-down на экран).
///
/// Запрещённые метрики (Р6) в `payloadJson` НЕ хранятся: часы×ставка=₽,
/// было→стало «до Коры», medianHoursToAnswer, roiScore/alignment как KPI,
/// «N знаний спасено». Гарантия — в `ValueRecapService` + unit-тест.
model ValueRecapSnapshot {
  id          String    @id @default(cuid())
  tenantId    String
  /// YYYY-MM — месяц снимка (например 2026-05).
  periodYm    String    @db.VarChar(7)
  /// Структурный payload витрины (счётчики снятой рутины + soft-слой + дельта
  /// к прошлому месяцу + human-readable narrative). Контракт — `ValueRecapPayload`.
  payloadJson Json
  /// Когда отправлен push владельцу/COO (NULL — не отправляли).
  deliveredAt DateTime?
  /// Когда владелец открыл витрину (NULL — не открывал).
  openedAt    DateTime?
  createdAt   DateTime  @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodYm])
  @@index([tenantId, createdAt])
  @@map("value_recap_snapshot")
}

/// TZ-1 Фаза 3.A (daily-value-engine) — накопительный синтез блокеров.
///
/// `BlockerSynthesisCron` (`@Cron('0 22 * * *')`, после вечернего окна
/// чек-инов) нормализует `DailyCheckIn.blockersJson` + `IdeaBlock(signalType=
/// blocker)` дня, кластеризует (дешёвый ratio-детект + embedding KNN, как в
/// insight-радаре) и сопоставляет с прошлыми днями (окно `blocker_synthesis.
/// lookback_days`, default 7). Каждому кластеру присваивает статус
/// (new|recurring|resolved), `daysOpen` и `businessImpactScore` (выше, если
/// задевает customer/deadline/commitment). LLM — ТОЛЬКО на финальный
/// абзац-сводку (`blocker-synthesis-summary`). При `status=recurring` и
/// `daysOpen >= blocker_synthesis.recurring_days` — мостит кластер в `Insight`
/// (через Specialist35Service).
///
/// Идемпотентность — `@@unique([tenantId, clusterKey])`: повторный прогон за
/// тот же день апдейтит существующий кластер (upsert), не плодит дубли.
model BlockerSynthesis {
  id                  String   @id @default(cuid())
  tenantId            String
  /// Стабильный ключ кластера блокеров (детерминированный по нормализованному
  /// тексту/embedding-кластеру) — якорь идемпотентности между днями.
  clusterKey          String
  /// Репрезентативный текст кластера (самый свежий/частый блокер).
  representativeText  String   @db.Text
  /// 'new' | 'recurring' | 'resolved'.
  status              String   @db.VarChar(20)
  /// YYYY-MM-DD (МСК) — когда кластер впервые замечен.
  firstSeenDateLocal  String   @db.VarChar(10)
  /// YYYY-MM-DD (МСК) — когда кластер последний раз замечен.
  lastSeenDateLocal   String   @db.VarChar(10)
  /// Сколько дней кластер открыт (по календарю между first/last seen).
  daysOpen            Int      @default(0)
  /// Взвешенный бизнес-удар: выше, если блокер задевает customer/deadline/
  /// commitment. Веса — AdminSetting.
  businessImpactScore Decimal  @db.Decimal(8, 4)
  /// IdeaBlock.id-источники кластера (для drill-down).
  relatedBlockIdsJson Json
  /// Связанный Insight (создан/привязан мостом при recurring). NULL — не мостили.
  linkedInsightId     String?
  /// Ответственный (Person той же Org), если резолвится по блокам. NULL — нет.
  responsiblePersonId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org         Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsible Person? @relation("BlockerSynthesisResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)

  @@unique([tenantId, clusterKey])
  @@index([tenantId, status, lastSeenDateLocal])
  @@map("blocker_synthesis")
}

/// TZ-1 Фаза 4.C (daily-value-engine) — знание-под-риском × уход человека.
///
/// Еженедельный снимок `KnowledgeAtRiskCron`: пересечение critical bus-factor
/// (категория знаний держится на одном соло-эксперте — из
/// `KnowledgeRiskSnapshot.riskLevel='critical'`) × активных high-severity
/// risk-флагов носителя (`Person.riskFlagsJson`/`engagementScore`). Результат —
/// подсветка РУКОВОДИТЕЛЮ: «зона X на одном человеке, и он под риском ухода —
/// продублируй / поговори». Носителю НИЧЕГО не уходит (этика).
model KnowledgeAtRiskSnapshot {
  id                 String   @id @default(cuid())
  tenantId           String
  /// Категория знаний (= KnowledgeRiskSnapshot.categoryName).
  categoryName       String
  /// Соло-эксперт (Person той же Org), если резолвится. NULL — не определился.
  soleExpertPersonId String?
  /// Уровень bus-factor категории: 'critical' (0-1 эксперт) | 'warning' | 'ok'.
  busFactorLevel     String   @db.VarChar(16)
  /// Уровень риска ухода носителя из riskFlags/engagementScore:
  /// 'high' | 'medium' | 'low'. NULL — нет данных по носителю.
  personRiskLevel    String?  @db.VarChar(16)
  /// Совмещённая серьёзность (computeCombinedSeverity): 'critical' | 'warning' | 'ok'.
  combinedSeverity   String   @db.VarChar(16)
  snapshotAt         DateTime @default(now())

  org        Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  soleExpert Person? @relation("KnowledgeAtRiskSoleExpert", fields: [soleExpertPersonId], references: [id], onDelete: SetNull)

  @@index([tenantId, combinedSeverity, snapshotAt])
  @@map("knowledge_at_risk_snapshot")
}

/// TZ-1 Фаза 3.B (daily-value-engine) — join-таблица связи Decision↔Issue.
///
/// Прямой связи Decision→Issue в схеме нет (Issue.sourceBlockIds — массив
/// блоков, не FK на Decision). Вместо плодёжа массивов вводим явную join —
/// заполняется `backfill-decision-linked-task-count.ts` и воркером триажа.
/// `Decision.linkedTaskCount` — денормализованный счётчик строк этой таблицы.
model DecisionTaskLink {
  id         String   @id @default(cuid())
  decisionId String
  issueId    String
  /// Как связаны: 'implements' (задача внедряет решение) | 'derived' (создана
  /// из решения) | 'manual'. Строкой — расширение словаря без миграции.
  linkType   String   @default("implements") @db.VarChar(24)
  createdAt  DateTime @default(now())

  decision Decision @relation("DecisionTaskLinkDecision", fields: [decisionId], references: [id], onDelete: Cascade)
  issue    Issue    @relation("DecisionTaskLinkIssue", fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([decisionId, issueId])
  @@index([issueId])
  @@map("decision_task_link")
}

/// Pulse Wave 3 §3.3 — историческая лента engagement-score сотрудника.
///
/// Создаётся ежедневно `EngagementScorerCron` (03:00 UTC). Хранит снапшот
/// сводного score + источники (signalsJson). По этой таблице строится
/// тренд engagement в UI и определяется аномалия «резкое падение».
///
/// Decimal(4,3) — [0..1] нормированный к личному baseline (если данных < 7d,
/// baseline = 0.5; иначе среднее за прошлые 30d по тому же person).
model PersonEngagementSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  personId    String
  /// Decimal(4,3): 0..1 нормированный.
  score       Decimal  @db.Decimal(4, 3)
  /// JSON со списком источников и весов:
  /// { signals: { checkin_sentiment, checkin_regularity, commitment_kept_ratio,
  ///   meeting_activity }, baseline: number }.
  signalsJson Json
  snapshotAt  DateTime @default(now())

  org    Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId, snapshotAt])
  @@index([tenantId, snapshotAt])
  @@map("person_engagement_snapshots")
}

/// Pulse Wave 4 §4.6 — еженедельный прогноз от Forecaster агента.
///
/// Создаётся `ForecasterCron` (понедельник 04:00 UTC). LLM анализирует тренды
/// 4 метрик за 4 недели (sentiment_index / commitment_kept_ratio /
/// hanging_decisions / engagement_score) и возвращает прогноз: тренд +
/// риски + возможности + ожидаемые сдвиги по метрикам.
///
/// На MVP — только scope='company' (scopeId=null). scope='team' заложен
/// на будущее (per Department); чтение в Weekly digest идёт строго по
/// scope='company'.
///
/// История не перезаписывается: каждую неделю — новая запись через
/// `prisma.forecastSnapshot.create`. UI берёт последний снапшот за 14 дней.
///
/// `payloadJson` структура:
/// {
///   trend: 'improving' | 'stable' | 'declining',
///   risks: string[],
///   opportunities: string[],
///   expectedShifts: Array<{metric: string, direction: 'up'|'flat'|'down', confidence: number}>,
///   modelName: string,
///   provenance: { weeks: 4 }
/// }
model ForecastSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  /// 'company' | 'team' (на MVP — только company, team на будущее).
  scope       String   @db.VarChar(16)
  /// NULL для scope='company', иначе Department.id.
  scopeId     String?
  payloadJson Json
  snapshotAt  DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, snapshotAt(sort: Desc)])
  @@index([scopeId])
  @@map("forecast_snapshots")
}

/// Pulse Wave 6 §6.1 — Bus Factor snapshot.
///
/// Создаётся `BusFactorAnalyzerCron` (weekly Mon 05:00 UTC) per knowledge-area
/// в tenant'е. Для каждой категории из `PersonKnowledgeCategoryEmbedding`
/// считаем число экспертов по уровню `confidence` и риск-уровень:
///   - 'critical' (0-1 эксперт)
///   - 'warning'  (2-3 эксперта)
///   - 'ok'       (≥4 эксперта)
///
/// `topExpertsJson` структура: `Array<{personId, name, confidence}>` (макс 5).
///
/// История не перезаписывается: каждую неделю — новые записи. UI читает
/// последний snapshot per categoryName (через DISTINCT ON / GROUP BY).
model KnowledgeRiskSnapshot {
  id                  String   @id @default(cuid())
  tenantId            String
  /// Категория из PersonKnowledgeCategoryEmbedding.categoryName.
  categoryName        String   @db.VarChar(200)
  /// Число Person с confidence='high' в этой категории.
  highConfidenceCount Int
  /// Число Person с confidence ∈ ('high','medium').
  totalExpertsCount   Int
  /// 'critical' (0-1 эксперт), 'warning' (2-3), 'ok' (≥4).
  riskLevel           String   @db.VarChar(16)
  /// Имена и IDs топ-экспертов (для UI).
  topExpertsJson      Json
  snapshotAt          DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, riskLevel, snapshotAt(sort: Desc)])
  @@index([tenantId, categoryName, snapshotAt(sort: Desc)])
  @@map("knowledge_risk_snapshots")
}

/// Pulse Wave 6 §6.2 — Темы, повторяющиеся без принятого Decision.
///
/// Создаётся `TopicRecurrenceDetectorCron` (weekly Mon 05:00 UTC).
/// Для каждой `Theme` за окно (90 дней) считаем количество упоминаний,
/// разнообразие встреч и наличие implemented `Decision`. В snapshot пишем
/// только Theme с `mentionCount >= 5` и `hasImplementedDecision = false`.
///
/// `blockIdsJson` — `string[]` (макс 50) для drill-down из UI.
model RecurringTopic {
  id                     String   @id @default(cuid())
  tenantId               String
  /// FK на Theme (опц.: NULL если Theme удалён ретеншеном после snapshot).
  themeId                String?
  themeName              String   @db.VarChar(500)
  /// Сколько раз тема упоминалась за окно (default 90д).
  mentionCount           Int
  /// В скольких разных встречах.
  meetingCount           Int
  /// Есть ли implemented Decision (status='approved') linked к Theme через IdeaBlock.
  hasImplementedDecision Boolean
  /// Список IdeaBlock.id (truncated до 50).
  blockIdsJson           Json
  windowStart            DateTime
  windowEnd              DateTime
  snapshotAt             DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, snapshotAt(sort: Desc)])
  @@index([tenantId, mentionCount(sort: Desc)])
  @@map("recurring_topics")
}

/// Pulse Wave 6 §6.5 — Граф обещаний tenant'а.
///
/// Создаётся `PromiseNetworkAnalyzerCron` (weekly Mon 05:00 UTC).
/// Грузим `IdeaBlock` с `signalType='commitment'` за последние 30 дней.
/// Автор обещания — Person через `IdeaBlockEntity.role='subject'`,
/// получатель — `IdeaBlock.commitmentRecipientPersonId`.
///
/// Для каждого узла графа считаем `inDegree`, `outDegree`, `balance` и
/// помечаем `role`:
///   - 'accumulator': inDegree ≥ 3*outDegree (получает много обещаний).
///   - 'donor':       outDegree ≥ 3*inDegree (раздаёт обещания).
///   - 'isolated':    inDegree + outDegree ≤ 1.
///   - 'balanced':    иначе.
///
/// `graphJson` структура:
/// {
///   nodes: Array<{personId, name, role, inDegree, outDegree, balance}>,
///   edges: Array<{fromPersonId, toPersonId, count}>,
///   periodStart: ISO, periodEnd: ISO
/// }
model PromiseNetworkSnapshot {
  id               String   @id @default(cuid())
  tenantId         String
  graphJson        Json
  totalCommitments Int
  snapshotAt       DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, snapshotAt(sort: Desc)])
  @@map("promise_network_snapshots")
}

/// Pulse Wave 6 §6.6 — Pro/contra contribution per (person, goal, week).
///
/// Создаётся `GoalVectorTrackerCron` (weekly Mon 05:00 UTC). Для каждой
/// active `Goal` собирает per-person артефакты за неделю (IdeaBlock,
/// commitment, closed Issue) и одним LLM-вызовом (taskType
/// `goal-vector-tracker`) получает pro/contra/net score.
///
/// `signalsJson` — провенанс: какие сигналы вошли (для transparent sourcing).
/// Структура: `Array<{kind: 'idea'|'commitment_kept'|'commitment_broken'|
/// 'issue_closed', refId: string, direction: 'pro'|'contra'}>`.
///
/// `@@unique([tenantId, personId, goalId, weekStart])` — идемпотентность
/// upsert'а внутри недели (повторный запуск cron'а в ту же неделю обновляет).
model PersonGoalContribution {
  id          String   @id @default(cuid())
  tenantId    String
  personId    String
  goalId      String
  /// Pro-points (артефакты «в цель»): IdeaBlock idea + Commitment в направлении.
  proScore    Decimal  @db.Decimal(8, 3)
  /// Contra-points (артефакты «против»): commitment broken на goal, friction.
  contraScore Decimal  @db.Decimal(8, 3)
  /// proScore - contraScore.
  netScore    Decimal  @db.Decimal(8, 3)
  /// Provenance: какие сигналы вошли (для transparent sourcing).
  signalsJson Json
  weekStart   DateTime
  snapshotAt  DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personId, goalId, weekStart])
  @@index([tenantId, personId, weekStart(sort: Desc)])
  @@index([tenantId, goalId, weekStart(sort: Desc)])
  @@map("person_goal_contributions")
}

/// Pulse Wave 6 §6.7 — Скорость накопления знаний.
///
/// Создаётся `KnowledgeVelocityTrackerCron` (weekly Mon 05:00 UTC).
/// `IdeaBlock` с `signalType='knowledge_gap'` за окно (90 дней). Блок
/// считается «отвеченным», если `trustedAnswer` непустой и `updatedAt`
/// продвинулся минимум на 1 минуту относительно `createdAt`. Время до
/// ответа = `updatedAt - createdAt`.
///
/// `topRespondersJson` — топ-N person, упомянутых в `IdeaBlockEntity`
/// блоков-ответов (role IN ('subject','object')). Структура:
/// `Array<{personId, name, resolvedCount}>`.
model KnowledgeVelocitySnapshot {
  id                  String   @id @default(cuid())
  tenantId            String
  /// Median часов от создания IdeaBlock signalType='knowledge_gap' до ответа.
  medianHoursToAnswer Decimal? @db.Decimal(10, 2)
  /// Количество gaps с answer'ом в окне.
  resolvedGapsCount   Int
  /// Количество gaps без answer'а в окне (зависших).
  openGapsCount       Int
  /// Top-N person с most-gap-resolved.
  topRespondersJson   Json
  windowStart         DateTime
  windowEnd           DateTime
  snapshotAt          DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, snapshotAt(sort: Desc)])
  @@map("knowledge_velocity_snapshots")
}

/// SBA β-8.1 — WeeklyOperationsDigest. Готовый недельный дайджест для
/// операционного директора. Источник: plans/tz/2026-05-24-sba-beta-8-1-coo-dobivka.md §5.
///
/// Генерируется `operations-weekly-digest.cron` каждый понедельник в 08:00
/// локального времени каждой Org (через фильтр по `Org.timezone`).
/// `WeeklyDigestService.generate` собирает агрегаты за 7 дней (чек-ины,
/// блокеры, инсайты, цели, висящие решения) и одним LLM-вызовом
/// `operations-weekly-digest` собирает связный текст комментария.
///
/// `metricsJson` — структурированные показатели (для виджетов на странице
/// /dashboard/operations/weekly). `sourcesJson` — провенанс: id блокеров,
/// инсайтов, целей, решений, использованных в дайджесте.
///
/// Идемпотентность — `@@unique([tenantId, weekStart])`. Если за неделю
/// дайджест уже сгенерирован — повторный запуск cron'а не создаёт второй.
model WeeklyOperationsDigest {
  id             String   @id @default(cuid())
  tenantId       String
  /// YYYY-MM-DD, понедельник недели в локальной TZ Org'а.
  weekStart      String   @db.VarChar(10)
  /// YYYY-MM-DD, воскресенье недели (weekStart + 6).
  weekEnd        String   @db.VarChar(10)
  /// Связный текст комментария от LLM. Markdown (5-7 коротких разделов).
  /// При неудаче LLM сохраняется «сухой» вариант со структурой без связного текста.
  bodyMarkdown   String   @db.Text
  /// Структурированные показатели для виджетов. Свободный JSON
  /// (greenShare/yellowShare/redShare/totalCheckIns/topBlockers/...).
  metricsJson    Json
  /// Провенанс: id блокеров, инсайтов, целей, решений, использованных
  /// в дайджесте. Для drill-down из UI.
  sourcesJson    Json
  /// Идентификатор маршрута/модели LLM (или `prompt-v1+<model>`), который
  /// реально отработал. NULL если LLM упал и сохранён «сухой» вариант.
  llmTaskRouteId String?
  createdAt      DateTime @default(now())

  tenant         Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  @@unique([tenantId, weekStart])
  @@index([tenantId, weekStart])
  @@map("weekly_operations_digests")
}

/// SBA β-8.3 — DailyOperationsDigest. Ежедневный отчёт операционного директора.
/// Источник: plans/tz/2026-05-25-sba-beta-8-3-coo-daily-and-doelka.md §1.2.
///
/// Зеркало `WeeklyOperationsDigest` с окном «вчерашние сутки в МСК». Генерируется
/// глобальным cron'ом `operations-daily-digest.cron` каждый день в 01:00 МСК
/// (= 22:00 UTC). Не per-Org timezone — ICP РФ, к утру рабочего дня готово
/// во всех часовых поясах страны.
///
/// `DailyDigestService.generate` собирает агрегаты вчерашнего дня
/// (чек-ины, новые блокеры, просроченные обещания, цели, новые high-severity
/// инсайты, решения) и одним LLM-вызовом `operations-daily-digest` собирает
/// связный текст комментария (4-6 коротких разделов + shortSummary для
/// Telegram-рассылки и блока на главной).
///
/// Идемпотентность — `@@unique([tenantId, dateLocal])`. Если за день дайджест
/// уже сгенерирован — повторный запуск cron'а не создаёт второй.
///
/// `deliveredAt` — отметка успешной Telegram-рассылки. NULL — ещё не доставлено
/// (или тумблер `operations.daily_digest.deliver_to_telegram` выключен).
model DailyOperationsDigest {
  id             String    @id @default(cuid())
  tenantId       String
  /// YYYY-MM-DD — дата отчёта в МСК (день, ЗА который сделан отчёт).
  dateLocal      String    @db.VarChar(10)
  /// Связный текст комментария от LLM. Markdown (4-6 коротких разделов).
  /// При неудаче LLM — «сухой» вариант со структурой без связного текста.
  bodyMarkdown   String    @db.Text
  /// Структурированные показатели для виджетов: greenShare/yellowShare/redShare,
  /// topBlockers, openCommitments, completedGoals, missedGoals, ...
  metricsJson    Json
  /// Провенанс: id блокеров, чек-инов, обещаний, целей, инсайтов, решений.
  sourcesJson    Json
  /// Идентификатор маршрута/модели LLM (`prompt-v1+<model>`). NULL при сухом fallback.
  llmTaskRouteId String?
  /// Кратко (1 короткий параграф) — для Telegram-рассылки и блока на главной.
  shortSummary   String?   @db.Text
  /// Telegram-доставка прошла. NULL — ещё не доставлено или выключено.
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  tenant         Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  @@unique([tenantId, dateLocal])
  @@index([tenantId, dateLocal])
  @@map("daily_operations_digests")
}

// ──────────────────────────── SBA δ-2 — ProactiveWatcher (2026-05-23) ────────────────────────────

/// ProactiveNotification — инициативное уведомление от ProactiveWatcher.
/// Источник: plans/tz/2026-05-23-sba-delta-2-proactive-watcher.md §5.
///
/// Watcher (`proactive-watcher.cron`, @Cron('0 *‎/6 * * *')) каждые 6 часов
/// обходит 8 deterministic-правил над графом (Decision/Insight/Experiment/
/// Process/Role/Department/FunctionalDomain). На каждое сработавшее правило
/// для одного recipient'а создаём `ProactiveNotification` (audit-row) +
/// отправляем через `ConversationalService.sendNotification` (eventType
/// 'proactive.notification') c кратким friendly-сообщением, сгенерированным
/// через LLM-задачу 'proactive-message-craft'.
///
/// `notificationId` — FK на исходящий `Notification` после отправки (NULL,
/// если отправка ещё не произошла или упала).
///
/// `payloadJson` — структурированный контекст правила (например, decisionId,
/// insightId, ageDays, suggestedAction); схема не фиксирована, чтобы каждое
/// правило могло хранить свои поля без миграций.
///
/// Anti-spam: Redis SETNX dedup-key `proactive:dedup:{tenantId}:{userId}:{dateLocal}`
/// TTL 24h — максимум 1 proactive per user per day. `ProactiveNotification`-row
/// создаётся ТОЛЬКО при успешном захвате lock'а — так в БД нет «отброшенных»
/// мусорных записей.
///
/// `dismissedAt` — пользователь нажал «Скрыть» в `/me/notifications` (вкладка
/// «Проактивные»). После dismiss карточка не показывается в default-фильтре.
model ProactiveNotification {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  /// Код правила-инициатора (см. ProactiveWatcherService.RULES):
  /// 'decision_no_owner' | 'insight_no_mitigation' | 'experiment_running_too_long'
  /// | 'process_stale_review' | 'role_low_completeness' | 'department_no_domain'
  /// | 'insights_siloed_in_domain' | 'plan_item_overdue'.
  ruleType       String    @db.VarChar(60)
  /// Уровень важности — 'low' | 'medium' | 'high'. UI использует для бейджа.
  severity       String    @db.VarChar(10)
  /// Структурированный контекст правила (free-form per rule).
  payloadJson    Json
  /// FK на исходящий Notification (после успешной отправки через
  /// ConversationalService.sendNotification). NULL, если отправка не произошла.
  notificationId String?
  emittedAt      DateTime  @default(now())
  dismissedAt    DateTime?

  user   User @relation("ProactiveNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, emittedAt])
  @@index([tenantId, ruleType, emittedAt])
  @@map("proactive_notifications")
}

// ──────────────────────────── фаза B: поведенческие метрики встречи ────────────────────────────

/// MeetingBehaviorMetrics — общие (per-meeting) поведенческие метрики
/// (one-to-one с Meeting). Источник: ТЗ B (`plans/tz/2026-05-21-phase-B-meeting-behavior-metrics.md` §4).
///
/// Рассчитывается воркером `ai.behavior-metrics` параллельно `ai.analyze`
/// после `ai.merge`. Не зависит от готовности AiResult — может стать готовой
/// раньше/позже основного отчёта.
model MeetingBehaviorMetrics {
  id        String @id @default(cuid())
  meetingId String @unique
  tenantId  String

  /// Общая длительность встречи (по Meeting.endedAt - startedAt), мс.
  totalDurationMs Int
  /// Суммарное время речи всех участников (с учётом crosstalk дважды), мс.
  totalSpeechMs   Int
  /// Суммарная тишина (ни один спикер не говорит), мс.
  silenceMs       Int
  /// Доля тишины (0..100).
  silencePercent  Float
  /// Суммарное время одновременной речи 2+ участников, мс.
  crossTalkMs     Int
  /// Нормированный индекс доминирования: max(speakingTimeMs)/median(speakingTimeMs).
  /// При median=0 возвращаем 999 (моноспикер / низкая активность).
  dominanceIndex  Float

  /// Confidence диаризации (0..1) из Vox-ответа. <0.85 → lowConfidence=true.
  diarizationConfidence Float
  /// True, если метрики ориентировочные (низкое качество диаризации /
  /// короткая встреча / иные edge-кейсы из ТЗ B §5.4).
  lowConfidence         Boolean @default(false)

  computedAt DateTime @default(now())

  meeting      Meeting                      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participants MeetingParticipantBehavior[]

  @@index([tenantId])
}

/// MeetingParticipantBehavior — per-participant поведенческие метрики
/// (one-to-many от MeetingBehaviorMetrics). Источник: ТЗ B §4.
///
/// displayName хранит снимок имени на момент расчёта (для гостей, у которых
/// нет пользовательского профиля). isGuest повторяет Participant.role='guest'
/// для удобства фильтра без JOIN.
model MeetingParticipantBehavior {
  id                       String  @id @default(cuid())
  meetingBehaviorMetricsId String
  /// participantId NULL допустим только для синтезированных гостей без
  /// записи в Participant (edge-case из ТЗ B §5.4). На MVP всегда заполнен.
  participantId            String?
  tenantId                 String

  /// Снимок имени на момент расчёта (для гостей, у которых нет userId).
  displayName String
  /// True для гостей без аккаунта.
  isGuest     Boolean @default(false)

  speakingTimeMs             Int
  speakingTimePercent        Float
  turnsCount                 Int
  avgTurnDurationMs          Float
  /// Сколько turn'ов длительностью >= 60_000 мс.
  monologueCount             Int
  longestMonologueMs         Int
  questionCount              Int
  fillerWordsCount           Int
  interruptionsMadeCount     Int
  interruptionsReceivedCount Int

  /// Pulse Wave 4 §4.4 — sentiment ПО ТЕКСТУ per speaker (НЕ audio/video, EU AI Act §1.3).
  /// Структура: { topics: string[], textSentiment: 'positive'|'neutral'|'negative', confidence: number }.
  /// NULL до прогона `MeetingSpeakerAnalyzerWorker` (hourly cron, см. модуль ai).
  sentimentTextPerSpeakerJson Json?

  metrics     MeetingBehaviorMetrics @relation(fields: [meetingBehaviorMetricsId], references: [id], onDelete: Cascade)
  participant Participant?           @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([meetingBehaviorMetricsId, participantId])
  @@index([tenantId])
  @@index([participantId])
}

// ──────────────────────────── фаза C: AI-оценка качества встречи ────────────────────────────

/// MeetingQualityScore — AI-оценка качества встречи (sub-TZ C §4).
///
/// Источник: plans/tz/2026-05-21-phase-C-meeting-quality-score.md §4.
///
/// One-to-one с `Meeting`. Создаётся воркером `ai.quality-score` после
/// `ai_ready` основного pipeline'а. Видит хост (`Meeting.ownerId`) и
/// Org-Admin (owner/admin). Гости и non-host members получают 403.
///
/// Категорий всегда 5: preparation/structure/clarity/outcomes/engagement
/// (0..100). `overallScore` — взвешенное среднее (вычисляет LLM).
///
/// `recommendations` — массив `{ text, severity, category, degradedMode? }`.
/// `degradedMode=true` появляется, когда LLM-router сработал на tertiary
/// (Ollama qwen3.5:9b — graceful-degradation по sub-TZ C §5.4).
///
/// `strengths` — массив строк (2-4 пункта «что было хорошо»).
///
/// `promptTemplateVersionId` — версия шаблона `meeting-quality-score`
/// (после A.2/A.3 — из БД; до этого — NULL = code-fallback).
model MeetingQualityScore {
  id        String @id @default(cuid())
  meetingId String @unique
  tenantId  String

  /// Общий балл качества встречи, 0..100. Взвешенное среднее категорий,
  /// рассчитывает LLM (см. промпт).
  overallScore     Int
  /// Подготовка: озвучена ли повестка / цель в первые 5 минут (0..100).
  preparationScore Int
  /// Структура: есть ли введение → обсуждение → итоги (0..100).
  structureScore   Int
  /// Чёткость формулировок vs «надо подумать», «как-то решим» (0..100).
  clarityScore     Int
  /// Итоги: есть ли конкретные решения с ответственными и сроками (0..100).
  outcomesScore    Int
  /// Вовлечённость участников (0..100). Не путать с behaviorMetrics — это
  /// LLM-оценка диалога, не статистика.
  engagementScore  Int

  /// Список рекомендаций «как сделать встречу лучше».
  /// Структура: [{ text: string, severity: 'info'|'warning'|'critical',
  ///   category: 'preparation'|'structure'|'clarity'|'outcomes'|'engagement',
  ///   degradedMode?: boolean }].
  recommendations Json
  /// Что было хорошо (2-4 пункта). Структура: string[].
  strengths       Json

  /// Версия шаблона `meeting-quality-score` (PromptTemplateVersion.id).
  /// NULL = code-fallback (`ai/services/prompts/meeting-quality-score.ts`).
  promptTemplateVersionId String?
  computedAt              DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, overallScore])
  @@index([tenantId, computedAt])
}

// ───────────────────────── SBA α-5 — Layer 5 Chat-v2 Omnichannel ─────────────────────────
//
// AI-чат компании поверх knowledge-core с conversation history и omnichannel
// inbound/outbound. См. plans/tz/2026-05-21-sba-alpha-5-layer5-chat-v2.md.
//
// ChatV2Conversation — диалог пользователя с AI (память за всё время).
// ChatV2Message — одно сообщение в диалоге (user или assistant). citations и
// retrievalMeta/llmMeta хранятся в Json — структура задокументирована в
// сервисах chat-v2 (см. ChatV2Output из knowledge-core/services/chat-v2.service.ts).
//
// `scope` — 5 «обычных» + 'personal' (личный диалог с AI без жёсткой
// привязки). `channelKindOrigin` — где был СОЗДАН диалог (web/in_app/
// telegram_bot/...); сами сообщения могут приходить и уходить через любой
// канал, к которому привязан пользователь.

/// Диалог пользователя с AI-чатом v2. Хранится вечно (cron auto-archive
/// после 90 дней без активности, см. workers/chat-v2-cleanup.cron.ts).
/// Pin через UI исключает диалог из auto-archive.
model ChatV2Conversation {
  id                String                   @id @default(uuid())
  tenantId          String
  tenant            Org                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource    String?
  userId            String
  user              User                     @relation("ChatV2ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Авто-генерация после первого сообщения через LLM (taskType
  /// `chat-v2-conversation-title`). До генерации — NULL, фронт показывает
  /// «Новый диалог».
  title             String?
  scope             ChatV2Scope
  /// Для scope='meeting'/'card'/'theme'/'entity' — id соответствующей
  /// сущности; для scope='org'/'personal' — NULL.
  scopeRefId        String?
  /// Где был создан диалог. 'web' / 'in_app' / 'email_smtp' / 'telegram_bot' /
  /// 'max_bot'. Не валидируется enum'ом — расширяется новыми каналами без
  /// миграций.
  channelKindOrigin String?
  status            ChatV2ConversationStatus @default(active)
  /// NULL = не закреплён. Закреплённые диалоги не попадают в auto-archive.
  pinnedAt          DateTime?
  /// SBA α-5 dialog-layer — сжатое представление старой части диалога
  /// (создаётся ConversationSummarizerCron для диалогов с >12 сообщениями).
  /// В systemPrompt подмешивается `summary + last 6 messages`. Markdown 200-400 chars
  /// + JSON-секция «упомянутые сущности».
  summary           String?                  @db.Text
  summaryUpdatedAt  DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  messages          ChatV2Message[]

  @@index([tenantId, userId, updatedAt])
  @@index([tenantId, status])
}

/// Сообщение в диалоге chat-v2. role='user' — вопрос пользователя; role='assistant'
/// — ответ AI с citations/retrievalMeta/llmMeta.
model ChatV2Message {
  id             String             @id @default(uuid())
  conversationId String
  conversation   ChatV2Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatV2MessageRole
  /// Только для assistant. factual / synthetic / clone_style. NULL для user.
  mode           ChatV2Mode?
  text           String             @db.Text
  /// Структура: [{ blockId, evidenceId?, meetingId, meetingTitle, startMs,
  /// endMs, snippet }, ...]. Парсится из [BLOCK:id] маркеров ChatV2Service.
  citations      Json?
  /// Структура: { usedBlockIds: string[], inputTokens, outputTokens,
  /// candidateBlockIds?: string[] }.
  retrievalMeta  Json?
  /// Структура: { model: string, inputTokens: number, outputTokens: number,
  /// tier?: 'primary'|'secondary'|'tertiary', fallbackUsed?: boolean }.
  llmMeta        Json?
  /// TZ-1 Фаза 5 (daily-value-engine) — оценка пользователя «помог ли ответ»:
  /// 'up' | 'down'. Только для assistant-сообщений (на user-сообщение оценку
  /// не ставим). NULL — не оценивали. Эталон формы — AiResultFeedback.reaction.
  /// Несущая часть честного helped-rate месячной витрины (value-recap).
  helpful        String?            @db.VarChar(8)
  /// TZ-1 Фаза 5 — когда поставлена/обновлена оценка `helpful`.
  helpfulAt      DateTime?
  /// TZ-1 Фаза 5 — опциональный комментарий к оценке (что не так / что помогло).
  helpfulComment String?            @db.Text
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
}

/// 5 «обычных» scope (org/meeting/card/theme/entity) + 'personal' — личный
/// диалог пользователя с AI без жёсткой привязки. Personal заведено для
/// γ-1 (Employee Clone), на α-5 — общий org-доступ через retrieval.
/// Wave 2 polish T6-6b — добавлен `issue` как первоклассный scope для
/// чат-в-задаче (IssueChat). Маппинг на retrieval scope knowledge-core —
/// в `SynthesisService.mapScope` (issue → card, чтобы переиспользовать
/// существующий card-retrieval + CardSpecialistRegistry/IssueCardHandler).
enum ChatV2Scope {
  org
  meeting
  card
  theme
  entity
  personal
  issue
}

enum ChatV2MessageRole {
  user
  assistant
}

/// factual — ответ только по найденным блокам (с цитатами).
/// synthetic — синтез по нескольким источникам с маркировкой уверенности.
/// clone_style — стиль конкретной персоны (Persona), реализация в γ-1.
/// Имя clone_style выбрано вместо clone-style потому что Prisma enum не
/// допускает дефис.
enum ChatV2Mode {
  factual
  synthetic
  clone_style
}

enum ChatV2ConversationStatus {
  active
  archived
}

// ──────────────────────────── SBA γ-1 — Specialist 3.7 SkillProfile + ExecutablePersona ────────────────────────────

/// SkillProfileStatus — состояние навыкового профиля сотрудника.
///   - active: сотрудник работает, профиль активно перестраивается.
///   - archived: сотрудник перешёл в former — профиль заморожен, snapshots остаются.
///   - paused_relationship: текущий relationship не employee (например, candidate) —
///     профиль есть, но не достраивается до возвращения в employee.
enum SkillProfileStatus {
  active
  archived
  paused_relationship
}

/// SkillConfidence — качественная уверенность в trait (3 уровня).
enum SkillConfidence {
  low
  medium
  high
}

/// SkillTraitStatus — жизненный цикл черты профиля.
///   - active: черта активна и видна.
///   - superseded_by: заменена более новой формулировкой (см. supersededById).
///   - archived: давно не подтверждалась (>SKILL_ARCHIVE_MONTHS).
///   - misleading: пометил direct manager / admin как неверную.
///   - pending_verification: черта создана, ждёт grounding-проверки
///     (skill-trait-verify); в персону НЕ попадает, пока не станет active.
enum SkillTraitStatus {
  active
  superseded_by
  archived
  misleading
  pending_verification
}

/// PersonaScope — область охвата исполняемой персоны.
///   - person: персона конкретного сотрудника (profileId обязателен).
///   - role: агрегат по должности (scopeRefId=roleId, profileId=null).
enum PersonaScope {
  person
  role
}

/// PersonaStatus — статус снапшота персоны.
///   - active: используется ClonesService (текущий носитель должности; ровно один на роль).
///   - superseded: заменён более новой версией (legacy-семантика «скрыт»; для новых
///     клонов роли НЕ используется — см. `frozen`).
///   - pending_rebuild: Clones=Roles Ф2 (2026-05-25) — создан при смене
///     носителя роли, ждёт пересборки `personaPrompt` через
///     `ExecutablePersonaBuildService.buildForRole`. Активным НЕ считается
///     (clone-API не использует), но виден в `/history`.
///   - frozen: Раздел 7 (2026-06-16) «один человек = один клон должности» — снимок
///     БЫВШЕГО носителя должности. Read-only: доступен для вопросов навсегда, но НЕ
///     активен, НЕ дообучается и НЕ декеится (И5/И6). Уходящий клон → `frozen` (не
///     `superseded`/удаление): «пропажи клона» при смене носителя не возникает.
enum PersonaStatus {
  active
  superseded
  pending_rebuild
  frozen
}

/// SkillProfile — навыковый профиль сотрудника. 1:1 с Person (только relationship='employee').
/// Источник информации — IdeaBlockEntity.role='subject' от Person с signalType
/// ∈ {reasoning, rationale, decision_basis}. Категории черт эмерджентные —
/// LLM сам формирует строковые имена (не enum). См. sub-TZ §4.
model SkillProfile {
  id             String             @id @default(uuid())
  tenantId       String
  /// 1:1 — у одного Person строго один SkillProfile.
  personId       String             @unique
  status         SkillProfileStatus @default(active)
  /// Момент последней успешной пересборки. null до первого rebuild'а.
  lastBuildAt    DateTime?
  /// Версия профиля (инкремент при каждом успешном rebuild).
  buildVersion   Int                @default(0)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (для всего профиля
  /// как агрегата traits + персонального субъекта).
  dataClassAudit Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant         Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  person         Person              @relation("SkillProfilePerson", fields: [personId], references: [id], onDelete: Cascade)
  traits         SkillTrait[]
  personas       ExecutablePersona[]

  @@index([tenantId, status])
  @@map("skill_profiles")
}

/// SkillTrait — отдельная черта рабочего поведения сотрудника. Эмерджентная
/// категория (string), гипотезная формулировка («похоже, склонен к …»), минимум
/// SKILL_MIN_OBSERVATIONS (5) наблюдений. См. sub-TZ §4 + зонтичный §3.4.
model SkillTrait {
  id                        String                       @id @default(uuid())
  profileId                 String
  /// @deprecated SBA γ-1 доделки — оставлено параллельно с `categoryId` на
  /// 1 месяц для миграции (см. patch-skill-trait-categories-from-strings.ts).
  /// Новые записи пишут `categoryId`; чтение поддерживает оба поля до полного
  /// dropping legacy column.
  category                  String                       @db.VarChar(200)
  /// SBA γ-1 доделки — FK на SkillTraitCategory (эмерджентная категория,
  /// поддерживает merge через CurationDecisionType.merge_categories).
  /// Может быть null временно — пока patch-script не отработал на проде.
  categoryId                String?
  /// Гипотезная формулировка: «похоже, …» / «склонен …» / «в большинстве случаев …».
  statement                 String                       @db.Text
  confidence                SkillConfidence
  observationCount          Int
  /// IdeaBlock.id, на которых построена черта.
  sourceBlockIds            String[]                     @default([])
  firstObservedAt           DateTime
  lastConfirmedAt           DateTime
  status                    SkillTraitStatus
  /// Если status='superseded_by' — id нового trait'а.
  supersededById            String?
  /// Если status='misleading' — обязательное обоснование от куратора.
  misleadingReason          String?                      @db.Text
  /// user.id куратора, пометившего trait как misleading.
  misleadingFlaggedByUserId String?
  misleadingFlaggedAt       DateTime?
  /// Эмбеддинг (category + statement) для KNN-merge при rebuild'е.
  embedding                 Unsupported("vector(1536)")?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  /// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 2 — ссылка на канонический
  /// «смысловой блок навыка» (SkillTraitConcept). Канонизация одинаковых по
  /// смыслу traits у разных сотрудников: «осторожен с оценками сроков»,
  /// «не любит давать сроки без данных», «откладывает оценку» → один концепт.
  /// Null временно — до прогона backfill-скрипта.
  conceptId String?
  concept   SkillTraitConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  /// TZ clone-method (2026-06-11) — слой черты (skill | value | motivation |
  /// process_marker). persona-compile v2 секционирует по нему.
  layer SkillTraitLayer @default(skill)

  profile    SkillProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  categoryFk SkillTraitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([profileId, status])
  @@index([profileId, category])
  @@index([profileId, categoryId])
  @@index([categoryId])
  @@index([conceptId])
  @@index([profileId, layer, status])
  @@map("skill_traits")
}

/// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 2 — Смысловой блок навыка.
/// Канонизирует одинаковые по смыслу SkillTrait у разных сотрудников
/// (напр. «осторожен с оценками сроков», «не любит давать сроки без данных»,
/// «откладывает оценку» — все указывают на один концепт).
model SkillTraitConcept {
  id            String                       @id @default(cuid())
  tenantId      String
  /// Каноническое имя — берётся из category первого trait'а при создании,
  /// пересчитывается агентом `skill-trait-concept-name` при слиянии 2+ концептов.
  canonicalName String                       @db.VarChar(200)
  /// 1-2 предложения, поясняющие смысл, для админки (опционально).
  description   String?                      @db.Text
  /// Все наблюдённые варианты названия (для прозрачности и debug).
  variants      String[]                     @default([])
  /// Семантический отпечаток canonicalName + description.
  embedding     Unsupported("vector(1536)")?
  status        SkillTraitConceptStatus      @default(active)
  /// Куда слит, если status='merged_into'.
  mergedIntoId  String?
  mergedInto    SkillTraitConcept?           @relation("ConceptMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    SkillTraitConcept[]          @relation("ConceptMerge")
  /// Денормализованный счётчик активных traits с этим conceptId.
  traitCount    Int                          @default(0)
  firstSeenAt   DateTime                     @default(now())
  lastSeenAt    DateTime                     @default(now())
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  org    Org          @relation("SkillTraitConceptTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  traits SkillTrait[]

  @@unique([tenantId, canonicalName])
  @@index([tenantId, status])
  @@map("skill_trait_concepts")
}

enum SkillTraitConceptStatus {
  active
  merged_into
  archived
}

enum SubjectMemoryKind {
  term            /// термин/аббревиатура компании: «КП» = «коммерческое предложение»
  disambiguation  /// разрешённая неоднозначность: «дизайн» → отдел/роль X
  preference      /// предпочтение: «задачи ставить с дедлайном»
}

enum SubjectMemoryStatus {
  shadow          /// выведено, но не влияет на поведение (наблюдаем метрику)
  canary          /// влияет на часть трафика, под наблюдением rollback-метрики
  active          /// влияет полностью
  superseded      /// заменено более свежим правилом (по occurredAt)
  rolled_back     /// авто-откат: ухудшило внешнюю метрику
  disabled        /// kill-switch владельца
}

model SubjectMemory {
  id              String              @id @default(cuid())
  tenantId        String
  kind            SubjectMemoryKind
  contextText     String              @db.Text
  ruleText        String              @db.Text
  embedding       Unsupported("vector(1536)")?
  status          SubjectMemoryStatus @default(shadow)
  confirmCount    Int                 @default(0)
  refuteCount     Int                 @default(0)
  confidence      Decimal             @db.Decimal(4, 3) @default(0)
  occurredAt      DateTime
  supersededById  String?
  supersededBy    SubjectMemory?      @relation("SubjectMemorySupersede", fields: [supersededById], references: [id])
  supersedes      SubjectMemory[]     @relation("SubjectMemorySupersede")
  sourceProbeIds  String[]            @default([])
  sourceBlockIds  String[]            @default([])
  staleAfter      DateTime?
  lastAppliedAt   DateTime?
  /// Когда правило переведено в canary — старт окна наблюдения rollback-метрики.
  canaryAt        DateTime?
  appliedCount    Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, status])
  @@index([tenantId, status, occurredAt])
  @@map("subject_memory")
}

/// TZ clone-method (2026-06-11) — дискриминатор СЛОЯ черты: persona-compile v2
/// отбирает черты по слою (подход/ценности/мотивация/маркеры процесса), без
/// него черты и ценности смешиваются в одном топ-20.
enum SkillTraitLayer {
  skill          // поведение при решениях (текущий дефолт)
  value          // что ставит выше при конфликте приоритетов (revealed preference)
  motivation     // что драйвит в работе
  process_marker // конструктивный маркер процесса (перечисляет критерии / перепроверяет)
}

/// TZ clone-method (2026-06-11) — RolePrinciple — синтезированный ПРИНЦИП/паттерн
/// решений роли (Reflection-слой, Park 2023). НЕ черта человека («осторожный»),
/// а обобщённый ПРОЦЕСС роли («типовой ход: сначала пилот на 5%, потом раскатка»).
/// Синтезируется периодическим cron из накопленных reasoning-блоков должности,
/// с обратными ссылками на наблюдения (grounding). Отдельный узел: черта = одно
/// наблюдение, принцип = обобщение многих.
model RolePrinciple {
  id                String                       @id @default(uuid())
  tenantId          String
  /// Role.id — принцип процесса ДОЛЖНОСТИ (переживает ротацию носителя).
  /// Без FK (как PracticeSkill.scopeRefId) — архивация вместо каскада.
  roleId            String
  /// Краткая метка-ситуация, к которой относится принцип («срыв срока», «выбор подрядчика»).
  situation         String                       @db.VarChar(200)
  /// Обобщённая ПОВЕДЕНЧЕСКАЯ формулировка процесса (без оценок личности):
  /// «При срыве срока — сначала эскалирует владельцу с 2 вариантами, затем режет scope».
  statement         String                       @db.Text
  /// IdeaBlock.id, на которых построено обобщение (grounding-trail, ≥ порога).
  sourceBlockIds    String[]                     @default([])
  observationCount  Int                          @default(0)
  confidence        SkillConfidence
  /// Эмбеддинг (situation+statement) — дедуп/ретрив. HNSW — postgres-init.sql.
  embedding         Unsupported("vector(1536)")?
  status            RolePrincipleStatus          @default(active)
  supersededById    String?
  lastSynthesizedAt DateTime                     @default(now())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  org Org @relation("RolePrincipleTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, roleId, status])
  @@index([tenantId, situation])
  @@map("role_principles")
}

/// TZ clone-method (2026-06-11) — жизненный цикл принципа роли.
enum RolePrincipleStatus {
  active
  superseded
  archived
}

/// TZ clone-method (2026-06-11), Этап 0 — лёгкий журнал запросов к клону,
/// видимый владельцу Org. Пишется на каждый ask (включая отказы).
/// Текст вопроса храним превью+hash (не полный текст — он уже в ChatV2Message).
model CloneQueryLog {
  id               String       @id @default(uuid())
  tenantId         String
  /// person | role — какой клон спрашивали (reuse PersonaScope).
  cloneScope       PersonaScope
  /// personId (scope=person) или roleId (scope=role) — без FK (как PracticeSkill.scopeRefId).
  cloneTargetId    String
  /// User.id спросившего.
  userId           String
  /// Первые 200 символов вопроса — для списка у владельца.
  questionPreview  String       @db.VarChar(200)
  /// sha256(вопроса) — дедуп/аналитика без хранения полного текста.
  questionHash     String       @db.VarChar(64)
  /// true — ответ опёрся на наблюдения (grounded); false — отказ или ответ без опоры.
  answeredGrounded Boolean
  /// Причина отказа, если был: 'topic_starved' | 'ungrounded' | null.
  refusalReason    String?      @db.VarChar(64)
  createdAt        DateTime     @default(now())

  tenant Org @relation("CloneQueryLogTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, cloneTargetId, createdAt])
  @@index([tenantId, createdAt])
  @@map("clone_query_logs")
}

/// Agents v2 Фаза C1 (2026-05-30) — PracticeSkill — выполняемая процедура
/// (рецепт «когда X → делай 1, 2, 3»), извлечённая из reasoning-блоков
/// сотрудников. В отличие от SkillTrait/SkillTraitConcept (черты характера и
/// принципы), PracticeSkill — это **операционная** инструкция, которую клон
/// может явно «процитировать» при ответе.
///
/// Lifecycle:
///   - shadow      — кандидат, добавляется в retrieval с долей `trafficShare`
///                   (≈10% запросов), накапливает SkillUsage для оценки.
///   - active      — выдерживает evaluator-gate, добавляется ВСЕГДА.
///   - archived    — proven хуже baseline за окно ≥30 runs.
///   - deprecated  — replaced более новой версией / устарел.
///
/// Источник доказательств: Voyager NeurIPS 2023, SkillWeaver arxiv 2504.07079.
/// См. plans/tz/2026-05-29-agents-v2-umbrella.md §C1.
model PracticeSkill {
  id                      String                       @id @default(uuid())
  tenantId                String
  scope                   SkillScope
  /// personId / roleId / orgId — без формального FK (тройная природа),
  /// валидируется на уровне сервиса. Для scope='org' = tenantId.
  scopeRefId              String
  /// Триггер: «когда клиент возражает на цену enterprise». ≤200 chars по schema.
  trigger                 String                       @db.Text
  /// Embedding `trigger` (text-embedding-3-small, 1536d). Используется в KNN
  /// retrieval (cosine ≥ cfg.practiceSkills.knnRetrievalThreshold) и dedup
  /// при extraction (cosine ≥ cfg.practiceSkills.knnDedupThreshold).
  triggerEmbedding        Unsupported("vector(1536)")?
  /// Шаги процедуры: [{order:1, action:"...", emotionalRegister?:"...", redFlags?:[]}].
  steps                   Json
  /// Примеры применения: [{episodeBlockId, outcome:'success'|'fail'|'mixed', editDistance?}].
  examples                Json
  /// «Чего НЕ делать в этом скилле» — string[]. Дублируется на шагах для
  /// retrieval-удобства (LLM получает общий redFlags + per-step).
  redFlags                Json
  status                  PracticeSkillStatus          @default(shadow)
  /// 0..1 — доля случаев, в которые retrieval подмешивает skill при status='shadow'.
  /// Для status='active' игнорируется (всегда 1.0 эффективно).
  trafficShare            Float                        @default(0.1)
  /// Аудитный snapshot evaluator'а: {runs, successRate, vsBaseline, composite, lastEvalAt}.
  /// Заполняется PracticeSkillEvaluatorCron'ом.
  shadowMetrics           Json?
  /// Денормализованный success rate (последняя оценка). 0..1.
  successRate             Float?
  /// Последняя дата использования в retrieval (для archive idle skills).
  lastUsed                DateTime?
  /// SkillTraitConcept.id[], из которых извлечён skill (extractor-trail).
  derivedFromConceptIds   String[]                     @default([])
  /// SkillTrait.id[], из которых извлечён skill (extractor-trail).
  derivedFromTraitIds     String[]                     @default([])
  /// Сколько IdeaBlock-эпизодов учли при извлечении.
  derivedFromEpisodeCount Int                          @default(0)
  /// Manual priority flag (admin: «📌 Закрепить»). Если true — retrieval
  /// поднимает в начало topK при равных confidence.
  pinned                  Boolean                      @default(false)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  promotedAt              DateTime?
  archivedAt              DateTime?
  archivedReason          String?                      @db.Text
  version                 Int                          @default(1)

  tenant Org          @relation("PracticeSkillTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  usages SkillUsage[]

  @@index([tenantId, scope, scopeRefId, status])
  @@index([tenantId, status, lastUsed])
  // HNSW индекс на triggerEmbedding не объявляем здесь — Prisma не поддерживает
  // pgvector index types. Создаётся в backend/scripts/postgres-init.sql.
  @@map("practice_skills")
}

/// Agents v2 Фаза C1 (2026-05-30) — SkillUsage — лог использования PracticeSkill
/// в одном clone-respond'е. Используется evaluator'ом для расчёта composite
/// score (editDistance + outcome + adversarial-verify).
model SkillUsage {
  id                String   @id @default(uuid())
  tenantId          String
  practiceSkillId   String
  /// ChatV2Conversation.id (clone_style mode), внутри которого использован skill.
  conversationId    String
  /// ChatV2Message.id, в ответ на который retrieval вернул этот skill.
  messageId         String
  /// true — skill попал в SYSTEM/USER промпта; false — был отобран retrieval'ом,
  /// но shadow sampling (trafficShare) отсеял (для метрик «сколько отсеяли»).
  wasUsed           Boolean  @default(true)
  /// 'accepted_as_is' | 'edited' | 'rejected' | 'pending'. Заполняется
  /// post-hoc обработчиком user feedback / followup edits.
  outcome           String?  @db.VarChar(40)
  /// Levenshtein normalized 0..1 — между clone ответом и финальной user-версией.
  /// null = ещё не оценили (pending) или нет edited-версии.
  editDistance      Float?
  /// Произвольные downstream сигналы для будущей аналитики (clicks, response time…).
  downstreamSignals Json?
  createdAt         DateTime @default(now())

  tenant        Org           @relation("SkillUsageTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  practiceSkill PracticeSkill @relation(fields: [practiceSkillId], references: [id], onDelete: Cascade)

  @@index([practiceSkillId, createdAt])
  @@index([conversationId])
  @@index([tenantId, createdAt])
  @@map("skill_usages")
}

/// Agents v2 Фаза C1 — scope PracticeSkill.
///   - person — навык конкретного сотрудника (по personId).
///   - role   — навык роли (по roleId), агрегат паттернов носителей.
///   - org    — навык всей компании (по orgId/tenantId).
enum SkillScope {
  person
  role
  org
}

/// Agents v2 Фаза C1 — lifecycle PracticeSkill (см. модель выше).
enum PracticeSkillStatus {
  shadow
  active
  archived
  deprecated
}

/// SBA γ-1 доделки — SkillTraitCategory — эмерджентная категория группы
/// `SkillTrait`. Заменяет free-string `SkillTrait.category` first-class моделью
/// для следующих сценариев:
///   - Куратор может слить две дублирующиеся категории через CurationDecisionType
///     `merge_categories` (см. α-4 wave 2 enum-value).
///   - Категории получают slug для URL-safe ссылок (`/skills/categories/:slug`).
///   - Иерархия (parentCategoryId) — задел: можно сгруппировать «низкоуровневые»
///     категории в «высокоуровневые» (на γ-1 не используем активно).
/// См. plans/tz/2026-05-23-sba-gamma-1-finishing-skilltraitcategory-persona-versioning.md.
model SkillTraitCategory {
  id               String    @id @default(cuid())
  tenantId         String
  name             String    @db.VarChar(200)
  /// URL-safe slug (latinized + lowercased). Уникален per-tenant.
  slug             String    @db.VarChar(220)
  description      String?   @db.Text
  /// Иерархия категорий — задел; на γ-1 не используется.
  parentCategoryId String?
  /// Если категория была merge-источником (поглощена в target) — выставляется
  /// soft-delete момент. Сама запись остаётся для аудита и rollback.
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Org                  @relation("SkillTraitCategoryTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  parent   SkillTraitCategory?  @relation("SkillTraitCategoryToParent", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children SkillTraitCategory[] @relation("SkillTraitCategoryToParent")
  traits   SkillTrait[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
  @@index([parentCategoryId])
  @@map("skill_trait_categories")
}

/// ExecutablePersona — версионированный snapshot «думай как X» / «думай как Role».
/// Собирается раз в неделю cron'ом (ExecutablePersonaBuildCron) + on-demand
/// через admin API. Используется ClonesService при ответе в стиле сотрудника.
/// См. sub-TZ §4.
model ExecutablePersona {
  id                    String        @id @default(uuid())
  tenantId              String
  /// Для scope='person' — обязателен (SkillProfile сотрудника).
  /// Для scope='role' — null (используется scopeRefId=roleId).
  profileId             String?
  scope                 PersonaScope
  /// Для scope='role' — Role.id. Для scope='person' — null (берём profileId).
  scopeRefId            String?
  version               Int
  snapshotAt            DateTime      @default(now())
  /// Сам persona prompt — структурированный текст «Думай как X. Тебя характеризует …».
  /// Длина 300–800 слов (TODO: на этапе γ-1 placeholder; финальную длину согласовать).
  personaPrompt         String        @db.Text
  /// SkillTrait.id[], попавшие в этот snapshot.
  includedTraitIds      String[]      @default([])
  status                PersonaStatus
  builtFromTraitsCount  Int
  /// SBA γ-1 доделки — почему этот snapshot был собран.
  /// 'scheduled' — еженедельный cron; 'threshold' — ≥N новых traits с прошлого
  /// snapshot; 'critical' — mark_as_misleading (severity=critical); 'manual' —
  /// вручную через admin API; 'on_demand' — on-the-fly из ClonesService.
  triggerReason         String?       @db.VarChar(40)
  /// SBA γ-1 доделки — время триггерного события (создания N-го trait'а / mark_misleading);
  /// нужно для метрики `executable_persona_snapshot_lag_seconds`.
  triggerEventAt        DateTime?
  /// Clones=Roles Ф1 (2026-05-25) — версия клона роли (1, 2, 3...).
  /// При смене носителя роли создаётся новая версия. null — для scope='person'
  /// (legacy) и для записей до backfill.
  roleVersion           Int?          @default(1)
  /// Clones=Roles Ф1 — Person.id текущего носителя роли (для scope='role').
  /// null — для scope='person', для архивных версий и пока компания
  /// не назначила первого носителя.
  currentBearerPersonId String?
  /// Clones=Roles Ф1 — публичное имя клона: «Клон Маркетолога v2».
  /// Генерируется при build/backfill. null — для legacy persona.
  publicName            String?
  /// Clones=Roles Ф1 — id предыдущей версии ExecutablePersona в цепочке
  /// версий клона роли (succeed-link).
  succeedsPersonaId     String?
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (как минимум 'internal'
  /// по правилу floor для executable_persona; private-trait'ы анонимизируются
  /// до sensitive по private-aggregation в DataClassPolicyService).
  dataClassAudit        Json?
  createdAt             DateTime      @default(now())

  tenant         Org                 @relation("ExecutablePersonaTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  profile        SkillProfile?       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Clones=Roles Ф1 — связь на предыдущую версию персоны.
  succeeds       ExecutablePersona?  @relation("PersonaSuccession", fields: [succeedsPersonaId], references: [id])
  /// Clones=Roles Ф1 — обратная связь: какие персоны заменили эту.
  succeededBy    ExecutablePersona[] @relation("PersonaSuccession")

  @@unique([profileId, scope, scopeRefId, version])
  @@index([scope, scopeRefId, status])
  @@index([tenantId])
  /// Clones=Roles Ф1 — быстрый lookup «активная версия клона роли».
  @@index([scope, scopeRefId, status, roleVersion])
  @@map("executable_personas")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA β-6 — Experiment Tracker (Specialist 3.9)
// Источник: plans/tz/2026-05-23-sba-beta-6-experiment-tracker.md
//
// Идея: институциональная память «что мы пробовали и что вышло». Specialist 3.9
// собирает Experiment-карточки из signalType={hypothesis, result, lesson},
// отслеживает переходы Experiment ↔ Insight ↔ Decision через EntityLink
// predicates (см. EntityTransitionCron). Auto-status transitions только при
// confidence ≥ 0.7 (иначе probe куратору).
// ─────────────────────────────────────────────────────────────────────────

/// Эксперимент компании — гипотеза → выполнение → результат → урок.
/// First-class сущность (не extension Decision/Insight). Может быть автономной
/// (running без результата 90 дней) или закрытой (completed / dropped).
///
/// Status machine: `hypothesis → running → completed | dropped` (+ опц. `paused`).
/// Auto-status transitions выполняются `experiment-status-resolver.cron` каждые
/// 6 часов ТОЛЬКО при confidence ≥ 0.7; иначе оставляем текущий статус и эмитим
/// probe куратору (см. β-6 §3 решение #3).
model Experiment {
  id               String    @id @default(cuid())
  tenantId         String
  /// Краткое имя эксперимента (для UI и поиска).
  name             String
  /// Полный текст гипотезы — главный источник для retrieval и дедупа.
  hypothesisText   String    @db.Text
  /// Опц. владелец (Person.entityId, не Person.id — для согласованности с графом).
  ownerEntityId    String?
  /// Статус: hypothesis | running | completed | dropped | paused.
  /// Без enum — гибкость для будущих доделок (см. β-6 §3 решение #2).
  status           String    @default("hypothesis")
  /// Текущий результат (краткий summary). NULL = ещё нет результата.
  currentResult    String?   @db.Text
  /// Уроки — Array<{ text, sourceBlockId, type ∈ {what_worked|what_failed|next_time} }>.
  /// Multi-faceted (см. β-6 §3 решение #5).
  lessonsJson      Json?
  /// Когда эксперимент стартовал (заполняется при status=running).
  startedAt        DateTime?
  /// Когда эксперимент завершён (заполняется при status ∈ {completed, dropped}).
  completedAt      DateTime?
  /// IdeaBlock'и, на которых построен Experiment (гипотеза + результаты + уроки).
  sourceBlockIds   String[]  @default([])
  /// Person'ы, упомянутые в блоках как subject (для атрибуции в γ-1 SkillProfile).
  personSubjectIds String[]  @default([])
  /// Последняя активная ExperimentVersion (snapshot перед каждым изменением).
  currentVersionId String?
  /// Уверенность extraction [0..1] (Decimal(4,3) — 3 знака после точки).
  /// Auto-status transition ТОЛЬКО при confidence ≥ 0.7 (см. §3 решение #3).
  confidence       Decimal   @default(0.500) @db.Decimal(4, 3)
  /// Опц. связка с Entity-графом (для отображения в graph view).
  entityId         String?
  /// Когда последний раз подтверждали актуальность (используется для probe «no_owner»).
  lastConfirmedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions ExperimentVersion[]

  // Частые фильтры master-detail UI + status-resolver cron.
  @@index([tenantId, status])
  @@index([tenantId, ownerEntityId])
  @@index([tenantId, updatedAt])
  @@map("experiments")
}

/// Immutable snapshot Experiment'а перед каждым существенным изменением (status
/// transition, добавление result/lessons). Хранит весь payload в snapshotJson.
/// Используется для audit-trail и rollback'а в UI (β-6 §5).
model ExperimentVersion {
  id            String   @id @default(cuid())
  /// FK на родительский Experiment.
  experimentId  String
  /// Tenant дублируется для cardinality-safe фильтров (Org-Admin / soft-delete).
  tenantId      String
  /// Возрастающий счётчик версий (1, 2, 3, ...). @@unique([experimentId, versionNumber]).
  versionNumber Int
  /// Сериализованный snapshot Experiment-поля (всё значимое: status, currentResult,
  /// lessonsJson, sourceBlockIds, confidence, etc.).
  snapshotJson  Json
  /// Краткая причина создания версии (для UI «история»).
  changeReason  String?  @db.VarChar(120)
  createdAt     DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  tenant     Org        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, versionNumber])
  @@index([tenantId, experimentId])
  @@map("experiment_versions")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA γ-2 — Concierge Agent
//
// Сквозной UX-слой кабинета: floating button в AppShell + страница /assistant +
// <ConciergeSlot>. Понимает context страницы (route, currentEntityId), имеет
// доступ к whitelist REST-эндпоинтам через tool-use, может выполнить действие
// за пользователя. Поддерживает Undo через ConciergeUndoLog.
//
// См. plans/tz/2026-05-23-sba-gamma-2-concierge-agent.md §5.
// ─────────────────────────────────────────────────────────────────────────

/// Диалог пользователя с Concierge Agent. Один пользователь может иметь
/// множество параллельных диалогов (например, по контексту страницы).
model ConciergeConversation {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  /// Снимок pageContext на момент создания диалога (route, currentEntityId, …).
  pageContextJson Json?
  startedAt       DateTime  @default(now())
  lastMessageAt   DateTime?
  /// Сжатый summary длинного диалога (заполняется conversation-summarizer cron).
  summary         String?   @db.Text
  archivedAt      DateTime?

  user     User               @relation("ConciergeConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant   Org                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages ConciergeMessage[]
  undoLogs ConciergeUndoLog[]

  @@index([tenantId, userId, lastMessageAt])
  @@index([tenantId, archivedAt])
  @@map("concierge_conversations")
}

/// Сообщение диалога Concierge.
///   - role='user'      — пользовательский запрос.
///   - role='assistant' — текст ответа LLM.
///   - role='tool'      — результат tool call (для tool-use loop).
model ConciergeMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   @db.VarChar(16)
  content        String   @db.Text
  /// Запрошенные LLM tool calls — Array<{ id, name, arguments }>.
  toolCallsJson  Json?
  createdAt      DateTime @default(now())

  conversation ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("concierge_messages")
}

/// Лог выполненных tool calls с rollback-инструкциями. Используется для
/// «Готово. Отменить» action toast'ов.
model ConciergeUndoLog {
  id                  String    @id @default(cuid())
  tenantId            String
  conversationId      String
  toolName            String    @db.VarChar(120)
  paramsJson          Json
  resultJson          Json
  /// Описание, как откатить действие. Например:
  ///   { method: 'POST', path: '/api/v1/meetings/:id/cancel', params: {...} }
  /// NULL → действие нельзя отменить (concierge должен явно предупредить).
  undoInstructionJson Json?
  executedAt          DateTime  @default(now())
  rolledBackAt        DateTime?

  conversation ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Org                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, executedAt])
  @@index([conversationId, executedAt])
  @@map("concierge_undo_logs")
}

/// Anti-abuse: дневная / месячная квота сообщений Concierge на Org. Realtime-
/// счётчики живут в Redis, а БД — для durable snapshot и cron-reset.
model OrgConciergeQuota {
  tenantId             String    @id
  dailyMessagesLimit   Int       @default(100)
  monthlyMessagesLimit Int       @default(3000)
  currentDailyCount    Int       @default(0)
  currentMonthlyCount  Int       @default(0)
  resetDailyAt         DateTime?
  resetMonthlyAt       DateTime?
  updatedAt            DateTime  @updatedAt

  tenant Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("org_concierge_quotas")
}

// ──────────────────────────── SBA δ-1 — Orchestrator (multi-agent research) ────────────────────────────

/// Один запуск Orchestrator'а — multi-agent deep research для сложных
/// запросов («составь отчёт по X», «сравни Y и Z»). 4 шага:
///   planning → subagents_running → synthesizing → verifying → done|failed.
///
/// Hard limits (anti-cost-runaway):
///   - depth=1 (subagent не может spawn'ить subagent'ов);
///   - max 5 subagents per run;
///   - 15-min timeout;
///   - feature-flag ORCHESTRATOR_ENABLED default false.
///
/// `planJson`         — массив шагов { agentType, contextSlice }.
/// `synthesisJson`    — { text, citations[] }.
/// `verificationJson` — { confidence: 0..1, reasoning, retried: boolean }.
model OrchestratorRun {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  task             String    @db.Text
  /// planning | subagents_running | synthesizing | verifying | done | failed.
  status           String    @default("planning") @db.VarChar(32)
  planJson         Json?
  synthesisJson    Json?
  verificationJson Json?
  /// Сообщение об ошибке (для status='failed') — для UI и логов.
  errorMessage     String?   @db.Text
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  user   User @relation("OrchestratorRunUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobs OrchestratorSubagentJob[]

  @@index([tenantId, userId, startedAt])
  @@index([status])
  @@map("orchestrator_runs")
}

/// Один subagent-job в рамках OrchestratorRun. Запускается параллельно
/// через BullMQ-очередь `orchestrator.subagents`.
///
/// `agentType` ∈ { 'entity_research', 'comparison', 'topic_summary',
/// 'timeline_construction' }.
/// `contextJson` — изолированный slice контекста (НЕ полная история run'а).
/// `resultJson`  — { text, citations[], confidence? }.
model OrchestratorSubagentJob {
  id           String    @id @default(cuid())
  runId        String
  stepIndex    Int
  agentType    String    @db.VarChar(64)
  contextJson  Json
  resultJson   Json?
  /// pending | running | done | failed.
  status       String    @default("pending") @db.VarChar(16)
  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?

  run OrchestratorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepIndex])
  @@index([status])
  @@map("orchestrator_subagent_jobs")
}

// ──────────────────────────── tracker: Phase 1 (Sprint 1, 2026-05-24) ────────────────────────────
// Полноценный таск-трекер Z/Кора поверх legacy `Task`. См. план:
// plans/tz/2026-05-23-tracker-phase-1-models-api.md.
//
// Все модели имеют `tenantId String` (multi-tenancy), `createdAt`, `updatedAt`
// (где нужно), soft-delete через `deletedAt` (для основных сущностей).
// `entityId String?` — связь с графом знаний (Entity) — opt.
// НЕ добавляем embedding pgvector в Issue — это Phase 3 (Sprint 6).

/// Проект трекера. Каждый проект имеет короткий идентификатор (префикс задач
/// `KORA-`, `SALES-` и т.д.) и slug, уникальные в рамках org.
model Project {
  id                String    @id @default(cuid())
  tenantId          String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource    String?
  slug              String // короткий уникальный slug per tenant
  identifier        String // префикс задач: PROJ, SALES, DEV (до 5 симв.)
  name              String
  description       String?   @db.Text
  ownerId           String
  defaultAssigneeId String?
  defaultStateId    String?
  network           Int       @default(0) // 0=Private, 2=Public-внутри-org
  archivedAt        DateTime?
  timezone          String    @default("Europe/Moscow")

  // Feature flags per project
  cycleViewEnabled    Boolean @default(true)
  intakeViewEnabled   Boolean @default(true)
  gantViewEnabled     Boolean @default(true)
  timeTrackingEnabled Boolean @default(false)

  /// audit (2026-06-06) — системно-сгенерированный проект-контейнер
  /// (org-scope «Спринт компании» из quickCreate). Скрыт из GET /projects;
  /// спринты доступны через раздел «Спринты». См. ТЗ A6.
  systemGenerated Boolean @default(false)

  // Tracker Phase 4 (Email-to-task, T5) — уникальный alias для приёма писем.
  // Полный адрес = `${emailInboxAlias}@${MAIL_INBOX_DOMAIN}`.
  // - emailInboxAlias: nullable + @unique (одноимённый alias невозможен в принципе).
  // - emailInboxEnabled: kill-switch на проект (по умолчанию выключено).
  emailInboxAlias   String? @unique
  emailInboxEnabled Boolean @default(false)

  // Шаблон команды, из которого создан
  teamTemplateId String?
  teamTemplate   TeamTemplate? @relation(fields: [teamTemplateId], references: [id], onDelete: SetNull)

  // Связь с графом
  entityId String?

  /// Sprints (2026-05-27) — гибкая привязка проекта-спринта. Один из 4 опц.
  /// scope-полей может быть заполнен (или ни одного — «Спринт компании»).
  /// Инвариант: не более 1 заполненного поля. Валидация — в
  /// `ProjectsService.create/update` (см. plans/tz/2026-05-27-sprints.md §1.6).
  customerCardId  String?
  customerCard    Card?       @relation("ProjectCustomerCard", fields: [customerCardId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          Vendor?     @relation("ProjectVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  subjectPersonId String?
  subjectPerson   Person?     @relation("ProjectSubjectPerson", fields: [subjectPersonId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department? @relation("ProjectDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members           ProjectMember[]
  issues            Issue[]
  cycles            Cycle[]
  states            IssueState[]
  labels            Label[]
  mailInboundLogs   MailInboundLog[]
  /// Tracker Boards (2026-05-27) — несколько досок per project (Weeek/Kaiten-паритет).
  /// При создании проекта одна доска isDefault=true создаётся автоматически
  /// (см. `BoardsService.ensureDefaultBoard` + `backfill-default-board.ts`).
  boards            Board[]
  /// Tracker Project Documents (2026-05-27) — простые rich-text документы,
  /// привязанные к проекту (бриф, ТЗ, протокол, инструкция). См. модель
  /// `ProjectDocument` ниже и plans/tz/2026-05-27-tracker-project-documents.md.
  documents         ProjectDocument[]
  /// ТЗ-4 Ф1 — документы (Document), привязанные к этому проекту
  /// (Document.attachedProjectId). Имя поля `attachedDocuments`, т.к. `documents`
  /// уже занято под `ProjectDocument[]` (rich-text доки трекера).
  attachedDocuments Document[]        @relation("DocumentProject")

  @@unique([tenantId, slug])
  @@index([tenantId, archivedAt])
  @@index([tenantId, identifier])
  @@index([tenantId, customerCardId])
  @@index([tenantId, vendorId])
  @@index([tenantId, subjectPersonId])
  @@index([tenantId, departmentId])
}

/// Tracker Project Documents (2026-05-27) — простой rich-text документ,
/// привязанный к проекту (бриф, ТЗ, протокол, инструкция). Контент — TipTap
/// JSON. Иерархия `parentId` заложена в схему, в MVP UI плоский список с
/// возможностью «закрепить». См. plans/tz/2026-05-27-tracker-project-documents.md.
model ProjectDocument {
  id             String  @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title           String // «Бриф ремонта офиса»
  /// TipTap JSON (rich-text). Хранится «как есть», без серверной валидации схемы.
  content         Json
  /// Отрендеренный HTML (для preview, share, e-mail). Опционален.
  contentHtml     String? @db.Text
  /// Plain text без разметки — для поиска / AI / knowledge-core ingest.
  contentStripped String? @db.Text

  /// Иерархия (MVP UI плоский). При удалении родителя — children становятся
  /// корневыми (SetNull).
  parentId  String?
  parent    ProjectDocument?  @relation("ProjectDocumentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProjectDocument[] @relation("ProjectDocumentChildren")
  sortOrder Int               @default(0)

  pinned Boolean @default(false)

  /// Связь с графом знаний (Knowledge-core auto-tag через axis-classifier).
  entityId String?

  createdById String
  updatedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, title])
  @@index([projectId, sortOrder])
  @@index([projectId, deletedAt])
  @@index([tenantId])
  @@index([parentId])
}

/// Tracker Boards (2026-05-27) — доска внутри проекта (Канбан-доска маркетинга,
/// бэклога, релиза и т.п.). У каждой задачи есть одна `boardId`; колонки доски —
/// общий список `IssueState` проекта (не per-board). Одна доска per project
/// помечается `isDefault=true` и не может быть удалена.
///
/// Бизнес-смысл: пользователь, привыкший к Weeek/Kaiten, разделяет работу
/// внутри одного проекта по направлениям (Маркетинг / Монтаж / Личные задачи).
/// ТЗ: plans/tz/2026-05-27-tracker-boards.md.
model Board {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String // «Доска маркетинга», «Бэклог», «Релиз 2.0»
  color       String  @default("#5EEAD4")
  icon        String? // emoji или slug иконки lucide
  description String? @db.Text

  sequence   Int       @default(0) // порядок отображения в боковой панели
  isDefault  Boolean   @default(false) // одна доска per project помечается как default
  archivedAt DateTime?

  issues Issue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, name])
  @@index([projectId, sequence])
  @@index([tenantId])
}

/// M:M между User и Project. Роль числовая: 20=Admin, 15=Member, 5=Guest.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Int // 20=Admin, 15=Member, 5=Guest
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// Статус задачи в проекте (Backlog / In Progress / Done / Cancelled и пр.).
/// Каждый проект имеет свой набор статусов с порядком (`sequence`) и категорией.
model IssueState {
  id             String  @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  projectId      String
  name           String // «Бэклог», «В работе», «Готово»
  color          String  @default("#94A3B8")
  category       String // backlog | unstarted | started | completed | cancelled
  sequence       Int
  isDefault      Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, sequence])
  @@index([tenantId])
}

/// Цикл — «неделя работы» / спринт. Снимок прогресса обновляется cron'ом.
model Cycle {
  id             String   @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  projectId      String
  name           String // «Неделя 23», «Спринт продаж — июнь»
  startDate      DateTime
  endDate        DateTime
  ownedById      String?
  description    String?  @db.Text

  /// Снимок прогресса (агрегированный, обновляется cron'ом).
  /// Формат: { total: N, completed: M, inProgress: K, ... }
  progressSnapshot Json?

  version  Int    @default(1)
  timezone String @default("Europe/Moscow")

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Goals OKR v2 (2026-06-02) — «этот спринт продвигает цель X» (развилка 2).
  primaryGoalId String?
  primaryGoal   Goal?   @relation("CyclePrimaryGoal", fields: [primaryGoalId], references: [id], onDelete: SetNull)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  /// Sprints (2026-05-27) — встречи, явно привязанные к этому спринту через
  /// `POST /cycles/:id/start-meeting` (обычно type=sprint_review).
  linkedMeetings Meeting[]    @relation("MeetingLinkedCycle")
  /// Sprints (2026-05-27) — подсказки помощника по спринтам (Specialist 3-13).
  sprintHints    SprintHint[]

  @@index([projectId, startDate])
  @@index([tenantId])
  @@index([tenantId, completedAt])
  @@index([tenantId, primaryGoalId])
}

// ──────────────────────────── Sprints (2026-05-27) ────────────────────────────

/// Sprints (2026-05-27) — категория подсказки помощника по спринтам.
/// См. plans/tz/2026-05-27-sprints.md §1.1.
enum SprintHintKind {
  no_due_date
  no_description
  no_assignee
  due_date_at_risk
  recurring_carry_over
  no_recent_mentions
  conflicts_with_goal
  can_be_split
  similar_to_past_task
  generic
}

/// Sprints (2026-05-27) — уровень критичности подсказки.
enum SprintHintSeverity {
  info
  warning
  critical
}

/// Sprints (2026-05-27) — статус подсказки.
enum SprintHintStatus {
  active
  dismissed
  resolved
}

/// Sprints (2026-05-27) — подсказка помощника по спринтам (Specialist 3-13).
/// Создаётся воркером `3-13-sprint-helper`, отображается на странице спринта
/// в блоке «Помощник предлагает». Пользователь может закрыть (dismiss) или
/// пометить выполненной (resolve). См. plans/tz/2026-05-27-sprints.md.
model SprintHint {
  id             String  @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?
  cycleId        String
  cycle          Cycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  kind     SprintHintKind
  severity SprintHintSeverity
  title    String             @db.VarChar(300)
  body     String             @db.Text

  /// Id'ы Issue, к которым относится подсказка (могут быть пустыми для общих подсказок).
  affectedIssueIds String[] @default([])
  /// Id'ы IdeaBlock из графа знаний, на основании которых сделана подсказка.
  sourceBlockIds   String[] @default([])

  status            SprintHintStatus @default(active)
  /// Пользователь, который закрыл/разрешил подсказку.
  dismissedByUserId String?
  dismissedAt       DateTime?

  /// Confidence модели LLM (0..1).
  confidence  Decimal @db.Decimal(4, 3)
  /// SHA-1 hash от title+body — для дедупликации повторных подсказок в worker'е.
  /// Не индексируем (используется только при findOrCreate).
  contentHash String  @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, cycleId, status])
  @@index([tenantId, status, createdAt])
  @@index([cycleId, kind, contentHash])
}

/// Задача трекера. Расширение legacy `Task`. Самореферентная иерархия через
/// `parentId` (подзадачи). `identifier` уникален в рамках tenant (например
/// `KORA-123`), `sequenceId` — внутренний порядковый номер в проекте.
///
/// Phase 3 (Sprint 6, 2026-05-24): добавлен `embedding vector(1536)` для
/// KNN-поиска похожих задач + LLM-suggest goalId по семантике. HNSW-индекс
/// создаётся через `backend/scripts/postgres-init.sql` (cosine ops).
model Issue {
  id         String @id @default(cuid())
  tenantId   String
  projectId  String
  identifier String // PROJ-123 (уникален per tenant)
  sequenceId Int // 123 — внутренний порядковый номер per project

  title               String // ранее name
  description         String? @db.Text // rich-text JSON через TipTap
  descriptionHtml     String? @db.Text
  descriptionStripped String? @db.Text // plain text для поиска / индексации AI

  priority String  @default("none") // urgent | high | medium | low | none
  stateId  String?

  parentId String? // для иерархии подзадач

  estimatePoints Int?
  sortOrder      Int  @default(0)

  /// Денормализованные счётчики чек-листов (см. IssueChecklist / IssueChecklistItem).
  /// Пересчитываются в коде через ChecklistsService.recountCounters(issueId)
  /// при любом CRUD по чек-листам/пунктам — чтобы не делать COUNT() на каждый
  /// запрос списка задач (карточка канбана показывает «☑ 3/7» прямо из Issue).
  checklistTotalCount Int @default(0)
  checklistDoneCount  Int @default(0)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  /// Sprint 3 B1-3.1 — момент последнего обнаружения просрочки
  /// `IssueOverdueDetectorCron`. Используется для дедупликации: не
  /// эмитим overdue-событие в knowledge-core повторно в течение 7 дней.
  /// null — никогда не было overdue-эмиссии.
  lastOverdueDetectedAt DateTime?

  // Циклы и модули
  cycleId String?

  /// Tracker Boards (2026-05-27) — доска, к которой относится задача.
  /// Nullable на схеме (для случая если доска удалена → onDelete:SetNull),
  /// но фактически после backfill-default-board.ts всегда заполнено.
  /// Колонки внутри доски = `IssueState` проекта (общий справочник).
  boardId String?

  // СВЯЗИ С ДРУГИМИ СИСТЕМАМИ — критично для второго мозга
  goalId           String? // связь с Goal! (FK opt.)
  meetingId        String? // legacy compatibility
  linkedMeetingIds String[] // видеовстречи из задачи

  // AI metadata
  sourceBlockIds  String[] // если задача создана AI — откуда вытащил
  /// Денорм-снимок провенанса для рендера списков без join.
  previewQuote     String?  @db.Text
  /// { evidenceId, blockId, sourceType, sourceExternalId, startMs?, deepLink, attribution }
  previewSourceRef Json?
  confidence      Decimal? @db.Decimal(4, 3)
  createdManually Boolean  @default(true)

  /// Phase 3 — pgvector embedding (text-embedding-3-small, 1536 dim).
  /// Генерируется `issue-embed.worker` на create/update title+description.
  /// HNSW-индекс (cosine) создаётся через postgres-init.sql.
  embedding     Unsupported("vector(1536)")?
  embeddingHash String? // sha256(title + description) — чтобы не пересчитывать без изменений

  // Внешний источник
  externalSource String? // email | telegram | checkin | meeting | api | manual
  externalId     String?

  // Граф знаний
  entityId String?

  /// Р4 (TZ 2026-06-16, Ф4) — задача помечена «под вопросом» после отмены/замены
  /// связанного решения (supersede). null — обычная задача. НЕ авто-снос:
  /// показывается человеку в pending-actions, снимается при ручном решении.
  closureReviewState  String?   @db.VarChar(24) // null | superseded_decision
  closureReviewReason String?   @db.Text
  closureReviewAt     DateTime?

  // RBAC и owner
  createdById String

  // Support desk (TZ 2026-06-09 support-desk) — заполняются ТОЛЬКО для тикетов
  // поддержки (cross-tenant: клиент из другой Org пишет в вендор-Org).
  supportCustomerOrgId   String?   /// Org клиента, приславшего обращение
  supportCustomerUserId  String?   /// User клиента (глобальный User.id)
  supportCustomerContact String?   @db.VarChar(320) /// email/имя для отображения в деске
  firstResponseDueAt     DateTime? /// SLA: дедлайн первого ответа
  resolutionDueAt        DateTime? /// SLA: дедлайн решения
  firstRespondedAt       DateTime? /// факт первого ответа клиенту
  slaBreachedAt          DateTime? /// зафиксированное нарушение SLA

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state    IssueState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  cycle    Cycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  goal     Goal?       @relation("IssueGoal", fields: [goalId], references: [id], onDelete: SetNull)
  /// Tracker Boards (2026-05-27) — доска. onDelete: SetNull чтобы при удалении
  /// доски задача не пропала (сервис boards.service.ts перевешивает её на default
  /// в транзакции до удаления; SetNull — safety net).
  board    Board?      @relation(fields: [boardId], references: [id], onDelete: SetNull)
  parent   Issue?      @relation("IssueSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[]     @relation("IssueSubtasks")

  assignees    IssueAssignee[]
  labels       IssueLabel[]
  subscribers  IssueSubscriber[]
  mentions     IssueMention[]
  comments     IssueComment[]
  attachments  IssueAttachment[]
  links        IssueLink[]
  relationsOut IssueRelation[]   @relation("IssueRelationSource")
  relationsIn  IssueRelation[]   @relation("IssueRelationTarget")
  activities   IssueActivity[]
  versions     IssueVersion[]
  checklists   IssueChecklist[]
  progressUpdates IssueProgressUpdate[]
  fieldValues  IssueFieldValue[]
  worklogs     IssueWorklog[]

  /// Встречи, запущенные из этой задачи (см. `Meeting.linkedIssueId`).
  meetingsFromIssue Meeting[] @relation("MeetingLinkedIssue")

  /// Tracker Phase 4 (Email-to-task, T5) — логи входящих писем,
  /// из которых была создана эта задача. Обычно ≤1 запись на Issue.
  mailInboundLogs MailInboundLog[]

  /// TZ-1 Фаза 3.B (daily-value-engine) — связи задача↔решение (join).
  decisionLinks DecisionTaskLink[] @relation("DecisionTaskLinkIssue")

  taskSources TaskSource[]

  @@unique([projectId, sequenceId])
  @@unique([tenantId, identifier])
  @@index([tenantId, stateId, deletedAt])
  @@index([tenantId, dueDate])
  @@index([tenantId, goalId])
  @@index([tenantId, cycleId])
  @@index([tenantId, projectId, deletedAt])
  @@index([parentId])
  /// Tracker Boards (2026-05-27) — фильтр задач по доске на канбане.
  @@index([boardId])
  /// Support desk (TZ 2026-06-09) — тикеты конкретного клиента + SLA-сканер.
  @@index([tenantId, supportCustomerUserId])
  @@index([tenantId, firstResponseDueAt])
  /// Р4 (TZ 2026-06-16, Ф4) — выборка задач «под вопросом» для pending-actions.
  @@index([tenantId, closureReviewState])
}

/// Э2 (TZ 2026-06-16) — обратимое предложение закрыть задачу по сигналу из
/// разговора. НЕ меняет Issue сам: человек подтверждает в очереди pending-actions.
/// Закрытие применяется через IssuesService.transitionState(category='completed')
/// только при confirm. status: pending → accepted | rejected | expired.
model TaskClosureCandidate {
  id              String    @id @default(cuid())
  tenantId        String
  issueId         String    /// задача-кандидат на закрытие
  sourceBlockId   String    /// IdeaBlock-сигнал выполнения из разговора
  status          String    @default("pending") @db.VarChar(16)
  matchSimilarity Decimal?  @db.Decimal(4, 3)   /// cosine similarity матча блок↔Issue
  confidence      Decimal?  @db.Decimal(4, 3)   /// откалиброванная уверенность верификатора
  rationale       String?   @db.Text            /// «почему считаем сделанным» — человеческим языком, +/- сигналы
  evidenceQuote   String?   @db.Text            /// цитата из разговора (для показа человеку)
  decidedByUserId String?
  decidedAt       DateTime?
  expiresAt       DateTime?                      /// авто-протухание pending (sweep, как IntakeIssue)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Идемпотентность: один сигнал-блок → максимум один кандидат на задачу.
  @@unique([tenantId, issueId, sourceBlockId])
  @@index([tenantId, status])
  @@index([issueId])
}

/// M:M задача↔исполнители. Несколько ассайнеров на одну задачу разрешено.
model IssueAssignee {
  id           String   @id @default(cuid())
  issueId      String
  userId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

/// Метка (label). `projectId` null — глобальная метка организации.
model Label {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String? // null = глобальная метка организации
  name      String
  color     String

  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@index([projectId])
  @@index([tenantId])
}

/// M:M задача↔метка.
model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([labelId])
}

/// Подписчик на задачу — получает уведомления об изменениях.
model IssueSubscriber {
  id           String   @id @default(cuid())
  issueId      String
  userId       String
  subscribedAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

/// @-упоминание пользователя (в описании задачи или комментарии).
/// `commentId` — если упоминание в комментарии; иначе null (упоминание в самой задаче).
model IssueMention {
  id                String   @id @default(cuid())
  issueId           String
  commentId         String? // упоминание в комментарии
  mentionedUserId   String
  mentionedByUserId String
  createdAt         DateTime @default(now())

  issue   Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment IssueComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId])
  @@index([issueId])
  @@index([commentId])
}

/// Комментарий к задаче. Rich-text JSON + опц. голосовое сообщение.
/// Поддерживает треды через `parentCommentId`. Гость может оставлять
/// комментарии типа `external`.
model IssueComment {
  id              String  @id @default(cuid())
  issueId         String
  authorId        String
  parentCommentId String? // для тредов

  content         String  @db.Text // rich-text JSON
  contentHtml     String? @db.Text
  contentStripped String? @db.Text // plain для поиска / AI

  access String @default("internal") // internal | external (гость)

  // Support desk (TZ 2026-06-09) — провенанс + состояние черновика клона.
  authorType        String   @default("human") /// human | clone | system
  draftState        String?  /// null=обычный | pending | accepted | edited | rejected (только authorType=clone)
  cloneConfidence   Decimal? @db.Decimal(4, 3) /// калиброванная уверенность клона
  groundednessScore Decimal? @db.Decimal(4, 3) /// результат critic (truthful/total)

  // Голосовое сообщение
  voiceUrl        String?
  voiceDuration   Int? // секунды
  voiceTranscript String? @db.Text // транскрипт от Vox/GigaAM

  // Gamification (Wave 2): кто нажал «спасибо»
  thanksUserIds String[] @default([])

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  issue       Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  parent      IssueComment?     @relation("IssueCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  children    IssueComment[]    @relation("IssueCommentThread")
  mentions    IssueMention[]
  attachments IssueAttachment[]

  @@index([issueId, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
}

/// Датированное обновление прогресса задачи (Asana/Linear Project Update-стиль).
/// health — строкой (расширяемо, не enum). authorType=ai_agent + draftState=pending —
/// авто-черновик из графа, ждёт подтверждения человеком (НЕ авто-постинг).
model IssueProgressUpdate {
  id             String    @id @default(cuid())
  tenantId       String
  issueId        String
  authorId       String? /// null пока авто-черновик не подтверждён
  authorType     String    @default("human") /// human | ai_agent
  health         String /// on_track | at_risk | off_track (в норме/риск/буксует)
  body           String    @db.Text
  doneText       String?   @db.Text /// «что сделано»
  nextText       String?   @db.Text /// «что дальше»
  draftState     String? /// null=опубликовано | pending | accepted | edited | rejected (для ai_agent)
  sourceBlockIds String[]  @default([]) /// провенанс: блоки графа авто-черновика
  evidenceQuote  String?   @db.Text
  confidence     Decimal?  @db.Decimal(4, 3)
  previewQuote     String? @db.Text /// Д1: снимок цитаты-источника, контракт как Issue.previewQuote
  previewSourceRef Json? /// Д1: снимок ProvenancePreviewRef (deepLink ?t=/?page=N/?m=)
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, issueId, createdAt])
  @@index([issueId, createdAt])
  @@index([tenantId, draftState])
}

/// Определение кастом-поля задач (per-project или глобально по Org).
model IssueFieldDef {
  id         String    @id @default(cuid())
  tenantId   String
  projectId  String?   /// null = поле на всю Org
  name       String    @db.VarChar(100)
  type       String    /// text|number|date|checkbox|status|selectSingle|selectMulti|person|url (подмн. TablePropType)
  config     Json      /// { options:[{id,name,color}] } и т.п.
  order      Decimal   @db.Decimal(20, 10)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, projectId, order])
}

/// Значение кастом-поля для конкретной задачи.
model IssueFieldValue {
  id       String @id @default(cuid())
  tenantId String
  issueId  String
  fieldId  String
  value    Json

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, fieldId])
  @@index([tenantId, fieldId])
}

/// Запись учёта времени по задаче (датированная). Под Project.timeTrackingEnabled.
model IssueWorklog {
  id          String   @id @default(cuid())
  tenantId    String
  issueId     String
  userId      String
  minutes     Int
  description String?  @db.Text
  startedAt   DateTime /// дата работы (датированность)
  createdAt   DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, issueId, startedAt])
  @@index([userId, startedAt])
}

/// Пользовательское правило-автоматизация. trigger→conditions→actions как JSON.
model IssueAutomationRule {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String?  /// null = на всю Org
  name        String
  enabled     Boolean  @default(true)
  trigger     Json     /// { type: 'status_changed'|'assigned'|'created'|'due_approaching'|'label_added', ... }
  conditions  Json     /// [{ field, op, value }]
  actions     Json     /// [{ type:'set_status'|'assign'|'add_label'|'set_priority'|'notify'|'create_subtask', ... }]
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, projectId, enabled])
}

/// Повторение: материализует новую задачу по расписанию из снимка config.
model IssueRecurrence {
  id              String    @id @default(cuid())
  tenantId        String
  projectId       String
  templateIssueId String?
  rrule           String    /// { freq:'daily'|'weekly'|'monthly', interval, byweekday? } сериализованный
  config          Json      /// снимок: title, description, checklist[], assignees[], labels[], priority, estimate
  nextRunAt       DateTime
  lastRunAt       DateTime?
  enabled         Boolean   @default(true)
  createdById     String
  createdAt       DateTime  @default(now())

  @@index([tenantId, enabled, nextRunAt])
}

/// Шаблон задачи (ручное создание из шаблона).
model IssueTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String?
  name        String
  config      Json     /// { title, description, checklist[], labels[], priority, estimate, assigneeRole? }
  createdById String
  createdAt   DateTime @default(now())

  @@index([tenantId, projectId])
}

/// SLA-политика деска поддержки (синглтон per вендор-Org для v1). TZ support-desk Ф1.
model SupportSlaPolicy {
  id                String   @id @default(cuid())
  tenantId          String   @unique /// вендор-Org
  firstResponseMins Int      @default(60)
  resolutionMins    Int      @default(480)
  businessHoursOnly Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// CSAT/оценка тикета поддержки клиентом. TZ support-desk Ф1 (R-INV-2/R3 — чистый сигнал петле).
model IssueRating {
  id            String   @id @default(cuid())
  tenantId      String
  issueId       String   @unique
  score         Int      /// 1..5
  comment       String?  @db.Text
  ratedByUserId String?  /// клиент (User.id)
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Обучающий сигнал клона поддержки (R-INV-2): пара черновик→финал + тип правки.
/// TZ support-desk Ф3.
model SupportDraftOutcome {
  id                String   @id @default(cuid())
  tenantId          String   /// вендор-Org
  issueId           String
  draftCommentId    String?
  taskType          String   @default("support-clone-draft")
  draftText         String   @db.Text
  finalText         String?  @db.Text /// что реально ушло клиенту (null если отклонён)
  outcome           String   /// accepted | edited | rejected
  editType          String?  /// factual | tone | policy | empty | null
  cloneConfidence   Decimal? @db.Decimal(4, 3)
  groundednessScore Decimal? @db.Decimal(4, 3)
  promotedToContour Boolean  @default(false) /// прошёл гейт качества и попал в контур
  createdAt         DateTime @default(now())

  @@index([tenantId, taskType, createdAt])
  @@index([tenantId, issueId])
}

/// Аудит действий ночного куратора контура поддержки (TZ Ф4, R-INV-6/R24).
/// Каждая операция (в т.ч. отклонённая дебатом) фиксируется — что/почему/verdict.
model SupportCuratorAction {
  id             String   @id @default(cuid())
  tenantId       String   /// вендор-Org
  runDate        String   /// YYYY-MM-DD прогон (идемпотентность в пределах дня)
  blockId        String
  action         String   /// keep | promote | fix | merge | archive
  reason         String   @db.Text
  targetBlockId  String?  /// для merge — куда слили
  debateDecision String?  /// итог MultiAgentDebateService (для destructive)
  applied        Boolean  @default(false) /// применена ли (false = дебат отклонил / keep)
  createdAt      DateTime @default(now())

  @@index([tenantId, runDate])
  @@index([tenantId, blockId])
}

/// Вложение к задаче или комментарию.
model IssueAttachment {
  id           String   @id @default(cuid())
  issueId      String
  commentId    String? // если приложен к комментарию
  uploaderId   String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  thumbnailUrl String? // для картинок
  createdAt    DateTime @default(now())

  issue   Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment IssueComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([commentId])
}

/// Внешняя ссылка на задаче (URL + title).
model IssueLink {
  id        String   @id @default(cuid())
  issueId   String
  title     String
  url       String
  addedById String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

/// Tracker Phase 4 (Email-to-task, T5) — лог обработки входящих писем
/// в общем IMAP-ящике `MAIL_INBOX_*`. Используется для:
///   - идемпотентности по `messageId` (уникальный RFC822 Message-ID);
///   - аудита bounce/failed для отладки и UI «последние входящие письма»;
///   - связи Issue ← письмо (issueId nullable: bounce/failed).
enum MailInboundStatus {
  received // принято к обработке
  bounced // alias не найден / проект выключен
  failed // ошибка обработки (S3, Issue.create и т.п.)
  created // успешно создан Issue
}

model MailInboundLog {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// RFC822 Message-ID письма (с угловыми скобками снят). Идемпотентность —
  /// повторная обработка того же письма даёт `findUnique`-hit и skip.
  messageId String @unique

  fromEmail String
  subject   String

  status MailInboundStatus
  reason String? // human-readable код для bounced/failed

  issueId String?
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, status, createdAt])
  @@index([projectId, createdAt])
}

/// Связь между задачами: blocks / blocked_by / duplicates / relates_to.
model IssueRelation {
  id            String   @id @default(cuid())
  sourceIssueId String
  targetIssueId String
  relationType  String // blocks | blocked_by | duplicates | duplicated_by | relates_to
  createdById   String
  createdAt     DateTime @default(now())

  source Issue @relation("IssueRelationSource", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  target Issue @relation("IssueRelationTarget", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, relationType])
  @@index([targetIssueId])
}

/// Audit-trail задачи. `epoch` — микросекунды для строгой сортировки.
/// `actorType`: user | ai_agent | system. `agentName` заполнен только когда
/// `actorType='ai_agent'`.
model IssueActivity {
  id          String  @id @default(cuid())
  tenantId    String
  issueId     String
  actorUserId String?
  actorType   String // user | ai_agent | system
  agentName   String? // если actor — AI, какой именно

  verb     String // created | updated | status_changed | assigned | commented | linked | ...
  field    String? // если updated — какое поле
  oldValue Json?
  newValue Json?

  metadata Json? // доп. контекст (например, кто упомянут)
  epoch    BigInt // микросекунды для сортировки

  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, epoch])
  @@index([tenantId, createdAt])
}

/// Исторический снимок задачи (полный snapshot Json + связи на момент версии).
/// Создаётся при ключевых изменениях.
model IssueVersion {
  id              String   @id @default(cuid())
  issueId         String
  versionNumber   Int
  snapshot        Json // полный снимок Issue + связей на момент версии
  createdByUserId String
  createdAt       DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, versionNumber])
}

/// Чек-лист внутри задачи (плоский список пунктов). В одной задаче может быть
/// несколько чек-листов (например «Подготовка» и «Проверки»). Пункты — отдельная
/// модель IssueChecklistItem. См. plans/tz/2026-05-27-tracker-checklists.md.
model IssueChecklist {
  id       String @id @default(cuid())
  tenantId String
  issueId  String

  title    String @default("Чек-лист")
  sequence Int    @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  issue Issue                @relation(fields: [issueId], references: [id], onDelete: Cascade)
  items IssueChecklistItem[]

  @@index([issueId, sequence])
  @@index([tenantId])
}

/// Пункт чек-листа задачи. Без исполнителя/срока — только текст и состояние
/// «сделано / не сделано». Денормализованные счётчики на Issue
/// (checklistTotalCount / checklistDoneCount) пересчитываются в коде через
/// ChecklistsService.recountCounters(issueId) при любом CRUD по item.
model IssueChecklistItem {
  id          String @id @default(cuid())
  tenantId    String
  checklistId String

  text     String  @db.Text
  isDone   Boolean @default(false)
  sequence Int     @default(0)

  completedAt   DateTime?
  completedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist IssueChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, sequence])
  @@index([tenantId])
}

/// Входящая задача (inbox) перед триажем. AI-предложения по проекту,
/// исполнителю, цели, приоритету, дедлайну.
model IntakeIssue {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String? // если уже определён, иначе AI suggest

  status         String  @default("pending") // pending | snoozed | accepted | rejected | duplicate
  source         String // in_app | email | telegram | checkin | meeting | api | concierge
  sourceEmail    String?
  externalSource String?
  externalId     String?

  // Фикс linkedMeetingIds 2026-06-17 — ID встречи-источника (source='meeting').
  // При авто-приёме (IntakeAutoTriageWorker) прокидывается в Issue.linkedMeetingIds.
  meetingId      String?

  rawContent           String  @db.Text // исходный текст
  extractedTitle       String?
  extractedDescription String? @db.Text

  // AI-предложения
  suggestedProjectId  String?
  suggestedAssigneeId String?
  suggestedGoalId     String?
  suggestedPriority   String?
  suggestedDueDate    DateTime?
  suggestedLabels     String[]

  /// A10 (2026-06-14) — провенанс: IdeaBlock'и, на которых построен кандидат.
  /// Для intake из next-step отчёта / авто-экстракции встречи резолвится по
  /// canonical-блокам встречи. При промоуте в Issue прокидывается в
  /// `Issue.sourceBlockIds`; пересечение с `Decision.sourceBlockIds` той же Org
  /// рождает `DecisionTaskLink(linkType='derived')` (замыкание петли
  /// next-step → задача → решение). Пустой массив — провенанс неизвестен.
  sourceBlockIds      String[]  @default([])

  confidence Decimal? @db.Decimal(4, 3)

  // Триаж
  triagedByUserId String?
  triagedAt       DateTime?
  rejectedReason  String?
  snoozedUntil    DateTime?

  // Если принят — создаётся Issue
  createdIssueId String?

  /// TZ task-dedup (2026-06-16, Ф1 уровень A) — кандидат-дубль: открытая Issue,
  /// которую дедуп-арбитр (`task-dedup-arbiter`) счёл тем же поручением. НЕ
  /// авто-merge (R13): при заполненном поле auto-triage НЕ принимает карточку
  /// автоматически (route to human), человек сам сливает через triage
  /// decision='duplicate'. null — дубль не найден.
  suggestedDuplicateOfIssueId String?

  /// Редизайн Ф4 (2026-06-13) — авто-протухание pending-intake: после
  /// `expiresAt` sweep-крон (CurationItemLifecycleCron) переводит pending →
  /// rejected («авто-закрыт по сроку»), чтобы входящие не висели вечно. TTL
  /// вычисляется при создании (createdAt + cfg TTL). null — бессрочный
  /// (легаси-записи до миграции).
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([source, createdAt])
  @@index([tenantId, status, expiresAt])
  @@index([meetingId])
}

/// Исходящий webhook для внешних интеграций. `secretKey` хранится с префиксом
/// `kora_wh_` + 32 случайных байта. Доставка через очередь с exp backoff.
model IssueWebhook {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  url       String
  secretKey String // с префиксом `kora_wh_` + 32 байта

  events String[] // issue.created, issue.updated, comment.created, cycle.completed, ...

  /// W4.3 (KC-Temporal) — какие классы данных webhook'у разрешено принимать.
  /// Пустой массив трактуется как `['public','internal']` (default). `sensitive`/`private`
  /// не уходят в outbound webhook без явного opt-in админом.
  allowedDataClasses DataClass[] @default([public, internal])

  isActive   Boolean @default(true)
  isInternal Boolean @default(false)
  version    Int     @default(1)

  createdByUserId String
  createdAt       DateTime @default(now())

  logs IssueWebhookLog[]

  @@index([tenantId, isActive])
}

/// Лог доставки исходящего webhook'а. Используется для аудита и retry.
model IssueWebhookLog {
  id        String @id @default(cuid())
  webhookId String
  eventType String

  requestMethod  String
  requestUrl     String
  requestHeaders Json
  requestBody    Json

  responseStatus Int?
  responseBody   String? @db.Text
  responseTime   Int? // мс

  retryCount   Int     @default(0)
  success      Boolean
  errorMessage String?

  createdAt DateTime @default(now())

  webhook IssueWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

/// Шаблон команды (sales / development / installation / marketing / management / …).
/// `tenantId=null` — системный (платформенный) шаблон. `definition` — Json со
/// структурой { roles[], states[], laneTemplates[], typicalTasks[],
/// regulationStubs[], kpiTemplates[] }.
model TeamTemplate {
  id          String  @id @default(cuid())
  tenantId    String? // null = системный шаблон (платформенный)
  slug        String // sales | development | installation | marketing | management | ...
  name        String // «Команда продаж», «Команда разработки», ...
  description String  @db.Text
  category    String

  definition Json // { roles[], states[], laneTemplates[], typicalTasks[], regulationStubs[], kpiTemplates[] }

  isPublic   Boolean @default(true)
  usageCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@unique([tenantId, slug])
}

/// ImportLog — лог импорта задач из внешних трекеров (Битрикс24 / Trello / Я.Трекер).
/// Tracker Phase 5 (Sprint 8, 2026-05-24). Каждый импорт — отдельная запись с
/// progress'ом, итоговой статистикой и (если случилось) массивом ошибок.
/// Идемпотентность импорта — через Issue.externalSource + externalId.
model ImportLog {
  id                String    @id @default(cuid())
  tenantId          String
  source            String // 'bitrix24' | 'trello' | 'yandex_tracker'
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  totalProjects     Int       @default(0)
  totalIssues       Int       @default(0)
  totalComments     Int       @default(0)
  totalAttachments  Int       @default(0)
  processedItems    Int       @default(0) // для progress
  errors            Json? // массив { stage, externalId?, message } ошибок
  status            String    @default("running") // 'running' | 'completed' | 'failed' | 'cancelled'
  /// Параметры запуска — какие проекты выбраны + email-mapping pairs (для replay).
  paramsJson        Json?
  /// User-маппинг unmatched email'ов: какие пригласили, какие игнорировали.
  unmatchedJson     Json?
  initiatedByUserId String

  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

/// Производственный календарь РФ (или per-tenant override).
/// Tracker Phase 4 (Sprint 7, 2026-05-24) — учёт праздников в dueDate / cycle.endDate.
/// Если задача попадает на праздник — авто-перенос на следующий рабочий день.
/// `tenantId = null` — глобальный платформенный календарь.
/// `isWorking = true` — для перенесённых рабочих суббот (производственный календарь РФ).
model HolidayCalendar {
  id        String   @id @default(cuid())
  tenantId  String? // null = глобальный РФ-календарь
  date      DateTime // YYYY-MM-DD (хранится как DateTime, но логически date-only)
  name      String // «Новый год», «8 марта», «Перенесённая суббота 04.05»
  isWorking Boolean  @default(false) // true для перенесённых рабочих суббот

  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([date])
}

model PersonLeave {
  id        String   @id @default(cuid())
  tenantId  String
  personId  String
  fromDate  DateTime
  toDate    DateTime
  kind      String   @default("vacation")
  comment   String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId, fromDate, toDate])
}

// ──────────────────────────── Wave 2: Activity Feeds (2026-05-24) ────────────────────────────
// Sub-ТЗ: plans/tz/2026-05-23-activity-feeds.md
// Единая модель ленты активности — live-канал между AI-агентами и людьми.

/// Запись в ленте активности. Источник: AI-агент / пользователь / система.
/// 6 типов лент: probe_question | insight | decision | task | idea | conflict | knowledge_change.
model ActivityFeedItem {
  id       String @id @default(cuid())
  tenantId String

  feedType String // probe_question | insight | decision | task | idea | conflict | knowledge_change

  sourceType      String // ai_agent | system | user
  sourceAgentName String? // 'probe_agent' | 'insights_radar' | 'decisions_registry' | 'helpfulness_agent' | ...
  sourceUserId    String?

  relatedEntityType String? // probe_event | insight | decision | issue | idea | conflict_item | helpfulness_spotlight
  relatedEntityId   String?

  title    String
  summary  String? @db.Text
  iconType String? // question | bulb | check | warning | flame | thumbs
  severity String? @default("normal") // critical | high | normal | low

  status String // emitted | delivered | seen | responded | actioned | dismissed | expired

  visibility      String // public_org | team | role | private
  visibilityScope Json? // { teamIds: [], roleIds: [], userIds: [] }

  targetUserId  String?
  targetChannel String? // in_app | telegram | email | mobile_push

  teamId    String?
  projectId String?
  goalId    String?

  reactions Json? // { thanks: [userId, ...], votes: [userId, ...] }

  expiresAt DateTime?

  emittedAt   DateTime  @default(now())
  deliveredAt DateTime?
  seenAt      DateTime?
  respondedAt DateTime?
  actionedAt  DateTime?

  @@index([tenantId, feedType, emittedAt])
  @@index([tenantId, targetUserId, status])
  @@index([tenantId, teamId, emittedAt])
  @@index([tenantId, visibility, emittedAt])
  @@index([tenantId, expiresAt])
}

/// Подписка пользователя на конкретный тип ленты с фильтрами и режимом дайджеста.
model ActivityFeedSubscription {
  id         String   @id @default(cuid())
  userId     String
  feedType   String
  filters    Json // { teamIds, projectIds, severities, ... }
  digestMode String   @default("realtime") // realtime | daily_digest | weekly_digest | off
  channels   String[] @default(["in_app"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, feedType])
}

/// Редизайн Ф8.6 «Лента Коры» (2026-06-13) — per-user курсор «непрочитанного».
///
/// ActivityFeedItem.seenAt — единый timestamp на запись (НЕ per-user), поэтому
/// он не годится для метки «прочитано конкретным пользователем» в гибридной
/// ленте, которая виртуально читает ещё и source-таблицы (IdeaBlock / Insight /
/// Decision / ConflictItem / BlockerSynthesis) без собственного seenAt-поля.
///
/// `lastSeenAt` — момент, когда пользователь последний раз «дочитал» ленту до
/// верха (POST /feed/cora/seen). Запись из ленты считается непрочитанной
/// (`unread=true`), если её `createdAt > lastSeenAt`. Если курсора нет —
/// вся лента непрочитана.
/// (без relation на Org — как и ActivityFeedItem / ActivityFeedSubscription:
/// эти модели намеренно не заводят back-relation на Org, чтобы не раздувать
/// модель Org. tenant-scope обеспечивается WHERE-фильтром в сервисе.)
model FeedReadCursor {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, userId])
  @@map("feed_read_cursor")
}

// ──────────────────────────── Wave 2: Specialist 3.8 Helpfulness (2026-05-24) ────────────────────────────
// Sub-ТЗ: plans/tz/2026-05-23-specialist-3-8-helpfulness-agent.md
// Этическая защита: question_unanswered + question_acknowledged_no_action — только private (admin + руководитель), никогда публично.

/// Сигнал помощи / mentoring / поддержки, извлечённый из IdeaBlock-ов.
/// 7 типов traitType: help_provided | proactive_hint | mentoring | emotional_support |
/// constructive_feedback | question_unanswered | question_acknowledged_no_action.
/// Последние два — visibility='restricted' (только админ + руководитель).
model HelpfulnessTrait {
  id       String @id @default(cuid())
  tenantId String

  helperUserId    String
  recipientUserId String?

  traitType String // help_provided | proactive_hint | mentoring | emotional_support | constructive_feedback | question_unanswered | question_acknowledged_no_action
  intensity Decimal @db.Decimal(4, 3) // 0..1

  topicHint String?

  sourceBlockIds String[]
  evidenceQuote  String?  @db.Text

  contextEntityType String? // issue_comment | meeting_transcript_chunk | checkin
  contextEntityId   String?

  embedding Unsupported("vector(1536)")?

  confidence Decimal @db.Decimal(4, 3)

  visibility String @default("internal") // public_team | internal | restricted

  lastObservedAt DateTime
  decayedAt      DateTime?
  status         String    @default("active") // active | decayed | mark_as_misleading

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, helperUserId])
  @@index([tenantId, recipientUserId])
  @@index([tenantId, traitType, status])
  @@index([tenantId, status, lastObservedAt])
}

/// Агрегат вклада в команду per person. Пересчитывается SocialContributionProfileCron (05:00 UTC).
/// contributionScoreCached — НЕ публично, НЕ как рейтинг. Только для дашборда руководителя.
model SocialContributionProfile {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  helpProvidedCount     Int @default(0)
  proactiveHintCount    Int @default(0)
  mentoringCount        Int @default(0)
  emotionalSupportCount Int @default(0)

  expertiseTopics String[] @default([])

  socialRoles String[] @default([]) // mentor | connector | problem_solver | mood_keeper | trainer

  lastWeekHelpCount  Int @default(0)
  lastMonthHelpCount Int @default(0)

  contributionScoreCached Decimal? @db.Decimal(6, 3)

  buildVersion Int      @default(1)
  lastBuiltAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Публичный «спасибо» для ленты — формулирует LLM на основе HelpfulnessTrait-ов за период.
/// Status: pending → approved (руководителем) → published. Hidden = скрыто.
model HelpfulnessSpotlight {
  id             String  @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  helperUserId String
  topicHint    String?
  message      String  @db.Text

  periodFrom DateTime
  periodTo   DateTime

  helpCount Int

  traitIds String[] @default([])

  status           String  @default("pending") // pending | approved | published | hidden
  approvedByUserId String?

  publishedAt DateTime?
  feedItemId  String? // ссылка на ActivityFeedItem

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([helperUserId, periodFrom])
}

// ──────────────────────────── Wave 2: Recognition + Gamification (2026-05-24) ────────────────────────────
// Sub-ТЗ: plans/tz/2026-05-23-gamification-and-motivation.md
// Никаких рейтингов «топ-10», никаких очков-валюты. Бейджи без сравнения между людьми.

/// Благодарность / признание от AI или от пользователя.
/// types: thanks_comment | thanks_helpfulness | mention_helped | idea_shipped | streak_milestone | weekly_summary.
model Recognition {
  id             String  @id @default(cuid())
  tenantId       String
  /// audit Б3 (2026-05-29) — источник записи. 'demo' для seed-данных демо-кабинета;
  /// null для боевых. Фильтр в `resetDemoWorkspace`.
  externalSource String?

  fromUserId String? // null если от AI / системы
  toUserId   String

  type String

  contextEntityType String? // issue_comment | insight | regulation | idea | checkin | helpfulness_spotlight
  contextEntityId   String?

  message String? @db.Text

  visibility String @default("private") // private | team | public_org

  createdAt DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([tenantId, type])
  @@index([tenantId, toUserId, visibility])
}

/// Каталог бейджей. 5 базовых: ideator | expert | helper | aligned | consistent.
model Badge {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String  @db.Text
  iconUrl     String?
  condition   Json // { type: 'ideas_in_dev', threshold: 5 } и т.д.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBadges UserBadge[]
}

/// M2M user ↔ badge. Бейдж выдаётся один раз.
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
}

/// Агрегированные показатели вклада per user — обновляются ContributionSnapshotCron (04:00 UTC).
model ContributionSnapshot {
  id     String @id @default(cuid())
  userId String

  ideasInDevelopment Int @default(0)
  ideasShipped       Int @default(0)
  thanksReceived     Int @default(0)
  thanksReceivedWeek Int @default(0)

  currentCheckinStreak Int @default(0)
  longestCheckinStreak Int @default(0)

  helpfulComments        Int @default(0)
  probeQuestionsAnswered Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId])
}

// ──────────────────────────── Wave 2 finishing — Web Push (2026-05-24) ────────────────────────────
// PushSubscription — подписка браузера на push (Push API + VAPID).
// Frontend через navigator.serviceWorker.pushManager.subscribe() получает
// { endpoint, keys: { p256dh, auth } }; backend хранит для отправки notifications.
// failureCount накапливается при 410/404 (RFC 8030 §7.3) → удаление после PUSH_MAX_FAILURES.
model PushSubscription {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  endpoint     String    @db.Text
  p256dh       String
  auth         String
  userAgent    String?
  expiresAt    DateTime?
  lastSeenAt   DateTime  @default(now())
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([userId, endpoint])
  @@index([tenantId, userId])
}

// ════════════════════════════════════════════════════════════════════════════
// Admin Redesign Фаза 0 — Foundation (2026-05-25)
// План: plans/tz/2026-05-25-admin-redesign-tz.md
// Цель: вынести ~140 тюнинг-ENV в БД, дать UI управления продуктом super_admin'у.
// ════════════════════════════════════════════════════════════════════════════

/// AdminSetting — динамическая настройка, перекрывающая ENV-default.
/// Чтение через TypedConfigService.getDynamic(key, envFallbackKey?, default?).
/// При записи через AdminSettingsService: история в AdminSettingHistory + Redis
/// pub/sub 'admin:setting:invalidate' для перечитки в воркер-процессах.
model AdminSetting {
  key         String   @id
  value       Json
  /// "ai" | "platform" | "content" | "tenants" | "media" | "integrations" | "analytics" | "operations"
  category    String
  /// внутри категории: "knowledge-core" | "crons" | "retention" | ...
  section     String
  /// "low" | "medium" | "high" | "destructive" — определяет, обязательна ли reason при изменении.
  severity    String   @default("low")
  /// Идентификатор Zod-схемы из registry (для валидации значения и автогенерации UI-поля).
  schemaId    String?
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  /// Последняя причина изменения (для high/destructive обязательна, минимум 10 символов).
  comment     String?

  @@index([category, section])
}

/// История изменений AdminSetting. Полный audit-trail для UI вкладки «История».
model AdminSettingHistory {
  id        String   @id @default(cuid())
  key       String
  prevValue Json
  newValue  Json
  changedBy String
  reason    String?
  changedAt DateTime @default(now())

  @@index([key, changedAt])
}

/// LEGACY (ТЗ 2026-05-31 admin-plans-collapse-to-standard).
/// Модель оставлена в схеме для обратной совместимости и data-recovery;
/// CRUD-эндпоинты упразднены — на /api/v1/admin/orgs/plans остался только
/// GET /current (снимок единого `tier_standard` из AdminSetting + TIER_CONFIG).
/// Физическое удаление таблицы — отдельным ТЗ через 2 недели prod-наблюдений.
///
/// Plan — глобальный план продукта (basic/pro/enterprise/...). Содержит
/// фичи и квоты по умолчанию. Конкретная Org ссылается через OrgEntitlement.tier
/// (string, без foreign key — чтобы можно было soft-deactivate план).
model Plan {
  id              String   @id
  displayName     String
  description     String?
  /// { "ai_chat": true, "employee_clones": false, ... }
  features        Json
  /// { "max_meetings_per_day": 100, "max_chat_tokens_per_day": 2000000, ... }
  quotas          Json
  monthlyPriceRub Int?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// FeatureFlag — глобальный фиче-флаг с тремя уровнями: default → orgOverrides
/// → rolloutPercent (hash-based). Resolution: if key in orgOverrides → return;
/// if rolloutPercent && hash(orgId + key) % 100 < rolloutPercent → true; else default.
model FeatureFlag {
  key            String   @id
  description    String
  defaultValue   Boolean
  /// { "tenant_xxx": true, "tenant_yyy": false }
  orgOverrides   Json     @default("{}")
  rolloutPercent Int?
  /// "ai" | "ui" | "experimental" | "billing" | ...
  category       String
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

/// EmailTemplate — Handlebars-source plain text (как сейчас в mail.templates.ts).
/// htmlBody опционален — для маркетинговых писем в будущем.
model EmailTemplate {
  key       String   @id
  subject   String
  body      String   @db.Text
  htmlBody  String?  @db.Text
  /// { "name": "имя получателя", "magicLinkUrl": "ссылка на вход", ... }
  variables Json
  /// "transactional" | "marketing" | "system"
  category  String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// MeetingTypeConfig — конфигурация типов встреч (9 в MVP), редактируется
/// из админки. Сам enum MeetingType остаётся для type-safety, конфиг хранит
/// отображаемые поля и привязку к промпту отчёта. id матчится с MeetingType
/// enum-значением как строка.
/// reportPromptKey — FK на PromptTemplate.key (без явной relation, чтобы
/// можно было soft-rename промпта без миграции).
model MeetingTypeConfig {
  id                     String   @id
  displayName            String
  description            String?
  icon                   String?
  reportPromptKey        String?
  isActive               Boolean  @default(true)
  sortOrder              Int      @default(0)
  /// Ф2 knowledge-access — admin-editable дефолт закрытости для этого типа встречи.
  /// null = открыто; 'leadership' | 'council' | 'personal'. interview→'personal' (сид).
  defaultClosedGroupKind String?  @db.VarChar(20)
  updatedBy              String?
  updatedAt              DateTime @updatedAt
}

/// SystemMessage — баннеры пользователю / maintenance-режим / алерты.
/// targetOrgs пустой массив = показать всем; иначе — только перечисленным.
model SystemMessage {
  id         String    @id @default(cuid())
  /// "banner" | "maintenance" | "alert"
  type       String
  /// "info" | "warning" | "critical"
  severity   String
  body       String    @db.Text
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean   @default(true)
  /// Пустой массив = все Org.
  targetOrgs String[]
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([isActive, startsAt])
}

/// RetentionPolicy — глобальные сроки хранения данных по типу. Заменяет
/// *_RETENTION_DAYS ENV. type — стабильный идентификатор: "meeting_recording",
/// "share_view", "api_access_log", "webhook_delivery", "soft_delete_grace".
model RetentionPolicy {
  type        String   @id
  days        Int
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// CronSchedule — расписание @Cron-джоба, override'ит bootstrap-дефолт из
/// @Cron(EXPRESSION). CronManagerService.onModuleInit() читает таблицу и
/// перевешивает SchedulerRegistry. Pub/sub 'cron.schedule.updated' для
/// hot-reload без рестарта.
model CronSchedule {
  name              String    @id
  expression        String
  /// Bootstrap-дефолт из @Cron(...) — для сравнения и кнопки «Сбросить».
  defaultExpression String
  enabled           Boolean   @default(true)
  description       String?
  lastRunAt         DateTime?
  lastRunDurationMs Int?
  lastRunError      String?
  updatedBy         String?
  updatedAt         DateTime  @updatedAt
}

/// CronRunHistory — журнал запусков кронов (scheduled + manual). triggeredBy
/// null = scheduled, иначе userId super_admin'а который запустил вручную.
model CronRunHistory {
  id          String   @id @default(cuid())
  cronName    String
  startedAt   DateTime @default(now())
  durationMs  Int?
  /// "success" | "failed" | "running"
  status      String
  error       String?
  triggeredBy String?

  @@index([cronName, startedAt])
}

/// IntegrationSyncRun — журнал прогонов источников (Bitrix/ChatBox): забор (sync)
/// и AI-анализ (analyze) по каждому job. Закрывает дыру наблюдаемости — детальный
/// результат прогона ранее жил только в pino-stdout.
/// Источник правды: plans/tz/2026-06-19-integration-sync-observability.md
model IntegrationSyncRun {
  id         String    @id @default(cuid())
  tenantId   String
  /// "bitrix" | "chatbox"
  provider   String
  /// "sync" | "analyze"
  kind       String
  /// sync: all/users/dialogs/crm/incremental/customers/managers/chats ; analyze: null
  scope      String?
  /// sync: jobId ; analyze: sessionId
  refId      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  /// "running" | "success" | "failed" | "skipped"
  status     String
  /// counts забранного: { users: 2, dialogs: 5, ... } | analyze: { rawEventId, tasks }
  counts     Json?
  error      String?

  @@index([tenantId, provider, startedAt])
  @@index([provider, kind, status, startedAt])
}

/// W2.3 KC-Temporal (2026-05-25) — LlmPreferenceSample.
///
/// Каждое исправление пользователя через CurationDecision (mark_as_misleading,
/// rejected, rolled_back, approved) фиксируется как пример для будущего
/// retraining'а few-shot'ов и оценки качества LLM-агентов.
///
/// Источник правды: plans/tz/2026-05-25-knowledge-core-temporal-and-graph-quality.md §W2.3.
///
/// `taskType` — LlmTaskType из ai/services/llm-router.service.ts (хранится строкой
/// для расширяемости без миграций enum'а).
/// `label` — 'correct' | 'wrong' | 'misleading' | 'partially_correct'.
/// `inputContext` — сырой вход LLM (segment / block / candidates).
/// `modelOutput` — что LLM вернул (для voting/comparison).
model LlmPreferenceSample {
  id           String   @id @default(cuid())
  tenantId     String
  taskType     String
  inputContext Json
  modelOutput  Json
  label        String   @db.VarChar(40)
  reason       String?  @db.Text
  recordedBy   String   @db.VarChar(80)
  decisionId   String?
  createdAt    DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, taskType, createdAt])
  @@map("llm_preference_samples")
}

// ───────────────────────────────────────────────────────────────────────────
// User Feedback with AI Clustering (2026-05-25)
// Источник: plans/tz/2026-05-25-user-feedback-with-ai-clustering.md
// Канал прямой обратной связи пользователей продукту Z с ночным AI-агентом,
// который кластеризует тезисы в смысловые блоки.
// ───────────────────────────────────────────────────────────────────────────

/// Сообщение, отправленное пользователем через форму «Ваши предложения».
/// Один FeedbackMessage = одна отправка из UI. Лимит 5 в сутки на userId.
/// Может породить несколько FeedbackItem (по одному на тезис) после
/// ночной обработки агентом.
model FeedbackMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Org, в контексте которой пользователь писал сообщение (если он залогинен
  /// в Org). Опционально, потому что фидбэк глобальный — мы храним для
  /// аналитики «из каких org приходят запросы».
  orgId       String?
  org         Org?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  text        String    @db.Text
  createdAt   DateTime  @default(now())
  /// Помечается, когда ночной digest-воркер обработал сообщение и создал
  /// items. NULL = ещё не обработано, ждёт следующий прогон.
  processedAt DateTime?
  /// Счётчик неудачных попыток обработки. После 3 — сообщение исключается
  /// из дальнейших прогонов и попадает в /admin/feedback/messages/failed
  /// для ручного разбора.
  failedRuns  Int       @default(0)

  items FeedbackItem[]

  @@index([processedAt])
  @@index([userId, createdAt])
}

/// Смысловой блок обратной связи. Создаётся либо AI-агентом во время
/// ночного digest'а, либо вручную super-admin'ом. Items группируются в блок
/// по тематической близости тезисов.
model FeedbackTopic {
  id           String              @id @default(cuid())
  title        String
  description  String              @db.Text
  status       FeedbackTopicStatus @default(ACTIVE)
  archivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  /// Если блок был объединён с другим — здесь id «целевого» блока.
  /// Сами items при merge переносятся в target, а source помечается
  /// status=MERGED. См. /admin/feedback/topics/:sourceId/merge.
  mergedIntoId String?
  mergedInto   FeedbackTopic?      @relation("FeedbackTopicMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   FeedbackTopic[]     @relation("FeedbackTopicMerge")

  items FeedbackItem[]

  @@index([status])
  @@index([createdAt])
}

enum FeedbackTopicStatus {
  ACTIVE
  ARCHIVED
  MERGED
}

/// Тезис, выделенный AI-агентом из FeedbackMessage. Один FeedbackMessage
/// может породить несколько items (если пользователь высказал несколько
/// тем в одном сообщении). discarded=true означает, что агент посчитал
/// тезис мусором (spam / unintelligible / off-topic) и не привязал к блоку.
model FeedbackItem {
  id            String          @id @default(cuid())
  messageId     String
  message       FeedbackMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// NULL если discarded=true (мусор/спам), либо если блок был удалён
  /// (onDelete: SetNull сохраняет item для аналитики).
  topicId       String?
  topic         FeedbackTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  text          String          @db.Text
  discarded     Boolean         @default(false)
  /// 'spam' | 'unintelligible' | 'off-topic' | 'agent_marked'.
  discardReason String?
  createdAt     DateTime        @default(now())

  @@index([topicId, createdAt])
  @@index([messageId])
  @@index([discarded])
}

// ════════════════════════════════════════════════════════════════════════════
// ТЗ 2026-05-27 — Billing (Точка) + Реферальная программа + DaData
// См. plans/tz/2026-05-27-billing-tochka-referral-dadata-z.md
// ════════════════════════════════════════════════════════════════════════════

/// Платёжный провайдер для подписки. `manual` — заглушка (Subscription
/// ведётся только админскими действиями), `tochka` — реальная интеграция
/// с Точка Банком (acquiring + invoice + webhook).
enum BillingProviderName {
  tochka
  manual
}

/// Тип биллингового периода подписки.
enum BillingPeriod {
  monthly
  yearly
}

/// Статус подписки. Переходы — через FSM (SubscriptionService).
/// См. таблицу переходов в plans/analysis/2026-05-25-billing-and-referrals.md §4.3.
enum SubscriptionStatus {
  DEMO // Org зарегистрирована, демо-кабинет, без оплаты
  ACTIVE // подписка оплачена (paid) или активирована бонусом (bonus)
  PAST_DUE // платёж не прошёл, льготный период 7 дней
  SUSPENDED // льготный период истёк, read-only
  CANCELED // отменено автопродление, активна до конца оплаченного периода
  EXPIRED // период закончился, не продлили
}

/// Режим текущей подписки. `paid` идёт в выручку + реф-выплата. `bonus`
/// не идёт в выручку и не порождает реф-выплат.
enum PaymentMode {
  paid
  bonus
  /// 2026-06-01 — режим эталонной демо-Org. НЕ идёт в выручку, НЕ порождает
  /// реф-выплат, НЕ считается в `paid`/`bonus` метриках в billing-overview.
  /// Используется только на Org с `isReferenceDemo=true`.
  reference
}

/// Статус инвойса. Источник истины «клиент платный» = `Invoice { status='paid' }`.
enum InvoiceStatus {
  draft
  issued
  paid
  bonus
  void
}

/// Способ оплаты конкретного инвойса.
enum BillingPaymentMethod {
  card_recurring // Точка subscription (картой с автопродлением)
  bank_invoice // безнал через Точку (PDF на email)
  manual_admin // ручная отметка администратором (paid)
  bonus // бонусная активация без оплаты
}

/// Subscription — одна на Org (`@unique tenantId`). Денежные суммы хранятся
/// в копейках (Int) во всём биллинге Z.
model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  org      Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status        SubscriptionStatus @default(DEMO)
  paymentMode   PaymentMode?
  billingPeriod BillingPeriod?

  startedAt          DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// Конец grace-периода (7 дней после неуспешного платежа). Только в PAST_DUE.
  pastDueUntil       DateTime?

  /// Базовое число мест (главный + 30 сотрудников = 31 место). Поле — Int
  /// чтобы можно было изменить базу в будущем без миграции данных.
  seatsBase           Int @default(30)
  seatsExtra          Int @default(0)
  /// 60 000 ₽ × 100 = 6 000 000 копеек.
  monthlyPriceKopecks Int @default(6000000)
  totalPaidKopecks    Int @default(0)

  autoRenew     Boolean               @default(false)
  /// Способ возобновления при autoRenew=true. NULL для manual/bonus подписок
  /// без автопродления.
  renewalMethod BillingPaymentMethod?

  // ── Привязка к провайдеру (Точка / другие в будущем) ──
  providerName           BillingProviderName?
  providerSubscriptionId String?
  providerCustomerCode   String?
  providerConsumerId     String?
  lastRenewalAttemptAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events             SubscriptionEvent[]
  invoices           Invoice[]
  clientReferralLink ClientReferralLink?

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([renewalMethod, autoRenew, currentPeriodEnd])
}

/// История изменений Subscription (audit-trail FSM-переходов + админских
/// действий). См. plans/tz/2026-05-27-billing-tochka-referral-dadata-z.md §6.
model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// 'created' | 'activated_paid' | 'activated_bonus' | 'renewed' |
  /// 'past_due' | 'suspended' | 'canceled' | 'expired' | 'seats_changed' |
  /// 'status_forced' | 'provider_recurring_canceled'.
  eventType      String
  payload        Json
  byUserId       String?
  reason         String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, createdAt])
}

/// Счёт за подписку. `billingNumber` (autoincrement) → строковый
/// `invoiceNumber` (Z-YYYY-NNNNNN), формируется в InvoiceService.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  org            Org           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// Числовой sequence-номер (Postgres autoincrement). Строковый
  /// `invoiceNumber` (Z-2026-000123) формируется в коде на основе
  /// `billingNumber` + года `createdAt`.
  billingNumber Int                   @unique @default(autoincrement())
  invoiceNumber String                @unique
  periodStart   DateTime
  periodEnd     DateTime
  /// Состав счёта: [{ kind, qty, unitKopecks, totalKopecks, note }].
  items         Json
  totalKopecks  Int
  status        InvoiceStatus         @default(draft)
  paymentMethod BillingPaymentMethod?

  // ── PDF: наша генерация (manual/bonus) ИЛИ от Точки (bank_invoice) ──
  pdfUrl       String?
  pdfSource    String? // 'z' | 'tochka'
  pdfFetchedAt DateTime?

  // ── Привязка к провайдеру ──
  providerName      BillingProviderName?
  providerInvoiceId String? // operationId/documentId
  paymentUrl        String?
  externalStatus    String?

  issuedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  dueAt          DateTime?
  /// Внешний референс при ручной отметке оплаченным (номер платёжки клиента).
  externalRef    String?
  /// Кто отметил paid/bonus вручную. NULL для автоматики (webhook).
  markedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingEventLogs BillingEventLog[]
  referralPayouts  ReferralPayout[]

  @@index([tenantId, status])
  @@index([status, paidAt])
  @@index([providerInvoiceId])
}

/// Лог провайдерских событий + дедуп webhook'ов по `externalEventId`.
/// `externalEventId = <eventType>:<operationId>:<status>` — формат от
/// TochkaBillingProvider.parseWebhook.
model BillingEventLog {
  id              String               @id @default(cuid())
  tenantId        String?
  org             Org?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  subscriptionId  String?
  invoiceId       String?
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  eventType       String
  providerName    BillingProviderName?
  externalEventId String?
  /// audit Б4 (2026-05-29): JWT-jti для webhook'а Точки. Защита от replay.
  /// Уникальный — повторный INSERT с тем же jti кидает P2002 → controller
  /// отвечает 409 без обработки события.
  jti             String?              @unique
  payload         Json
  /// 'received' | 'processed' | 'failed'.
  status          String               @default("received")
  processedAt     DateTime?
  createdAt       DateTime             @default(now())

  /// audit Б7 (2026-05-29): атомарная защита от двойного обработки одного и
  /// того же event (двойной инкремент totalPaidKopecks при параллельных
  /// webhook-ретраях). Старый findFirst+create был TOCTOU — теперь unique
  /// делает дедуп атомарным на уровне БД.
  /// ВАЖНО: перед prisma:push на проде запустить patch-dedupe-billing-event-log.ts.
  @@unique([providerName, externalEventId], name: "uniq_provider_event")
  @@index([eventType])
  @@index([externalEventId])
  @@index([tenantId])
}

/// Узкая KV-таблица для биллинга: OAuth-токены, OAuth-state, регистрация
/// webhook'а. Не используем общий PipelineConfig (его нет в Z).
/// Ключи: 'tochka.production.oauth_tokens' | 'tochka.production.oauth_state'
/// | 'tochka.webhook_registration'.
model BillingProviderConfig {
  key       String   @id
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════════════════
// Накопительный баланс встреч (заменяет квоту meetings_per_month).
// ════════════════════════════════════════════════════════════════════════════

model MeetingsBalance {
  id       String @id @default(cuid())
  tenantId String @unique
  org      Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Текущий доступный остаток встреч (накопительный, без потолка).
  balance       Int       @default(0)
  totalGranted  Int       @default(0)
  totalConsumed Int       @default(0)
  lastGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════════════════
// Реферальная программа: профиль реферала + атрибуция + first-touch + payouts.
// ════════════════════════════════════════════════════════════════════════════

/// Юр.форма реферала — нужна чтобы знать какой документ для выплаты
/// требовать (чек НПД для самозанятого, акт для ИП/юрлица).
enum ReferralLegalForm {
  self_employed
  individual_entrepreneur
  legal_entity
}

/// Статус начисления реф-комиссии.
enum ReferralPayoutStatus {
  pending
  paid
  void
}

/// Реферальный профиль пользователя. Живёт независимо от его Org —
/// один user может быть реферал, владея другой Org.
model Referral {
  id          String @id @default(cuid())
  ownerUserId String @unique
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// Уникальный slug 6–8 символов, генерируется системой. URL вида
  /// https://app.z.ru/?ref=<slug>.
  slug               String             @unique
  /// Optional. Заполняется отдельно при подготовке к выводу (см. ТЗ §6.1).
  inn                String?            @db.VarChar(20)
  /// Подтверждение по API ИНН через InnLookupService.
  innVerifiedAt      DateTime?
  /// Optional. Обязателен если задан inn — проверка на уровне сервиса (ReferralsService.create).
  legalForm          ReferralLegalForm?
  /// Реквизиты для выплат (структура зависит от legalForm).
  /// Optional — заполняется отдельно при подготовке к выводу денег (см. ТЗ referrals-cabinet-revamp §6.1).
  payoutDetails      Json?
  /// Дата принятия оферты. Фиксируется при первой выплате.
  contractAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributions ReferralAttribution[]
  clientLinks  ClientReferralLink[]
  payouts      ReferralPayout[]

  @@index([slug])
}

/// Сырое касание лендинга. Cookie `z_ref` TTL = 90 дней (expiresAt).
/// Атрибуция используется первой попавшейся не-истёкшей записи на момент
/// регистрации Org.
model ReferralAttribution {
  id         String   @id @default(cuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  /// Дублируется (denorm) для read-without-join.
  slug        String
  /// Browser fingerprint (рассчитывается на клиенте).
  fingerprint String? @db.VarChar(64)
  ip          String? @db.VarChar(45)
  userAgent   String? @db.Text
  referer     String? @db.Text

  createdAt DateTime @default(now())
  /// createdAt + 90 дней.
  expiresAt DateTime

  /// audit-fixes Б8 (2026-05-29): дата (UTC, YYYY-MM-DD) для composite unique
  /// `(referralId, fingerprint, dateBucket)`. Защита от DoS-flood: даже если
  /// атакующий с одного fingerprint шлёт beacon тысячами в день, у нас в БД
  /// останется максимум 1 запись на партнёра-fingerprint в сутки.
  /// При fingerprint=NULL composite unique не работает (NULL не равно NULL
  /// в стандартном SQL), это допустимо — beacon без fingerprint достаточно
  /// редок (только если фронт не смог его посчитать).
  /// Optional — для совместимости с legacy-данными, новые записи всегда
  /// заполняют (см. AttributionService.record + patch-backfill-… скрипт).
  dateBucket String? @db.VarChar(10)

  @@unique([referralId, fingerprint, dateBucket], name: "uniq_referral_fp_date")
  @@index([slug, createdAt])
  @@index([fingerprint])
  @@index([expiresAt])
}

/// First-touch привязка Org к реферальному профилю. Создаётся ТОЛЬКО при
/// первой реальной оплате (paymentMode='paid'). До первой оплаты атрибуция
/// живёт на Org.pendingAttributionSlug.
model ClientReferralLink {
  id       String @id @default(cuid())
  tenantId String @unique
  org      Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  referralId String
  referral   Referral @relation(fields: [referralId], references: [id])

  attachedAt          DateTime  @default(now())
  /// Дата первой РЕАЛЬНОЙ оплаты (не bonus).
  firstPaidAt         DateTime?
  /// Снапшот ReferralAttribution.id, который победил при first-touch.
  sourceAttributionId String?

  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  payouts ReferralPayout[]

  @@index([referralId])
}

/// Начисление реф-комиссии за каждый реальный paid-инвойс приведённой
/// компании. Сумма фиксированная — 20 000 ₽ × 100 = 2 000 000 копеек.
model ReferralPayout {
  id                   String             @id @default(cuid())
  referralId           String
  referral             Referral           @relation(fields: [referralId], references: [id], onDelete: Cascade)
  clientReferralLinkId String
  clientReferralLink   ClientReferralLink @relation(fields: [clientReferralLinkId], references: [id], onDelete: Cascade)

  /// audit Б7 (2026-05-29): unique. На один Invoice — максимум один payout.
  /// Защита от двойной выплаты (40 000 ₽ вместо 20 000 ₽) при параллельных
  /// onInvoicePaid-обработчиках. ВАЖНО: перед prisma:push на проде запустить
  /// patch-dedupe-referral-payout.ts.
  triggerInvoiceId String?  @unique
  triggerInvoice   Invoice? @relation(fields: [triggerInvoiceId], references: [id], onDelete: SetNull)

  /// Месяц начисления — 'YYYY-MM' (для группировки в cron'е 10-го числа).
  periodMonth   String               @db.VarChar(7)
  /// 20 000 ₽ × 100 = 2 000 000 копеек (default).
  amountKopecks Int                  @default(2000000)
  status        ReferralPayoutStatus @default(pending)

  /// URL акта самозанятого / чека НПД / счёта ИП в S3.
  payoutDocumentUrl String?
  paidAt            DateTime?
  /// reason для status='void'.
  voidReason        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralId, periodMonth])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agents v2 Фаза B1 (2026-05-30) — AutoRule extract (shadow mode).
// См. plans/tz/2026-05-29-agents-v2-umbrella.md §B1.
//
// Записываем feedback по каждому LLM-вызову (original output) и
// edited-вариант (когда пользователь редактирует AI-генерированный текст).
// Cron `autorule-extract` ночью группирует похожие feedback'и по KNN
// и выводит правило (PromptRule) — все в `status='shadow'`, без инъекции в
// продакшн-промпты. Инъекция включится в Фазе C после ручной валидации.
// ─────────────────────────────────────────────────────────────────────────────

/// AutoRule Фаза B1 — запись об одном LLM-вызове и его пользовательской правке.
/// Идентифицируется `invocationId` = `AiUsageLog.id`. `editedOutput` заполняется
/// позже (когда поступает событие `ai.invocation.edited`), null до тех пор.
model PromptFeedback {
  id                String                       @id @default(cuid())
  tenantId          String
  /// `taskType` из `LlmTaskRoute` (например 'meeting-report-fast').
  /// Хранится строкой — taskType'ы добавляются часто, enum переусложнит.
  promptKey         String
  promptVersion     String
  /// Ссылка на `AiUsageLog.id`. NOT FK (AiUsageLog хранит ВСЕ вызовы, а
  /// feedback — только семейство user-facing). soft-link, дедуп — по uniq ниже.
  invocationId      String
  /// Короткий sha256 (первые 16 hex-символов) текста input'а — для group-by
  /// при отсутствии embedding'а (fallback ветка autorule-extractor'а).
  inputDigest       String                       @db.Text
  /// Эмбеддинг input'а (system+user) для KNN-группировки похожих контекстов.
  /// Лениво заполняется PromptFeedbackCollectorService через
  /// `EmbeddingFallbackService.embed`. Если null — group by inputDigest.
  inputEmbedding    Unsupported("vector(1536)")?
  originalOutput    String                       @db.Text
  /// Текст после правки пользователя. NULL пока правка не пришла.
  editedOutput      String?                      @db.Text
  /// Нормализованное расстояние Левенштейна 0..1 (0 = идентично, 1 = совсем другое).
  /// Не пересчитывается на каждом запросе — вычисляется в момент handleInvocationEdited.
  editDistance      Float?
  editedAt          DateTime?
  editedByUserId    String?
  /// Сигналы пользования после правки (фоллоw-up, клик, выполнение задачи).
  /// Структура: { followUpCreated?: boolean, recoClicked?: boolean,
  ///              taskCompleted?: boolean, statusChanged?: boolean }.
  downstreamSignals Json?
  createdAt         DateTime                     @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// HNSW индекс на `inputEmbedding` создаётся в `scripts/postgres-init.sql`
  /// (Prisma не умеет генерировать HNSW + ops в `@@index`).

  /// Один invocationId не должен порождать две PromptFeedback-записи
  /// (один LLM-вызов = один feedback). Защита от race в эмиттере.
  @@unique([invocationId])
  @@index([promptKey, createdAt])
  @@index([tenantId])
}

/// AutoRule Фаза B1 — извлечённое правило (или manual_admin копия).
/// В Фазе B всегда `status='shadow'` — не инъектируется в реальные промпты.
/// В Фазе C добавятся переходы shadow → active с A/B-метриками.
model PromptRule {
  id             String                       @id @default(cuid())
  /// NULL = global rule (для всех Org). Per-Org rules — `tenantId NOT NULL`.
  tenantId       String?
  promptKey      String
  /// Человеко-читаемая формулировка ≤200 символов (русский).
  rule           String                       @db.Text
  ruleType       RuleType
  source         RuleSource
  /// JSON: Array<{originalSnippet, editedSnippet, why}>. До 3 примеров.
  examples       Json
  confidence     Float
  status         RuleStatus
  /// Метрики shadow-A/B: { runs, withRuleScore, withoutRuleScore }.
  shadowMetrics  Json?
  /// Эмбеддинг текста rule — для KNN-дедупа похожих правил (≥0.90 = дубль).
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  /// Когда правило промоутили в `status='active'` (в Фазе B всегда NULL).
  promotedAt     DateTime?
  archivedAt     DateTime?
  archivedReason String?

  org Org? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([promptKey, status])
  @@index([tenantId, status])
}

enum RuleType {
  must_do
  must_not_do
  tone
  structure
}

enum RuleSource {
  autorule
  manual_admin
}

enum RuleStatus {
  shadow
  active
  archived
  overridden_by_admin
}

// ─────────────────────────────────────────────────────────────────────────────
// Agents v2 Фаза B2 (2026-05-30) — Concierge PRM step-scorer (shadow mode).
// См. plans/tz/2026-05-29-agents-v2-umbrella.md §B2.
//
// На каждый tool_call ConciergeService.runToolUseLoop (при включённом
// CONCIERGE_PRM_SHADOW_ENABLED=true) дополнительно генерирует K-1 альтернативных
// кандидатов, оценивает все K через `concierge-step-prm` LLM-scorer и записывает
// результат сюда. Concierge выполняет ВЫБОР LLM (не PRM) — это shadow.
//
// В фазе C/D shadow → active: PRM-выбор реально подменяет LLM-выбор.
// Источник доказательств: AgentPRM (arxiv 2511.08325), MASPRM (2510.24803),
// PRIME-RL 2025.
// ─────────────────────────────────────────────────────────────────────────────

/// Запись об одном tool-call в Concierge: какие кандидаты были, как их оценил
/// PRM, что выбрал LLM, насколько они согласны. Используется для shadow-A/B
/// анализа (PRM vs LLM) перед промоушеном в active.
model ConciergeStepScore {
  id               String   @id @default(uuid())
  tenantId         String
  conversationId   String
  /// Ссылка на `ConciergeMessage.id` (assistant-сообщение с tool_call).
  /// soft-link (не FK), чтобы удаление сообщения не каскадило в score.
  messageId        String
  /// 0..MAX_TOOL_LOOP_ITERATIONS — индекс итерации в runToolUseLoop.
  stepIndex        Int
  /// Краткое представление user intent (≤500 символов), для drill-down аналитики.
  goalSummary      String   @db.Text
  /// { toolName, args } — то, что выполнил LLM (top-1).
  selectedTool     Json
  /// [{ toolName, args, score, reasoning }] top-K по PRM-сортировке (включая selectedTool).
  alternatives     Json
  /// PRM-скор инструмента, выбранного LLM (0..1).
  selectedScore    Float
  /// 1-based ранг выбора LLM в PRM-сортировке (1 = top по PRM).
  selectedRank     Int
  /// Дублирует selectedRank для семантики «какой ранг по PRM получил выбор LLM».
  /// В фазе B всегда == selectedRank (LLM выбирает top-1 по своей логике; PRM
  /// ранжирует). В фазе D, когда применяется PRM-выбор — selectedRank станет 1.
  llmChoseRank     Int
  /// true если top-1 LLM == top-1 PRM (по toolName).
  prmAgreed        Boolean
  /// В фазе B всегда false (shadow only). В фазе D — true, если PRM реально
  /// заменил LLM-выбор перед исполнением.
  promotedToActive Boolean  @default(false)
  createdAt        DateTime @default(now())

  tenant Org @relation("ConciergeStepScoreTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, stepIndex])
  @@index([tenantId, createdAt])
  @@index([promotedToActive, prmAgreed])
  @@map("concierge_step_scores")
}

// ─────────────────────────────────────────────────────────────────────────────
// Agents v2 Фаза C2 (2026-05-30) — GEPA prompt evolution.
// См. plans/tz/2026-05-29-agents-v2-umbrella.md §C2.
//
// PromptCandidate — кандидат на эволюцию prompt'а, найденный GEPA-runner'ом
// (Python subprocess через gepa + dspy-ai). Жизненный цикл:
//   pareto_pool → testing (A/B 10% traffic) → promoted ИЛИ rejected.
//
// Routing 10% trafficShare:
//   - LlmRouter.call ищет активный PromptCandidate(status='testing') для
//     (promptKey, tenantId), берёт deterministic hash по invocationId %100 и
//     если попало в первые `abTrafficShare*100` — заменяет systemPrompt на
//     candidate.promptText. Tag invocation experimentGroup='gepa_candidate'.
//
// Auto-rollback: gepa-ab-monitor cron каждые 15 минут сравнивает composite
// score A (без gepa_candidate) vs B (gepa_candidate) за 48ч; если B хуже на
// abRejectThreshold → status='rejected'. Если B лучше на abPromoteThreshold +
// ≥ abMinInvocationsBeforeDecision → promote (записать candidate.promptText в
// LlmTaskRoute.promptOverride + pinnedVersionNote='Auto-promoted by GEPA Y-M-D').
//
// Защита editedByAdmin: gepa-promote cron перед промоутом проверяет
// LlmTaskRoute.editedByAdmin === false; если admin ручно правил route —
// candidate не промоутится. Через 30 дней — status='rejected' с
// rejectedReason='admin_edit_blocks_promotion'.
// ─────────────────────────────────────────────────────────────────────────────

model PromptCandidate {
  id               String          @id @default(uuid())
  /// NULL = global candidate (для всех Org); иначе per-tenant.
  tenantId         String?
  /// Соответствует LlmTaskRoute.taskType (например 'meeting-report-fast').
  promptKey        String
  /// LlmTaskRoute.version или snapshot модели на момент запуска GEPA (для audit).
  /// NULL если route ещё не имеет version'а.
  parentVersion    String?
  /// Текст evolved prompt'а (заменяет systemPrompt в LlmRouter.dispatch).
  promptText       String          @db.Text
  /// Опц. структурированная разбивка: system / user шаблоны. Для будущих
  /// архитектур, где GEPA эволюционирует обе части. На MVP — оба поля NULL,
  /// promptText содержит system-часть.
  systemPart       String?         @db.Text
  userPart         String?         @db.Text
  /// {accuracy, cost, latency, ...} — Pareto frontier метрики от GEPA-runner'а.
  paretoMetric     Json
  /// Adaptive Self-Improvement traces (reflection chain) от GEPA. JSON.
  reflectionTraces Json
  status           CandidateStatus
  /// Кол-во invocations с этим кандидатом (LlmRouter инкрементирует через
  /// отдельный update в ab-monitor cron'е, для simplicity не на каждый вызов).
  evaluations      Int             @default(0)
  /// Composite score за окно эксперимента. NULL пока не посчитан.
  compositeScore   Float?
  /// Доля трафика для A/B (0..1). NULL вне testing.
  abTrafficShare   Float?
  abStartedAt      DateTime?
  abEndedAt        DateTime?
  promotedAt       DateTime?
  /// 'ab_deg_detected' | 'admin_edit_blocks_promotion' | 'manual_reject' | …
  rejectedReason   String?
  createdAt        DateTime        @default(now())

  org Org? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([promptKey, status])
  @@index([tenantId, promptKey, status])
  @@index([status, abStartedAt])
}

enum CandidateStatus {
  pareto_pool
  testing
  promoted
  rejected
}

// ──────── Smart Tables (см. plans/tz/2026-05-31-smart-tables.md) ────────
//
// Подсистема «умных таблиц» (паритет с Notion-database / Teamly Smart Tables).
// Фаза 0 — каркас данных: модели Table / TableProperty / TableRow / TableView /
// TableAutomation + enum'ы типов колонок, типов представлений, видимости views.
// Строки хранятся как JSONB (cells) с GIN-индексом jsonb_path_ops, создаваемым
// через backend/scripts/postgres-init.sql (`table_row_cells_gin`).
// CRUD/RBAC/UI — отдельные ТЗ-фазы 1+.

model Table {
  id               String    @id @default(cuid())
  tenantId         String
  name             String    @db.VarChar(255)
  description      String?   @db.Text
  /// Эмодзи (одним символом) или ID лукапа icon-set'а — не валидируется в Prisma.
  icon             String?   @db.VarChar(50)
  /// S3-key обложки таблицы (фон шапки в UI).
  coverImageS3     String?   @db.VarChar(500)
  /// Если таблица «живёт внутри документа» — ссылка на parent Document.
  /// FK не вешаем (Document — отдельный домен, кросс-доменные FK создают каскад-боли);
  /// валидация на уровне сервиса.
  parentDocumentId String?
  /// Если строки таблицы автоматически создают/линкуются с Entity графа,
  /// формат: `{ type: 'org'|'person'|..., autoCreate: bool, primaryProperty: string }`.
  entitySync       Json?
  /// id дефолтного TableView (открывается, если в URL не передан viewId).
  defaultViewId    String?
  /// Soft-delete: archivedAt = когда пользователь нажал «архивировать»;
  /// deletedAt = когда поставлен в очередь на hard-delete воркером retention.
  archivedAt       DateTime?
  /// Системная таблица — создаётся автоматически при создании Org (Smart-tables Фаза 0).
  /// Системную таблицу нельзя удалить навсегда (hard-delete), только архивировать.
  isSystem         Boolean   @default(false)
  /// Стабильный ключ системного шаблона (clients_deals / team / …). NULL у пользовательских таблиц.
  /// Уникален в пределах Org — гарантирует идемпотентность авто-провижининга.
  systemKey        String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  org         Org               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  properties  TableProperty[]
  rows        TableRow[]
  views       TableView[]
  automations TableAutomation[]

  @@unique([tenantId, systemKey])
  @@index([tenantId, archivedAt])
  @@index([parentDocumentId])
  @@index([tenantId, isSystem])
}

model TableProperty {
  id        String        @id @default(cuid())
  tableId   String
  name      String        @db.VarChar(100)
  type      TablePropType
  /// Тип-специфичный конфиг колонки. Примеры:
  ///  - currency: `{ currency: 'RUB' }`
  ///  - status:   `{ options: [{id,name,color}] }`
  ///  - relation: `{ relatedTableId, displayPropertyId }`
  ///  - formula:  `{ expression: '...' }`
  config    Json
  /// Primary колонка (как Title в Notion) — отображается в карточке строки сверху.
  isPrimary Boolean       @default(false)
  /// Фракционная сортировка (без перенумерации всех строк при drag&drop).
  order     Decimal       @db.Decimal(20, 10)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, order])
}

enum TablePropType {
  text
  /// Multi-line, mini-document с ProseMirror.
  longtext
  number
  /// config: `{ currency: 'RUB'|'USD'|... }`.
  currency
  percent
  /// config: `{ withTime: bool }`.
  date
  /// config: `{ options: [{id, name, color}] }`.
  status
  selectSingle
  selectMulti
  checkbox
  /// Ссылка на User в Org.
  person
  url
  email
  phone
  /// S3-attachment.
  file
  /// config: `{ expression: '...' }`.
  formula
  /// config: `{ relatedTableId, displayPropertyId }`.
  relation
  /// config: `{ relationPropertyId, targetPropertyId, aggregator }`.
  rollup
  createdAt
  updatedAt
  createdBy
  // ── Z-специфичные ──
  /// Линк на Entity графа знаний (type — любой).
  entityLink
  /// Линк на Meeting.
  meetingLink
  /// Линк на Document.
  documentLink
}

model TableRow {
  id          String    @id @default(cuid())
  tableId     String
  tenantId    String
  /// `{ [propertyId]: value }`. Value — JSON-serializable: string/number/array/etc.
  /// GIN-индекс по cells создаётся в backend/scripts/postgres-init.sql
  /// (`table_row_cells_gin`, jsonb_path_ops).
  cells       Json
  /// Если у таблицы включён entitySync — авто-линка с Entity графа.
  /// FK на Entity не вешаем (см. комментарий к Table.parentDocumentId).
  entityId    String?
  /// Фракционная сортировка строк (drag&drop без перенумерации).
  order       Decimal   @db.Decimal(20, 10)
  archivedAt  DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  /// Embedded mini-document внутри карточки строки (ProseMirror doc JSON).
  /// Опционально — заполняется в Фазе 2 (карточка строки как документ).
  pageContent Json?

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, order])
  @@index([tableId, archivedAt])
  @@index([entityId])
}

model TableView {
  id         String              @id @default(cuid())
  tableId    String
  name       String              @db.VarChar(100)
  type       TableViewType
  /// `{ filters, sorts, groupBy, hiddenProps, propOrder, cardCover, ... }`.
  /// Структура — UI-специфична, валидируется в Zod-DTO API-слоя.
  config     Json
  /// personal — видит только владелец; shared — вся Org; public — по токен-ссылке.
  visibility TableViewVisibility @default(personal)
  ownerId    String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

enum TableViewType {
  grid
  kanban
  calendar
  gantt
  /// Карточки с обложкой — у Teamly нет, у нас плюс.
  gallery
  /// Хронологическая лента — у Teamly нет.
  timeline
  /// Карта по адресу/координатам — у Teamly нет.
  map
  /// Публичная форма-собиратель (Фаза 14).
  form
  chart
}

enum TableViewVisibility {
  personal
  shared
  public
}

model TableAutomation {
  id        String   @id @default(cuid())
  tableId   String
  name      String   @db.VarChar(100)
  /// `{ kind:'property_change'|'row_created'|'row_deleted'|'cron', config: {...} }`.
  trigger   Json
  /// `[{ kind:'send_notification'|'update_property'|'create_row'|'webhook', config: {...} }]`.
  actions   Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

/// TableCellProvenance — провенанс (происхождение) значения ячейки Smart-таблицы.
/// Smart-tables auto-creation Фаза 3 — Event-to-Cells. После встречи агент
/// патчит ПУСТЫЕ ячейки фактами из транскрипта и фиксирует здесь источник:
/// какая встреча/документ, цитата-таймкод (deep-link), что было раньше (для
/// undo). FK на Table/TableRow/TableProperty НЕ вешаем — связи по id (как в
/// TableRow.entityId / Table.parentDocumentId), чтобы не плодить каскад-боли.
model TableCellProvenance {
  id            String    @id @default(cuid())
  tenantId      String
  tableRowId    String
  propertyId    String
  /// 'meeting' | 'document' | 'manual'.
  sourceType    String
  /// meetingId / documentId (id сущности-источника).
  sourceId      String
  /// Человекочитаемая метка источника, например «Встреча Алексей×Бета-Корп, 14:32».
  sourceLabel   String
  /// Deep-link на тайминг источника (`/meetings/:id?t=872`). NULL — нет таймкода.
  sourceLink    String?
  /// Прежнее значение ячейки (для undo). NULL — ячейка была пустой.
  previousValue Json?
  /// Применённое значение.
  appliedValue  Json?
  confidence    Decimal?  @db.Decimal(3, 2)
  appliedAt     DateTime  @default(now())
  /// 'agent' (авто-патч) | userId (ручное подтверждение pending-патча).
  appliedBy     String
  /// Когда правка была откатена (undo). NULL — действует.
  rolledBackAt  DateTime?

  @@index([tableRowId, propertyId])
  @@index([tenantId, sourceType, sourceId])
}

/// TableCellPendingPatch — очередь подтверждений правок ячеек Smart-таблицы.
/// Smart-tables auto-creation Фаза 3 — Event-to-Cells. Если предложенный
/// агентом факт перезаписал бы НЕпустую ячейку (overwrite) либо confidence ниже
/// порога (low_confidence) — ячейка НЕ меняется, а кандидат кладётся сюда на
/// подтверждение владельцем. FK не вешаем — связи по id (см. TableCellProvenance).
model TableCellPendingPatch {
  id            String    @id @default(cuid())
  tenantId      String
  tableId       String
  tableRowId    String
  propertyId    String
  proposedValue Json
  /// Текущее значение ячейки на момент создания патча. NULL — была пустой
  /// (для low_confidence пустой ячейки).
  currentValue  Json?
  confidence    Decimal   @db.Decimal(3, 2)
  sourceType    String
  sourceId      String
  sourceLabel   String
  sourceLink    String?
  /// 'pending' | 'approved' | 'rejected'.
  status        String    @default("pending")
  /// Почему попало в очередь: 'low_confidence' | 'overwrite'.
  reason        String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?
  /// userId, принявший решение (approve/reject).
  decidedBy     String?

  @@index([tenantId, status])
  @@index([tableId, status])
  @@index([tableRowId, propertyId])
}

// ─────────────────────── logging (технические логи) ───────────────────────
// Модуль LoggingModule: операционная диагностика приложения в БД.
// ВАЖНО: это НЕ audit trail (бизнес-аудит — SuperAdminAccessLog, вечный, без
// ретеншена). SystemLog — диагностика с автоудалением (retentionDays), БЕЗ
// FK-связей: userId/orgId — «мягкие» ссылки-строки.
// План: plans/tz/2026-06-01-logging-module.md.

enum SystemLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum SystemLogCategory {
  SYSTEM
  REQUEST
  BUSINESS
  SECURITY
  PAYMENT
  WEBHOOK
  AUTH
  DB
  INTEGRATION
  AUDIT
  FRONTEND
  JOB
  OTHER
}

/// Контур = крупная зона доступа Коры (адаптация домена orgs/tenancy).
enum SystemLogContour {
  GUEST
  MEMBER
  ORG_ADMIN
  SUPERADMIN
  PLATFORM
  PUBLIC
  SYSTEM
}

/// Процессный контур (pipeline) = крупная цепочка вызовов сквозь модули.
/// В отличие от `contour` (роль/зона доступа) описывает ПРОЦЕСС, а не субъекта.
/// Одна цепочка одного действия объединяется общим `traceId` (напр. mtg_<id>).
/// План: plans/tz/2026-06-03-logging-pipelines-coverage.md.
enum SystemLogPipeline {
  MEETING_LIFECYCLE // создание/старт/join/leave/завершение, LiveKit room/токены/webhooks
  RECORDING // egress, S3-загрузка дорожек, recording webhooks
  TRANSCRIPTION // ASR: transcribe, transcript-clean, transcript-index, merge
  AI_ANALYSIS // chapters, analyze, tasks, custom-report, clip, report-fast, analyze-v2, specialists-combined
  KNOWLEDGE_GRAPH // ingest→block→distill→linker→entity-resolver→theme, specialists 3-*, rollup, profiles
  NOTIFICATIONS // push, events/reminders, recognition, concierge, dialog, proactive
  AUTH // login/guest/sessions/tokens, rbac
  BILLING // billing/payments, entitlements, провайдеры
  INTEGRATIONS // webhooks-out, tracker, tables, внешние API
  ONBOARDING // company-foundation, onboarding, role-map
  ADMIN // admin/platform операции
  SCHEDULER // cron'ы, retention, фоновые периодические задачи
  SYSTEM // прочее / bootstrap / не классифицировано
}

model SystemLog {
  id           String             @id @default(uuid())
  level        SystemLogLevel
  category     SystemLogCategory  @default(SYSTEM)
  contour      SystemLogContour   @default(SYSTEM)
  /// Процессный контур цепочки (nullable — старые логи и неклассифицированные).
  pipeline     SystemLogPipeline?
  module       String?
  action       String?
  message      String
  details      Json?
  userId       String?
  userRole     String?
  /// Soft-ref на Org (tenantId). Без FK — лог переживает удаление org.
  orgId        String?
  requestId    String?
  traceId      String?
  ip           String?
  userAgent    String?
  method       String?
  path         String?
  statusCode   Int?
  durationMs   Int?
  errorName    String?
  errorMessage String?
  errorStack   String?
  environment  String?
  instanceId   String?
  createdAt    DateTime           @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([category, createdAt])
  @@index([contour, createdAt])
  @@index([pipeline, createdAt])
  @@index([module, createdAt])
  @@index([statusCode, createdAt])
  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([requestId])
  @@index([traceId, createdAt])
}

/// Платформенная key-value таблица настроек (singleton-строки по ключу).
/// Ключ `logging_settings` хранит runtime-настройки LoggingModule.
model PlatformSetting {
  key       String   @id
  valueJson Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// ChatBox: конфиг интеграции org с app.agent-lia.ru. Один на org.
model ChatboxIntegration {
  id                    String                   @id @default(cuid())
  tenantId              String                   @unique
  /// AES-256-GCM (CryptoService). Никогда не возвращается plain в API.
  tokenEnc              String                   @db.Text
  workspaceId           String
  workspaceName         String?
  syncMode              ChatboxSyncMode          @default(daily)
  /// Включён ли AI-анализ переписок (LLM-summary сессий + мост в knowledge-core).
  /// По умолчанию ВЫКЛ — синк зеркалит чаты, но LLM не дёргаем, пока не включат.
  analysisEnabled       Boolean                  @default(false)
  status                ChatboxIntegrationStatus @default(connected)
  lastError             String?                  @db.Text
  lastFullSyncAt        DateTime?
  lastIncrementalSyncAt DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// ChatBox: канал (мессенджер) воркспейса.
model ChatboxChannel {
