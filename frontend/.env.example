# API backend (HTTP). Для prod обычно https://api.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# LiveKit-сервер (медиа). Для prod обычно wss://media.example.com
NEXT_PUBLIC_LIVEKIT_URL=http://localhost:7880

# Frontend (этот сайт). Для prod обычно https://meet.example.com
NEXT_PUBLIC_FRONTEND_URL=http://localhost:4001

# ── Опциональные (имеют fallback в коде) ───────────────────────────────────

# Base URL для WebSocket-эндпоинтов (/ws/voice, /ws/tracker, /ws/logs).
# Пусто = выводится из NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_WS_URL=

# Публичный VAPID-ключ для web-push (соответствует VAPID_PUBLIC_KEY на бэке).
# Пусто = push-уведомления выключены.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Username бота-помощника для каналов. Fallback в коде — kora_bot.
# NEXT_PUBLIC_KORA_BOT_USERNAME=

# Включить service worker в dev (только для отладки PWA). В prod SW включён всегда.
# NEXT_PUBLIC_PWA_ENABLE_IN_DEV=0
