  /// SBA β-8.2 — `commitment_status` блок закрывает (resolves) исходный `commitment`.
  resolves
  /// KC-Temporal W1.1 (2026-05-25) — новый блок-факт замещает старый.
  /// Создаётся `FactSupersedeService` при детектировании supersede-вердикта.
  /// Пара: from=новый блок, to=старый блок.
  supersedes
}

/// Тип типизированной связи между сущностями. С Фазы 0 — также все
/// бизнес-связи каркаса компании (Person↔Role↔Department, Process↔Role,
/// Strategy↔Goal и т.д.). См. plans/tz/2026-05-21-phase-0a-data-model-and-graph-infra.md §4.4.
enum EntityLinkType {
  // ── существующие knowledge-core связи Entity↔Entity (Фаза 3) ──
  works_at
  belongs_to
  part_of
  opposes
  depends_on
  mentions_with

  // ── Фаза 0: Person ↔ Role ↔ Department ↔ Skill ──
  /// Person -> Role; временной интервал в validFrom/validTo.
  executes_role
  /// Person -> Department.
  member_of
  /// Role -> JobDescription.
  described_by
  /// JobDescription -> Document (или Process -> Document, см. produces).
  derived_from
  /// Role -> Skill (требование).
  requires_skill
  /// Person -> Skill (наблюдается).
  has_skill

  // ── Фаза 0: каркас 5 уровней (группа Б) ──
  /// Mission -> Strategy.
  realized_by
  /// Strategy -> Goal; Goal -> Goal (декомпозиция).
  decomposes_into
  /// Goal -> Metric; Process -> Metric.
  measured_by
  /// Strategy -> Process.
  executed_by
  /// Process -> ProcessStep.
  has_step
  /// Process -> Role / Person; Role -> Process (Role is_responsible_for).
  owned_by
  /// Process -> Tool.
  lives_in
  /// Process -> Document.
  produces
  /// Process -> Event / Meeting.
  triggered_by
  /// Regulation -> Process.
  regulates
  /// Policy -> Process / Role / любая сущность.
  constrains
  /// Regulation(category=standard) -> ArtifactType (строковый идентификатор в properties.artifactType).
  applies_to
  /// Role -> Process (зеркало owned_by для дискриминации направления).
  is_responsible_for

  // ── Фаза 0: RACI (UI назначения — Фаза γ) ──
  responsible_for
  accountable_for
  consulted_on
  informed_about

  // ── SBA α-3 (2026-05-23) — связи слоя организационного графа ──
  /// Person/Role -> Person/Role: иерархия подчинения.
  reports_to
  /// Person/Role -> Person/Role: подчинённый/команда.
  manages
  /// Person/Department -> Person/Department: горизонтальные взаимодействия.
  collaborates_with
  /// Person -> Person: наставничество (источник для γ-1 SkillProfile).
  mentors
  /// Person -> Person: фиксированный конфликт (источник для β-8 PersonalRelation).
  conflicted_with
  /// Process -> Process / Role -> Role: передача результата по pipeline.
  transfers_result_to
  /// Decision/Person -> Role: эскалация до вышестоящего.
  escalates_to

  // ── SBA β-6 (2026-05-23) — Experiment Tracker (Specialist 3.9) ──
  /// Experiment -> Insight: результат эксперимента подтверждает существующий
  /// сигнал/инсайт (EntityTransitionCron эмитит ежедневно в 07:00).
  result_supports_insight
  /// Experiment -> Decision: извлечённый из эксперимента урок информирует
  /// прошлое или будущее решение (EntityTransitionCron, см. β-6 §3 решение #4).
  lesson_informs_decision
}

/// Кто создал связь:
///   - linker: block-linker.worker (на canonical-блок).
///   - reframing: ночной reframing.cron (рефлексия графа).
///   - manual: пользователь через UI (не в MVP, но поле зафиксировано сразу).
enum LinkCreatedBy {
  linker
  reframing
  manual
}

/// Состояние связи: active = живая, archived = архив (понижен confidence или
/// сброшен ночным reframing).
enum LinkStatus {
  active
  archived
}

// ──────────────────────────── knowledge-core: theme (Фаза 4) ────────────────────────────

/// Состояние темы:
///   - active       — обнаружена кластерером, видна в UI и поиске.
///   - archived     — устарела или неактуальна (после reframing).
///   - merged_into  — слита в другую тему (mergedIntoId указывает целевую).
enum ThemeStatus {
  active
  archived
  merged_into
}

/// Динамика темы — заполняется reframing'ом по дельте новых блоков:
///   growing / stable / declining.
enum ThemeDynamic {
  growing
  stable
  declining
}

/// 12 веток компании (M-07 delivery). Для отнесения темы к крупному блоку
/// бизнеса. Опциональна — LLM может вернуть `null`, если ветка не очевидна.
enum ThemeBranch {
  strategy
  clients
  sales
  marketing
  product
  operations
  team
  finance
  technology
  production
  partnerships
  legal
}

// ──────────────────────────── knowledge-core: goals (Фаза 9) ────────────────────────────

/// Состояние цели:
///   - active     — активная, ежедневно оценивается воркером.
///   - paused     — owner временно приостановил мониторинг (не оценивается).
///   - achieved   — цель достигнута (закрыта успешно).
///   - abandoned  — цель брошена (soft-delete через archivedAt).
enum GoalStatus {
  active
  paused
  achieved
  abandoned
}

/// Источник связи Goal ↔ Theme:
///   - manual — owner вручную привязал тему через UI.
///   - ai     — предложено strategic-alignment.suggester (vNext).
enum GoalThemeSource {
  manual
  ai
}

// ──────────────────────────── Фаза 0: каркас компании (группа А, видимая) ────────────────────────────

/// Горизонт цели/стратегии/миссии (см. ontology §11.6). Используется и для
/// Goal (расширение), и для Mission/Strategy (Фаза 0, группа Б).
enum GoalHorizon {
  strategic
  annual
  quarterly
  monthly
  sprint
}

// ──────────────────────────── Goals OKR v2 (2026-06-02) ────────────────────────────

/// Goals OKR v2 — источник появления цели.
///   - manual — owner завёл руками.
///   - ai     — специалист 3-14-goals добыл из встреч.
enum GoalSource {
  manual
  ai
}

/// Goals OKR v2 — жизненный цикл предложения (отдельная ось от GoalStatus).
///   - suggested — AI-кандидат, виден, но визуально отличим.
///   - active    — официальная цель (ручная → сразу active).
///   - dismissed — отклонён человеком.
enum GoalPromotionState {
  suggested
  active
  dismissed
}

/// Goals OKR v2 — статус движения для пульса (вычисляется авто, правится руками).
/// Отдельная ось от GoalStatus (жизненный цикл).
enum GoalProgressStatus {
  on_track
  at_risk
  stalled
  achieved
  dropped
}

/// ТЗ-2 Ф6.A (daily-value-dashboards) — MoSCoW-приоритет цели для портфеля.
///   - must   — обязательно (must have).
///   - should — следует сделать (should have).
///   - could  — можно (could have).
///   - wont   — пока не делаем (won't have this time).
/// Nullable на Goal: приоритет проставляется владельцем вручную (Patch), AI не
/// выдумывает — отсутствие = «не классифицировано» (корзина 'none' в портфеле).
enum GoalPriority {
  must
  should
  could
  wont
}

/// Goals OKR v2 — откуда тянуть GoalKeyResult.currentValue автоматически.
enum GoalKrSourceKind {
  manual
  meeting_count
  issue_rollup
  metric_entity
}

/// Тип документа в Document-модели (Фаза 0).
enum DocumentKind {
  pdf
  docx
  markdown
  /// Создаётся из text.adapter (фронт /dump → POST /api/v1/dumps).
  text
  /// ТЗ-4 Ф1 — Excel-таблица (.xlsx). Парсер ExcelJS → текст по листам.
  xlsx
  /// ТЗ-4 Ф1 — PowerPoint-презентация (.pptx). Текст по слайдам.
  pptx
  /// ТЗ-4 Ф1 — HTML-страница (выгрузка из вики/Confluence/Notion).
  html
  /// ТЗ-4 Ф1 — Rich Text Format (.rtf).
  rtf
  /// ТЗ-4 Ф1 — OpenDocument Text (.odt).
  odt
  /// ТЗ-4 Ф1 — CSV-таблица. Парсится как текст по строкам.
  csv
  other
}

/// ТЗ-4 Ф1 (manual-document-upload) — смысловой тип документа (что это по сути),
/// в отличие от `DocumentKind` (формат файла). Заполняется вручную при загрузке
/// или предлагается классификатором (`suggestedDocType`).
enum DocumentType {
  regulation
  policy
  instruction
  process
  job_description
  other
}

/// Статус document-ingest pipeline.
enum DocumentStatus {
  uploaded // только что POSTнут
  parsing // парсер работает
  parsed // парсер завершил
  blocks_extracted // BlockExtractionService отработал
  failed
}

/// ТЗ-4 Ф7 — источник массового импорта документов. `upload_zip` —
/// загруженный пользователем ZIP-архив; `notion` / `confluence` —
/// зарезервированы под Ф8/Ф9 (переиспользуют тот же batch-pipeline).
enum DocumentImportSource {
  upload_zip
  notion
  confluence
}

/// ТЗ-4 Ф7 — статус batch-импорта документов.
enum DocumentImportStatus {
  pending // создан, ждёт воркера
  processing // воркер распаковывает и создаёт Document'ы
  completed // все записи обработаны
  failed // фатальная ошибка (битый архив / превышение лимита)
}

/// Статус сборки карты должности (Фаза 0d, RoleProfileAgent).
enum RoleProfileStatus {
  forming // данных <N блоков идей с role_relevant=true
  ready // summaryCache заполнен
  stale // прошло >24ч с lastBuildAt + есть новые данные
  error // LLM упал, нужна ручная проверка
}

// ──────────────────────────── Фаза 0: каркас компании (группа Б, без UI в Фазе 0) ────────────────────────────

/// Категория регламента (см. ontology §10 «Уровень 3»).
enum RegulationCategory {
  regulation
  standard
}

/// Статус процесса/регламента/политики.
enum ProcessStatus {
  active
  deprecated
  archived
}

enum PolicySeverity {
  advisory // рекомендация
  mandatory // обязательно
  blocking // нарушение блокирует процесс
}

enum ToolKind {
  software
  hardware
  template
  document
  service
  other
}

enum MetricValueType {
  count
  ratio
  duration_seconds
  money
  other
}

/// SBA β-3 — расширенный набор статусов Decision'а.
/// Значения 'active' и 'rolled_back' оставлены для обратной совместимости с
/// legacy Decision'ами Фазы 0a (могут существовать в БД у dev-инстансов до
/// миграции). Все новые Decision'ы создаются специалистом 3.3 со значением из
/// {proposed, approved, rejected, implemented, cancelled, superseded}.
enum DecisionStatus {
  active
  rolled_back
  superseded
  // ── SBA β-3 ──
  proposed
  approved
  rejected
  implemented
  cancelled
}

/// SBA β-4 — Specialist 3.5 (Insights Radar).
/// Тип повторяющегося сигнала, который агрегирует специалист.
///   - problem — фиксируемая проблема в работе компании.
///   - risk — потенциальная угроза (ещё не реализовалась).
///   - blocker — что мешает движению задачи / проекта.
///   - inefficiency — неэффективность процесса (трата ресурсов без угрозы).
enum InsightKind {
  problem
  risk
  blocker
  inefficiency
}

/// SBA β-4 — острота сигнала. Влияет на triage (critical → deep review) и
/// сортировку радара (high/critical поднимаются вверх).
enum InsightSeverity {
  low
  medium
  high
  critical
}

/// SBA β-4 — динамика повторений сигнала за rolling-окно.
///   - growing — 7d-частота заметно выше 30d-средней (ratio > 1.3).
///   - stable — обычный фон.
///   - declining — частота падает (ratio < 0.5).
///   - spike — резкий всплеск (ratio > INSIGHT_SPIKE_RATIO, default 3.0).
enum InsightDynamic {
  growing
  stable
  declining
  spike
}

/// SBA β-4 — статус карточки Insight.
///   - active — активный, отображается на радаре.
///   - mitigating — берут в работу (черновой mitigationPlan).
///   - mitigated — закрыт; новое упоминание → probe recurring_after_mitigation.
///   - archived — устарел, скрыт.
///   - false_alarm — куратор / admin отметил ложной тревогой.
enum InsightStatus {
  active
  mitigating
  mitigated
  archived
  false_alarm
}

// ──────────────────────────── models ────────────────────────────

model User {
  id                    String           @id @default(cuid())
  externalId            String?          @unique
  email                 String
  name                  String
  phone                 String?          @db.VarChar(20)
  role                  UserRole         @default(user)
  /// Флаг владельца продукта Z (super-admin Z-Admin раздела). См. rbac-access-control.md.
  /// На уровне БД — независим от `role` и `Membership`. Включается вручную DBA / seed'ом.
  isSuperAdmin          Boolean          @default(false)
  signupSource          UserSignupSource @default(crossmark)
  signupRef             String?          @db.VarChar(255)
  // argon2id (standalone) или bcrypt (admin local login). Опционально для Crossmark-провижененных юзеров.
  passwordHash          String?
  mustChangePassword    Boolean          @default(false)
  /// Согласие на обработку персональных данных (обязательное при регистрации).
  consentDataProcessing Boolean          @default(false)
  /// Согласие на маркетинговые рассылки (опциональное).
  consentMarketing      Boolean          @default(false)
  /// Дата и время принятия согласий.
  consentAcceptedAt     DateTime?
  createdAt             DateTime         @default(now())
  lastSeenAt            DateTime?
  deletedAt             DateTime?

  meetings             Meeting[]
  sessions             UserSession[]
  verificationTokens   UserVerificationToken[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  destinations         IntegrationDestination[]
  tags                 Tag[]
  tasks                Task[]
  /// ТЗ 2026-05-25 hard-participant-identification — задачи, где этот User
  /// сопоставлен как assignee через AI/manual (`Task.assigneeUserId`).
  assignedTasks        Task[]                   @relation("TaskAssignee")
  chatMessages         MeetingChatMessage[]
  userTemplates        UserTemplate[]
  exports              Export[]
  meetingShares        MeetingShare[]
  highlightShares      HighlightShare[]
  meetingHighlights    MeetingHighlight[]
  quotaCounters        UserQuotaCounter[]
  auditLog             AuditLog[]
  apiAccessLog         ApiAccessLog[]
  cards                Card[]
  ownedOrgs            Org[]                    @relation("OrgOwner")
  memberships          Membership[]
  invitedMemberships   Membership[]             @relation("MembershipInvitedBy")
  createdInvitations   OrgInvitation[]          @relation("OrgInvitationInvitedBy")
  acceptedInvitations  OrgInvitation[]          @relation("OrgInvitationAcceptedBy")
  superAdminAccessLogs SuperAdminAccessLog[]    @relation("SuperAdminAccessLog")
  goalsCreated         Goal[]                   @relation("GoalCreatedBy")
  /// Фаза 0a — Person-аватары пользователя в Org'ах (после accept'а приглашений).
  persons              Person[]                 @relation("UserPersons")
  // ── SBA α-1 — Conversational Channels Foundation ──
  channelBindings      ChannelBinding[]
  notifications        Notification[]           @relation("NotificationRecipient")

  // ── Фаза A.1 — Prompt Registry ──
  createdPromptTemplates   PromptTemplate[]        @relation("PromptTemplateCreatedBy")
  createdPromptVersions    PromptTemplateVersion[] @relation("PromptTemplateVersionCreatedBy")
  createdPromptExperiments PromptExperiment[]      @relation("PromptExperimentCreatedBy")
  aiResultFeedback         AiResultFeedback[]      @relation("AiResultFeedbackUser")
  // ── Фаза A.4 — Audit log переключений LlmTaskRoute ──
  llmTaskRouteChanges      LlmTaskRouteChange[]    @relation("LlmTaskRouteChangeBy")

  // ── SBA α-4 — Layer 4 Curation Foundation ──
  curationItemsAssigned CurationItem[]     @relation("CurationItemAssignedTo")
  curationDecisions     CurationDecision[] @relation("CurationDecisionReviewer")
  conflictsResolved     ConflictItem[]     @relation("ConflictItemResolvedBy")
  cardVersionsCreated   CardVersion[]      @relation("CardVersionCreatedBy")

  // ── SBA α-5 — Layer 5 Chat-v2 Omnichannel ──
  chatV2Conversations ChatV2Conversation[] @relation("ChatV2ConversationUser")

  // ── SBA α-7 wave 2 — Specialist 3.1 (ProcessTemplate) ──
  publishedProcessTemplateVersions ProcessTemplateVersion[] @relation("ProcessTemplateVersionPublishedBy")

  // ── SBA α-10 wave 2 — Admin LLM + Unit Economics ──
  llmModelPriceChanges LlmModelPrice[] @relation("LlmModelPriceChangedBy")
  orgBudgetCapsSet     OrgBudgetCap[]  @relation("OrgBudgetCapSetBy")

  // ── SBA γ-2 — Concierge Agent ──
  conciergeConversations ConciergeConversation[] @relation("ConciergeConversationUser")

  // ── SBA δ-1 — Orchestrator (multi-agent deep research) ──
  orchestratorRuns OrchestratorRun[] @relation("OrchestratorRunUser")

  // ── SBA δ-2 — ProactiveWatcher (2026-05-23) ──
  proactiveNotifications ProactiveNotification[] @relation("ProactiveNotificationUser")

  // ── Calendar MVP (2026-05-25) — события и подписка на ICS-feed ──
  /// Секретный токен для подписки на персональный ICS-feed
  /// (`GET /api/v1/calendar/:userId.ics?token=...`). Генерируется по запросу
  /// из /me/settings/calendar. Хранится как HMAC base64.
  calendarFeedToken String? @db.VarChar(80)

  // ── Onboarding Tour (2026-05-27) — состояние онбординг-туров ──
  /// Состояние прохождения onboarding-туров. Структура:
  ///   { welcome?: { completedAt, skipped? }, project?: { ... }, meeting?: { ... } }
  /// Touch при PATCH /api/v1/users/me/tour-progress; reset обнуляет до `{}`.
  /// См. plans/tz/2026-05-27-tracker-onboarding-tour.md.
  tourProgress Json @default("{}")

