enum LlmRouteTier {
  primary
  secondary
  tertiary
}

model LlmTaskRoute {
  id         String   @id @default(cuid())
  /// NULL = глобальный дефолт, заданный super_admin (Z-Admin).
  /// Не-NULL = override на конкретную Org (Z-Admin Фаза 7).
  tenantId   String?
  tenant     Org?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskType   String
  /// Legacy (до A.4): JSON-массив { provider, model? } — fallback chain в одной записи.
  /// После A.4 запись = ОДИН провайдер + tier + priority (см. поля ниже). Legacy-форма
  /// остаётся работать, пока для taskType нет ни одной записи с `tier IS NOT NULL`.
  /// Routing решает: если есть tier'ы — собирает цепочку по ним; иначе использует
  /// legacy JSON. Это обратная совместимость.
  providers  Json?
  isActive   Boolean  @default(true)
  /// Фаза A.4 — уровень в цепочке: primary / secondary / tertiary.
  /// NULL = legacy-запись (старая модель). NOT NULL = нормализованная запись.
  tier       LlmRouteTier?
  /// Фаза A.4 — порядок внутри одного tier'а (0 = первый кандидат). Только если tier NOT NULL.
  priority   Int      @default(0)
  /// Фаза A.4 — фактический провайдер для нормализованной записи (если tier NOT NULL).
  /// Совпадает с одним из ALL_PROVIDERS (`deepseek` / `openai-via-proxy` / …).
  providerName String?
  /// Фаза A.4 — конкретная модель в рамках провайдера (например `deepseek-v4-flash`).
  /// NULL = провайдер выбирает default.
  model        String?
  /// Фаза A.4 — был ли маршрут вручную отредактирован админом. Используется в
  /// идемпотентном seed'е: если true — seed не перезаписывает запись.
  editedByAdmin Boolean @default(false)
  /// A/B-эксперимент legacy: { enabled: bool, modelA: string, modelB: string,
  ///                    splitPercent: number, startedAt: ISO, endsAt: ISO }.
  /// Новые A/B-эксперименты per-agent — через модель `LlmModelExperiment`.
  experiment Json?
  /// Фаза 11 knowledge-core: минимальный класс данных, который маршрут
  /// поддерживает. NULL трактуется как 'internal'. LlmRouter фильтрует
  /// провайдеров по `provider.maxDataClass >= max(dataClass, requiredDataClass)`.
  /// Если ни один провайдер не подходит — `NoEligibleProviderError` +
  /// метрика `core_data_class_violations_total`.
  requiredDataClass DataClass?
  updatedAt  DateTime @updatedAt

  /// Legacy unique: (taskType, tenantId) — для записей БЕЗ tier (одна запись на taskType).
  /// Сохраняем для обратной совместимости. Записи с tier живут отдельно — для них
  /// уникальность держится по (taskType, tenantId, tier, providerName).
  @@unique([taskType, tenantId, tier, providerName], name: "task_tenant_tier_provider_unique")
  @@index([tenantId])
  @@index([taskType, tier, priority])
}

/// Фаза A.4 — audit log переключений маршрутов в `/admin/ai-models`.
/// На каждый switch-primary / add-provider / remove-provider / start-ab / stop-ab — запись.
/// Используется в `<TaskTypeDetailsCard />` для отображения истории и в API
/// `GET /admin/ai-models/:taskType/history`.
model LlmTaskRouteChange {
  id          String       @id @default(cuid())
  /// NULL = глобальное изменение (только super_admin); иначе org-scoped.
  tenantId    String?
  taskType    String
  /// Tier, который менялся. NULL для удалений где tier не определён.
  tier        LlmRouteTier?
  /// Один из: 'switched_primary' | 'added_provider' | 'removed_provider' |
  /// 'started_ab' | 'stopped_ab' | 'reset_to_default'.
  changeType  String
  /// Snapshot цепочки до изменения (массив { tier, providerName, model, priority }).
  before      Json
  /// Snapshot цепочки после изменения.
  after       Json
  changedById String
  changedBy   User         @relation("LlmTaskRouteChangeBy", fields: [changedById], references: [id], onDelete: NoAction)
  /// Обязательно для switch-primary (по DoD §7.4).
  reason      String?
  createdAt   DateTime     @default(now())

  @@index([taskType, createdAt])
  @@index([changedById, createdAt])
  @@index([tenantId, taskType, createdAt])
}

/// Фаза A.4 — A/B-эксперимент per-agent (по моделям, а не по промптам).
/// Параллельная сущность к `PromptExperiment` (которая про шаблоны промптов).
model LlmModelExperiment {
  id              String        @id @default(cuid())
  /// NULL = глобальный (только super_admin); иначе org-scoped.
  tenantId        String?
  taskType        String
  /// Текущий primary (контрольная группа).
  controlModel    String
  controlProvider String
  /// Тестируемая модель (вариант).
  variantModel    String
  variantProvider String
  /// 0..100 — доля трафика на variant (sticky-allocation по hash(meetingId)).
  splitPercent    Int
  /// 'draft' | 'running' | 'stopped' | 'completed'.
  status          String        @default("draft")
  startedAt       DateTime?
  endsAt          DateTime?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  notes           String?

  @@index([tenantId, taskType, status])
  @@index([status, startedAt])
}

// ──────────────────────────── ai-workspace: audit / quotas / api access ────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Org?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resourceId String?
  metadata   Json?
  ipHash     String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
}

model ApiAccessLog {
  id         String   @id @default(cuid())
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  route      String
  status     Int
  durationMs Int?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model UserQuotaCounter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotaName   String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, quotaName, windowStart])
  @@index([userId, quotaName])
}

// ──────────────────────────── cards: CRM-структура встреч ────────────────────────────

model Card {
  id          String  @id @default(cuid())
  /// tenant: Org, к которой принадлежит карточка. После backfill — NOT NULL.
  tenantId    String?
  tenant      Org?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  // 'client' | 'deal' | 'project' | 'topic' | 'custom'.
  // Хранится строкой (а не enum'ом), чтобы можно было добавлять виды без миграций.
  kind        String  @default("client")
  color       String  @default("#5EEAD4")
  icon        String?
  description String? @db.Text

  // Один опциональный primary-контакт. Несколько — vNext через CardContact.
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Knowledge-core (Фаза 4): primary-сущность карточки + связанные сущности +
  // опциональная ссылка на Theme, из которой пользователь сохранил карточку
  // через `POST /themes/:id/save-as-card`.
  entityId         String?
  entity           Entity?  @relation("CardEntity", fields: [entityId], references: [id], onDelete: SetNull)
  relatedEntityIds String[] @default([])
  bornFromThemeId  String?
  bornFromTheme    Theme?   @relation("CardBornFromTheme", fields: [bornFromThemeId], references: [id], onDelete: SetNull)

  pinned     Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  // AI rollup-кэш (заполняется card-rollup.worker'ом).
  summaryCache     String?   @db.Text
  summaryUpdatedAt DateTime?

  // Knowledge-core (Фаза 4): топ-N тем, связанных с карточкой через её блоки.
  // Заполняется card-rollup-v2.worker'ом — кэш для быстрого рендера UI.
  cachedTopThemeIds String[] @default([])

  // Денормализация для сортировки списка без JOIN.
  meetingCount  Int       @default(0)
  lastMeetingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings     Meeting[]
  chatMessages MeetingChatMessage[]

  @@unique([ownerId, name])
  @@index([ownerId, lastMeetingAt])
  @@index([ownerId, archivedAt])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([entityId])
  @@index([bornFromThemeId])
}

// ──────────────────────────── orgs / RBAC / invitations (Фаза 0 knowledge-core) ────────────────────────────

/// Org — организация-клиент. Любой ресурс (встреча, карточка, задача и т.д.)
/// принадлежит ровно одной Org через поле tenantId.
///
/// При регистрации создаётся персональный Org с owner=User. Member'ов добавляет
/// owner через OrgInvitation. visibilityMode определяет, видят ли manager-ы
/// чужие ресурсы внутри Org.
model Org {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  ownerId        String
  owner          User              @relation("OrgOwner", fields: [ownerId], references: [id])
  visibilityMode OrgVisibilityMode @default(open)
  /// Тариф — placeholder для Фазы 12. На Фазе 0 все Org = basic.
  tier           OrgTier           @default(basic)
  /// Карта тумблеров воркеров для Org. {} = все включены. Воркеры читают
  /// org.workersEnabled[workerName] !== false. Управляется из Org-Admin (Фаза 7).
  /// Структура: { "block-ingest": false, "block-distill": true, ... }.
  workersEnabled Json              @default("{}")
  /// Окно (в днях) для strategic-alignment воркера (Фаза 9). По умолчанию 30,
  /// валидация в API: 7..90.
  strategicAlignmentWindowDays Int @default(30)
  /// Фаза D — Очистка транскрипта (sub-TZ 2026-05-21-phase-D-transcript-cleaning §4).
  /// Если true — после завершения `ai.merge` автоматически ставится job в `ai.transcript-clean`.
  /// По умолчанию false — Org включает руками, оценив бюджет на LLM-refine (~$0.05 за 100 мин).
  /// Поле живёт на Org для простоты (отдельной модели OrgSettings в проекте сейчас нет).
  transcriptCleaningAuto Boolean @default(false)
  /// Фаза C — типы встреч, для которых AI-оценка качества НЕ рассчитывается
  /// (sub-TZ C §4). Управляется через `PATCH /org/settings/quality-score`
  /// owner/admin'ом Org. Пустой массив = считать для всех типов. Поле живёт
  /// на Org по консистентности с `transcriptCleaningAuto` (отдельной OrgSettings
  /// в проекте нет).
  qualityScoreDisabledForTypes MeetingType[] @default([])
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  memberships  Membership[]
  invitations  OrgInvitation[]
  meetings     Meeting[]
  cards        Card[]
  tasks        Task[]
  chapters     MeetingChapter[]
  highlights   MeetingHighlight[]
  chatMessages MeetingChatMessage[]
  tags         Tag[]
  apiKeys      ApiKey[]
  webhookSubs  WebhookSubscription[]
  destinations IntegrationDestination[]
  exports      Export[]
  llmRoutes    LlmTaskRoute[]
  auditLogs    AuditLog[]
  aiUsageLogs  AiUsageLog[]
  sources      Source[]
  rawEvents    RawEvent[]
  ideaBlocks   IdeaBlock[]
  entities     Entity[]
  blockLinks   IdeaBlockLink[]
  entityLinks  EntityLink[]
  themes       Theme[]
  goals        Goal[]
  goalAlignmentSnapshots GoalAlignmentSnapshot[]
  retentionPolicy OrgRetentionPolicy?
  entitlement OrgEntitlement?

  // ── Фаза 0 — каркас компании ──
  departments     Department[]
  roles           Role[]
  persons         Person[]
  personRoles     PersonRole[]
  jobDescriptions JobDescription[]
  skills          Skill[]
  documents       Document[]
  roleProfiles    RoleProfile[]
  // Группа Б
  missions        Mission[]
  visions         Vision[]
  strategies      Strategy[]
  processes       Process[]
  processSteps    ProcessStep[]
  regulations     Regulation[]
  policies        Policy[]
  tools           Tool[]
  metrics         Metric[]
  decisions       Decision[]

  // ── Фаза A.1 — Prompt Registry ──
  promptTemplates  PromptTemplate[]
  promptExperiments PromptExperiment[]

  // ── SBA α-1 — Conversational Channels Foundation ──
  channels      Channel[]
  notifications Notification[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id        String         @id @default(cuid())
  orgId     String
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MembershipRole
  /// Кто пригласил/добавил. Для owner-а первичной Org = NULL.
  invitedBy String?
  inviter   User?          @relation("MembershipInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  /// Фаза 0a §10 — линковка с бизнес-Person, заполняется при accept'е
  /// приглашения. NULL для legacy memberships (до Фазы 0).
  personId  String?
  person    Person?        @relation("MembershipPerson", fields: [personId], references: [id], onDelete: SetNull)
  joinedAt  DateTime       @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
  @@index([personId])
}

model OrgInvitation {
  id               String              @id @default(cuid())
  orgId            String
  org              Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email            String
  role             MembershipRole
  /// Случайный nanoid(40); хранится как plaintext (короткоживущий + одноразовый).
  token            String              @unique
  status           OrgInvitationStatus @default(pending)
  invitedBy        String
  inviter          User                @relation("OrgInvitationInvitedBy", fields: [invitedBy], references: [id])
  /// Фаза 0a §10 — линковка с бизнес-Person. Опц.; при создании приглашения
  /// из wizard'а или /structure?tab=persons backend заранее создаёт Person
  /// и сохраняет ссылку здесь, чтобы при accept'е заполнить Person.userId.
  personId         String?
  person           Person?             @relation("OrgInvitationPerson", fields: [personId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?               @relation("OrgInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@index([personId])
}

// ──────────────────────────── llm-prices (Фаза 0 knowledge-core) ────────────────────────────

/// Версионируемая прайс-карта моделей. При расчёте `costUsd` LlmRouter сначала
/// смотрит сюда (актуальная запись по provider+model+effectiveFrom<=now AND
/// (effectiveTo IS NULL OR effectiveTo>now)), фолбэк на MODEL_PRICES в коде.
///
/// Цены — стоимость за 1 миллион токенов в указанной валюте.
model LlmModelPrice {
  id                         String    @id @default(cuid())
  provider                   String
  model                      String
  inputCostPerMillionTokens  Decimal   @db.Decimal(10, 6)
  outputCostPerMillionTokens Decimal   @db.Decimal(10, 6)
  /// Цена за 1M кэшированных входных токенов (prompt cache hit). 0 — не поддерживается.
  cachedCostPerMillionTokens Decimal   @default(0) @db.Decimal(10, 6)
  currency                   String    @default("USD")
  effectiveFrom              DateTime  @default(now())
  effectiveTo                DateTime?
  createdAt                  DateTime  @default(now())

  @@index([provider, model, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

// ──────────────────────────── knowledge-core: Source / RawEvent (Фаза 1) ────────────────────────────

/// Справочник подключённых источников Org (meeting, chat, email, …).
/// Дефолтный `Source(type=meeting, name='Встречи Z')` создаётся автоматически
/// при создании Org. Управление источниками из UI — Фаза 10.
model Source {
  id        String     @id @default(cuid())
  tenantId  String
  type      SourceType
  name      String
  config    Json?
  dataClass DataClass  @default(internal)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org       Org        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEvents RawEvent[]

  @@unique([tenantId, type, name])
  @@index([tenantId, isActive])
}

/// Иммутабельная запись сырого события из любого источника. Главный entry-point
/// в knowledge-core. На Фазе 2 над ней появится `block-ingest.worker`.
model RawEvent {
  id               String                   @id @default(cuid())
  tenantId         String
  sourceId         String
  sourceType       SourceType
  /// Если null — событие без внешнего ID, дедуп по checksum.
  sourceExternalId String?
  /// sha256(sourceId + ':' + (sourceExternalId ?? payloadChecksum) + ':' + occurredAtIso)
  idempotencyKey   String                   @unique
  occurredAt       DateTime
  receivedAt       DateTime                 @default(now())
  payloadStorage   RawEventPayloadStorage   @default(inline)
  /// null если payloadStorage = s3
  payload          Json?
  /// не null если payloadStorage = s3
  payloadS3Key     String?
  /// sha256 от исходного payload (всегда, для верификации).
  payloadChecksum  String
  payloadSizeBytes Int
  dataClass        DataClass                @default(internal)
  processingStatus RawEventProcessingStatus @default(received)
  /// Текст ошибки при processingStatus = failed.
  processingError  String?                  @db.Text
  /// Когда последний раз обработался ingest pipeline (Фаза 2).
  processedAt      DateTime?

  org      Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source   Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  evidence IdeaBlockEvidence[]

  @@index([tenantId, sourceId, occurredAt])
  @@index([tenantId, processingStatus])
}

// ──────────────────────────── knowledge-core: IdeaBlock + Entity (Фаза 2) ────────────────────────────

/// IdeaBlock — единица знания «вопрос ↔ доверенный ответ».
/// Извлекается block-ingest.worker'ом из RawEvent, дедуплицируется
/// block-distill.worker'ом по эмбеддингам и LLM-арбитру.
///
/// Поля name / criticalQuestion / trustedAnswer индексируются ts_vector'ом
/// (см. postgres-init.sql) для гибридного поиска. embedding (vector(1536))
/// — для семантического поиска через HNSW.
///
/// status:
///   - draft: только что извлечён, не прошёл distill
///   - canonical: основной блок, остальные похожие через mergedIntoId → его id
///   - merged_into: блок-дубликат, его mergedIntoId указывает на canonical
///   - archived: устарел / явно скрыт
model IdeaBlock {
  id               String                       @id @default(cuid())
  tenantId         String
  name             String
  criticalQuestion String                       @db.Text
  trustedAnswer    String                       @db.Text
  tags             String[]                     @default([])
  signalType       SignalType
  confidence       Decimal                      @default(0.5) @db.Decimal(4, 3)
  dataClass        DataClass                    @default(internal)
  embedding        Unsupported("vector(1536)")?
  status           IdeaBlockStatus              @default(draft)
  mergedIntoId     String?
  evidenceCount    Int                          @default(0)
  /// Динамический рейтинг: пересчитывается ретеншеном; влияет на ранжирование в поиске.
  dynamicScore     Decimal                      @default(1.0) @db.Decimal(8, 4)
  /// Фаза 0b — пометка role-relevance из BlockExtractionService.
  /// Если true и roleId != null — блок учитывается RoleProfileAgent'ом (Фаза 0d).
  roleRelevant     Boolean                      @default(false)
  /// Опц. связь блока с Role (бизнес-должность). NULL — общий блок.
  roleId           String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  org        Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto IdeaBlock?          @relation("BlockMerges", fields: [mergedIntoId], references: [id])
  mergedFrom IdeaBlock[]         @relation("BlockMerges")
  evidence   IdeaBlockEvidence[]
  entities   IdeaBlockEntity[]
  linksFrom  IdeaBlockLink[]     @relation("BlockLinkFrom")
  linksTo    IdeaBlockLink[]     @relation("BlockLinkTo")
  themes     ThemeIdeaBlock[]
  /// Decision-сущности, созданные параллельно этому блоку (idempotent по
  /// sourceIdeaBlockId; Фаза 0b §I.66 зонтичного ТЗ).
  decisions  Decision[]
  /// Фаза 0d — link на Role-бизнес-должность для RoleProfileAgent.
  role       Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, signalType])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, roleRelevant, roleId])
}

/// IdeaBlockEvidence — link block ↔ конкретный фрагмент RawEvent с цитатой.
/// Один блок может иметь много свидетельств из разных встреч/чатов/звонков.
/// quote — текстовая цитата, startMs/endMs — таймкоды (если применимо к источнику).
model IdeaBlockEvidence {
  id              String     @id @default(cuid())
  blockId         String
  rawEventId      String
  sourceType      SourceType
  sourceTimestamp DateTime?
  quote           String     @db.Text
  startMs         Int?
  endMs           Int?
  createdAt       DateTime   @default(now())

  block    IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rawEvent RawEvent  @relation(fields: [rawEventId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@index([rawEventId])
}

/// Entity — сущность (клиент, человек, проект, продукт, тема, локация, custom).
/// Используется в IdeaBlockEntity (M:M с блоками) и в knowledge-core search.
/// canonicalName уникален в рамках tenant + type через приложение (не индексом —
/// возможны исторические дубликаты до прохода entity-merge-arbiter).
model Entity {
  id            String                       @id @default(cuid())
  tenantId      String
  type          EntityType
  canonicalName String
  aliases       String[]                     @default([])
  mergedIntoId  String?
  mentionsCount Int                          @default(0)
  embedding     Unsupported("vector(1536)")?
  metadata      Json?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  org           Org               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto    Entity?           @relation("EntityMerges", fields: [mergedIntoId], references: [id])
  mergedFrom    Entity[]          @relation("EntityMerges")
  blockMentions IdeaBlockEntity[]
  // ↓ С Фазы 0 EntityLink — полиморфная модель без FK на Entity. Обратные
  //   relations убраны; для поиска связей используется
  //   EntityLink.findMany({ where: { fromEntityId, fromType: 'entity' } })
  //   или GraphService.getNeighbors. См. EntityLink выше.
  themes        ThemeEntity[]
  cards         Card[]            @relation("CardEntity")
  /// Линковка Person → Entity (Фаза 0b §8.3): Entity{type=person} может быть
  /// связана с Prisma-моделью Person через EntityResolutionService.
  persons       Person[]

  @@index([tenantId, type])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, canonicalName])
}

/// IdeaBlockEntity — M:M связь block ↔ entity с ролью и контекстом упоминания.
/// role — subject (главное действующее), object (на что направлено), mentioned (вскользь).
model IdeaBlockEntity {
  blockId        String
  entityId       String
  mentionContext String              @db.Text
  role           IdeaBlockEntityRole @default(mentioned)
  createdAt      DateTime            @default(now())

  block  IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([blockId, entityId])
  @@index([entityId])
}

/// IdeaBlockLink — типизированная связь между двумя IdeaBlock.
/// Создаётся `block-linker.worker` (KNN top-K кандидатов + LLM-арбитр)
/// или `reframing.cron` (рефлексия графа). 7 типов связей —
/// см. enum `IdeaBlockLinkType`.
///
/// Дедупликация: уникальная пара (fromBlockId, toBlockId, relationType).
/// Идемпотентный upsert при повторных проходах линкера.
model IdeaBlockLink {
  id           String            @id @default(cuid())
  tenantId     String
  fromBlockId  String
  toBlockId    String
  relationType IdeaBlockLinkType
  confidence   Decimal           @db.Decimal(4, 3)
  explanation  String            @db.Text
  createdBy    LinkCreatedBy
  status       LinkStatus        @default(active)
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11). Если не null — связь скрыта в UI.
  deletedAt    DateTime?
  /// userId, инициировавший удаление через Org-Admin. Для аудита.
  deletedBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  org       Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBlock IdeaBlock @relation("BlockLinkFrom", fields: [fromBlockId], references: [id], onDelete: Cascade)
  toBlock   IdeaBlock @relation("BlockLinkTo", fields: [toBlockId], references: [id], onDelete: Cascade)

  @@unique([fromBlockId, toBlockId, relationType])
  @@index([tenantId, status])
  @@index([fromBlockId, status])
  @@index([toBlockId, status])
  @@index([tenantId, deletedAt])
}

/// EntityLink — типизированная связь между двумя узлами графа.
///
/// До Фазы 0 — только Entity↔Entity (knowledge-core, создаётся
/// `entity-graph-builder.cron` раз в час). С Фазы 0 — единая полиморфная
/// модель рёбер для ВСЕХ бизнес-связей Z (см.
/// plans/tz/2026-05-21-phase-0a-data-model-and-graph-infra.md §4.4).
///
/// `fromType` / `toType` — discriminator типа узла. NULL = legacy запись
/// до Фазы 0 (читается как `entity`). Backfill — `backend/scripts/backfill-entity-link-types.ts`.
///
/// FK на Entity убраны: новые связи могут ссылаться на Role, Person, Process,
/// Document и т.д. — таблицы, которые не Entity. Каскадное удаление узла
/// чистит рёбра через `GraphService.removeNode` (см. 0a.2).
///
/// Двойная запись Postgres EntityLink + AGE `z_graph` — единственная точка
/// записи через `GraphService.addEdge` (см.
/// `second-brain/02_architecture/code-pitfalls.md` «Cypher только через GraphService»).
model EntityLink {
  id           String         @id @default(cuid())
  tenantId     String
  /// id источника. До Фазы 0 — всегда `Entity.id`. С Фазы 0 — id любой
  /// бизнес-сущности (см. fromType).
  fromEntityId String
  /// id цели. До Фазы 0 — всегда `Entity.id`. С Фазы 0 — id любой
  /// бизнес-сущности (см. toType).
  toEntityId   String
  /// Discriminator типа источника. NULL = legacy (`entity`).
  /// Возможные значения см. `NodeType` в `backend/src/common/graph/graph.types.ts`.
  fromType     String?        @db.VarChar(50)
  /// Discriminator типа цели. NULL = legacy (`entity`).
  toType       String?        @db.VarChar(50)
  relationType EntityLinkType
  confidence   Decimal        @db.Decimal(4, 3)
  explanation  String         @db.Text
  createdBy    LinkCreatedBy
  status       LinkStatus     @default(active)
  /// Временной интервал жизни связи (для bi-temporal в Фазе α; в Фазе 0 —
  /// используется для `executes_role` Person→Role).
  validFrom    DateTime       @default(now())
  validTo      DateTime?
  /// Произвольные свойства связи (cosine score, RACI-флаги, observed_at и т.д.).
  properties   Json           @default("{}")
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11).
  deletedAt    DateTime?
  /// userId, инициировавший удаление через Org-Admin.
  deletedBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite unique с учётом fromType/toType: одна и та же пара id может
  // быть одновременно entity→entity и (с Фазы 0) role→person с тем же
  // relationType. Включаем fromType/toType в ключ для однозначности.
  @@unique([fromEntityId, fromType, toEntityId, toType, relationType])
  @@index([tenantId, status])
  @@index([tenantId, fromEntityId, fromType])
  @@index([tenantId, toEntityId, toType])
  @@index([tenantId, relationType, validFrom])
  @@index([tenantId, deletedAt])
}

// ──────────────────────────── knowledge-core: Theme (Фаза 4) ────────────────────────────

/// Theme — AI-кластер блоков. Создаётся `theme-clusterer.cron` (KNN-greedy
/// по эмбеддингам блоков + LLM-классификатор имени/ветки). Никогда не
/// создаётся пользователем вручную: если пользователь хочет «свою тему» —
/// он жмёт `POST /themes/:id/save-as-card` и получает Card с kind='topic'.
///
/// branch — одна из 12 веток компании (delivery M-07). Опциональна: LLM
/// может вернуть `null`, если ветка не определилась.
///
/// embedding(1536) — эмбеддинг от `name + ' ' + description`, для поиска
/// связанных тем и для UI-фильтров.
model Theme {
  id           String                       @id @default(cuid())
  tenantId     String
  name         String
  description  String                       @db.Text
  weight       Decimal                      @default(0.5) @db.Decimal(4, 3)
  dynamic      ThemeDynamic                 @default(stable)
  confidence   Decimal                      @default(0.5) @db.Decimal(4, 3)
  status       ThemeStatus                  @default(active)
  mergedIntoId String?
  branch       ThemeBranch?
  embedding    Unsupported("vector(1536)")?
  lastSignalAt DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  org        Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto Theme?           @relation("ThemeMerges", fields: [mergedIntoId], references: [id])
  mergedFrom Theme[]          @relation("ThemeMerges")
  blocks     ThemeIdeaBlock[]
  entities   ThemeEntity[]
  cards      Card[]           @relation("CardBornFromTheme")
  goalLinks  GoalTheme[]

  @@index([tenantId, status])
  @@index([tenantId, branch])
  @@index([tenantId, mergedIntoId])
}

/// ThemeIdeaBlock — M:M связь Theme ↔ IdeaBlock.
/// weight — мера принадлежности блока к теме (1.0 для seed-кластера, ниже
/// для дополнительно «прибившихся» блоков в reframing).
model ThemeIdeaBlock {
  themeId   String
  blockId   String
  weight    Decimal  @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime @default(now())

  theme Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  block IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([themeId, blockId])
  @@index([blockId])
}

/// ThemeEntity — denormalized связь Theme ↔ Entity (через блоки темы).
/// Заполняется кластерером и поддерживается reframing'ом для быстрых фильтров
/// «темы про этого клиента / этот продукт».
model ThemeEntity {
  themeId       String
  entityId      String
  mentionsCount Int      @default(0)
  createdAt     DateTime @default(now())

  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([themeId, entityId])
  @@index([entityId])
}

// ──────────────────────────── Z-Admin: SuperAdminAccessLog (Фаза 7) ────────────────────────────

/// Лог drill-down действий super_admin (Z-Admin Фаза 7).
/// Любое чтение/запись super_admin'а в данные конкретной Org пишется сюда
/// для compliance. На Фазе 7 — только запись, ежемесячный email-отчёт vNext.
///
/// Глобальная таблица (нет tenantId на уровне модели — `accessedTenantId`
/// указывает, к какой Org обращался super_admin; null = глобальный уровень).
model SuperAdminAccessLog {
  id               String   @id @default(cuid())
  superAdminUserId String
  superAdmin       User     @relation("SuperAdminAccessLog", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  /// NULL = действие на глобальном уровне (без конкретной Org).
  accessedTenantId String?
  route            String
  method           String
  params           Json?
  createdAt        DateTime @default(now())

  @@index([superAdminUserId, createdAt])
  @@index([accessedTenantId, createdAt])
}

// ──────────────────────────── knowledge-core: goals (Фаза 9) ────────────────────────────

/// Цель компании (Фаза 9 knowledge-core).
/// Создаётся owner Org вручную. Связь с Theme — M:M (GoalTheme).
/// Ежесуточно strategic-alignment.worker оценивает движение к цели.
model Goal {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String       @db.Text
  /// Опциональный дедлайн. Используется как контекст для LLM-судьи.
  targetDate   DateTime?
  status       GoalStatus   @default(active)
  /// Вес в среднем "Согласованность стратегии" (Фаза 8 dashboard). Default 1.0.
  weight       Decimal      @default(1.0) @db.Decimal(4, 3)
  /// Фаза 0a §11.6 — горизонт цели для декомпозиции strategic→annual→…→sprint.
  /// Default quarterly — типичная цель компании в delivery/03-frame.md.
  horizon      GoalHorizon  @default(quarterly)
  /// Фаза 0a §11.6 — декомпозиция целей. Self-relation; UI появится в Фазе γ.
  parentGoalId String?
  parent       Goal?        @relation("GoalDecomposition", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children     Goal[]       @relation("GoalDecomposition")
  createdById  String
  createdBy    User         @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?
  /// Кэш последнего snapshot для быстрого чтения списка целей без JOIN'а.
  /// Обновляется воркером после каждого расчёта.
  cachedAlignment      Int?      /// 0..100, NULL = ещё не считалось.
  cachedAlignmentAt    DateTime?
  cachedAlignmentDelta Int?      /// разница со снапшотом 24h назад, для подсветки падений.
  cachedSnapshotId     String?   /// FK на последний GoalAlignmentSnapshot.

  themes    GoalTheme[]
  snapshots GoalAlignmentSnapshot[]

  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
  @@index([tenantId, horizon])
  @@index([tenantId, parentGoalId])
}

/// M:M между Goal и Theme. На старте — ручная привязка от owner;
/// AI-предложения добавляются с source='ai' в vNext.
model GoalTheme {
  goalId    String
  themeId   String
  /// Источник связи: manual (owner добавил) | ai (предложено suggester'ом).
  source    GoalThemeSource @default(manual)
  /// Вес (1.0 — основная, ниже — частично связанная). По умолчанию 1.0.
  weight    Decimal         @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime        @default(now())

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([goalId, themeId])
  @@index([themeId])
}

/// Суточный снапшот «движения к цели» от strategic-alignment.worker.
/// Используется для timeline'а и вычисления delta.
model GoalAlignmentSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  goalId       String
  /// 0..100 — оценка движения за окно (default 30 дней).
  score        Int
  /// Разница со снапшотом 24h назад (для подсветки падений). NULL для первого.
  delta        Int?
  /// 1-3 предложения объяснения от LLM.
  explanation  String   @db.Text
  /// Структура: { pro: ['…'], contra: ['…'] } — по 3-5 пунктов.
  signals      Json
  /// Какое окно использовалось (в днях).
  windowDays   Int      @default(30)
  /// Сколько связанных тем участвовало в оценке.
  themesCount  Int
  /// Сколько блоков LLM проанализировал.
  blocksCount  Int
  /// AiUsageLog.id (для drill-down в Z-Admin). FK не делаем — может быть очищен ретеншеном.
  aiUsageLogId String?
  /// Если delta <= -15 и score <= 60 — alertPending=true.
  alertPending Boolean  @default(false)
  createdAt    DateTime @default(now())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tenant Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, alertPending])
}

// ──────────────────────────── knowledge-core: retention (Фаза 11) ────────────────────────────

/// OrgRetentionPolicy — конфиг ретеншена per-Org для knowledge-core/152-ФЗ
/// (Фаза 11). Создаётся seed'ом или lazy upsert'ом в RetentionPolicyService.
///
/// Поля — длительности в днях:
///   - rawEventDays: 7 лет (2555) — дефолт под 152-ФЗ; ниже 30 нельзя установить.
///   - archivedBlockDays: 365 — сколько живёт IdeaBlock.status='archived' до hard-delete.
///   - chatMessageDays: 90 — MeetingChatMessage.
///   - auditLogDays: 730 — AuditLog (compliance).
///
/// archivedBlockAction:
///   - 'archive_then_delete' (default) — блок без evidence уходит в archived,
///     а через archivedBlockDays — hard-delete.
///   - 'keep_forever' — архив остаётся всегда (нет hard-delete по retention).
///
/// lastSweepAt — когда последний раз RetentionService.processAll проходил по Org.
model OrgRetentionPolicy {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  org                 Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEventDays        Int       @default(2555)
  archivedBlockDays   Int       @default(365)
  chatMessageDays     Int       @default(90)
  auditLogDays        Int       @default(730)
  archivedBlockAction String    @default("archive_then_delete")
  lastSweepAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ──────────────────────────── knowledge-core: entitlements (Фаза 12) ────────────────────────────

/// OrgEntitlement — per-Org конфиг тарифа и override'ов фич/квот (Фаза 12).
///
/// `tier` — строка ('tier_basic' | 'tier_pro' | 'tier_enterprise'), не enum.
/// Причина: бизнес может ввести четвёртый/пятый тариф без миграции.
/// Реестр тарифов (features/quotas) — статический в коде (TierConfigRegistry).
///
/// `featureOverrides` / `quotaOverrides` — JSON-карты для исключений.
/// Пример: `{"feature.theme": true}` даст enterprise-фичу одной Org бесплатно.
///
/// `notes` — ручной комментарий super_admin'а (для audit-trail в UI).
///
/// На MVP backfill сидит `tier_pro` по умолчанию (см. seed-entitlements.ts).
model OrgEntitlement {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  org              Org      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier             String   @default("tier_pro")
  featureOverrides Json?
  quotaOverrides   Json?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════════════════
// Фаза 0 — каркас компании (см. plans/tz/2026-05-21-phase-0-roles-and-onboarding.md)
// ════════════════════════════════════════════════════════════════════════════
//
// Группа А (с UI в Фазе 0):
//   Department, Role, Person, PersonRole, JobDescription, Skill, Document, RoleProfile.
//
// Группа Б (без UI в Фазе 0, наполняется extraction'ом):
//   Mission, Vision, Strategy, Process, ProcessStep, Regulation, Policy,
//   Tool, Metric, Decision. См. ниже после группы А.
//
// Conventions: id = cuid(); tenantId (НЕ orgId, для консистентности с
// существующими моделями); все @relation на tenant идут через Org.
// Membership.role (owner/admin/manager) ≠ бизнес-Role (должность в компании
// клиента) — это две разные сущности. См. README в second-brain.

// ──────────────────────────── группа А: структура компании ────────────────────────────

/// Department — отдел компании клиента (Фаза 0).
/// Поле `parentDepartmentId` — иерархия в схеме, UI в Фазе 0 плоский (γ
/// добавит дерево). См. зонтичный ТЗ §2 «Не входит».
model Department {
  id                 String      @id @default(cuid())
  tenantId           String
  name               String      @db.VarChar(200)
  parentDepartmentId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  /// Soft-delete: cohabits с уникальностью (orgId, name) благодаря включению deletedAt в @@unique.
  deletedAt          DateTime?

  org      Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentParent", fields: [parentDepartmentId], references: [id])
  children Department[] @relation("DepartmentParent")
  roles    Role[]
  persons  Person[]     @relation("PersonPrimaryDepartment")

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@index([tenantId, parentDepartmentId])
  @@map("departments")
}

/// Role — должность в компании клиента (бизнес-сущность).
/// **НЕ ПУТАТЬ** с `Membership.role` (owner/admin/manager) — это права доступа
/// в Z. `Role` (эта модель) — бизнес-должность ("Менеджер по продажам", "QA Engineer").
model Role {
  id           String    @id @default(cuid())
  tenantId     String
  name         String    @db.VarChar(200)
  departmentId String?
  /// Свободные теги для поиска и фильтрации.
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  org             Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id])
  jobDescriptions JobDescription[]
  roleProfile     RoleProfile?
  personRoles     PersonRole[]
  /// IdeaBlock-и с пометкой role_relevant=true для RoleProfileAgent (Фаза 0d).
  ideaBlocks      IdeaBlock[]
  /// Документы, явно загруженные на эту должность через wizard или /structure.
  attachedDocuments Document[]    @relation("DocumentAttachedRole")
  /// Процессы, owner которых — эта роль (Фаза 0b, наполняется extraction'ом).
  ownedProcesses    Process[]     @relation("ProcessOwnerRole")

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId, departmentId])
  @@map("roles")
}

/// Person — сотрудник компании клиента (Фаза 0).
///
/// Отличие от Entity{type=person}: `Entity` — это упоминание персоны в графе
/// знаний (knowledge-core); `Person` — это сущность ЛК со связями с
/// Role/Department/User. `Person.entityId` — линковка, заполняется
/// EntityResolutionService (Фаза 0b §8.3).
///
/// `userId` NULL до accept'а приглашения. Membership создаётся атомарно с
/// `Person.userId = currentUserId` в `POST /api/v1/orgs/:orgId/invitations/:token/accept`.
model Person {
  id                  String    @id @default(cuid())
  tenantId            String
  /// NULL до accept'а приглашения. После accept'а — атомарно линкуется с User.
  userId              String?
  name                String    @db.VarChar(200)
  email               String    @db.VarChar(320)
  /// Основной отдел для UI; для графовых связей `member_of` — через PersonRole.
  primaryDepartmentId String?
  /// Линковка с Entity{type=person} (см. EntityResolutionService, Фаза 0b §8.3).
  entityId            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  org                 Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?        @relation("UserPersons", fields: [userId], references: [id], onDelete: SetNull)
  primaryDepartment   Department?  @relation("PersonPrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  entity              Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  personRoles        PersonRole[]
  uploadedDocuments  Document[]   @relation("DocumentUploader")
  decisionsMade      Decision[]   @relation("DecisionDecidedBy")
  ownedProcesses     Process[]    @relation("ProcessOwnerPerson")
  memberships        Membership[] @relation("MembershipPerson")
  invitations        OrgInvitation[] @relation("OrgInvitationPerson")

  @@unique([tenantId, email, deletedAt])
  @@index([tenantId, userId])
  @@index([tenantId, primaryDepartmentId])
  @@index([tenantId, entityId])
  @@map("persons")
}

/// PersonRole — many-to-many Person ↔ Role с временным интервалом.
/// Зеркало AGE-ребра `executes_role` (Фаза 0a). Открытая роль = validTo IS NULL.
/// Закрытие старой роли при переназначении: validTo = now() + создание новой записи.
model PersonRole {
  id        String    @id @default(cuid())
  tenantId  String
  personId  String
  roleId    String
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())

  org    Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([personId, roleId, validFrom])
  @@index([tenantId, roleId])
  @@index([tenantId, personId])
  @@index([tenantId, validTo])
  @@map("person_roles")
}

/// JobDescription — declared-форма должности (что прописано в инструкции,
/// в отличие от observed-картины в RoleProfile).
model JobDescription {
  id               String    @id @default(cuid())
  tenantId         String
  roleId           String
  contentMd        String    @db.Text
  sourceDocumentId String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  org            Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([tenantId, roleId])
  @@map("job_descriptions")
}

/// Skill — переиспользуемая компетенция (одна Skill — много Role/Person).
model Skill {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    @db.VarChar(200)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@map("skills")
}

/// Document — загруженный файл (PDF / DOCX / Markdown / text). Фаза 0b.
///
/// inline ≤ 10 MiB кладётся в `inlineContent`; больше — в S3 (`s3Key`).
/// `parsedText` заполняется `document.adapter` / `text.adapter` (Фаза 0b).
/// `attachedRoleId` — если документ привязан к конкретной должности (из
/// wizard step-4 или `/structure?tab=roles → Загрузить должностную`).
model Document {
  id             String         @id @default(cuid())
  tenantId       String
  /// Person.id (НЕ User.id) — кто загрузил.
  uploaderId     String
  kind           DocumentKind
  name           String         @db.VarChar(500)
  mimeType       String         @db.VarChar(100)
  /// S3-ключ; null если используется inlineContent (file ≤ 10 MiB).
  s3Key          String?        @db.VarChar(500)
  /// Inline-байты; null если использован S3.
  inlineContent  Bytes?
  originalSize   Int
  /// Заполняется парсером (Фаза 0b).
  parsedText     String?        @db.Text
  /// Если status=failed — текст ошибки парсера.
  parseError     String?        @db.Text
  status         DocumentStatus @default(uploaded)
  /// Если документ привязан к Role — wizard step-4 или /structure → Загрузить должностную.
  attachedRoleId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  org             Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader        Person           @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  attachedRole    Role?            @relation("DocumentAttachedRole", fields: [attachedRoleId], references: [id], onDelete: SetNull)
  jobDescriptions JobDescription[]

  @@index([tenantId, status])
  @@index([tenantId, uploaderId])
  @@index([tenantId, attachedRoleId])
  @@map("documents")
}

/// RoleProfile — материализованный кеш "карта должности" (observed-форма).
/// Один RoleProfile на Role. Создаётся автоматически при создании Role
/// (через RolesService); наполняется RoleProfileAgent (Фаза 0d).
model RoleProfile {
  id           String            @id @default(cuid())
  tenantId     String
  roleId       String            @unique
  /// `{ responsibilities[], skills[], decision_patterns[], common_pitfalls[], style_profile }`.
  /// Schema валидируется zod'ом в `role-profile.service.ts` (Фаза 0d).
  summaryCache Json              @default("{}")
  status       RoleProfileStatus @default(forming)
  lastBuildAt  DateTime?
  /// Инкрементируется при каждой успешной пересборке. Используется в
  /// idempotency-key BullMQ ('role-profile:${roleId}:${buildVersion}').
  buildVersion Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  org  Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("role_profiles")
}

// ──────────────────────────── группа Б: каркас 5 уровней (без UI в Фазе 0) ────────────────────────────

/// Mission — «зачем» компании (Фаза 0a, группа Б). UI в Фазе γ.
/// Наполняется UI-формой в γ; в Фазе 0 поле существует, extraction отключен
/// флагом `EXTRACTION_ENABLE_TOP_LEVEL=false` (зонтичный ТЗ §6 решение #11).
model Mission {
  id         String      @id @default(cuid())
  tenantId   String
  contentMd  String      @db.Text
  markets    Json?
  bets       Json?
  horizon    GoalHorizon @default(strategic)
  targetDate DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("missions")
}

/// Vision — образ будущего компании (Фаза 0a, группа Б). UI в Фазе γ.
model Vision {
  id           String    @id @default(cuid())
  tenantId     String
  contentMd    String    @db.Text
  horizonYears Int?
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("visions")
}

/// Strategy — стратегия (рынки + ставки) (Фаза 0a, группа Б). UI в Фазе γ.
model Strategy {
  id         String      @id @default(cuid())
  tenantId   String
  contentMd  String      @db.Text
  markets    Json        @default("[]")
  bets       Json        @default("[]")
  horizon    GoalHorizon @default(strategic)
  targetDate DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("strategies")
}

/// Process — бизнес-процесс компании (Фаза 0a, группа Б). UI в Фазе γ.
///
/// Наполняется BlockExtractionService (Фаза 0b) с дедупом через
/// EntityResolutionService. `confidence` — точность LLM-классификации;
/// `ambiguousTypes` — если LLM колебалась (например, Process vs Regulation),
/// сохраняем оба варианта для CuratorAgent в Фазе δ.
model Process {
  id                 String        @id @default(cuid())
  tenantId           String
  name               String        @db.VarChar(300)
  description        String?       @db.Text
  ownerRoleId        String?
  ownerPersonId      String?
  triggerDescription String?       @db.Text
  slaMinutes         Int?
  status             ProcessStatus @default(active)
  /// 0..1 — confidence от extraction-LLM (Фаза 0b §6.2).
  confidence         Float?
  /// Если LLM колеблется (Process vs Regulation/Policy) — список альтернатив.
  ambiguousTypes     String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  org         Org           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerRole   Role?         @relation("ProcessOwnerRole", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  ownerPerson Person?       @relation("ProcessOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  steps       ProcessStep[]

  /// Уникальность гарантируется EntityResolutionService + cosine + LLM-arbiter (0b §8).
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, ownerRoleId])
  @@map("processes")
}

/// ProcessStep — шаг процесса (Фаза 0a, группа Б).
model ProcessStep {
  id          String    @id @default(cuid())
  tenantId    String
  processId   String
  name        String    @db.VarChar(300)
  order       Int
  description String?   @db.Text
  slaMinutes  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org     Org     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([processId, order])
  @@index([tenantId, processId])
  @@map("process_steps")
}

/// Regulation — регламент / стандарт (Фаза 0a, группа Б).
/// `category=standard` через AGE-ребро `applies_to` ссылается на тип
/// артефакта (строка, динамическая онтология — γ).
model Regulation {
  id         String             @id @default(cuid())
  tenantId   String
  name       String             @db.VarChar(300)
  contentMd  String             @db.Text
  category   RegulationCategory @default(regulation)
  status     ProcessStatus      @default(active)
  version    Int                @default(1)
  confidence Float?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@map("regulations")
}

/// Policy — политика (Фаза 0a, группа Б). UI в Фазе γ.
model Policy {
  id         String         @id @default(cuid())
  tenantId   String
  name       String         @db.VarChar(300)
  contentMd  String         @db.Text
  severity   PolicySeverity @default(advisory)
  status     ProcessStatus  @default(active)
  confidence Float?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, severity])
  @@map("policies")
}

/// Tool — инструмент / система / шаблон (Фаза 0a, группа Б).
model Tool {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    @db.VarChar(200)
  kind        ToolKind  @default(software)
  externalUrl String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tools")
}

/// Metric — метрика (Фаза 0a, группа Б).
model Metric {
  id          String          @id @default(cuid())
  tenantId    String
  name        String          @db.VarChar(200)
  description String?         @db.Text
  unit        String          @db.VarChar(50)
  target      Float?
  valueType   MetricValueType @default(count)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("metrics")
}

/// Decision — решение, принятое в компании (Фаза 0a, группа Б).
///
/// Критично для миграционного долга: сейчас «размазан» как
/// `IdeaBlock.signalType='decision'`. С Фазы 0 — отдельная сущность с
/// idempotent-связью к исходному `IdeaBlock` (один Decision на IdeaBlock).
model Decision {
  id                 String         @id @default(cuid())
  tenantId           String
  text               String         @db.Text
  rationale          String?        @db.Text
  decidedAt          DateTime
  decidedByPersonId  String?
  sourceMeetingId    String?
  sourceIdeaBlockId  String?        @unique
  status             DecisionStatus @default(active)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  org             Org        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decidedBy       Person?    @relation("DecisionDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: SetNull)
  sourceMeeting   Meeting?   @relation("DecisionSourceMeeting", fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  sourceIdeaBlock IdeaBlock? @relation(fields: [sourceIdeaBlockId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, decidedAt])
  @@index([tenantId, decidedByPersonId])
  @@map("decisions")
}

// ─────────────────────────────────────────────────────────────────────────
// Фаза A.1 — Prompt Registry
// Источник: plans/tz/2026-05-21-phase-A-prompt-registry-admin.md §4
//
// Идея: все 9 системных промптов AI-отчёта (по типам встреч) + tasks /
// chapters / follow-up / card-rollup переезжают в БД как `PromptTemplate`
// с версионированием через `PromptTemplateVersion`. Файлы
// `backend/src/modules/ai/services/prompts/type-*.ts` остаются в коде
// как fallback и НЕ удаляются. Резолв и выбор источника промпта живёт
// в `PromptResolverService`.
// ─────────────────────────────────────────────────────────────────────────

/// Шаблон промпта AI-отчёта. Может быть системным (поставляется с Z) или
/// созданным Org-Admin'ом. В рамках Org `key` уникален; для system orgId=null
/// и `key` уникален глобально.
///
/// `activeVersionId` ссылается на текущую активную `PromptTemplateVersion`.
/// Менять активную версию — через `POST /admin/prompt-templates/:id/activate-version/:versionId`
/// (см. A.2). В A.1 endpoint'ов нет — только модель + seed.
model PromptTemplate {
  id              String                  @id @default(cuid())
  scope           PromptTemplateScope
  /// NULL для scope='system'; обязателен для scope='org' (валидируется в сервисе).
  orgId           String?
  /// Уникальный slug, e.g. 'type-sales', 'tasks-default', 'custom-sales-deep-dive'.
  key             String
  name            String
  description     String?                 @db.Text
  /// Если задан — шаблон используется только для этого типа встречи.
  /// NULL = универсальный (например, tasks/chapters/follow-up для всех типов).
  meetingType     MeetingType?
  /// Legacy LLM taskType: 'summary' | 'tasks' | 'chapters' | 'follow-up' | 'card-rollup'.
  /// Хранится как String, чтобы расширяться без миграций enum'а.
  taskType        String
  status          PromptTemplateStatus    @default(draft)
  /// Текущая активная версия (FK на PromptTemplateVersion). NULL до первого save.
  activeVersionId String?                 @unique
  /// Флаг safe-seed: true = шаблон редактировался админом, при повторном запуске seed'а
  /// не перезаписываем содержимое. Защита от потери ручных правок (skill `safe-seed-rules`).
  editedByAdmin   Boolean                 @default(false)
  createdById     String
  createdBy       User                    @relation("PromptTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  org             Org?                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions        PromptTemplateVersion[] @relation("PromptTemplateVersions")
  activeVersion   PromptTemplateVersion?  @relation("PromptTemplateActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  /// Фаза E — дополнительные («custom») отчёты встреч, созданные по этому шаблону.
  /// onDelete=Restrict на стороне MeetingReport: история отчётов жива даже после
  /// архивирования шаблона.
  meetingReports  MeetingReport[]         @relation("MeetingReportTemplate")

  @@unique([orgId, key])
  @@index([scope, status])
  @@index([orgId, status])
  @@index([taskType, meetingType, status])
}

/// Версия шаблона промпта. На каждое «Сохранить как новую версию» в UI A.2
/// создаётся новая запись. История версий используется для отката и
/// сравнения через diff в UI.
model PromptTemplateVersion {
  id              String                    @id @default(cuid())
  templateId      String
  /// Целочисленный номер версии (1, 2, 3...). Уникален в рамках шаблона.
  versionNumber   Int
  /// Общая часть промпта (шапка system-message).
  systemPrompt    String                    @db.Text
  /// Ожидаемая JSON-схема ответа (для structured-вывода через tool_use).
  /// Может включать `properties`, `required` — формат совместим с LlmTool.input_schema.
  outputSchema    Json
  /// Имя tool'а, который будет передан LLM при вызове (например, 'extract_sales').
  /// Используется для парсинга `toolCalls[].name` в analyze.worker. NULL = вызов без tool_use.
  toolName        String?
  createdById     String
  createdBy       User                      @relation("PromptTemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now())
  /// Свободный changelog от автора версии (см. ТЗ A §4.1).
  notes           String?                   @db.Text

  template          PromptTemplate          @relation("PromptTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  asActiveOf        PromptTemplate?         @relation("PromptTemplateActiveVersion")
  sections          PromptTemplateSection[]
  aiResults         AiResult[]              @relation("from_prompt_version")
  experimentsAsA    PromptExperiment[]      @relation("experiment_a")
  experimentsAsB    PromptExperiment[]      @relation("experiment_b")
  /// Фаза E — snapshot этой версии в MeetingReport: какая именно версия была
  /// использована при генерации (для воспроизводимости/диффа).
  meetingReports    MeetingReport[]         @relation("MeetingReportVersion")

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

/// Раздел отчёта в рамках версии шаблона. До 30 разделов на версию
/// (валидируется в сервисе). В A.1 секции создаются seed'ом из существующих
/// type-*.ts: каждое поле SCHEMA = одна секция с outputType.
model PromptTemplateSection {
  id              String                  @id @default(cuid())
  versionId       String
  /// Порядковый номер 1..30. Уникален в рамках версии.
  order           Int
  /// Slug секции для маппинга на ключ в JSON-ответе LLM.
  key             String
  title           String
  /// Инструкция LLM «что писать в этой секции».
  instruction     String                  @db.Text
  /// 'text' | 'bullet_list' | 'table' | 'json_object'. Хранится как String для расширяемости.
  outputType      String
  required        Boolean                 @default(true)
  /// Опциональный лимит maxTokens на секцию (см. валидатор в A.2).
  maxTokens       Int?

  version         PromptTemplateVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@unique([versionId, order])
  @@index([versionId])
}

/// A/B-эксперимент между двумя версиями шаблонов. Реализация A.3.
/// В A.1 модель заводится только для FK-целостности и future-proof'а — резолвер
/// уже умеет читать experimentGroup, но активных экспериментов в A.1 не будет.
model PromptExperiment {
  id              String     @id @default(cuid())
  /// NULL = эксперимент системного шаблона (только super_admin); иначе Org-эксперимент.
  orgId           String?
  /// Версия A (control).
  templateAId     String
  /// Версия B (variant).
  templateBId     String
  /// Доля трафика на B, 0..100.
  splitPercent    Int
  /// 'draft' | 'running' | 'stopped' | 'completed'.
  status          String     @default("draft")
  startedAt       DateTime?
  endsAt          DateTime?
  createdById     String
  createdBy       User       @relation("PromptExperimentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime   @default(now())
  notes           String?    @db.Text

  org             Org?                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateA       PromptTemplateVersion   @relation("experiment_a", fields: [templateAId], references: [id], onDelete: Restrict)
  templateB       PromptTemplateVersion   @relation("experiment_b", fields: [templateBId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@index([status])
}

/// Реакция пользователя (👍/👎) на AI-результат встречи. Заполняется
/// эндпоинтом A.3 `POST /api/v1/meetings/:meetingId/result/feedback`.
/// В A.1 модель заводится только для FK-целостности; UI/endpoint появляется в A.3.
model AiResultFeedback {
  id              String    @id @default(cuid())
  aiResultId      String
  userId          String
  /// 'positive' | 'negative'.
  reaction        String
  comment         String?   @db.Text
  createdAt       DateTime  @default(now())

  aiResult        AiResult  @relation(fields: [aiResultId], references: [id], onDelete: Cascade)
  user            User      @relation("AiResultFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([aiResultId, userId])
  @@index([aiResultId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Фаза E — несколько AI-отчётов на одну встречу
// ─────────────────────────────────────────────────────────────────────────
// Источник: plans/tz/2026-05-21-phase-E-multi-report-per-meeting.md §4.
//
// Primary-отчёт (`AiResult`, под `Meeting.type`) остаётся как есть. `MeetingReport`
// хранит «дополнительные» отчёты, генерируемые on-demand по выбранному шаблону.
// Partial unique index `(meeting_id, prompt_template_id) WHERE status IN
// ('pending','running')` создаётся вручную через apply-postgres-init.sql —
// Prisma partial unique не поддерживает.

enum MeetingReportStatus {
  pending
  running
  ready
  failed
  archived
}

/// Дополнительный («custom») AI-отчёт встречи. Генерируется воркером
/// `ai.custom-report` по выбранному `PromptTemplate` + `PromptTemplateVersion`.
/// Снимок версии шаблона хранится в `promptTemplateVersionId` для
/// воспроизводимости: если шаблон позже изменили или архивировали — отчёт всё
/// равно показывает то, что было в момент генерации.
model MeetingReport {
  id                      String              @id @default(cuid())
  meetingId               String
  /// tenant: Org, в которой принадлежит отчёт. Дублирует `meeting.tenantId`,
  /// чтобы admin-выборки/аудит не делали join.
  tenantId                String
  promptTemplateId        String
  promptTemplateVersionId String

  /// 'primary' | 'additional'. В рамках E все записи — 'additional';
  /// primary-отчёт показывается из `AiResult` синтетически. Колонка введена
  /// сразу, чтобы при будущей миграции primary в `MeetingReport` ничего не
  /// ломать в API-контракте.
  kind                    String              @default("additional")
  /// Снимок `PromptTemplate.name` в момент генерации (защита от ребрендинга
  /// шаблона позже).
  title                   String

  status                  MeetingReportStatus @default(pending)
  /// JSON-вывод LLM по `PromptTemplateVersion.outputSchema`. NULL пока не ready.
  output                  Json?
  /// Фактическая стоимость в USD (precision 4 знака после запятой).
  llmCostUsd              Decimal?            @db.Decimal(10, 4)
  llmDurationMs           Int?
  errorMessage            String?

  createdById             String
  createdAt               DateTime            @default(now())
  completedAt             DateTime?
  /// Soft-delete: при DELETE выставляем `status='archived'` + `deletedAt=now()`.
  deletedAt               DateTime?

  meeting                 Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  promptTemplate          PromptTemplate          @relation("MeetingReportTemplate", fields: [promptTemplateId], references: [id], onDelete: Restrict)
  promptTemplateVersion   PromptTemplateVersion   @relation("MeetingReportVersion", fields: [promptTemplateVersionId], references: [id], onDelete: Restrict)

  @@index([meetingId, status])
  @@index([meetingId, deletedAt])
  @@index([tenantId, createdAt])
  @@index([promptTemplateId])
  @@index([promptTemplateVersionId])
}

// ─────────────────────────────────────────────────────────────────────────
// SBA α-1 — Conversational Channels Foundation
// ─────────────────────────────────────────────────────────────────────────
// Источник: plans/tz/2026-05-21-sba-alpha-1-channels-foundation.md
//
// Двунаправленный омниканальный слой общения с человеком. InApp + Email
// — фундамент α-1. Telegram/MAX добавляются в β-1 расширением `ChannelKind`
// без правки моделей.

/// Тип канала. На α-1: `in_app`, `email_smtp`, `email_imap`. На β-1
/// добавляются `telegram_bot`, `max_bot`. На γ+: `slack`, `mattermost`,
/// `vk_messenger`, `whatsapp_business`, `web_push`, `voice_via_asr`.
enum ChannelKind {
  in_app
  email_smtp
  email_imap
  telegram_bot
  max_bot
}

/// Направление канала. Большинство каналов — bidirectional. Outbound-only
/// (`email_smtp`) есть; inbound-only (`email_imap`) появится с β-1.
enum ChannelDirection {
  inbound_only
  outbound_only
  bidirectional
}

enum ChannelStatus {
  active
  disabled
  broken
}

/// Жизненный цикл `Notification`.
/// `queued` → `sent_partial` (часть доставок ушла, часть в очереди) →
/// `delivered` (хотя бы один канал доставил) → `read` (хотя бы один отметил
/// прочитанным) → `responded` (получен ответ). `failed` — ни одна доставка
/// не прошла, retry'и исчерпаны.
enum NotificationStatus {
  queued
  sent_partial
  delivered
  read
  responded
  failed
}

/// Статус ожидания ответа на probe-нотификацию. Для не-probe (например,
/// `curation.pending` без явного respond-flow) — `null`.
enum NotificationResponseStatus {
  pending
  answered
  dismissed
  expired
}

/// Статус одной попытки доставки в конкретный `ChannelBinding`. Отдельный
/// enum от webhook'ового `DeliveryStatus`, потому что семантика другая
/// (read/responded состояния значимы для conversational, не для webhook).
enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  read
  responded
  failed
}

/// Channel — настроенный per-Org канал общения.
///
/// Конкретные секреты (botToken, IMAP password и т.п.) лежат в `config`
/// в зашифрованном виде через `CryptoService.encrypt(...)`. Для `in_app`
/// `config` пустой (`{}`). Для `email_smtp` — переиспользуем общий SMTP
/// из `cfg.mail` (per-Org переопределение появится позже), но запись
/// в `Channel` всё равно нужна, чтобы маршрутизатор знал, что Org
/// разрешила email-доставку.
model Channel {
  id           String           @id @default(cuid())
  tenantId     String
  kind         ChannelKind
  direction    ChannelDirection
  /// Зашифрованные секреты (botToken, etc). Для `in_app` = `{}`.
  config       Json             @default("{}")
  status       ChannelStatus    @default(active)
  /// Верхний потолок класса данных, который разрешено отправлять в этот
  /// канал. `internal` по умолчанию — `sensitive`/`private` не уходят
  /// во внешние каналы без явного апгрейда настройки.
  maxDataClass DataClass        @default(internal)
  brokenReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  org      Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings ChannelBinding[]

  @@unique([tenantId, kind])
  @@index([tenantId, kind])
  @@index([tenantId, status])
  @@map("channels")
}

/// ChannelBinding — привязка конкретного пользователя к конкретному каналу.
/// Для `in_app` `externalId = userId` (равенство сохраняется ради
/// единообразия). Для `email_smtp/imap` — email. Для `telegram_bot/max_bot`
/// — внешний user_id мессенджера (после verify через одноразовый код).
model ChannelBinding {
  id          String    @id @default(cuid())
  userId      String
  channelId   String
  /// Внешний идентификатор адресата: userId (in_app), email
  /// (email_smtp/imap), tg/max user_id (β-1). Уникален на канал.
  externalId  String
  /// Preferences пользователя per-binding: quiet hours, rate limits,
  /// фильтры eventType. См. ChannelBindingPreferences (zod-схема).
  preferences Json      @default("{}")
  linkedAt    DateTime  @default(now())
  /// Заполняется после проверки кода/верификации. Для in_app — равен
  /// `linkedAt` (auto-verified).
  verifiedAt  DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([channelId, externalId])
  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@map("channel_bindings")
}

/// Notification — событие, адресованное пользователю, доставляемое через
/// один или несколько `ChannelBinding`. Логическая единица — пожизненна,
/// `NotificationDelivery` — попытка доставки в конкретный канал.
///
/// `payload.schemaVersion`/`payload.body` — фактическая структура зависит
/// от `eventType`. Валидация — в `ConversationalService.sendNotification`
/// через `NotificationEventPayloadRegistry`.
model Notification {
  id              String                      @id @default(cuid())
  tenantId        String
  recipientUserId String
  /// Тип события, например `probe.question`, `curation.pending`,
  /// `idea.status_changed`. На α-1 — `probe.question`, `curation.pending`,
  /// `system.message`. Расширяется потребителями (α-4, β-5).
  eventType       String
  payload         Json
  dataClass       DataClass                   @default(internal)
  /// Опц. ссылка на исходный `IdeaBlock` (для probe'а на блок).
  contextBlockId  String?
  /// Опц. ссылка на карточку специалиста (Card, Decision, Regulation, ...).
  contextCardId   String?
  status          NotificationStatus          @default(queued)
  responseStatus  NotificationResponseStatus?
  responsePayload Json?
  expiresAt       DateTime?
  createdAt       DateTime                    @default(now())
  respondedAt     DateTime?

  org        Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient  User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([tenantId, recipientUserId, status])
  @@index([tenantId, eventType, status])
  @@index([recipientUserId, status])
  @@index([expiresAt])
  @@map("notifications")
}

/// NotificationDelivery — одна попытка доставки в конкретный
/// `ChannelBinding`. На один `Notification` может быть несколько
/// доставок (по числу выбранных routing'ом каналов).
model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  channelBindingId  String
  status            NotificationDeliveryStatus @default(queued)
  /// Внешний id сообщения (smtp messageId, telegram message_id, …).
  externalMessageId String?
  errorReason       String?
  /// Сколько раз пробовали отправить (для retry-логики worker'а).
  attempts          Int                        @default(0)
  attemptedAt       DateTime                   @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  respondedAt       DateTime?

  notification    Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channelBinding  ChannelBinding  @relation(fields: [channelBindingId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channelBindingId, status])
  @@map("notification_deliveries")
}

// ──────────────────────────── фаза B: поведенческие метрики встречи ────────────────────────────

/// MeetingBehaviorMetrics — общие (per-meeting) поведенческие метрики
/// (one-to-one с Meeting). Источник: ТЗ B (`plans/tz/2026-05-21-phase-B-meeting-behavior-metrics.md` §4).
///
/// Рассчитывается воркером `ai.behavior-metrics` параллельно `ai.analyze`
/// после `ai.merge`. Не зависит от готовности AiResult — может стать готовой
/// раньше/позже основного отчёта.
model MeetingBehaviorMetrics {
  id        String  @id @default(cuid())
  meetingId String  @unique
  tenantId  String

  /// Общая длительность встречи (по Meeting.endedAt - startedAt), мс.
  totalDurationMs Int
  /// Суммарное время речи всех участников (с учётом crosstalk дважды), мс.
  totalSpeechMs   Int
  /// Суммарная тишина (ни один спикер не говорит), мс.
  silenceMs       Int
  /// Доля тишины (0..100).
  silencePercent  Float
  /// Суммарное время одновременной речи 2+ участников, мс.
  crossTalkMs     Int
  /// Нормированный индекс доминирования: max(speakingTimeMs)/median(speakingTimeMs).
  /// При median=0 возвращаем 999 (моноспикер / низкая активность).
  dominanceIndex  Float

  /// Confidence диаризации (0..1) из Vox-ответа. <0.85 → lowConfidence=true.
  diarizationConfidence Float
  /// True, если метрики ориентировочные (низкое качество диаризации /
  /// короткая встреча / иные edge-кейсы из ТЗ B §5.4).
  lowConfidence Boolean @default(false)

  computedAt DateTime @default(now())

  meeting      Meeting                       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participants MeetingParticipantBehavior[]

  @@index([tenantId])
}

/// MeetingParticipantBehavior — per-participant поведенческие метрики
/// (one-to-many от MeetingBehaviorMetrics). Источник: ТЗ B §4.
///
/// displayName хранит снимок имени на момент расчёта (для гостей, у которых
/// нет пользовательского профиля). isGuest повторяет Participant.role='guest'
/// для удобства фильтра без JOIN.
model MeetingParticipantBehavior {
  id                       String @id @default(cuid())
  meetingBehaviorMetricsId String
  /// participantId NULL допустим только для синтезированных гостей без
  /// записи в Participant (edge-case из ТЗ B §5.4). На MVP всегда заполнен.
  participantId            String?
  tenantId                 String

  /// Снимок имени на момент расчёта (для гостей, у которых нет userId).
  displayName String
  /// True для гостей без аккаунта.
  isGuest     Boolean @default(false)

  speakingTimeMs             Int
  speakingTimePercent        Float
  turnsCount                 Int
  avgTurnDurationMs          Float
  /// Сколько turn'ов длительностью >= 60_000 мс.
  monologueCount             Int
  longestMonologueMs         Int
  questionCount              Int
  fillerWordsCount           Int
  interruptionsMadeCount     Int
  interruptionsReceivedCount Int

  metrics     MeetingBehaviorMetrics @relation(fields: [meetingBehaviorMetricsId], references: [id], onDelete: Cascade)
  participant Participant?           @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([meetingBehaviorMetricsId, participantId])
  @@index([tenantId])
  @@index([participantId])
}

// ──────────────────────────── фаза C: AI-оценка качества встречи ────────────────────────────

/// MeetingQualityScore — AI-оценка качества встречи (sub-TZ C §4).
///
/// Источник: plans/tz/2026-05-21-phase-C-meeting-quality-score.md §4.
///
/// One-to-one с `Meeting`. Создаётся воркером `ai.quality-score` после
/// `ai_ready` основного pipeline'а. Видит хост (`Meeting.ownerId`) и
/// Org-Admin (owner/admin). Гости и non-host members получают 403.
///
/// Категорий всегда 5: preparation/structure/clarity/outcomes/engagement
/// (0..100). `overallScore` — взвешенное среднее (вычисляет LLM).
///
/// `recommendations` — массив `{ text, severity, category, degradedMode? }`.
/// `degradedMode=true` появляется, когда LLM-router сработал на tertiary
/// (Ollama qwen3.5:9b — graceful-degradation по sub-TZ C §5.4).
///
/// `strengths` — массив строк (2-4 пункта «что было хорошо»).
///
/// `promptTemplateVersionId` — версия шаблона `meeting-quality-score`
/// (после A.2/A.3 — из БД; до этого — NULL = code-fallback).
model MeetingQualityScore {
  id        String @id @default(cuid())
  meetingId String @unique
  tenantId  String

  /// Общий балл качества встречи, 0..100. Взвешенное среднее категорий,
  /// рассчитывает LLM (см. промпт).
  overallScore     Int
  /// Подготовка: озвучена ли повестка / цель в первые 5 минут (0..100).
  preparationScore Int
  /// Структура: есть ли введение → обсуждение → итоги (0..100).
  structureScore   Int
  /// Чёткость формулировок vs «надо подумать», «как-то решим» (0..100).
  clarityScore     Int
  /// Итоги: есть ли конкретные решения с ответственными и сроками (0..100).
  outcomesScore    Int
  /// Вовлечённость участников (0..100). Не путать с behaviorMetrics — это
  /// LLM-оценка диалога, не статистика.
  engagementScore  Int

  /// Список рекомендаций «как сделать встречу лучше».
  /// Структура: [{ text: string, severity: 'info'|'warning'|'critical',
  ///   category: 'preparation'|'structure'|'clarity'|'outcomes'|'engagement',
  ///   degradedMode?: boolean }].
  recommendations Json
  /// Что было хорошо (2-4 пункта). Структура: string[].
  strengths       Json

  /// Версия шаблона `meeting-quality-score` (PromptTemplateVersion.id).
  /// NULL = code-fallback (`ai/services/prompts/meeting-quality-score.ts`).
  promptTemplateVersionId String?
  computedAt              DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, overallScore])
  @@index([tenantId, computedAt])
}
