// Z — Prisma schema
// Источник: plans/tz/2026-05-08-mvp-fullstack-tz.md §1.3
//          plans/tz/2026-05-09-standalone-product.md
//          plans/tz/2026-05-09-ai-meeting-workspace.md
// Правило: ТОЛЬКО `prisma db push`. Никаких `prisma migrate*`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7: connection URL вынесен из schema.
  //   - CLI (db push / studio) берёт url из prisma.config.ts
  //   - рантайм — через driver adapter (PrismaPg) в PrismaService
  extensions = [pgvector(map: "vector")]
}

// ──────────────────────────── enums ────────────────────────────

enum UserRole {
  user
  admin
}

enum UserSignupSource {
  crossmark
  standalone
}

enum VerificationPurpose {
  password_reset
  account_restore
}

enum MeetingType {
  team
  standup
  plan_fact
  project
  sales
  custdev
  partner
  interview
  customer_success
}

enum MeetingStatus {
  scheduled
  active
  completed
  recording_processing
  recording_ready
  transcription_processing
  transcription_ready
  ai_processing
  ai_ready
  failed
}

enum AiStepStatus {
  none
  queued
  processing
  ready
  failed
}

enum ParticipantRole {
  host
  guest
}

enum RecordingStatus {
  not_started
  requested
  recording
  finalizing
  ready
  failed
  expired
  archived
  deleted
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

enum RenderStatus {
  none
  queued
  processing
  ready
  failed
}

enum ChatRole {
  user
  assistant
}

enum ApiKeyScope {
  read
  write
}

enum WebhookStatus {
  active
  paused
  failing
}

enum DeliveryStatus {
  pending
  retrying
  delivered
  failed
}

enum DestinationType {
  email
  slack_webhook
  telegram_bot
  generic_webhook
}

enum ExportType {
  meeting_md
  meeting_pdf
  meeting_docx
  bulk_zip
}

enum ExportStatus {
  queued
  processing
  ready
  failed
  expired
}

// ──────────────────────────── orgs / RBAC enums (Фаза 0 knowledge-core) ────────────────────────────

enum OrgVisibilityMode {
