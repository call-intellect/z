# ============================================================================
# Z — единый .env для деплоя (docker-compose.yml в корне).
# Скопируй в .env и заполни. Источник правды по backend-переменным:
#   backend/src/common/config/env.schema.ts
#
# Запуск:  docker compose up -d --build backend
#
# Генерация секретов:
#   openssl rand -hex 32       # JWT_* / INGEST_INTERNAL_TOKEN (64 hex-символа)
#   openssl rand -base64 32    # WEBHOOK_SECRETS_ENCRYPTION_KEY / CRYPTO_MASTER_KEY
# ============================================================================

# ── ПОРТЫ (проброс на хост + порты приложений) ──────────────────────────────
# *_HOST_PORT — на каком порту 127.0.0.1 публикуется контейнер (сюда смотрит nginx).
# PORT / FRONTEND_PORT — на каком порту приложение слушает ВНУТРИ контейнера.
BACKEND_HOST_PORT=3000
PORT=3000
FRONTEND_HOST_PORT=3001
FRONTEND_PORT=3001
# Опц. публикация БД/Redis на хост для отладки (раскомментируй и порт в compose):
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# ── ПРОКСИ ДЛЯ СБОРКИ (опционально) ──────────────────────────────────────────
# Если сервер не достаёт до npmjs / alpine CDN напрямую — укажи прокси. Он
# используется ТОЛЬКО при сборке (apk + bun install) и НЕ попадает в рантайм-образ.
# ВАЖНО: в docker-compose.yml `env_file: [.env]` грузит ВСЁ из этого файла
# в контейнер, включая HTTP_PROXY. Если раскомментируешь — `node`/Bun начнут
# автоматически проксировать ВСЕ исходящие HTTP-запросы, включая loopback
# (127.0.0.1:3000) — webhook'и от LiveKit SFU к бэку пойдут через squid и
# записи встреч сломаются. Зануление HTTP_PROXY='' в environment секции
# backend/gepa/migrate в compose спасает от этого, но лучше НЕ включать
# прокси в .env без явной необходимости.
# Пусто = без прокси. Пример: http://user:pass@proxy-host:3128
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ── FRONTEND build-args (вшиваются в бандл на СБОРКЕ!) ───────────────────────
# При смене URL — пересобери: docker compose up -d --build frontend
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_LIVEKIT_URL=wss://media.example.com
NEXT_PUBLIC_FRONTEND_URL=https://meet.example.com

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Postgres (контейнер postgres + DATABASE_URL ниже должны совпадать) ───────
POSTGRES_DB=z_main
POSTGRES_USER=z_app
POSTGRES_PASSWORD=CHANGE_ME_strong_password
# host = имя сервиса compose (postgres), порт внутренний 5432.
DATABASE_URL=postgresql://z_app:CHANGE_ME_strong_password@postgres:5432/z_main

# ── Redis (контейнер redis) ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth / cookies ──────────────────────────────────────────────────────────
JWT_SESSION_SECRET=CHANGE_ME_min_32_chars__openssl_rand_hex_32
JWT_DEEP_LINK_SECRET=CHANGE_ME_min_32_chars__openssl_rand_hex_32
COOKIE_DOMAIN=.example.com
# COOKIE_STANDALONE_DOMAIN=meet.example.com
PUBLIC_FRONTEND_URL=https://meet.example.com
SESSION_TTL_SECONDS=86400
DEEP_LINK_TTL_SECONDS=900

# ── argon2id (хэш паролей standalone-аккаунтов) ─────────────────────────────
ARGON_MEMORY_KB=19456
ARGON_ITERATIONS=2
ARGON_PARALLELISM=1

# ── SMTP ─────────────────────────────────────────────────────────────────────
MAIL_HOST=mail.hosting.reg.ru
MAIL_PORT=465
MAIL_SSL=true
# SMTP-логин/пароль. ВАЖНО: оставь ЗАКОММЕНТИРОВАННЫМИ, если SMTP-auth не нужен
# (пустая строка `MAIL_USERNAME=` НЕ допускается — поле optional, но min 1 символ).
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Кора
# true = письма только в лог (без реальной отправки)
MAIL_DRY_RUN=false

# ── LiveKit (медиа-сервер — отдельный compose, см. infra/livekit/) ──────────
LIVEKIT_API_URL=wss://media.example.com
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_WEBHOOK_API_KEY=CHANGE_ME
LIVEKIT_WEBHOOK_API_SECRET=CHANGE_ME

# ── TURN ─────────────────────────────────────────────────────────────────────
TURN_MODE=builtin
# TURN_HOST=turn.example.com
# TURN_PORT=5349
# TURN_USERNAME=
# TURN_PASSWORD=
TURN_TLS=true

# ── S3 (Selectel / MinIO / etc) ──────────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_BUCKET=meetings-prod
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PRESIGNED_TTL_SECONDS=3600

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_USE_PROXY=false
ANTHROPIC_PROXY_URL=https://proxy.agent-lia.ru

# ── ASR (Vox) ────────────────────────────────────────────────────────────────
VOX_API_URL=https://vox.agent-lia.ru
VOX_API_TOKEN=CHANGE_ME
VOX_MODEL=v3_rnnt
VOX_LANGUAGE=ru
VOX_PUNCTUATION_MODE=pro

# ── LLM-провайдеры (роутинг по taskType) ─────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
OLLAMA_BASE_URL=https://ollama.agent-lia.ru/v1
OLLAMA_API_KEY=
MINIMAX_API_KEY=CHANGE_ME
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
GRSAI_API_KEY=CHANGE_ME
GRSAI_BASE_URL=https://grsaiapi.com
KIE_API_KEY=CHANGE_ME
KIE_BASE_URL=https://api.kie.ai
PROXY_BASE_URL=https://proxy.agent-lia.ru/v1
PROXY_PREFIX=myFeedproxy3128

# ── Embeddings (cross-meeting RAG) ───────────────────────────────────────────
EMBEDDING_PROVIDER=openai-via-proxy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_PROXY_API_KEY=
OPENAI_PROXY_EMBEDDINGS_URL=https://proxy.agent-lia.ru/v1/embeddings
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CHUNK_TARGET_TOKENS=400
EMBEDDING_CHUNK_OVERLAP_TOKENS=50

# ── Webhooks (исходящие) — секрет шифрования (base64 от 32 байт!) ────────────
WEBHOOK_SECRETS_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes__openssl_rand_base64_32
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_EGRESS_ALLOWED_HOSTS=

# ── Crypto (шифрование секретов адаптеров) ──────────────────────────────────
# base64 от 32 байт. Нужен Telegram/IMAP/Mango адаптерам. Пусто = шифрование выключено.
CRYPTO_MASTER_KEY=
# Внешний адрес backend (для Telegram setWebhook). Обычно api.example.com.
# PUBLIC_HOST_URL=https://api.example.com

# ── knowledge-core ingest (внешние адаптеры) ────────────────────────────────
# Пусто = POST /api/v1/ingest возвращает 503. Сгенерируй: openssl rand -hex 32
INGEST_INTERNAL_TOKEN=

# ── anti-cheat соль для ipHash (≥16 символов) ───────────────────────────────
IP_HASH_DAILY_SALT=CHANGE_ME_at_least_16_chars

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_SESSION_TTL_SECONDS=43200

# ── Email IMAP fetch cron ────────────────────────────────────────────────────
EMAIL_FETCH_ENABLED=false

# ── Tracker (Sprint 1 — D-1.1) ──────────────────────────────────────────────
# Параметры tracker-модуля. Подробности — в backend/src/common/config/env.schema.ts
# (TrackerSchema) и backend/README.md.
WEBHOOK_HMAC_PREFIX=kora_wh_
TRACKER_INGEST_QUEUE=core.raw-events
IDEMPOTENCY_KEY_TTL_SECONDS=86400
TRACKER_WEBHOOK_MAX_RETRIES=5
TRACKER_WEBHOOK_RETRY_BACKOFF_INITIAL_MS=60000
