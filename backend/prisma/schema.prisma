  /// Роль пользователя в компании, указанная при онбординге (Экран 1 Блока A).
  companyRole        UserCompanyRole?
  /// Когда user прошёл 6 экранов Блока A (profileCompleted → разблокирует кабинет).
  profileCompletedAt DateTime?

  ownedEvents         Event[]            @relation("EventOwner")
  eventParticipations EventParticipant[] @relation("EventParticipantUser")
  participantsAsUser  Participant[]      @relation("ParticipantUser")

  // ── User Feedback with AI Clustering (2026-05-25) ──
  /// Сообщения обратной связи пользователя через канал «Ваши предложения».
  /// См. plans/tz/2026-05-25-user-feedback-with-ai-clustering.md.
  feedbackMessages FeedbackMessage[]

  // ── ТЗ 2026-05-25 §9 (clone-respond эволюция) — CloneAccessGrant ──
  /// Гранты на доступ к клонам (CloneAccessGrant). Под флагом
  /// CLONE_V2_ENABLED — единственный источник правды о доступе к
  /// person/role-клону. Без CLONE_V2_ENABLED не используется (legacy RBAC).
  cloneAccessGrantsReceived CloneAccessGrant[] @relation("CloneAccessGrant_grantedTo")
  cloneAccessGrantsGiven    CloneAccessGrant[] @relation("CloneAccessGrant_grantedBy")
  /// ТЗ 2026-05-26 — обратная relation для soft-revoke (см. CloneAccessGrant.revokedBy).
  cloneAccessGrantsRevoked  CloneAccessGrant[] @relation("CloneAccessGrant_revokedBy")

  // ── ТЗ «Команда + доступы» Фаза 5 — персональные override доступа ──
  /// Override'ы доступа, выданные/полученные пользователем (дельта поверх роли/тарифа).
  capabilityOverridesReceived EmployeeCapabilityOverride[] @relation("ECO_grantedTo")
  capabilityOverridesGranted  EmployeeCapabilityOverride[] @relation("ECO_grantedBy")

  // ── ТЗ 2026-05-27 — Billing/Referral/Dadata/Tochka ──
  /// Реферальный профиль пользователя (один user → один Referral).
  /// См. plans/tz/2026-05-27-billing-tochka-referral-dadata-z.md §9.
  referral Referral?

  @@unique([email, signupSource])
  @@index([email])
  @@index([deletedAt])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  userAgent String?   @db.Text
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model UserVerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  purpose   VerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Meeting {
  id                     String        @id // ULID, генерится сервисом
  title                  String
  type                   MeetingType
  customPrompt           String?       @db.Text
  /// tenant: Org, которой принадлежит встреча. CRIT-3 (2026-05-23):
  /// переведено в NOT NULL после backfill-orgs-fase0 +
  /// tighten-meeting-tenant-not-null. Все legacy-NULL заполнены personal-Org
  /// владельца через `scripts/backfill-orgs-fase0.ts`.
  tenantId               String
  tenant                 Org           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId                String
  owner                  User          @relation(fields: [ownerId], references: [id])
  cardId                 String?
  card                   Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  roomName               String        @unique // равен id
  status                 MeetingStatus @default(scheduled)
  startedAt              DateTime?
  endedAt                DateTime?
  failureReason          String?
  durationMs             Int?
  recapVersion           Int           @default(1)
  chaptersStatus         AiStepStatus  @default(none)
  tasksStatus            AiStepStatus  @default(none)
  embeddingsStatus       AiStepStatus  @default(none)
  /// Фаза 5 knowledge-core: статус v2-агентов (Tasks/Chapters/Summary над IdeaBlock).
  /// NULL = не запускался; 'queued'/'processing'/'ready'/'partial'/'failed'.
  /// Хранится строкой (а не enum'ом), чтобы было легко расширить без миграции.
  analyzeV2Status        String?
  /// Когда v2-агент завершил работу (последний раз).
  analyzeV2GeneratedAt   DateTime?
  /// Текст ошибки на failed/partial. Multi-line, агент пишет короткую сводку.
  analyzeV2Error         String?       @db.Text
  /// 2026-05-25 meeting-report-fast (ТЗ plans/tz/2026-05-25-meeting-report-split-from-block-ingest.md):
  /// статус «быстрого» отчёта пользователю (один LLM-вызов поверх сырого транскрипта).
  /// NULL = не запускался; 'processing'|'ready'|'failed'|'partial'.
  /// Независим от analyzeV2Status — два pipeline работают параллельно.
  reportFastStatus       String?
  /// Текст ошибки на failed/partial для `meeting-report-fast`.
  reportFastError        String?       @db.Text
  /// Когда `meeting-report-fast` завершил работу (последний раз).
  reportFastGeneratedAt  DateTime?
  /// 2026-05-25 quality_score целиком из meeting-report-fast (ТЗ
  /// plans/tz/2026-05-25-meeting-report-split-from-block-ingest.md, ответ из
  /// прозрачного блока «quality_score»). Json-объект формы:
  /// `{ overallScore, categories: { preparation, structure, clarity, outcomes,
  /// engagement }, recommendations: Array<{ text, severity, category }>,
  /// strengths: string[] }`. Структуру задаёт `meeting-report-fast.prompt.ts`.
  /// Поле названо `reportFastQualityScore`, потому что относится именно к
  /// fast-цепочке; relation `qualityScore` ниже зарезервирован за отдельным
  /// воркером `ai.quality-score` (модель `MeetingQualityScore`). В Admin
  /// API/UI поле отдаётся под ключом `qualityScore`.
  reportFastQualityScore Json?
  /// Автоматически вести запись при старте встречи. Если true — запись стартует
  /// при подключении хоста; ручное управление записью в комнате недоступно.
  recordByDefault        Boolean       @default(true)
  /// Статус расчёта поведенческих метрик (воркер ai.behavior-metrics).
  /// NULL = не запускался; 'pending'|'ready'|'failed'|'low_confidence'.
  behaviorMetricsStatus  String?
  /// Статус AI-оценки качества встречи (воркер ai.quality-score).
  /// NULL = не запускался; 'pending'|'ready'|'failed'|'disabled'.
  qualityScoreStatus     String?
  /// Pulse Wave 6 §6.3 — Meeting ROI:
  ///   (decisions × 10 + commitments × 5 + tasks × 3) /
  ///   (avgParticipants × durationMinutes / 60).
  /// Считается `MeetingRoiScorerWorker` (`dashboard.meeting-roi`) после
  /// успешного analyze (см. `analyze.worker` шаг 13a). NULL до прогона.
  /// Decimal(8,3) — потенциально большие значения для коротких встреч с
  /// большим числом решений / задач (внутри ТЗ §4.1 указано Decimal(4,3),
  /// но 4,3 даёт максимум 9.999 — недостаточно; согласовано с оркестратором).
  roiScore               Decimal?      @db.Decimal(8, 3)
  /// Когда `MeetingRoiScorerWorker` последний раз пересчитал `roiScore`.
  roiScoreAt             DateTime?
  createdAt              DateTime      @default(now())
  deletedAt              DateTime?

  participants     Participant[]
  recording        Recording?
  transcript       Transcript?
  aiResult         AiResult?
  /// Фаза B — one-to-one с MeetingBehaviorMetrics (метрики поведения участников).
  behaviorMetrics  MeetingBehaviorMetrics?
  /// Фаза C — one-to-one с MeetingQualityScore (AI-оценка качества).
  qualityScore     MeetingQualityScore?
  events           MeetingEvent[]
  tasks            Task[]
  chapters         MeetingChapter[]
  highlights       MeetingHighlight[]
  shares           MeetingShare[]
  transcriptChunks MeetingTranscriptChunk[]
  chatMessages     MeetingChatMessage[]
  roomMessages     MeetingRoomMessage[]
  meetingTags      MeetingTag[]
  /// Фаза 0a — Decision'ы, источник которых эта встреча (Фаза 0b extraction).
  decisions        Decision[]               @relation("DecisionSourceMeeting")
  /// Фаза E — дополнительные («custom») AI-отчёты, сгенерированные по выбранным
  /// шаблонам поверх той же встречи. Primary-отчёт остаётся в `aiResult`
  /// (one-to-one). См. plans/tz/2026-05-21-phase-E-multi-report-per-meeting.md.
  customReports    MeetingReport[]

  /// Tracker Phase 1 (2026-05-24) — встреча могла быть запущена из задачи трекера.
  /// См. plans/tz/2026-05-23-tracker-phase-1-models-api.md (endpoint `POST /issues/:id/start-meeting`).
  /// NULL для встреч, не связанных с задачей.
  linkedIssueId String?
  linkedIssue   Issue?  @relation("MeetingLinkedIssue", fields: [linkedIssueId], references: [id], onDelete: SetNull)

  /// Sprints (2026-05-27) — встреча могла быть запущена из спринта (обычно
  /// type=sprint_review). NULL для встреч, не связанных со спринтом.
  /// См. plans/tz/2026-05-27-sprints.md §1.2.
  linkedCycleId String?
  linkedCycle   Cycle?  @relation("MeetingLinkedCycle", fields: [linkedCycleId], references: [id], onDelete: SetNull)

  /// Ф2 knowledge-access — ручная пометка закрытости встречи (хост/админ).
  /// null = открыто; 'leadership' | 'council' | 'personal'. Читается на ingest
  /// (Ф3) для привязки блоков к закрытой группе. UI — Ф7.
  closedGroupKind String? @db.VarChar(20)

  /// ТЗ 2026-06-10 meeting-visibility — «Кому видно» встреча (видео/запись/расшифровка/отчёт).
  /// 'owner_only' | 'participants' (дефолт) | 'custom' | 'org'. Источник правды доступа к
  /// READ-поверхностям встречи. НЕ влияет на граф знаний (отдельная подсистема).
  visibilityScope String               @default("participants") @db.VarChar(16)
  accessGrants    MeetingAccessGrant[]

  /// ТЗ-5 Ф1 (meeting-upload-diarization) — источник встречи. `livekit` (дефолт)
  /// для встреч в комнате; `upload` для встреч, загруженных файлом и диаризованных.
  source                MeetingSource @default(livekit)
  /// ТЗ-5 Ф1 — подсказка числа спикеров для диаризации загруженной встречи
  /// (необязательно; пользователь может указать ожидаемое число голосов).
  uploadNumSpeakersHint Int?

  /// ТЗ-5 Ф1 — спикеры диаризации загруженной встречи (для ручной разметки).
  uploadSpeakers MeetingUploadSpeaker[]

  @@index([ownerId, createdAt])
  @@index([status, endedAt])
  @@index([deletedAt])
  @@index([cardId, createdAt])
  @@index([tenantId])
  @@index([linkedIssueId])
  @@index([linkedCycleId])
  @@index([tenantId, source, createdAt])
}

/// ТЗ 2026-06-10 meeting-visibility — явный грант доступа к встрече (scope='custom').
/// Кому хост открыл руками: человек (Person) или группа (KnowledgeGroup, ПРЯМОЕ членство).
/// tenantId — денормализован скаляром для индекса; каскад через Meeting (не через Org,
/// чтобы не править модель Org). При удалении встречи гранты удаляются.
model MeetingAccessGrant {
  id          String   @id @default(cuid())
  tenantId    String
  meetingId   String
  granteeType String   @db.VarChar(8) /// 'person' | 'group'
  granteeId   String /// Person.id | KnowledgeGroup.id
  grantedById String /// User.id хоста, выдавшего доступ
  createdAt   DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, granteeType, granteeId])
  @@index([tenantId, meetingId])
  @@index([granteeType, granteeId])
}

/// ТЗ-5 Ф1 (meeting-upload-diarization) — спикер диаризации загруженной встречи.
/// Один ряд = один обнаруженный голос (label вроде "SPEAKER_00"); хост/админ
/// сопоставляет его с сотрудником (personId) или внешним участником, либо
/// исключает. После полной разметки встреча уходит из `awaiting_speakers` в
/// `ai_processing`.
model MeetingUploadSpeaker {
  id               String                  @id @default(cuid())
  meetingId        String
  meeting          Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  label            String
  displayLabel     String
  turnsCount       Int                     @default(0)
  speakingSeconds  Int                     @default(0)
  sampleText       String                  @db.Text
  assignment       UploadSpeakerAssignment @default(unassigned)
  personId         String?
  person           Person?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  externalName     String?                 @db.VarChar(200)
  externalCompany  String?                 @db.VarChar(200)
  externalPosition String?                 @db.VarChar(200)
  mergedIntoLabel  String?
  participantId    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([meetingId, label])
  @@index([meetingId])
  @@map("meeting_upload_speaker")
}

model Participant {
  id               String                      @id @default(cuid())
  meetingId        String
  meeting          Meeting                     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  livekitIdentity  String
  name             String
  role             ParticipantRole
  isRegisteredUser Boolean                     @default(false)
  userId           String?
  user             User?                       @relation("ParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  personId         String?
  person           Person?                     @relation("ParticipantPerson", fields: [personId], references: [id], onDelete: SetNull)
  invitationStatus ParticipantInvitationStatus @default(none)
  inviteToken      String?                     @unique
  invitedAt        DateTime?
  deviceCount      Int                         @default(1)
  joinedAt         DateTime?
  leftAt           DateTime?

  audioTrack      AudioTrack?
  roomMessages    MeetingRoomMessage[]
  /// Фаза B — поведенческие метрики, рассчитанные для этого участника
  /// (one-to-many: один участник может фигурировать в нескольких MeetingBehaviorMetrics,
  /// если идёт регенерация и старая запись осталась — но обычно одна).
  behaviorEntries MeetingParticipantBehavior[]

  @@unique([meetingId, livekitIdentity])
  @@index([meetingId])
}

model Recording {
  id                String          @id @default(cuid())
  meetingId         String          @unique
  meeting           Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  mainVideoUrl      String?
  compositeEgressId String?
  status            RecordingStatus @default(not_started)
  retentionDays     Int
  expiresAt         DateTime
  archivedAt        DateTime?
  deletedAt         DateTime?
  bytesTotal        BigInt?
  durationSeconds   Int?

  audioTracks AudioTrack[]
  actions     RecordingAction[]

  @@index([expiresAt, status])
}

model AudioTrack {
  id              String       @id @default(cuid())
  recordingId     String
  recording       Recording    @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  participantId   String?      @unique
  participant     Participant? @relation(fields: [participantId], references: [id])
  participantName String
  livekitIdentity String
  trackId         String
  trackEgressId   String?
  voxTaskId       String?
  audioUrl        String
