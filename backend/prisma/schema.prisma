// Z — Prisma schema
// Источник: plans/tz/2026-05-08-mvp-fullstack-tz.md §1.3
//          plans/tz/2026-05-09-standalone-product.md
//          plans/tz/2026-05-09-ai-meeting-workspace.md
// Правило (с 2026-06-05): версионируемые миграции Prisma.
//   - Изменение схемы → `bun run prisma:migrate -- --name <описание>` (migrate dev) → коммит файла.
//   - На прод применяется `prisma migrate deploy` (через migrate-контейнер).
//   - `prisma db push` — ТОЛЬКО для черновых локальных проб, которые НЕ коммитятся.
// Подробно: .claude/skills/prisma-db-push-rules/SKILL.md, plans/tz/2026-06-05-prisma-migrations-switch.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7: connection URL вынесен из schema.
  //   - CLI (db push / studio) берёт url из prisma.config.ts
  //   - рантайм — через driver adapter (PrismaPg) в PrismaService
  extensions = [pgvector(map: "vector")]
}

