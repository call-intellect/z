  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?    @db.Text
  status           TaskStatus @default(open)
  assigneeRaw      String?
  /// ТЗ 2026-05-25 hard-participant-identification: жёсткая связь с User,
  /// заполняется AI-pipeline (через resolve по participants встречи).
  /// onDelete=SetNull: при удалении User'а assigneeUserId сбрасывается,
  /// но Task остаётся (assigneeRaw сохраняет историческую строку).
  assigneeUserId   String?
  assignee         User?      @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  dueDate          DateTime?
  sourceStartMs    Int?
  sourceEndMs      Int?
  sourceQuote      String?    @db.Text
  confidence       Float?
  createdManually  Boolean    @default(false)
  /// Фаза 5 knowledge-core: какие IdeaBlock'и породили задачу (для drill-down).
