  causes
  consequences_of
  shares_topic
  shares_entity
  question_answered_by
  /// SBA β-8.2 — `commitment_status` блок закрывает (resolves) исходный `commitment`.
  resolves
  /// KC-Temporal W1.1 (2026-05-25) — новый блок-факт замещает старый.
  /// Создаётся `FactSupersedeService` при детектировании supersede-вердикта.
  /// Пара: from=новый блок, to=старый блок.
  supersedes
}

/// Тип типизированной связи между сущностями. С Фазы 0 — также все
/// бизнес-связи каркаса компании (Person↔Role↔Department, Process↔Role,
/// Strategy↔Goal и т.д.). См. plans/tz/2026-05-21-phase-0a-data-model-and-graph-infra.md §4.4.
enum EntityLinkType {
  // ── существующие knowledge-core связи Entity↔Entity (Фаза 3) ──
  works_at
  belongs_to
  part_of
  opposes
  depends_on
  mentions_with

  // ── Фаза 0: Person ↔ Role ↔ Department ↔ Skill ──
  /// Person -> Role; временной интервал в validFrom/validTo.
  executes_role
  /// Person -> Department.
  member_of
  /// Role -> JobDescription.
  described_by
  /// JobDescription -> Document (или Process -> Document, см. produces).
  derived_from
  /// Role -> Skill (требование).
  requires_skill
  /// Person -> Skill (наблюдается).
  has_skill

  // ── Фаза 0: каркас 5 уровней (группа Б) ──
  /// Mission -> Strategy.
  realized_by
  /// Strategy -> Goal; Goal -> Goal (декомпозиция).
  decomposes_into
  /// Goal -> Metric; Process -> Metric.
  measured_by
  /// Strategy -> Process.
  executed_by
  /// Process -> ProcessStep.
  has_step
  /// Process -> Role / Person; Role -> Process (Role is_responsible_for).
  owned_by
  /// Process -> Tool.
  lives_in
  /// Process -> Document.
  produces
  /// Process -> Event / Meeting.
  triggered_by
  /// Regulation -> Process.
  regulates
  /// Policy -> Process / Role / любая сущность.
  constrains
  /// Regulation(category=standard) -> ArtifactType (строковый идентификатор в properties.artifactType).
  applies_to
  /// Role -> Process (зеркало owned_by для дискриминации направления).
  is_responsible_for

  // ── Фаза 0: RACI (UI назначения — Фаза γ) ──
  responsible_for
  accountable_for
  consulted_on
  informed_about

  // ── SBA α-3 (2026-05-23) — связи слоя организационного графа ──
  /// Person/Role -> Person/Role: иерархия подчинения.
  reports_to
  /// Person/Role -> Person/Role: подчинённый/команда.
  manages
  /// Person/Department -> Person/Department: горизонтальные взаимодействия.
  collaborates_with
  /// Person -> Person: наставничество (источник для γ-1 SkillProfile).
  mentors
  /// Person -> Person: фиксированный конфликт (источник для β-8 PersonalRelation).
  conflicted_with
  /// Process -> Process / Role -> Role: передача результата по pipeline.
  transfers_result_to
  /// Decision/Person -> Role: эскалация до вышестоящего.
  escalates_to

  // ── SBA β-6 (2026-05-23) — Experiment Tracker (Specialist 3.9) ──
  /// Experiment -> Insight: результат эксперимента подтверждает существующий
  /// сигнал/инсайт (EntityTransitionCron эмитит ежедневно в 07:00).
  result_supports_insight
  /// Experiment -> Decision: извлечённый из эксперимента урок информирует
  /// прошлое или будущее решение (EntityTransitionCron, см. β-6 §3 решение #4).
  lesson_informs_decision
}

