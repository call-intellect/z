/// ChatBox: чат (тред). Зеркало 1:1.
model ChatboxChat {
  id                    String            @id @default(cuid())
  tenantId              String
  externalId            String
  channelExternalId     String
  channelType           String
  clientExternalId      String?
  customerExternalId    String?
  responsibleExternalId String?
  status                ChatboxChatStatus @default(active)
  externalCreatedAt     DateTime
  externalUpdatedAt     DateTime
  lastMessageAt         DateTime?
  messageCount          Int               @default(0)
  /// Накопительное саммари разговора (ТЗ 2026-06-17): обновляется на закрытие
  /// каждой сессии-дня; компактный «живой» контекст без полной истории.
  rollingSummary        String?           @db.Text
  rollingSummaryAt      DateTime?
  raw                   Json?
  syncedAt              DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  org      Org                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions ChatboxChatSession[]
  messages ChatboxMessage[]

  @@unique([tenantId, externalId])
  @@index([tenantId, customerExternalId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, status])
