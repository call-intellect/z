{
  "title": "Z — Billing & Referrals",
  "uid": "z-billing-referrals",
  "schemaVersion": 38,
  "editable": true,
  "tags": ["z", "billing", "referrals", "commercial-reliability"],
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Биллинг сегодня — created / paid / cancelled (rate)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Главная панель здоровья биллинга: invoice_created, invoice_paid, subscription_cancelled. Если 4 часа paid=0 — горит алёрт BillingNoPaymentsLong.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(billing_invoice_created_total[5m]))",
          "legendFormat": "invoice_created",
          "refId": "A"
        },
        {
          "expr": "sum(rate(billing_invoice_paid_total[5m]))",
          "legendFormat": "invoice_paid",
          "refId": "B"
        },
        {
          "expr": "sum(rate(billing_subscription_cancelled_total[5m]))",
          "legendFormat": "subscription_cancelled",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Webhook здоровье Точки (status, 4h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Распределение webhook'ов от Точки за 4 часа. status=sig_fail > 5 за 10 мин → critical-алёрт BillingWebhookSignatureFailures.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (increase(billing_webhook_received_total{provider=\"tochka\"}[4h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Реферальная воронка — click → signup → payout (топ-10 партнёров)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Объём кликов, регистраций (signup) и созданных payout'ов для топ-10 партнёров (partner_top = tenantTopOf(slug)).",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, sum by (partner_top) (rate(referral_click_total[1h])))",
          "legendFormat": "click · {{partner_top}}",
          "refId": "A"
        },
        {
          "expr": "topk(10, sum by (partner_top) (rate(referral_signup_total[1h])))",
          "legendFormat": "signup · {{partner_top}}",
          "refId": "B"
        },
        {
          "expr": "sum(rate(referral_payout_created_total[1h]))",
          "legendFormat": "payout_created",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency банка (Точка) — p50/p95/p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Длительность исходящих HTTP-запросов в Точку (создание счёта, верификация webhook'а, ...). Если p99 > 5s — Точка тормозит, надо смотреть status='error'.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, method) (rate(billing_provider_request_duration_seconds_bucket{provider=\"tochka\"}[5m])))",
          "legendFormat": "p50 · {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(billing_provider_request_duration_seconds_bucket{provider=\"tochka\"}[5m])))",
          "legendFormat": "p95 · {{method}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, method) (rate(billing_provider_request_duration_seconds_bucket{provider=\"tochka\"}[5m])))",
          "legendFormat": "p99 · {{method}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    }
  ]
}
