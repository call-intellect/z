# ============================================================================
# Z backend — production ENV (deploy/backend/docker-compose.yml).
# Скопируй в backend.env и заполни. Источник правды — backend/src/common/config/env.schema.ts.
# Запуск: docker compose --env-file backend.env up -d --build
#
# Генерация секретов:
#   openssl rand -hex 32       # для JWT_* (64 hex-символа)
#   openssl rand -base64 32    # для WEBHOOK_SECRETS_ENCRYPTION_KEY / CRYPTO_MASTER_KEY (base64 от 32 байт)
# ============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Postgres (контейнер postgres + DATABASE_URL ниже должны совпадать) ──────
POSTGRES_DB=z_main
POSTGRES_USER=z_app
POSTGRES_PASSWORD=CHANGE_ME_strong_password
# host = имя сервиса compose (postgres), порт внутренний 5432.
DATABASE_URL=postgresql://z_app:CHANGE_ME_strong_password@postgres:5432/z_main

# ── Redis (контейнер redis) ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth / cookies ─────────────────────────────────────────────────────────
JWT_SESSION_SECRET=CHANGE_ME_min_32_chars__openssl_rand_hex_32
JWT_DEEP_LINK_SECRET=CHANGE_ME_min_32_chars__openssl_rand_hex_32
COOKIE_DOMAIN=.example.com
# COOKIE_STANDALONE_DOMAIN=meet.example.com
PUBLIC_FRONTEND_URL=https://meet.example.com
SESSION_TTL_SECONDS=86400
DEEP_LINK_TTL_SECONDS=900

# ── argon2id (хэш паролей standalone-аккаунтов) ────────────────────────────
ARGON_MEMORY_KB=19456
ARGON_ITERATIONS=2
ARGON_PARALLELISM=1

# ── SMTP ────────────────────────────────────────────────────────────────────
MAIL_HOST=mail.hosting.reg.ru
MAIL_PORT=465
MAIL_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Z
# true = письма только в лог (без реальной отправки)
MAIL_DRY_RUN=false

# ── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_API_URL=wss://media.example.com
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_WEBHOOK_API_KEY=CHANGE_ME
LIVEKIT_WEBHOOK_API_SECRET=CHANGE_ME

# ── TURN ────────────────────────────────────────────────────────────────────
TURN_MODE=builtin
# TURN_HOST=turn.example.com
# TURN_PORT=5349
# TURN_USERNAME=
# TURN_PASSWORD=
TURN_TLS=true

# ── S3 (Selectel / MinIO / etc) ─────────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_BUCKET=meetings-prod
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PRESIGNED_TTL_SECONDS=3600

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_USE_PROXY=false
ANTHROPIC_PROXY_URL=https://proxy.agent-lia.ru

# ── ASR (Vox) ───────────────────────────────────────────────────────────────
VOX_API_URL=https://vox.agent-lia.ru
VOX_API_TOKEN=CHANGE_ME
VOX_MODEL=v3_rnnt
VOX_LANGUAGE=ru
VOX_PUNCTUATION_MODE=pro

# ── LLM-провайдеры (роутинг по taskType) ────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
OLLAMA_BASE_URL=https://ollama.agent-lia.ru/v1
OLLAMA_API_KEY=
MINIMAX_API_KEY=CHANGE_ME
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
GRSAI_API_KEY=CHANGE_ME
GRSAI_BASE_URL=https://grsaiapi.com
KIE_API_KEY=CHANGE_ME
KIE_BASE_URL=https://api.kie.ai
PROXY_BASE_URL=https://proxy.agent-lia.ru/v1
PROXY_PREFIX=myFeedproxy3128

# ── Embeddings (cross-meeting RAG) ──────────────────────────────────────────
EMBEDDING_PROVIDER=openai-via-proxy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_PROXY_API_KEY=
OPENAI_PROXY_EMBEDDINGS_URL=https://proxy.agent-lia.ru/v1/embeddings
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CHUNK_TARGET_TOKENS=400
EMBEDDING_CHUNK_OVERLAP_TOKENS=50

# ── Webhooks (исходящие) — секрет шифрования (base64 от 32 байт!) ───────────
WEBHOOK_SECRETS_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes__openssl_rand_base64_32
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_EGRESS_ALLOWED_HOSTS=

# ── Crypto (шифрование секретов адаптеров) ──────────────────────────────────
# base64 от 32 байт. Нужен Telegram/IMAP/Mango адаптерам. Пусто = шифрование выключено.
CRYPTO_MASTER_KEY=
# Внешний адрес backend (для Telegram setWebhook). Обычно api.example.com.
# PUBLIC_HOST_URL=https://api.example.com

# ── knowledge-core ingest (внешние адаптеры) ────────────────────────────────
# Пусто = POST /api/v1/ingest возвращает 503. Сгенерируй: openssl rand -hex 32
INGEST_INTERNAL_TOKEN=

# ── anti-cheat соль для ipHash (≥16 символов) ──────────────────────────────
IP_HASH_DAILY_SALT=CHANGE_ME_at_least_16_chars

# ── Admin bootstrap ─────────────────────────────────────────────────────────
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_SESSION_TTL_SECONDS=43200

# ── Email IMAP fetch cron (Phase 10) ───────────────────────────────────────
EMAIL_FETCH_ENABLED=false

# ── Прочие лимиты/квоты/retention/AI-флаги ─────────────────────────────────
# Все имеют разумные дефолты в env.schema.ts. Переопредели здесь при необходимости.
# DEFAULT_RETENTION_DAYS=30
# MAX_PARTICIPANTS_PER_MEETING=10
# KNOWLEDGE_CORE_V2_AGENTS_ENABLED=false
# CHAT_V2_ENABLED=false
