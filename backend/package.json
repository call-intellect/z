{
  "name": "z-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Z — память компании. Backend (NestJS). MVP-вертикаль — AI-встречи на LiveKit.",
  "engines": {
    "bun": ">=1.3",
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && bun scripts/copy-assets.ts",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:seed": "bun prisma/seed.ts",
    "apply-postgres-init": "bun scripts/apply-postgres-init.ts",
    "patch:rename-client-to-customer": "bun run scripts/patch-rename-client-to-customer.ts",
    "patch:backfill-entity-id-person": "bun run scripts/patch-backfill-entity-id-person.ts",
    "patch:backfill-entity-id-goal": "bun run scripts/patch-backfill-entity-id-goal.ts",
    "patch:backfill-entity-id-document": "bun run scripts/patch-backfill-entity-id-document.ts",
    "patch:backfill-entity-id": "bun run scripts/patch-backfill-entity-id-person.ts && bun run scripts/patch-backfill-entity-id-goal.ts && bun run scripts/patch-backfill-entity-id-document.ts",
    "patch:person-relationship": "bun run scripts/patch-person-relationship.ts",
    "patch:skill-trait-categories": "bun run scripts/patch-skill-trait-categories-from-strings.ts",
    "patch:backfill-card-versions": "bun run scripts/patch-backfill-card-versions.ts",
    "migrate-task-to-issue": "bun run scripts/migrate-task-to-issue.ts",
    "seed:llm-task-routes-regulations": "bun run scripts/seed-llm-task-routes-regulations.ts",
    "seed:llm-task-routes-knowledge-clone": "bun run scripts/seed-llm-task-routes-knowledge-clone.ts",
    "seed:llm-task-routes-decisions": "bun run scripts/seed-llm-task-routes-decisions.ts",
    "seed:llm-task-routes-insights": "bun run scripts/seed-llm-task-routes-insights.ts",
    "seed:llm-task-routes-ideas-and-probe": "bun run scripts/seed-llm-task-routes-ideas-and-probe.ts",
    "seed:llm-task-routes-skill-and-clone": "bun run scripts/seed-llm-task-routes-skill-and-clone.ts",
    "setup:telegram-bot": "bun run scripts/setup-telegram-bot.ts",
    "setup:max-bot": "bun run scripts/setup-max-bot.ts"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/platform-socket.io": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.21",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "imapflow": "^1.3.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.3",
    "mailparser": "^3.9.8",
    "mammoth": "^1.11.0",
    "marked": "^16.4.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.11",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.38.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.21",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.4",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
