# ============================================================================
# Z frontend — ENV для контейнерной сборки/запуска (deploy/frontend/docker-compose.yml).
# Скопируй в frontend.env и заполни.
#
# ВАЖНО: NEXT_PUBLIC_* вшиваются в клиентский бандл во время сборки (build-args).
# При смене URL — пересобрать: docker compose --env-file frontend.env up -d --build
# ============================================================================

# ── Публичные URL-ы (вшиваются в бандл на сборке) ──────────────────────────
# Базовый URL backend API (apiClient).
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Backend origin для CSP connect-src.
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
# LiveKit WebSocket URL.
NEXT_PUBLIC_LIVEKIT_URL=wss://media.example.com
# Собственный URL фронта (для генерации ссылок). Необязательный.
NEXT_PUBLIC_FRONTEND_URL=https://meet.example.com

# ── Порт публикации на хосте (nginx проксирует на 127.0.0.1:${FRONTEND_PORT}) ──
FRONTEND_PORT=3001
