model User {
  id                 String           @id @default(cuid())
  externalId         String?          @unique
  email              String
  name               String
  role               UserRole         @default(user)
  /// Флаг владельца продукта Z (super-admin Z-Admin раздела). См. orgs-and-rbac.md.
  /// На уровне БД — независим от `role` и `Membership`. Включается вручную DBA / seed'ом.
  isSuperAdmin       Boolean          @default(false)
  signupSource       UserSignupSource @default(crossmark)
  // argon2id (standalone) или bcrypt (admin local login). Опционально для Crossmark-провижененных юзеров.
  passwordHash       String?
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  lastSeenAt         DateTime?
  deletedAt          DateTime?

  meetings             Meeting[]
  sessions             UserSession[]
  verificationTokens   UserVerificationToken[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  destinations         IntegrationDestination[]
  tags                 Tag[]
  tasks                Task[]
  /// ТЗ 2026-05-25 hard-participant-identification — задачи, где этот User
  /// сопоставлен как assignee через AI/manual (`Task.assigneeUserId`).
  assignedTasks        Task[]                   @relation("TaskAssignee")
  chatMessages         MeetingChatMessage[]
  userTemplates        UserTemplate[]
  exports              Export[]
  meetingShares        MeetingShare[]
  highlightShares      HighlightShare[]
  meetingHighlights    MeetingHighlight[]
  quotaCounters        UserQuotaCounter[]
  auditLog             AuditLog[]
  apiAccessLog         ApiAccessLog[]
  cards                Card[]
  ownedOrgs            Org[]                    @relation("OrgOwner")
  memberships          Membership[]
  invitedMemberships   Membership[]             @relation("MembershipInvitedBy")
  createdInvitations   OrgInvitation[]          @relation("OrgInvitationInvitedBy")
  acceptedInvitations  OrgInvitation[]          @relation("OrgInvitationAcceptedBy")
  superAdminAccessLogs SuperAdminAccessLog[]    @relation("SuperAdminAccessLog")
  goalsCreated         Goal[]                   @relation("GoalCreatedBy")
  /// Фаза 0a — Person-аватары пользователя в Org'ах (после accept'а приглашений).
  persons              Person[]                 @relation("UserPersons")
  // ── SBA α-1 — Conversational Channels Foundation ──
  channelBindings      ChannelBinding[]
  notifications        Notification[]           @relation("NotificationRecipient")

  // ── Фаза A.1 — Prompt Registry ──
  createdPromptTemplates   PromptTemplate[]        @relation("PromptTemplateCreatedBy")
  createdPromptVersions    PromptTemplateVersion[] @relation("PromptTemplateVersionCreatedBy")
  createdPromptExperiments PromptExperiment[]      @relation("PromptExperimentCreatedBy")
  aiResultFeedback         AiResultFeedback[]      @relation("AiResultFeedbackUser")
  // ── Фаза A.4 — Audit log переключений LlmTaskRoute ──
  llmTaskRouteChanges      LlmTaskRouteChange[]    @relation("LlmTaskRouteChangeBy")

  // ── SBA α-4 — Layer 4 Curation Foundation ──
  curationItemsAssigned CurationItem[]     @relation("CurationItemAssignedTo")
  curationDecisions     CurationDecision[] @relation("CurationDecisionReviewer")
  conflictsResolved     ConflictItem[]     @relation("ConflictItemResolvedBy")
  cardVersionsCreated   CardVersion[]      @relation("CardVersionCreatedBy")

  // ── SBA α-5 — Layer 5 Chat-v2 Omnichannel ──
  chatV2Conversations ChatV2Conversation[] @relation("ChatV2ConversationUser")

  // ── SBA α-7 wave 2 — Specialist 3.1 (ProcessTemplate) ──
  publishedProcessTemplateVersions ProcessTemplateVersion[] @relation("ProcessTemplateVersionPublishedBy")

  // ── SBA α-10 wave 2 — Admin LLM + Unit Economics ──
  llmModelPriceChanges LlmModelPrice[] @relation("LlmModelPriceChangedBy")
  orgBudgetCapsSet     OrgBudgetCap[]  @relation("OrgBudgetCapSetBy")

  // ── SBA γ-2 — Concierge Agent ──
  conciergeConversations ConciergeConversation[] @relation("ConciergeConversationUser")

  // ── SBA δ-1 — Orchestrator (multi-agent deep research) ──
  orchestratorRuns OrchestratorRun[] @relation("OrchestratorRunUser")

  // ── SBA δ-2 — ProactiveWatcher (2026-05-23) ──
  proactiveNotifications ProactiveNotification[] @relation("ProactiveNotificationUser")

  // ── Calendar MVP (2026-05-25) — события и подписка на ICS-feed ──
  /// Секретный токен для подписки на персональный ICS-feed
  /// (`GET /api/v1/calendar/:userId.ics?token=...`). Генерируется по запросу
  /// из /me/settings/calendar. Хранится как HMAC base64.
  calendarFeedToken   String?            @db.VarChar(80)
  ownedEvents         Event[]            @relation("EventOwner")
  eventParticipations EventParticipant[] @relation("EventParticipantUser")

  // ── User Feedback with AI Clustering (2026-05-25) ──
  /// Сообщения обратной связи пользователя через канал «Ваши предложения».
  /// См. plans/tz/2026-05-25-user-feedback-with-ai-clustering.md.
  feedbackMessages FeedbackMessage[]

