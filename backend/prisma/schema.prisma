model AiResult {
  id                      String                 @id @default(cuid())
  meetingId               String                 @unique
  meeting                 Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingType             MeetingType
  summary                 String                 @db.Text
  structuredData          Json?
  customOutputMd          String?                @db.Text
  followUpEmail           String?                @db.Text
  /// @deprecated после Phase 3 ai-workspace новые задачи пишутся в `Task`. Оставлено до миграции существующих записей через `backend/scripts/migrate-ai-tasks.ts`.
  tasks                   Json?
  modelUsed               String
  /// Фаза 5 knowledge-core: альтернативная сводка, сгенерированная
  /// `meeting-analyze-v2.worker` поверх IdeaBlock'ов встречи. Не перезаписывает
  /// `summary`, чтобы UI оставался на legacy до решения владельца про A/B.
  summaryV2               String?                @db.Text
  /// `<provider>:<model>` модели, которая сгенерила `summaryV2`.
  summaryV2Model          String?
  /// Когда сгенерирован `summaryV2`.
  summaryV2GeneratedAt    DateTime?
  /// 2026-05-25 meeting-report-fast (ТЗ plans/tz/2026-05-25-meeting-report-split-from-block-ingest.md):
  /// быстрая сводка пользователю, сгенерированная одним LLM-вызовом
  /// `MeetingReportFastWorker` поверх СЫРОГО транскрипта (минуя block-ingest).
  /// Не перезаписывает `summary` и `summaryV2`. Будет основным полем после A/B.
  summaryFast             String?                @db.Text
  /// `<provider>:<model>` модели, которая сгенерила `summaryFast`.
  summaryFastModel        String?
  /// Когда сгенерирован `summaryFast`.
  summaryFastGeneratedAt  DateTime?
  /// Фаза A.1 — какой версией шаблона промпта (`PromptTemplateVersion`) сгенерирован основной отчёт
  /// (structuredData / customOutputMd). NULL = `code_fallback` (промпт пришёл из встроенного кода
  /// `ai/services/prompts/type-*.ts`), что нормально при пустой БД или ошибке резолва.
  promptTemplateVersionId String?
  promptTemplateVersion   PromptTemplateVersion? @relation("from_prompt_version", fields: [promptTemplateVersionId], references: [id], onDelete: SetNull)
  /// Фаза A.1 — группа A/B-эксперимента, если резолвер попал в активный `PromptExperiment`.
  /// 'A' | 'B' | NULL. NULL = вне эксперимента.
  experimentGroup         String?
  /// Фаза A.3 — обратная связь пользователей по этому AI-результату (👍/👎).
  feedback                AiResultFeedback[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([promptTemplateVersionId])
}

model AiUsageLog {
  id                                 String   @id @default(cuid())
  /// tenant — Org, на которую списывается стоимость. NULL до backfill,
  /// после Шага 1 backfill становится NOT NULL для не-системных вызовов.
  tenantId                           String?
  tenant                             Org?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  meetingId                          String?
  userId                             String?
  agentType                          String
  taskType                           String?
  jobId                              String?
  model                              String
  provider                           String
  inputTokens                        Int      @default(0)
  outputTokens                       Int      @default(0)
  /// Кэшированные input-токены (prompt cache hit) — учитываются в costUsd по cachedPer1M.
  cachedTokens                       Int      @default(0)
  reasoningTokens                    Int?
  costUsd                            Decimal  @db.Decimal(10, 6)
  /// `durationMs` = latency end-to-end вызова. Поле оставлено как есть.
  durationMs                         Int
  success                            Boolean
  errorText                          String?  @db.Text
  /// Указатель на источник (откуда пришёл вызов) для drill-down в Z-Admin.
  /// Пример: { type: 'meeting', id: 'mtg_01HX...' }, { type: 'card', id: 'crd_...' }, { type: 'block', id: '...' }.
  sourceRef                          Json?
  /// Для A/B-экспериментов LlmTaskRoute.experiment: 'A' | 'B'. NULL = вне эксперимента.
  experimentGroup                    String?
  /// Z-Admin Фаза 7: превью отправленного промпта (system + user, конкатенация),
  /// truncate до 8KB. Заполняется LlmRouter'ом при каждом успешном вызове.
  /// Для исторических записей до Фазы 7 — null. Используется в drill-down.
  requestPreview                     String?  @db.Text
  /// Z-Admin Фаза 7: превью ответа модели (text), truncate до 8KB.
  responsePreview                    String?  @db.Text
  /// Фаза A.1 (заведено заранее под A.4) — фактически использованный уровень цепочки моделей:
  /// 'primary' | 'secondary' | 'tertiary'. NULL = legacy записи до A.4 или одноуровневая цепочка.
  tier                               String?
  /// Фаза A.1 (заведено заранее под A.4) — причина срабатывания fallback'а на secondary/tertiary,
  /// например: 'primary_timeout' | 'primary_error' | 'primary_rate_limit' | 'secondary_*' | NULL.
  fallbackReason                     String?
  /// SBA α-10 wave 2 (2026-05-23) — snapshot полей цены и курса на момент вызова.
  /// Без этого исторические запросы агрегации зависят от текущих LlmModelPrice,
  /// что некорректно при изменении прайса.
  inputCostPerMillionTokensSnapshot  Decimal? @db.Decimal(10, 6)
