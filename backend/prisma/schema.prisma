model Card {
  id          String  @id @default(cuid())
  /// tenant: Org, к которой принадлежит карточка. После backfill — NOT NULL.
  tenantId    String?
  tenant      Org?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  // 'client' | 'deal' | 'project' | 'topic' | 'custom' | 'vendor'.
  // 'vendor' добавлен в SBA α-3 (поставщики, см. модель Vendor).
  // Хранится строкой (а не enum'ом), чтобы можно было добавлять виды без миграций.
  kind        String  @default("client")
  color       String  @default("#5EEAD4")
  icon        String?
  description String? @db.Text

  // Один опциональный primary-контакт. Несколько — vNext через CardContact.
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Knowledge-core (Фаза 4): primary-сущность карточки + связанные сущности +
  // опциональная ссылка на Theme, из которой пользователь сохранил карточку
  // через `POST /themes/:id/save-as-card`.
  entityId         String?
  entity           Entity?  @relation("CardEntity", fields: [entityId], references: [id], onDelete: SetNull)
  relatedEntityIds String[] @default([])
  bornFromThemeId  String?
  bornFromTheme    Theme?   @relation("CardBornFromTheme", fields: [bornFromThemeId], references: [id], onDelete: SetNull)

  pinned     Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  // AI rollup-кэш (заполняется card-rollup.worker'ом).
  summaryCache     String?   @db.Text
  summaryUpdatedAt DateTime?

  // Knowledge-core (Фаза 4): топ-N тем, связанных с карточкой через её блоки.
  // Заполняется card-rollup-v2.worker'ом — кэш для быстрого рендера UI.
  cachedTopThemeIds String[] @default([])

  // SBA α-6 — контракт специалиста §5.2 зонтичного.
  // Заполняются Specialist 3.4 при rollup'е.
  /// Блоки-источники последнего rollup'а (для citations в chat-v2).
  sourceBlockIds   String[]     @default([])
  /// confidence последнего LLM-rollup'а [0..1]. Используется CurationService.triage().
  confidence       Decimal?     @db.Decimal(4, 3)
  /// KC-Temporal W2.2 (2026-05-25) — калиброванная confidence (Platt).
  calibratedConfidence Decimal? @db.Decimal(4, 3)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass.
  /// NB: у Card нет поля `dataClass` напрямую — audit описывает класс,
  /// применённый при rollup'е (для трассировки compliance).
  dataClassAudit   Json?
  /// FK на текущую опубликованную версию CardVersion (α-4). Заполняется после auto-triage.
  currentVersionId String?
  currentVersion   CardVersion? @relation("CardCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// Person.id, кому Card «присваивается» как subject. Для последующей сборки SkillProfile (γ-1).
  personSubjectIds String[]     @default([])
  /// Когда карточка последний раз подтверждалась (auto после успешного rollup'а
  /// или вручную). Используется stale-detection из α-4 и probe `card.outdated_summary`.
  lastConfirmedAt  DateTime?

  // Денормализация для сортировки списка без JOIN.
  meetingCount  Int       @default(0)
  lastMeetingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings     Meeting[]
  chatMessages MeetingChatMessage[]

  @@unique([ownerId, name])
  @@index([ownerId, lastMeetingAt])
  @@index([ownerId, archivedAt])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([entityId])
  @@index([bornFromThemeId])
  @@index([currentVersionId])
  @@index([tenantId, lastConfirmedAt])
}

// ──────────────────────────── orgs / RBAC / invitations (Фаза 0 knowledge-core) ────────────────────────────

/// Org — организация-клиент. Любой ресурс (встреча, карточка, задача и т.д.)
/// принадлежит ровно одной Org через поле tenantId.
///
/// При регистрации создаётся персональный Org с owner=User. Member'ов добавляет
/// owner через OrgInvitation. visibilityMode определяет, видят ли manager-ы
/// чужие ресурсы внутри Org.
model Org {
  id                           String            @id @default(cuid())
  name                         String
  slug                         String            @unique
  ownerId                      String
  owner                        User              @relation("OrgOwner", fields: [ownerId], references: [id])
  visibilityMode               OrgVisibilityMode @default(open)
  /// Тариф — placeholder для Фазы 12. На Фазе 0 все Org = basic.
  tier                         OrgTier           @default(basic)
  /// Карта тумблеров воркеров для Org. {} = все включены. Воркеры читают
  /// org.workersEnabled[workerName] !== false. Управляется из Org-Admin (Фаза 7).
  /// Структура: { "block-ingest": false, "block-distill": true, ... }.
  workersEnabled               Json              @default("{}")
  /// Окно (в днях) для strategic-alignment воркера (Фаза 9). По умолчанию 30,
  /// валидация в API: 7..90.
  strategicAlignmentWindowDays Int               @default(30)
  /// Фаза D — Очистка транскрипта (sub-TZ 2026-05-21-phase-D-transcript-cleaning §4).
  /// Если true — после завершения `ai.merge` автоматически ставится job в `ai.transcript-clean`.
  /// По умолчанию false — Org включает руками, оценив бюджет на LLM-refine (~$0.05 за 100 мин).
  /// Поле живёт на Org для простоты (отдельной модели OrgSettings в проекте сейчас нет).
  transcriptCleaningAuto       Boolean           @default(false)
  /// Фаза C — типы встреч, для которых AI-оценка качества НЕ рассчитывается
  /// (sub-TZ C §4). Управляется через `PATCH /org/settings/quality-score`
  /// owner/admin'ом Org. Пустой массив = считать для всех типов. Поле живёт
  /// на Org по консистентности с `transcriptCleaningAuto` (отдельной OrgSettings
  /// в проекте нет).
  qualityScoreDisabledForTypes MeetingType[]     @default([])
  /// SBA β-8.1 — IANA-таймзона организации. Используется в
  /// `operations-weekly-digest.cron` для определения «понедельник 08:00
  /// локального времени» при отправке недельной сводки. Default
  /// 'Europe/Moscow' (соответствует поведению других модулей, см.
  /// `local-date.ts:DEFAULT_TIMEZONE`).
  timezone                     String?           @default("Europe/Moscow")
  createdAt                    DateTime          @default(now())
  deletedAt                    DateTime?

  memberships            Membership[]
  invitations            OrgInvitation[]
  meetings               Meeting[]
  cards                  Card[]
  tasks                  Task[]
  chapters               MeetingChapter[]
  highlights             MeetingHighlight[]
  chatMessages           MeetingChatMessage[]
  tags                   Tag[]
  apiKeys                ApiKey[]
  webhookSubs            WebhookSubscription[]
  destinations           IntegrationDestination[]
  exports                Export[]
  llmRoutes              LlmTaskRoute[]
  auditLogs              AuditLog[]
  aiUsageLogs            AiUsageLog[]
  sources                Source[]
  rawEvents              RawEvent[]
  ideaBlocks             IdeaBlock[]
  entities               Entity[]
  blockLinks             IdeaBlockLink[]
  entityLinks            EntityLink[]
  themes                 Theme[]
  goals                  Goal[]
  goalAlignmentSnapshots GoalAlignmentSnapshot[]
  retentionPolicy        OrgRetentionPolicy?
  entitlement            OrgEntitlement?

  // ── Фаза 0 — каркас компании ──
  departments     Department[]
  roles           Role[]
  persons         Person[]
  personRoles     PersonRole[]
  /// SBA α-8 wave 3 — Appointment[] (replacement для PersonRole, миграция за 1 мес. в проде).
  appointments    Appointment[]
  jobDescriptions JobDescription[]
  skills          Skill[]
  documents       Document[]
  roleProfiles    RoleProfile[]
  // Группа Б
  missions        Mission[]
  visions         Vision[]
  strategies      Strategy[]
  processes       Process[]
  processSteps    ProcessStep[]
  regulations     Regulation[]
  policies        Policy[]
  tools           Tool[]
  metrics         Metric[]
  decisions       Decision[]
  // ── SBA β-4 — Specialist 3.5 (Insights Radar) ──
  insights        Insight[]
  // ── SBA β-5 — Specialist 3.6 (Ideas Collector) + Layer 6 (Probe-Agent) ──
  ideas           Idea[]
  ideaClusters    IdeaCluster[]
  probeEvents     ProbeEvent[]

  // ── Фаза A.1 — Prompt Registry ──
  promptTemplates   PromptTemplate[]
  promptExperiments PromptExperiment[]

  // ── SBA α-1 — Conversational Channels Foundation ──
  channels      Channel[]
  notifications Notification[]

  // ── SBA β-8 — DailyCheckIn ──
  dailyCheckIns DailyCheckIn[]

  // ── SBA β-8.1 — Weekly operations digest для операционного директора ──
  weeklyOperationsDigests WeeklyOperationsDigest[]

  // ── SBA β-8.3 — Daily operations digest (ежедневный отчёт COO) ──
  dailyOperationsDigests DailyOperationsDigest[]

  // ── SBA α-3 — Layer 2 ontology extension ──
  vendors  Vendor[]
  events   Event[]
  markets  Market[]
  orgUnits OrgUnit[]

  // ── SBA α-7 wave 2 — Specialist 3.1 расширение ──
  processTemplates        ProcessTemplate[]
  processTemplateVersions ProcessTemplateVersion[]
  decisionPoints          DecisionPoint[]
  processHandoffs         ProcessHandoff[]

  // ── SBA γ-3 — Cross-Functional Process + Handoff Tracker ──
  crossFunctionalFrictionReports CrossFunctionalFrictionReport[]

  // ── SBA α-8 wave 2 — Role Map нормализация ──
  responsibilityElements ResponsibilityElement[]
  authorityBoundaries    AuthorityBoundary[]
  requiredKnowledge      RequiredKnowledge[]
  decisionPolicies       DecisionPolicy[]
  interactions           Interaction[]

  // ── SBA α-9 wave 2 — Company Foundation ──
  companyProfile    CompanyProfile?
  functionalDomains FunctionalDomain[]

  // ── SBA β-6 — Experiment Tracker (Specialist 3.9) ──
  experiments        Experiment[]
  experimentVersions ExperimentVersion[]

  // ── SBA β-7 — Brand Voice Curator (Specialist 3.10) ──
  brandVoiceProfile     BrandVoiceProfile?
  departmentDomainLinks DepartmentDomainLink[]

  // ── SBA α-10 wave 2 — Admin LLM + Unit Economics ──
  aiCostsDaily AiCostDaily[]
  budgetCap    OrgBudgetCap?

  // ── SBA α-4 — Layer 4 Curation Foundation ──
  curationItems      CurationItem[]
  conflictItems      ConflictItem[]
  cardVersions       CardVersion[]
  curatorAssignments CuratorAssignment[]
  /// SBA α-4 wave 2 — слоты «незаполненных полей» нормативных карточек.
  completenessSlots  CompletenessSlot[]

  // ── SBA α-5 — Layer 5 Chat-v2 Omnichannel ──
  chatV2Conversations ChatV2Conversation[]

  // ── SBA α-3 wave 3 — AxisClassifierService (4 оси знания) ──
  ideaBlockAxisLabels IdeaBlockAxisLabel[]

  // ── SBA γ-1 — Specialist 3.7 (SkillProfile + ExecutablePersona) ──
  skillProfiles        SkillProfile[]
  executablePersonas   ExecutablePersona[]  @relation("ExecutablePersonaTenant")
  /// SBA γ-1 доделки — эмерджентные категории SkillTrait (заменяют free-string
  /// SkillTrait.category). См.
  /// plans/tz/2026-05-23-sba-gamma-1-finishing-skilltraitcategory-persona-versioning.md.
  skillTraitCategories SkillTraitCategory[] @relation("SkillTraitCategoryTenant")
  /// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 2 — Смысловые блоки навыка.
  /// Канонизация SkillTrait'ов разных сотрудников в общий концепт.
  skillTraitConcepts   SkillTraitConcept[]  @relation("SkillTraitConceptTenant")

  /// Org-настройки Слоя 4 (curation). См. plans/tz/2026-05-21-sba-alpha-4-layer4-curation-foundation.md §8.
  /// Структура: `{ autoThreshold: 0.85, deepReviewThreshold: 0.6,
  /// criticalTypes: ['regulation','process','decision'], itemExpiryDays: 30 }`.
  /// Если null — берутся ENV-defaults через TypedConfigService.
  curationSettings Json?

  // ── SBA γ-2 — Concierge Agent ──
  conciergeConversations ConciergeConversation[]
  conciergeUndoLogs      ConciergeUndoLog[]
  conciergeQuota         OrgConciergeQuota?

  // ── SBA δ-1 — Orchestrator (multi-agent deep research) ──
  orchestratorRuns OrchestratorRun[]

  // ── SBA δ-2 — ProactiveWatcher (2026-05-23) ──
  proactiveNotifications ProactiveNotification[]

  // ── W2.3 KC-Temporal (2026-05-25) — preference dataset ──
  llmPreferenceSamples LlmPreferenceSample[]

  // ── User Feedback with AI Clustering (2026-05-25) ──
  /// Сообщения обратной связи пользователей этой Org. Опционально —
  /// orgId на FeedbackMessage может быть NULL, поэтому это lookup-only релейшен.
  feedbackMessages FeedbackMessage[]

  // ── ТЗ 2026-05-25 §9 (clone-respond эволюция) — CloneAccessGrant ──
  /// Гранты на доступ к клонам (CloneAccessGrant). Под флагом
  /// CLONE_V2_ENABLED — единственный источник правды о доступе к
  /// person/role-клону. Без CLONE_V2_ENABLED не используется (legacy RBAC).
  cloneAccessGrants CloneAccessGrant[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id        String         @id @default(cuid())
  orgId     String
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MembershipRole
  /// Кто пригласил/добавил. Для owner-а первичной Org = NULL.
  invitedBy String?
  inviter   User?          @relation("MembershipInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  /// Фаза 0a §10 — линковка с бизнес-Person, заполняется при accept'е
  /// приглашения. NULL для legacy memberships (до Фазы 0).
  personId  String?
  person    Person?        @relation("MembershipPerson", fields: [personId], references: [id], onDelete: SetNull)
  joinedAt  DateTime       @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
  @@index([personId])
}

/// ТЗ 2026-05-25 §9 (clone-respond эволюция) — гранты доступа к клонам.
///
/// Под флагом `CLONE_V2_ENABLED=true` это ЕДИНСТВЕННЫЙ источник правды о
/// доступе к person/role-клону: галочка либо стоит, либо нет. Без флага
/// логика старая (носитель, manager, admin). См. RbacService.canAccessPersonClone /
/// canAccessRoleClone.
///
/// Создание/удаление — admin-эндпоинты `/api/v1/admin/clones/access-grants/*`
/// (отдельная подзадача). Скрипт первичной миграции грантов —
/// `backend/scripts/patch-migrate-clone-access.ts` (заглушка на этом этапе).
model CloneAccessGrant {
  id              String   @id @default(cuid())
  tenantId        String
  /// Пользователь, получающий право спрашивать клона.
  grantedToUserId String
  /// 'person' (person-scope, по personId) или 'role' (role-scope, по roleId).
  cloneType       String
  /// personId или roleId — без формального FK (двойная природа), валидируется на уровне сервиса.
  cloneRefId      String
  /// Кто выдал галочку (admin Org).
  grantedById     String
  grantedAt       DateTime @default(now())

  tenant    Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grantedTo User @relation("CloneAccessGrant_grantedTo", fields: [grantedToUserId], references: [id], onDelete: Cascade)
  grantedBy User @relation("CloneAccessGrant_grantedBy", fields: [grantedById], references: [id])

  @@unique([tenantId, grantedToUserId, cloneType, cloneRefId])
  @@index([tenantId, grantedToUserId])
  @@index([tenantId, cloneType, cloneRefId])
}

model OrgInvitation {
  id                 String              @id @default(cuid())
  orgId              String
  org                Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// β-9 (2026-05-25): email теперь опционален. Для линейного персонала без
  /// почты директор копирует ссылку приглашения и пересылает руками
  /// (через `linkCode` или magic-link URL из `manualShareUrl` ответа).
  email              String?
  role               MembershipRole
  /// Случайный nanoid(40); хранится как plaintext (короткоживущий + одноразовый).
  token              String              @unique
  status             OrgInvitationStatus @default(pending)
  invitedBy          String
  inviter            User                @relation("OrgInvitationInvitedBy", fields: [invitedBy], references: [id])
  /// Фаза 0a §10 — линковка с бизнес-Person. Опц.; при создании приглашения
  /// из wizard'а или /structure?tab=persons backend заранее создаёт Person
  /// и сохраняет ссылку здесь, чтобы при accept'е заполнить Person.userId.
  personId           String?
  person             Person?             @relation("OrgInvitationPerson", fields: [personId], references: [id], onDelete: SetNull)
  /// β-9 (2026-05-25) — одноразовый код для прямой привязки Telegram-бота
  /// из письма приглашения (deep-link `https://t.me/<bot>?start=<linkCode>`).
  /// Hex(12) от `ConversationalLinkCodeService`, дублируется в Redis для горячего
  /// пути бота. NULL для legacy-приглашений без β-9 интеграции.
  linkCode           String?             @unique
  linkCodeUsedAt     DateTime?
  /// β-9 (2026-05-25) — sha256 magic-link-токена (по аналогии с
  /// `UserVerificationToken.tokenHash`). Прожигается при первом клике по
  /// magic-link в письме → создаётся `User` + `Membership`, открывается сессия
  /// без пароля. NULL для legacy-приглашений.
  magicTokenHash     String?             @unique
  magicTokenUsedAt   DateTime?
  /// β-9 (2026-05-25) — когда крон `org-invitation-reminders` отправил
  /// напоминание сотруднику (на 7-й день после `createdAt`). NULL = не отправляли.
  reminderSentAt     DateTime?
  /// β-9 (2026-05-25) — когда крон уведомил директора, что сотрудник так и
  /// не принял (на 14-й день, в день истечения). NULL = не уведомляли.
  directorNotifiedAt DateTime?
  createdAt          DateTime            @default(now())
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedByUserId   String?
  acceptedByUser     User?               @relation("OrgInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@index([personId])
}

// ──────────────────────────── llm-prices (Фаза 0 knowledge-core) ────────────────────────────

/// Версионируемая прайс-карта моделей. При расчёте `costUsd` LlmRouter сначала
/// смотрит сюда (актуальная запись по provider+model+effectiveFrom<=now AND
/// (effectiveTo IS NULL OR effectiveTo>now)), фолбэк на MODEL_PRICES в коде.
///
/// Цены — стоимость за 1 миллион токенов в указанной валюте.
model LlmModelPrice {
  id                               String    @id @default(cuid())
  provider                         String
  model                            String
  /// SBA α-10 wave 2 (2026-05-23) — опц. FK на LlmModel (новый реестр).
  /// Старые `provider`/`model` (строки) остаются для backward-compat.
  modelId                          String?
  inputCostPerMillionTokens        Decimal   @db.Decimal(10, 6)
  outputCostPerMillionTokens       Decimal   @db.Decimal(10, 6)
  /// Цена за 1M кэшированных входных токенов (prompt cache hit). 0 — не поддерживается.
  cachedCostPerMillionTokens       Decimal   @default(0) @db.Decimal(10, 6)
  /// SBA α-10 wave 2 — цена за 1M токенов write-cache (для Anthropic prompt cache create).
  inputCachedWritePerMillionTokens Decimal?  @db.Decimal(10, 6)
  /// SBA α-10 wave 2 — snapshot курса валюты к USD на момент применения цены
  /// (для исторических AiUsageLog.costRub вычислений без re-query CurrencyRate).
  currencyRateToUsdSnapshot        Decimal?  @db.Decimal(12, 6)
  currency                         String    @default("USD")
  effectiveFrom                    DateTime  @default(now())
  effectiveTo                      DateTime?
  /// Кто внёс изменение цены (для аудита админ-действий).
  changedByUserId                  String?
  createdAt                        DateTime  @default(now())

  modelRef  LlmModel? @relation("LlmModelPriceModel", fields: [modelId], references: [id], onDelete: SetNull)
  changedBy User?     @relation("LlmModelPriceChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([provider, model, effectiveFrom])
  @@index([modelId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

// ──────────────────────────── SBA α-10 wave 2 — Admin LLM + Unit Economics ────────────────────────────

/// LlmProvider — реестр провайдеров LLM (deepseek, openai-proxy, ollama,
/// anthropic, minimax, …). Управляется из админки `/admin/llm/providers`.
///
/// Один provider может иметь несколько LlmModel. Adapter (как вызывать API)
/// определяется через `protocolKind` — мapping в LlmProtocolAdapterRegistry
/// (5 типов: openai-chat / openai-responses / anthropic-messages / ollama-native /
/// custom-http).
model LlmProvider {
  id               String    @id @default(cuid())
  /// Уникальное короткое имя (slug): 'deepseek', 'openai-proxy', 'ollama',
  /// 'anthropic', 'minimax'. Использовалось в коде до α-10 как `provider` string —
  /// сохраняем стабильным для backward-compat.
  name             String    @unique @db.VarChar(60)
  /// Человекочитаемое имя для UI.
  displayName      String    @db.VarChar(120)
  /// Базовый endpoint API.
  baseUrl          String    @db.VarChar(500)
  /// Тип протокола: 'openai-chat' | 'openai-responses' | 'anthropic-messages' |
  /// 'ollama-native' | 'custom-http'.
  protocolKind     String    @db.VarChar(40)
  /// Капабилити: 'sensitive' = поддерживает private data; 'public' = только публичные данные.
  /// Влияет на маршрутизацию dataClass через LlmRouterService.
  capability       String    @default("public") @db.VarChar(20)
  /// Зашифрованный AES-256-GCM API-ключ (формат gcm:v1:...). NULL для self-hosted (Ollama).
  apiKeyEncrypted  String?   @db.Text
  /// Дополнительные headers (например, Anthropic-Version). JSON.
  defaultHeaders   Json?
  /// Глобальный rate limit (RPS) для самозащиты. NULL = без лимита.
  globalRps        Int?
  /// Активен ли провайдер для маршрутизации.
  isActive         Boolean   @default(true)
  /// Последний результат smoke-теста.
  lastSmokeAt      DateTime?
  lastSmokeSuccess Boolean?
  lastSmokeError   String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  models LlmModel[]

  @@index([isActive, protocolKind])
  @@map("llm_providers")
}

/// LlmModel — конкретная модель LLM в реестре (gpt-5.4-flash, deepseek-v4-pro,
/// qwen3.5:9b, …). Привязана к LlmProvider.
///
/// Используется в LlmTaskRoute.modelId, LlmModelPrice.modelId, LlmModelExperiment.
model LlmModel {
  id               String    @id @default(cuid())
  providerId       String
  /// Идентификатор модели в API (string передаётся в запросе).
  modelKey         String    @db.VarChar(120)
  /// Человекочитаемое имя для UI.
  displayName      String    @db.VarChar(200)
  /// Контекстное окно (in tokens).
  contextWindow    Int?
  /// Поддерживаются ли json_schema / tool calls. JSON-карта capabilities.
  capabilitiesJson Json?
  /// Категория для UI: 'flagship' | 'fast' | 'reasoning' | 'embedding' | 'experimental'.
  category         String?   @db.VarChar(40)
  /// Активна ли модель для маршрутизации.
  isActive         Boolean   @default(true)
  /// Verified — прошла smoke-тест. NULL = не проверялась.
  verifiedAt       DateTime?
  /// Заметка о статусе (например «timeout в KIE при медиане > 30s»).
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  provider LlmProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  prices   LlmModelPrice[] @relation("LlmModelPriceModel")

  @@unique([providerId, modelKey])
  @@index([providerId, isActive])
  @@index([category])
  @@map("llm_models")
}

/// AiCostDaily — дневная агрегация затрат AI по (tenant × taskType × provider × model).
/// Наполняется DailyCostAggregatorCron из AiUsageLog. Хранит сумму costRub/costUsd
/// для быстрых дашбордов без скана миллионов AiUsageLog.
model AiCostDaily {
  id             String   @id @default(cuid())
  tenantId       String
  date           DateTime @db.Date
  taskType       String   @db.VarChar(80)
  provider       String   @db.VarChar(60)
  model          String   @db.VarChar(120)
  /// Сколько вызовов было за день.
  callsCount     Int      @default(0)
  /// Сколько успешных (без fallbackReason).
  callsSuccess   Int      @default(0)
  /// Сумма затрат в USD (по snapshot из LlmModelPrice).
  costUsd        Decimal  @default(0) @db.Decimal(14, 6)
  /// Сумма затрат в RUB (по snapshot currencyRateToUsdSnapshot).
  costRub        Decimal  @default(0) @db.Decimal(14, 4)
  /// Сумма input/output/cached токенов.
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  cachedTokens   Int      @default(0)
  /// Когда последний раз пересчитывалась эта строка (для idempotency cron).
  recalculatedAt DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, taskType, provider, model])
  @@index([tenantId, date])
  @@index([date, taskType])
  @@map("ai_cost_daily")
}

/// OrgBudgetCap — бюджетные лимиты per Org на AI-расходы. Используется
/// BudgetAlertCron для уведомлений Org-owner'у при превышении % лимита.
model OrgBudgetCap {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  /// Месячный лимит в RUB. NULL = без лимита.
  monthlyCapRub      Decimal?  @db.Decimal(14, 2)
  /// Hard-cap или soft-cap (только alert).
  capKind            String    @default("soft") @db.VarChar(10)
  /// Пороги для alert'ов в % (например, [50, 80, 95]).
  alertThresholds    Int[]     @default([50, 80, 95])
  /// Когда был последний alert (для дедупликации).
  lastAlertAt        DateTime?
  /// Какой порог триггерил последний alert (для предотвращения повторов на тот же %).
  lastAlertThreshold Int?
  /// Кто установил лимит.
  setByUserId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org   Org   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setBy User? @relation("OrgBudgetCapSetBy", fields: [setByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("org_budget_caps")
}

/// CurrencyRate — курс валют. Поддерживается CurrencyRateSyncCron из ЦБ РФ
/// (https://www.cbr-xml-daily.ru). Используется LlmModelPrice/AiUsageLog для
/// пересчёта USD → RUB.
model CurrencyRate {
  id            String   @id @default(cuid())
  /// Базовая валюта (всегда 'USD' в текущей реализации).
  baseCurrency  String   @db.VarChar(3)
  /// Котируемая валюта ('RUB', 'EUR', 'CNY', …).
  quoteCurrency String   @db.VarChar(3)
  /// Курс: 1 baseCurrency = `rate` quoteCurrency.
  rate          Decimal  @db.Decimal(14, 6)
  /// Источник: 'cbr' | 'manual' | 'ecb' | …
  source        String   @default("cbr") @db.VarChar(20)
  /// Дата котировки (на конец дня).
  rateDate      DateTime @db.Date
  /// Когда скриптовали в БД.
  fetchedAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, rateDate, source])
  @@index([rateDate])
  @@map("currency_rates")
}

// ──────────────────────────── knowledge-core: Source / RawEvent (Фаза 1) ────────────────────────────

/// Справочник подключённых источников Org (meeting, chat, email, …).
/// Дефолтный `Source(type=meeting, name='Встречи Z')` создаётся автоматически
/// при создании Org. Управление источниками из UI — Фаза 10.
model Source {
  id        String     @id @default(cuid())
  tenantId  String
  type      SourceType
  name      String
  config    Json?
  dataClass DataClass  @default(internal)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org       Org        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEvents RawEvent[]

  @@unique([tenantId, type, name])
  @@index([tenantId, isActive])
}

/// Иммутабельная запись сырого события из любого источника. Главный entry-point
/// в knowledge-core. На Фазе 2 над ней появится `block-ingest.worker`.
model RawEvent {
  id               String                   @id @default(cuid())
  tenantId         String
  sourceId         String
  sourceType       SourceType
  /// Если null — событие без внешнего ID, дедуп по checksum.
  sourceExternalId String?
  /// sha256(sourceId + ':' + (sourceExternalId ?? payloadChecksum) + ':' + occurredAtIso)
  idempotencyKey   String                   @unique
  occurredAt       DateTime
  receivedAt       DateTime                 @default(now())
  payloadStorage   RawEventPayloadStorage   @default(inline)
  /// null если payloadStorage = s3
  payload          Json?
  /// не null если payloadStorage = s3
  payloadS3Key     String?
  /// sha256 от исходного payload (всегда, для верификации).
  payloadChecksum  String
  payloadSizeBytes Int
  dataClass        DataClass                @default(internal)
  processingStatus RawEventProcessingStatus @default(received)
  /// Текст ошибки при processingStatus = failed.
  processingError  String?                  @db.Text
  /// Когда последний раз обработался ingest pipeline (Фаза 2).
  processedAt      DateTime?

  org      Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source   Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  evidence IdeaBlockEvidence[]

  @@index([tenantId, sourceId, occurredAt])
  @@index([tenantId, processingStatus])
}

// ──────────────────────────── knowledge-core: IdeaBlock + Entity (Фаза 2) ────────────────────────────

/// IdeaBlock — единица знания «вопрос ↔ доверенный ответ».
/// Извлекается block-ingest.worker'ом из RawEvent, дедуплицируется
/// block-distill.worker'ом по эмбеддингам и LLM-арбитру.
///
/// Поля name / criticalQuestion / trustedAnswer индексируются ts_vector'ом
/// (см. postgres-init.sql) для гибридного поиска. embedding (vector(1536))
/// — для семантического поиска через HNSW.
///
/// status:
///   - draft: только что извлечён, не прошёл distill
///   - canonical: основной блок, остальные похожие через mergedIntoId → его id
///   - merged_into: блок-дубликат, его mergedIntoId указывает на canonical
///   - archived: устарел / явно скрыт
model IdeaBlock {
  id                          String                       @id @default(cuid())
  tenantId                    String
  name                        String
  criticalQuestion            String                       @db.Text
  trustedAnswer               String                       @db.Text
  tags                        String[]                     @default([])
  signalType                  SignalType
  confidence                  Decimal                      @default(0.5) @db.Decimal(4, 3)
  dataClass                   DataClass                    @default(internal)
  embedding                   Unsupported("vector(1536)")?
  status                      IdeaBlockStatus              @default(draft)
  mergedIntoId                String?
  evidenceCount               Int                          @default(0)
  /// Динамический рейтинг: пересчитывается ретеншеном; влияет на ранжирование в поиске.
  dynamicScore                Decimal                      @default(1.0) @db.Decimal(8, 4)
  /// Фаза 0b — пометка role-relevance из BlockExtractionService.
  /// Если true и roleId != null — блок учитывается RoleProfileAgent'ом (Фаза 0d).
  roleRelevant                Boolean                      @default(false)
  /// Опц. связь блока с Role (бизнес-должность). NULL — общий блок.
  roleId                      String?
  /// SBA β-8.2 — поля «Хранителя обещаний». Заполняются ТОЛЬКО для
  /// блоков с signalType='commitment'. Для остальных типов всегда NULL.
  ///
  /// `commitmentDueDate` — срок исполнения (00:00 UTC соответствующей даты).
  /// Извлекается из текста промптом `block-distill` (`commitmentDueDateGuess`).
  /// Если не извлечён — backfill-скрипт ставит `createdAt + 5 рабочих дней`.
  commitmentDueDate           DateTime?
  /// 'open' | 'asked' | 'fulfilled' | 'missed' | 'cancelled' | 'superseded'.
  commitmentStatus            String?                      @db.VarChar(20)
  /// Адресат обещания (Person той же Org). NULL если не извлечён.
  commitmentRecipientPersonId String?
  /// Когда последний раз ушёл probe «выполнил ли?».
  commitmentAskedAt           DateTime?
  /// Когда эскалировали при молчании (probe ушёл COO + owner).
  commitmentEscalatedAt       DateTime?
  /// KC-Temporal W1.1 (2026-05-25) — bi-temporal оси факта.
  /// `validFrom` — когда факт стал верен в реальности (default — самый
  /// ранний `IdeaBlockEvidence.sourceTimestamp`, иначе `createdAt`).
  /// Заполняется при persist в block-ingest.worker'е (при `BITEMPORAL_ENABLED=true`).
  validFrom                   DateTime?
  /// KC-Temporal W1.1 — когда факт перестал быть верен (null = до сих пор).
  /// Выставляется `FactSupersedeService` при `supersedes`-вердикте.
  validUntil                  DateTime?
  /// KC-Temporal W1.1 — когда система узнала о факте.
  /// Default now(); для backfill — равно `createdAt`.
  recordedAt                  DateTime                     @default(now())
  /// KC-Temporal W1.1 — когда система пометила факт устаревшим (supersede).
  supersededAt                DateTime?
  /// KC-Temporal W1.1 — id нового блока, который заменил этот.
  supersededById              String?
  /// KC-Temporal W1.4 (2026-05-25) — спан-уровневые свидетельства.
  /// Структура: `Array<{ field, refId?, evidenceId, startMs, endMs }>`.
  /// `field ∈ {'name'|'criticalQuestion'|'trustedAnswer'|'mentionedEntity'}`.
  /// Best-effort; отсутствие не ломает рендер.
  propertySpans               Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  org                 Org                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto          IdeaBlock?           @relation("BlockMerges", fields: [mergedIntoId], references: [id])
  mergedFrom          IdeaBlock[]          @relation("BlockMerges")
  /// KC-Temporal W1.1 — supersede chain (новый блок → старый).
  supersedes          IdeaBlock?           @relation("IdeaBlockSupersedes", fields: [supersededById], references: [id])
  supersedeChain      IdeaBlock[]          @relation("IdeaBlockSupersedes")
  evidence            IdeaBlockEvidence[]
  entities            IdeaBlockEntity[]
  linksFrom           IdeaBlockLink[]      @relation("BlockLinkFrom")
  linksTo             IdeaBlockLink[]      @relation("BlockLinkTo")
  themes              ThemeIdeaBlock[]
  /// Decision-сущности, созданные параллельно этому блоку (idempotent по
  /// sourceIdeaBlockId; Фаза 0b §I.66 зонтичного ТЗ).
  decisions           Decision[]
  /// Фаза 0d — link на Role-бизнес-должность для RoleProfileAgent.
  role                Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// SBA α-3 wave 3 — axis-метки (who/functional/contextual/temporal),
  /// проставленные AxisClassifierService после router.dispatch.
  /// См. plans/tz/2026-05-23-sba-alpha-3-wave3-axis-classifier-full.md.
  axisLabels          IdeaBlockAxisLabel[]
  /// SBA β-8.2 — адресат обещания (для блоков signalType='commitment').
  commitmentRecipient Person?              @relation("CommitmentRecipient", fields: [commitmentRecipientPersonId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, signalType])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, roleRelevant, roleId])
  /// SBA β-8.2 — выборка «висящих обещаний к сроку» (cron Хранителя обещаний).
  @@index([tenantId, signalType, commitmentStatus, commitmentDueDate])
  /// SBA β-8.2 — личный кабинет «Мои обещания» (по personId через
  /// `Person.userId`, фильтр по статусу).
  @@index([tenantId, signalType, commitmentStatus])
  /// KC-Temporal W1.1 — частые запросы «активные сейчас» (validUntil IS NULL).
  @@index([tenantId, validUntil])
  /// KC-Temporal W1.1 — снапшот «активные блоки данного signalType».
  @@index([tenantId, signalType, validUntil])
}

/// IdeaBlockAxisLabel — fan-out IdeaBlock по 4 осям знания
/// (who / functional / contextual / temporal). Источник §α-3 wave 3 sub-ТЗ.
///
/// Идемпотентность: уникальный составной ключ (tenantId, blockId, axis, label) —
/// AxisClassifierService использует upsert, повторные классификации не дублируют
/// записи. `source` ∈ {'static' | 'llm' | 'manual'} — для аудита и качества.
/// `label` — динамическая строка: entityId / domain-slug / 'temporal:<period>'.
model IdeaBlockAxisLabel {
  id         String   @id @default(cuid())
  tenantId   String
  blockId    String
  axis       AxisType
  /// Динамический ключ: entityId (для who/contextual), FunctionalDomain.slug
  /// (для functional) или 'temporal:<period>' (для temporal).
  label      String   @db.VarChar(200)
  confidence Decimal  @db.Decimal(4, 3)
  /// 'static' (по уже разрешённым entities/доменам), 'llm' (классификатор),
  /// 'manual' (admin-override).
  source     String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  block  IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tenant Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, blockId, axis, label])
  @@index([tenantId, blockId])
  @@index([tenantId, axis, label])
  @@index([axis, label])
}

/// IdeaBlockEvidence — link block ↔ конкретный фрагмент RawEvent с цитатой.
/// Один блок может иметь много свидетельств из разных встреч/чатов/звонков.
/// quote — текстовая цитата, startMs/endMs — таймкоды (если применимо к источнику).
model IdeaBlockEvidence {
  id              String     @id @default(cuid())
  blockId         String
  rawEventId      String
  sourceType      SourceType
  sourceTimestamp DateTime?
  quote           String     @db.Text
  startMs         Int?
  endMs           Int?
  createdAt       DateTime   @default(now())

  block    IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rawEvent RawEvent  @relation(fields: [rawEventId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@index([rawEventId])
}

/// Entity — сущность (клиент, человек, проект, продукт, тема, локация, custom).
/// Используется в IdeaBlockEntity (M:M с блоками) и в knowledge-core search.
/// canonicalName уникален в рамках tenant + type через приложение (не индексом —
/// возможны исторические дубликаты до прохода entity-merge-arbiter).
///
/// KC-Temporal W3.4 (2026-05-25) — «Strong IDs»: поля inn/ogrn/email/phone/domain
/// используются для дедупа БЕЗ LLM в рамках Org. Уникальность гарантируется
/// partial unique indices в `backend/scripts/postgres-init.sql` (Prisma
/// `@@unique` не поддерживает WHERE-условия, а делать full-unique нельзя —
/// большинство сущностей не имеют этих идентификаторов).
model Entity {
  id            String                       @id @default(cuid())
  tenantId      String
  type          EntityType
  canonicalName String
  aliases       String[]                     @default([])
  mergedIntoId  String?
  mentionsCount Int                          @default(0)
  embedding     Unsupported("vector(1536)")?
  metadata      Json?
  /// KC-Temporal W3.4 — strong-IDs (ИНН/ОГРН/email/phone/domain).
  /// Все nullable; partial unique через postgres-init.sql.
  inn           String?                      @db.VarChar(20)
  ogrn          String?                      @db.VarChar(20)
  email         String?                      @db.VarChar(320)
  phone         String?                      @db.VarChar(40)
  domain        String?                      @db.VarChar(253)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  org           Org               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto    Entity?           @relation("EntityMerges", fields: [mergedIntoId], references: [id])
  mergedFrom    Entity[]          @relation("EntityMerges")
  blockMentions IdeaBlockEntity[]
  // ↓ С Фазы 0 EntityLink — полиморфная модель без FK на Entity. Обратные
  //   relations убраны; для поиска связей используется
  //   EntityLink.findMany({ where: { fromEntityId, fromType: 'entity' } })
  //   или GraphService.getNeighbors. См. EntityLink выше.
  themes        ThemeEntity[]
  cards         Card[]            @relation("CardEntity")
  /// Линковка Person → Entity (Фаза 0b §8.3): Entity{type=person} может быть
  /// связана с Prisma-моделью Person через EntityResolutionService.
  persons       Person[]

  /// SBA α-3 — обратные связи новых моделей категории A.
  vendor     Vendor?     @relation("VendorEntity")
  event      Event?      @relation("EventEntity")
  goal       Goal?       @relation("GoalEntity")
  document   Document?   @relation("DocumentEntity")
  market     Market?     @relation("MarketEntity")
  orgUnit    OrgUnit?    @relation("OrgUnitEntity")
  /// SBA α-8 wave 2 — линковка с Role.
  role       Role?       @relation("RoleEntity")
  /// SBA α-9 wave 2 — линковка с Department.
  department Department? @relation("DepartmentEntity")

  @@index([tenantId, type])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, canonicalName])
}

// ──────────────────────────── SBA α-3 — категория A: Vendor / Event ────────────────────────────

/// Vendor — поставщик (категория A онтологии, SBA α-3). С `entityId` строго
/// привязан к Entity{type=vendor} для участия в графе знаний.
///
/// Дедупликация: приоритет `metadata.inn` (юридическое лицо), fallback на
/// `name`. Реализация в `EntityResolutionService.findOrCreateVendorEntity`.
model Vendor {
  id                String         @id @default(cuid())
  tenantId          String
  /// Связка с Entity{type=vendor}. Уникальна (1:1).
  entityId          String         @unique
  entity            Entity         @relation("VendorEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org               Org            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String         @db.VarChar(300)
  inn               String?        @db.VarChar(20)
  segment           VendorSegment?
  status            VendorStatus   @default(active)
  /// User.id ответственного со стороны компании. NULL — не назначен.
  responsibleUserId String?
  /// Document.id'ы договоров (опц.). FK не делаем — мягкая ссылка, чтобы не
  /// каскадить delete документа на Vendor.
  contractIds       String[]       @default([])
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  @@index([tenantId, status])
  @@index([tenantId, segment])
  @@index([tenantId, deletedAt])
}

/// Event — событие графа знаний (категория A, SBA α-3). Объединяет встречи,
/// инциденты, релизы, переходы и milestone'ы под единой типизацией для
/// специалистов Слоя 3 (3-3-decisions, 3-5-insights).
///
/// Дедупликация: `(tenantId, title, startAt within ±1 day)`. Реализация в
/// `EntityResolutionService.findOrCreateEventEntity`.
model Event {
  id                    String    @id @default(cuid())
  tenantId              String
  /// Связка с Entity{type=event}.
  entityId              String    @unique
  entity                Entity    @relation("EventEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org                   Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind                  EventKind @default(other)
  title                 String    @db.VarChar(300)
  startAt               DateTime
  endAt                 DateTime?
  durationMin           Int?
  location              String?   @db.VarChar(300)
  /// Person.id участников (мягкая ссылка, без FK — каскад не нужен).
  /// Legacy-поле от AI-pipeline. Calendar MVP использует EventParticipant.
  participantsPersonIds String[]  @default([])
  /// Meeting.id, если событие отражает реальную видеовстречу LiveKit.
  relatedMeetingId      String?
  outcomeSummary        String?   @db.Text
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  // ── Calendar MVP (2026-05-25) — расширения для пользовательского календаря ──
  /// Организатор события. NULL для AI-сгенерированных событий из транскриптов
  /// (legacy путь через EntityResolutionService.findOrCreateOrLinkEventEntity).
  /// REQUIRED для событий, созданных через POST /api/v1/events.
  ownerId          String?
  owner            User?           @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  description      String?         @db.Text
  /// true → событие на весь день (startAt = 00:00 локальной TZ, endAt = 00:00 след. дня).
  allDay           Boolean         @default(false)
  /// IANA timezone организатора (например, "Europe/Moscow").
  timezone         String          @default("Europe/Moscow") @db.VarChar(64)
  /// RFC-5545 RRULE для повторяющихся событий. В MVP — только пресеты
  /// (FREQ=DAILY|WEEKLY|MONTHLY|YEARLY[;BYDAY=...]). Полный парсер — Фаза 3.
  rrule            String?
  status           EventStatus     @default(confirmed)
  visibility       EventVisibility @default(company)
  /// Источник синхронизации (для будущей 2-way OAuth, Фаза 3).
  externalProvider String?         @db.VarChar(40)
  externalEventId  String?         @db.VarChar(200)
  /// Опц. привязка к Project трекера (для per-project Calendar view).
  projectId        String?

  participants EventParticipant[]
  reminders    EventReminder[]

  @@index([tenantId, startAt])
  @@index([tenantId, kind])
  @@index([tenantId, deletedAt])
  @@index([tenantId, ownerId, startAt])
  @@index([tenantId, projectId, startAt])
  @@index([externalProvider, externalEventId])
}

/// EventParticipant — участник события (Calendar MVP 2026-05-25).
/// Один из (userId, personId) обязательно заполнен. userId — для приглашённых
/// пользователей платформы; personId — для external контактов (Person).
model EventParticipant {
  id        String               @id @default(cuid())
  eventId   String
  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                @relation("EventParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  personId  String?
  person    Person?              @relation("EventParticipantPerson", fields: [personId], references: [id], onDelete: Cascade)
  role      EventParticipantRole @default(required)
  rsvp      RsvpStatus           @default(pending)
  rsvpAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([eventId])
  @@index([userId, rsvp])
  @@index([personId])
}

/// EventReminder — напоминание по событию (Calendar MVP 2026-05-25).
/// Sweep'ит EventReminderSchedulerCron каждую минуту: где
/// `sentAt IS NULL AND event.startAt - offsetMin*60s <= now`.
/// userId=NULL → отправляется всем участникам.
model EventReminder {
  id        String          @id @default(cuid())
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offsetMin Int
  channel   ReminderChannel
  userId    String?
  sentAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([eventId])
  @@index([sentAt, eventId])
}

/// Market — рынок как сущность графа знаний (категория A, SBA α-3 wave 2).
/// Ось CONTEXTUAL онтологии Кора v2: «где играем» (география × индустрия).
/// Источник для β-7 Brand Voice (per-market принципы), α-9 Company Foundation
/// (target markets), δ-1 Orchestrator.
///
/// Дедупликация: `(tenantId, name)` через приложение
/// (`EntityResolutionService.findOrCreateMarketEntity`, реализуется в α-3 wave 3).
model Market {
  id          String    @id @default(cuid())
  tenantId    String
  /// Связка с Entity{type=market}. Уникальна (1:1).
  entityId    String    @unique
  entity      Entity    @relation("MarketEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org         Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(300)
  /// Географический scope (например «РФ», «СНГ», «Europe»). NULL — global.
  geography   String?   @db.VarChar(120)
  /// Индустрия / вертикаль (например «retail», «fintech», «edtech»).
  industry    String?   @db.VarChar(120)
  /// Краткое описание сегмента в этом рынке.
  description String?   @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, geography])
  @@index([tenantId, industry])
  @@index([tenantId, deletedAt])
}

/// OrgUnit — структурное подразделение / команда / гильдия (категория A,
/// SBA α-3 wave 2). Ось WHO онтологии Кора v2 на уровне коллектива.
///
/// Отличие от Department: Department — типизированный официальный отдел в
/// орг-структуре (Phase 0a). OrgUnit — более общая абстракция для любой
/// рабочей единицы: cross-functional team, гильдия архитекторов, временный
/// project office, BizDev-pod. Может иметь parentDepartmentId на Department.
model OrgUnit {
  id                 String    @id @default(cuid())
  tenantId           String
  /// Связка с Entity{type=org_unit}. Уникальна (1:1).
  entityId           String    @unique
  entity             Entity    @relation("OrgUnitEntity", fields: [entityId], references: [id], onDelete: Cascade)
  org                Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String    @db.VarChar(300)
  /// Тип единицы: 'department' (формальный отдел) | 'team' (команда) |
  /// 'guild' (гильдия по специализации) | 'project_office' (временный) |
  /// 'committee' (комитет). Строкой, чтобы расширять без миграций.
  unitKind           String    @db.VarChar(40)
  /// Опц. ссылка на формальный Department (если OrgUnit — это пере-обёртка над ним).
  parentDepartmentId String?
  /// User.id лидера команды. NULL — не назначен.
  leadUserId         String?
  /// Person.id участников (мягкая ссылка, без FK).
  memberPersonIds    String[]  @default([])
  description        String?   @db.Text
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([tenantId, unitKind])
  @@index([tenantId, parentDepartmentId])
  @@index([tenantId, deletedAt])
}

// ──────────────────────────── SBA α-4 — Layer 4 Curation Foundation ────────────────────────────

/// CurationItem — запись в очереди проверки карточки специалиста (см.
/// plans/tz/2026-05-21-sba-alpha-4-layer4-curation-foundation.md §4).
///
/// `proposedPayload` — что специалист предлагает канонизировать. Применяется
/// после `decide`'а; до этого карточка не становится canonical.
///
/// `candidateCuratorIds` — кандидаты-кураторы, выбранные CuratorRoutingService
/// (после `decide`'а — `assignedToUserId` указывает на финального ревьюера).
///
/// `triageReason` — JSON, например `{ confidence: 0.72, conflictIds: ['cf_1'],
/// criticalType: false, reason: 'low_confidence' }`. Используется UI для
/// объяснения «почему сюда попала».
model CurationItem {
  id                  String             @id @default(cuid())
  tenantId            String
  /// Тип карточки специалиста: 'regulation' | 'process' | 'decision' | 'insight'
  /// | 'idea' | 'knowledge_profile' | ... (см. §3.6 зонтичного и sub-TZ Слоя 3).
  resourceType        String             @db.VarChar(80)
  resourceId          String             @db.VarChar(80)
  level               CurationLevel
  triageReason        Json
  proposedPayload     Json
  status              CurationItemStatus @default(pending)
  /// User.id куратора, реально принявшего решение (заполняется при decide).
  assignedToUserId    String?
  /// Список User.id'ов потенциальных кураторов (из CuratorRoutingService).
  /// Любой из них может принять решение через decide.
  candidateCuratorIds String[]           @default([])
  createdAt           DateTime           @default(now())
  decidedAt           DateTime?
  expiresAt           DateTime?

  org        Org                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?              @relation("CurationItemAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  decisions  CurationDecision[]
  versions   CardVersion[]

  @@index([tenantId, status])
  @@index([tenantId, level, status])
  @@index([assignedToUserId, status])
  @@index([resourceType, resourceId])
  @@index([expiresAt])
}

/// CurationDecision — решение куратора по CurationItem.
///
/// `payload` — изменения для approve_with_edits / split / merge / supersede
/// (что записываем в новую CardVersion). Для reject — пустой объект.
///
/// `reasoning` — обязателен для `deep` review и для resolution-связанных
/// решений (проверка в CurationService.decide).
model CurationDecision {
  id             String               @id @default(cuid())
  curationItemId String
  decisionType   CurationDecisionType
  payload        Json                 @default("{}")
  reasoning      String?              @db.Text
  reviewerUserId String
  createdAt      DateTime             @default(now())

  curationItem CurationItem @relation(fields: [curationItemId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("CurationDecisionReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([curationItemId])
  @@index([reviewerUserId])
}

/// ConflictItem — first-class сущность для конфликтов карточек.
///
/// Источник:
///   - Авто: `IdeaBlockLink.relationType='contradicts'` с high confidence
///     (block-linker.worker → ConflictService.report).
///   - Специалистом Слоя 3 при обнаружении конкурирующей карточки.
///   - Вручную из UI.
///
/// `evidence` — JSON со ссылками на блоки/факты-источники конфликта:
/// `{ blockIds: ['...'], links: [{ id, relationType }], notes: '...' }`.
///
/// `evolvingMeta` — обязателен для `resolution='evolving'`: `{
/// existingValidUntil: ISO, newValidFrom: ISO }`.
model ConflictItem {
  id               String              @id @default(cuid())
  tenantId         String
  resourceType     String              @db.VarChar(80)
  existingId       String              @db.VarChar(80)
  newId            String              @db.VarChar(80)
  evidence         Json
  /// Тип отношения, который породил конфликт ('contradicts' | 'duplicates' |
  /// 'supersedes' | ...). Хранится как строка (а не enum IdeaBlockLinkType),
  /// потому что не все источники конфликта — от block-linker'а.
  relationType     String              @db.VarChar(40)
  /// Кто/что инициировал создание ConflictItem ('block-linker' | 'specialist' |
  /// 'manual' | ...).
  detectedBy       String              @db.VarChar(40)
  status           ConflictStatus      @default(open)
  resolution       ConflictResolution?
  evolvingMeta     Json?
  resolvedByUserId String?
  resolvedAt       DateTime?
  reasoning        String?             @db.Text
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (max от участников
  /// конфликта; evolving + admin-resolve → sensitive по §4 floors).
  dataClassAudit   Json?
  createdAt        DateTime            @default(now())

  org        Org   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ConflictItemResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, resourceType, status])
  @@index([resourceType, existingId])
  @@index([resourceType, newId])
}

/// CardVersion — общая таблица версий для всех типов карточек специалистов
/// (Regulation, Decision, Process, KnowledgeProfile, Idea, ...).
///
/// Решение по §13.1 sub-TZ: общая таблица, чтобы не дублировать историю
/// в каждом модуле. Поиск версий: `WHERE resourceType=? AND resourceId=?`.
///
/// `payload` — полный snapshot карточки на момент создания версии. Может
/// быть большим — см. §13.4: на α-4 без ограничений, мониторим размер.
///
/// `changeReason` — `'initial' | 'approve' | 'approve_with_edits' | 'merge' |
/// 'supersede' | 'evolving' | 'stale-confirm' | ...`.
model CardVersion {
  id                 String   @id @default(cuid())
  tenantId           String
  resourceType       String   @db.VarChar(80)
  resourceId         String   @db.VarChar(80)
  version            Int
  previousVersionId  String?
  payload            Json
  changeReason       String?  @db.VarChar(40)
  /// User.id автора правки. NULL — auto (triage с auto-canonical, stale-cron).
  createdByUserId    String?
  /// Опц. CurationDecision, в результате которого создалась эта версия.
  curationDecisionId String?
  /// Опц. CurationItem (связан через decision; денормализация для быстрой
  /// фильтрации без JOIN'а через CurationDecision).
  curationItemId     String?
  createdAt          DateTime @default(now())

  org                  Org           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy            User?         @relation("CardVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  previousVersion      CardVersion?  @relation("CardVersionPrevious", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions         CardVersion[] @relation("CardVersionPrevious")
  curationItem         CurationItem? @relation(fields: [curationItemId], references: [id], onDelete: SetNull)
  /// SBA α-6 — обратное relation для Card.currentVersionId.
  cardsAsCurrent       Card[]        @relation("CardCurrentVersion")
  /// SBA α-7 — обратные relations для Process / Regulation / Policy.currentVersionId.
  /// Используется Specialist 3.1 для отметки `currentVersionId = approvedVersion.id`
  /// после triage'а (см. sub-TZ §4, §5).
  processesAsCurrent   Process[]     @relation("ProcessCurrentVersion")
  regulationsAsCurrent Regulation[]  @relation("RegulationCurrentVersion")
  policiesAsCurrent    Policy[]      @relation("PolicyCurrentVersion")
  /// SBA β-3 — обратное relation для Decision.currentVersionId.
  decisionsAsCurrent   Decision[]    @relation("DecisionCurrentVersion")
  /// SBA β-4 — обратное relation для Insight.currentVersionId.
  insightsAsCurrent    Insight[]     @relation("InsightCurrentVersion")
  /// SBA β-5 — обратное relation для Idea.currentVersionId.
  ideasAsCurrent       Idea[]        @relation("IdeaCurrentVersion")

  @@unique([resourceType, resourceId, version])
  @@index([tenantId, resourceType])
  @@index([resourceType, resourceId])
  @@index([curationItemId])
}

/// CuratorAssignment — гибкое назначение кураторов per-ResourceType (см.
/// sub-TZ §3.6).
///
/// `resourceType` = '*' — wildcard на все типы карточек.
/// `criteria` — опционально доп. фильтр: `{ tag: 'enterprise', kind: 'process' }`.
/// Если null — assignment применяется ко всем карточкам данного resourceType.
///
/// `curatorUserIds` — кандидаты-кураторы. Не пустой массив на нормальной
/// конфигурации. Несколько ID — round-robin / любой по политике sub-TZ.
///
/// `level` = null — assignment применяется к light И deep.
model CuratorAssignment {
  id             String         @id @default(cuid())
  tenantId       String
  resourceType   String         @db.VarChar(80)
  criteria       Json?
  curatorUserIds String[]       @default([])
  level          CurationLevel?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resourceType])
}

/// CompletenessSlot — SBA α-4 wave 2.
/// First-class «незаполненный слот» нормативной карточки. Один слот = одно
/// обязательное (или опц.) поле/связь для конкретного типа карточки. Сканер
/// `CompletenessScannerCron` создаёт / обновляет слоты для 4 типов карточек:
///   - `regulation`  (поля statement / ownerPersonId / scope, …)
///   - `process`     (ownerRoleId / inputs / outputs / metrics, шагов > 0, …)
///   - `role`        (missionStatement / responsibilityElements > 0, …)
///   - `company_profile` (mission / vision / strategy / displayName)
///
/// Слот считается «заполненным» — `filledAt IS NOT NULL`. Закрывается либо
/// автоматически (повторный проход сканера обнаружил данные), либо вручную
/// (`POST /curation/completeness-slots/:id/mark-filled`).
///
/// `probeAttempts` / `lastProbedAt` — для будущего CompletenessProbeCron
/// (γ-фаза): не дёргать получателя слишком часто.
model CompletenessSlot {
  id             String    @id @default(cuid())
  tenantId       String
  /// Тип родительской карточки: 'regulation' | 'process' | 'role' | 'company_profile'.
  parentCardType String    @db.VarChar(40)
  parentCardId   String    @db.VarChar(80)
  /// Имя слота — машинно-читаемое (например 'statement', 'owner_person', 'mission').
  slotName       String    @db.VarChar(80)
  /// Тип слота: 'required' (блокирует completeness=1.0) | 'optional' (bonus до 0.1).
  slotKind       String    @db.VarChar(20)
  filledAt       DateTime?
  filledByUserId String?
  lastProbedAt   DateTime?
  probeAttempts  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, parentCardType, parentCardId, slotName])
  @@index([tenantId, parentCardType, parentCardId])
  @@index([tenantId, filledAt])
  @@map("completeness_slots")
}

/// IdeaBlockEntity — M:M связь block ↔ entity с ролью и контекстом упоминания.
/// role — subject (главное действующее), object (на что направлено), mentioned (вскользь).
model IdeaBlockEntity {
  blockId        String
  entityId       String
  mentionContext String              @db.Text
  role           IdeaBlockEntityRole @default(mentioned)
  createdAt      DateTime            @default(now())

  block  IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([blockId, entityId])
  @@index([entityId])
}

/// IdeaBlockLink — типизированная связь между двумя IdeaBlock.
/// Создаётся `block-linker.worker` (KNN top-K кандидатов + LLM-арбитр)
/// или `reframing.cron` (рефлексия графа). 7 типов связей —
/// см. enum `IdeaBlockLinkType`.
///
/// Дедупликация: уникальная пара (fromBlockId, toBlockId, relationType).
/// Идемпотентный upsert при повторных проходах линкера.
model IdeaBlockLink {
  id           String            @id @default(cuid())
  tenantId     String
  fromBlockId  String
  toBlockId    String
  relationType IdeaBlockLinkType
  confidence   Decimal           @db.Decimal(4, 3)
  explanation  String            @db.Text
  createdBy    LinkCreatedBy
  status       LinkStatus        @default(active)
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11). Если не null — связь скрыта в UI.
  deletedAt    DateTime?
  /// userId, инициировавший удаление через Org-Admin. Для аудита.
  deletedBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  org       Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBlock IdeaBlock @relation("BlockLinkFrom", fields: [fromBlockId], references: [id], onDelete: Cascade)
  toBlock   IdeaBlock @relation("BlockLinkTo", fields: [toBlockId], references: [id], onDelete: Cascade)

  @@unique([fromBlockId, toBlockId, relationType])
  @@index([tenantId, status])
  @@index([fromBlockId, status])
  @@index([toBlockId, status])
  @@index([tenantId, deletedAt])
}

/// EntityLink — типизированная связь между двумя узлами графа.
///
/// До Фазы 0 — только Entity↔Entity (knowledge-core, создаётся
/// `entity-graph-builder.cron` раз в час). С Фазы 0 — единая полиморфная
/// модель рёбер для ВСЕХ бизнес-связей Z (см.
/// plans/tz/2026-05-21-phase-0a-data-model-and-graph-infra.md §4.4).
///
/// `fromType` / `toType` — discriminator типа узла. NULL = legacy запись
/// до Фазы 0 (читается как `entity`). Backfill — `backend/scripts/backfill-entity-link-types.ts`.
///
/// FK на Entity убраны: новые связи могут ссылаться на Role, Person, Process,
/// Document и т.д. — таблицы, которые не Entity. Каскадное удаление узла
/// чистит рёбра через `GraphService.removeNode` (см. 0a.2).
///
/// Двойная запись Postgres EntityLink + AGE `z_graph` — единственная точка
/// записи через `GraphService.addEdge` (см.
/// `second-brain/02_architecture/code-pitfalls.md` «Cypher только через GraphService»).
model EntityLink {
  id           String         @id @default(cuid())
  tenantId     String
  /// id источника. До Фазы 0 — всегда `Entity.id`. С Фазы 0 — id любой
  /// бизнес-сущности (см. fromType).
  fromEntityId String
  /// id цели. До Фазы 0 — всегда `Entity.id`. С Фазы 0 — id любой
  /// бизнес-сущности (см. toType).
  toEntityId   String
  /// Discriminator типа источника. NULL = legacy (`entity`).
  /// Возможные значения см. `NodeType` в `backend/src/common/graph/graph.types.ts`.
  fromType     String?        @db.VarChar(50)
  /// Discriminator типа цели. NULL = legacy (`entity`).
  toType       String?        @db.VarChar(50)
  relationType EntityLinkType
  confidence   Decimal        @db.Decimal(4, 3)
  explanation  String         @db.Text
  createdBy    LinkCreatedBy
  status       LinkStatus     @default(active)
  /// Временной интервал жизни связи (для bi-temporal в Фазе α; в Фазе 0 —
  /// используется для `executes_role` Person→Role).
  validFrom    DateTime       @default(now())
  /// DEPRECATED (KC-Temporal W1.1): оставлено для legacy-кода. Новые
  /// записи должны использовать `validUntil` (см. ниже). Backfill-скрипт
  /// `patch-bitemporal-backfill.ts` переносит значение в `validUntil`.
  validTo      DateTime?
  /// KC-Temporal W1.1 (2026-05-25) — bi-temporal «когда связь перестала
  /// быть верной». null = действует до сих пор. Новые ребра пишутся сюда;
  /// `validTo` оставлен только для чтения legacy-данных.
  validUntil   DateTime?
  /// KC-Temporal W1.1 — когда система узнала о ребре. Default now();
  /// для backfill — равно `createdAt`.
  recordedAt   DateTime       @default(now())
  /// Произвольные свойства связи (cosine score, RACI-флаги, observed_at и т.д.).
  properties   Json           @default("{}")
  /// KC-Temporal W3.1 (2026-05-25) — семантически богатые rich-edge атрибуты,
  /// извлекаемые LLM (`entity-graph-builder`): `{role: 'CEO', share: 0.5,
  /// since: '2022-01', intensity: 0.8, ...}`. Семантически отличается от
  /// `properties` (там — технические метрики: cosine score / RACI-флаги).
  /// NULL — атрибутов нет. При update merge'ится плоско (новые ключи +
  /// перезапись существующих) — см. `EntityLinkService.upsertRichEdge`.
  attributes   Json?
  /// KC-Temporal W3.1 (2026-05-25) — IdeaBlock-источники, на основе которых
  /// LLM построил это ребро. При повторном upsert (другой батч блоков
  /// подтвердил то же ребро) — union. Используется для трассировки и
  /// `confidence`-калибровки. GIN-индекс для поиска «какие рёбра поддерживает
  /// этот блок».
  sourceBlockIds String[]     @default([])
  /// Soft-delete: записывается при удалении из Org-Admin (Фаза 7).
  /// Hard-delete после 30 дней (Фаза 11).
  deletedAt    DateTime?
  /// userId, инициировавший удаление через Org-Admin.
  deletedBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite unique с учётом fromType/toType: одна и та же пара id может
  // быть одновременно entity→entity и (с Фазы 0) role→person с тем же
  // relationType. Включаем fromType/toType в ключ для однозначности.
  @@unique([fromEntityId, fromType, toEntityId, toType, relationType])
  @@index([tenantId, status])
  @@index([tenantId, fromEntityId, fromType])
  @@index([tenantId, toEntityId, toType])
  @@index([tenantId, relationType, validFrom])
  @@index([tenantId, deletedAt])
  /// KC-Temporal W1.1 — выборка активных рёбер (validUntil IS NULL).
  @@index([tenantId, validUntil])
}

// ──────────────────────────── knowledge-core: Theme (Фаза 4) ────────────────────────────

/// Theme — AI-кластер блоков. Создаётся `theme-clusterer.cron` (KNN-greedy
/// по эмбеддингам блоков + LLM-классификатор имени/ветки). Никогда не
/// создаётся пользователем вручную: если пользователь хочет «свою тему» —
/// он жмёт `POST /themes/:id/save-as-card` и получает Card с kind='topic'.
///
/// branch — одна из 12 веток компании (delivery M-07). Опциональна: LLM
/// может вернуть `null`, если ветка не определилась.
///
/// embedding(1536) — эмбеддинг от `name + ' ' + description`, для поиска
/// связанных тем и для UI-фильтров.
model Theme {
  id           String                       @id @default(cuid())
  tenantId     String
  name         String
  description  String                       @db.Text
  weight       Decimal                      @default(0.5) @db.Decimal(4, 3)
  dynamic      ThemeDynamic                 @default(stable)
  confidence   Decimal                      @default(0.5) @db.Decimal(4, 3)
  status       ThemeStatus                  @default(active)
  mergedIntoId String?
  branch       ThemeBranch?
  embedding    Unsupported("vector(1536)")?
  lastSignalAt DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  org        Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto Theme?           @relation("ThemeMerges", fields: [mergedIntoId], references: [id])
  mergedFrom Theme[]          @relation("ThemeMerges")
  blocks     ThemeIdeaBlock[]
  entities   ThemeEntity[]
  cards      Card[]           @relation("CardBornFromTheme")
  goalLinks  GoalTheme[]

  @@index([tenantId, status])
  @@index([tenantId, branch])
  @@index([tenantId, mergedIntoId])
}

/// ThemeIdeaBlock — M:M связь Theme ↔ IdeaBlock.
/// weight — мера принадлежности блока к теме (1.0 для seed-кластера, ниже
/// для дополнительно «прибившихся» блоков в reframing).
model ThemeIdeaBlock {
  themeId   String
  blockId   String
  weight    Decimal  @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime @default(now())

  theme Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  block IdeaBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([themeId, blockId])
  @@index([blockId])
}

/// ThemeEntity — denormalized связь Theme ↔ Entity (через блоки темы).
/// Заполняется кластерером и поддерживается reframing'ом для быстрых фильтров
/// «темы про этого клиента / этот продукт».
model ThemeEntity {
  themeId       String
  entityId      String
  mentionsCount Int      @default(0)
  createdAt     DateTime @default(now())

  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([themeId, entityId])
  @@index([entityId])
}

// ──────────────────────────── Z-Admin: SuperAdminAccessLog (Фаза 7) ────────────────────────────

/// Лог drill-down действий super_admin (Z-Admin Фаза 7).
/// Любое чтение/запись super_admin'а в данные конкретной Org пишется сюда
/// для compliance. На Фазе 7 — только запись, ежемесячный email-отчёт vNext.
///
/// Глобальная таблица (нет tenantId на уровне модели — `accessedTenantId`
/// указывает, к какой Org обращался super_admin; null = глобальный уровень).
model SuperAdminAccessLog {
  id               String   @id @default(cuid())
  superAdminUserId String
  superAdmin       User     @relation("SuperAdminAccessLog", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  /// NULL = действие на глобальном уровне (без конкретной Org).
  accessedTenantId String?
  route            String
  method           String
  params           Json?
  /// Обязательна для severity high/destructive операций (admin-redesign Фаза 0).
  reason           String?
  createdAt        DateTime @default(now())

  @@index([superAdminUserId, createdAt])
  @@index([accessedTenantId, createdAt])
}

// ──────────────────────────── knowledge-core: goals (Фаза 9) ────────────────────────────

/// Цель компании (Фаза 9 knowledge-core).
/// Создаётся owner Org вручную. Связь с Theme — M:M (GoalTheme).
/// Ежесуточно strategic-alignment.worker оценивает движение к цели.
model Goal {
  id                      String      @id @default(cuid())
  tenantId                String
  tenant                  Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  description             String      @db.Text
  /// Опциональный дедлайн. Используется как контекст для LLM-судьи.
  targetDate              DateTime?
  status                  GoalStatus  @default(active)
  /// Вес в среднем "Согласованность стратегии" (Фаза 8 dashboard). Default 1.0.
  weight                  Decimal     @default(1.0) @db.Decimal(4, 3)
  /// Фаза 0a §11.6 — горизонт цели для декомпозиции strategic→annual→…→sprint.
  /// Default quarterly — типичная цель компании в delivery/03-frame.md.
  horizon                 GoalHorizon @default(quarterly)
  /// Фаза 0a §11.6 — декомпозиция целей. Self-relation; UI появится в Фазе γ.
  parentGoalId            String?
  parent                  Goal?       @relation("GoalDecomposition", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children                Goal[]      @relation("GoalDecomposition")
  /// SBA β-8 (2026-05-23) — флаг каскадного провала. Выставляется
  /// `GoalCascadeService`, когда parent-Goal перешёл в `abandoned`
  /// (трактуется как «missed»). При следующем UI-рендере подсвечиваем
  /// ребёнка отдельной плашкой «попал под каскад из родителя».
  cascadeMissed           Boolean     @default(false)
  /// Если cascadeMissed=true — id того parent'а, который запустил каскад.
  cascadeMissedFromGoalId String?
  /// Когда каскад был отмечен. Для аудита и для возможного «снять флаг»
  /// в UI после ручного решения owner'а.
  cascadeMissedAt         DateTime?
  createdById             String
  createdBy               User        @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  archivedAt              DateTime?
  /// Кэш последнего snapshot для быстрого чтения списка целей без JOIN'а.
  /// Обновляется воркером после каждого расчёта.
  cachedAlignment         Int? /// 0..100, NULL = ещё не считалось.
  cachedAlignmentAt       DateTime?
  cachedAlignmentDelta    Int? /// разница со снапшотом 24h назад, для подсветки падений.
  cachedSnapshotId        String? /// FK на последний GoalAlignmentSnapshot.

  /// SBA α-3 — линковка с Entity{type=goal} для графа знаний. Заполняется
  /// patch-backfill-entity-id-goal.ts и поддерживается knowledge-core.
  entityId String? @unique
  entity   Entity? @relation("GoalEntity", fields: [entityId], references: [id], onDelete: SetNull)

  themes    GoalTheme[]
  snapshots GoalAlignmentSnapshot[]

  /// Tracker Phase 1 (2026-05-24) — задачи трекера, привязанные к этой цели
  /// через `Issue.goalId`. См. plans/tz/2026-05-23-tracker-phase-1-models-api.md.
  linkedIssues Issue[] @relation("IssueGoal")

  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
  @@index([tenantId, horizon])
  @@index([tenantId, parentGoalId])
}

/// M:M между Goal и Theme. На старте — ручная привязка от owner;
/// AI-предложения добавляются с source='ai' в vNext.
model GoalTheme {
  goalId    String
  themeId   String
  /// Источник связи: manual (owner добавил) | ai (предложено suggester'ом).
  source    GoalThemeSource @default(manual)
  /// Вес (1.0 — основная, ниже — частично связанная). По умолчанию 1.0.
  weight    Decimal         @default(1.0) @db.Decimal(4, 3)
  createdAt DateTime        @default(now())

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([goalId, themeId])
  @@index([themeId])
}

/// Суточный снапшот «движения к цели» от strategic-alignment.worker.
/// Используется для timeline'а и вычисления delta.
model GoalAlignmentSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  goalId       String
  /// 0..100 — оценка движения за окно (default 30 дней).
  score        Int
  /// Разница со снапшотом 24h назад (для подсветки падений). NULL для первого.
  delta        Int?
  /// 1-3 предложения объяснения от LLM.
  explanation  String   @db.Text
  /// Структура: { pro: ['…'], contra: ['…'] } — по 3-5 пунктов.
  signals      Json
  /// Какое окно использовалось (в днях).
  windowDays   Int      @default(30)
  /// Сколько связанных тем участвовало в оценке.
  themesCount  Int
  /// Сколько блоков LLM проанализировал.
  blocksCount  Int
  /// AiUsageLog.id (для drill-down в Z-Admin). FK не делаем — может быть очищен ретеншеном.
  aiUsageLogId String?
  /// Если delta <= -15 и score <= 60 — alertPending=true.
  alertPending Boolean  @default(false)
  createdAt    DateTime @default(now())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tenant Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, alertPending])
}

// ──────────────────────────── knowledge-core: retention (Фаза 11) ────────────────────────────

/// OrgRetentionPolicy — конфиг ретеншена per-Org для knowledge-core/152-ФЗ
/// (Фаза 11). Создаётся seed'ом или lazy upsert'ом в RetentionPolicyService.
///
/// Поля — длительности в днях:
///   - rawEventDays: 7 лет (2555) — дефолт под 152-ФЗ; ниже 30 нельзя установить.
///   - archivedBlockDays: 365 — сколько живёт IdeaBlock.status='archived' до hard-delete.
///   - chatMessageDays: 90 — MeetingChatMessage.
///   - auditLogDays: 730 — AuditLog (compliance).
///
/// archivedBlockAction:
///   - 'archive_then_delete' (default) — блок без evidence уходит в archived,
///     а через archivedBlockDays — hard-delete.
///   - 'keep_forever' — архив остаётся всегда (нет hard-delete по retention).
///
/// lastSweepAt — когда последний раз RetentionService.processAll проходил по Org.
model OrgRetentionPolicy {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  org                 Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawEventDays        Int       @default(2555)
  archivedBlockDays   Int       @default(365)
  chatMessageDays     Int       @default(90)
  auditLogDays        Int       @default(730)
  archivedBlockAction String    @default("archive_then_delete")
  lastSweepAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ──────────────────────────── knowledge-core: entitlements (Фаза 12) ────────────────────────────

/// OrgEntitlement — per-Org конфиг тарифа и override'ов фич/квот (Фаза 12).
///
/// `tier` — строка ('tier_basic' | 'tier_pro' | 'tier_enterprise'), не enum.
/// Причина: бизнес может ввести четвёртый/пятый тариф без миграции.
/// Реестр тарифов (features/quotas) — статический в коде (TierConfigRegistry).
///
/// `featureOverrides` / `quotaOverrides` — JSON-карты для исключений.
/// Пример: `{"feature.theme": true}` даст enterprise-фичу одной Org бесплатно.
///
/// `notes` — ручной комментарий super_admin'а (для audit-trail в UI).
///
/// На MVP backfill сидит `tier_pro` по умолчанию (см. seed-entitlements.ts).
model OrgEntitlement {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  org              Org      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier             String   @default("tier_pro")
  featureOverrides Json?
  quotaOverrides   Json?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════════════════
// Фаза 0 — каркас компании (см. plans/tz/2026-05-21-phase-0-roles-and-onboarding.md)
// ════════════════════════════════════════════════════════════════════════════
//
// Группа А (с UI в Фазе 0):
//   Department, Role, Person, PersonRole, JobDescription, Skill, Document, RoleProfile.
//
// Группа Б (без UI в Фазе 0, наполняется extraction'ом):
//   Mission, Vision, Strategy, Process, ProcessStep, Regulation, Policy,
//   Tool, Metric, Decision. См. ниже после группы А.
//
// Conventions: id = cuid(); tenantId (НЕ orgId, для консистентности с
// существующими моделями); все @relation на tenant идут через Org.
// Membership.role (owner/admin/manager) ≠ бизнес-Role (должность в компании
// клиента) — это две разные сущности. См. README в second-brain.

// ──────────────────────────── группа А: структура компании ────────────────────────────

/// Department — отдел компании клиента (Фаза 0).
/// Поле `parentDepartmentId` — иерархия в схеме, UI в Фазе 0 плоский (γ
/// добавит дерево). См. зонтичный ТЗ §2 «Не входит».
model Department {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String    @db.VarChar(200)
  parentDepartmentId String?
  /// SBA α-9 wave 2 (2026-05-23) — расширение Department для Company Foundation.
  /// Краткое описание миссии отдела (1-2 предложения).
  missionStatement   String?   @db.Text
  /// 0..1 — насколько полно у отдела заполнены: roles, processes, regulations.
  /// Рассчитывается MaturityScorerCron.
  completeness       Decimal?  @db.Decimal(4, 3)
  /// Опц. линковка с Entity{type=org_unit} (для участия в графе знаний).
  entityId           String?   @unique
  /// IdeaBlock-источники последнего извлечения отдела (provenance).
  sourceBlockIds     String[]  @default([])
  /// Confidence от extraction-LLM (для агентских записей).
  confidence         Decimal?  @db.Decimal(4, 3)
  /// ТЗ 2026-05-25 «clone-reliability-hardening» Фаза 3 — глава отдела.
  /// Person.id главы отдела; probe-уведомления об аномалиях профиля клона
  /// сначала идут ему, и только при NULL — fallback к admin'ам.
  headPersonId       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// Soft-delete: cohabits с уникальностью (orgId, name) благодаря включению deletedAt в @@unique.
  deletedAt          DateTime?

  org                       Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent                    Department?            @relation("DepartmentParent", fields: [parentDepartmentId], references: [id])
  children                  Department[]           @relation("DepartmentParent")
  entity                    Entity?                @relation("DepartmentEntity", fields: [entityId], references: [id], onDelete: SetNull)
  /// ТЗ 2026-05-25 Фаза 3 — глава отдела (см. headPersonId).
  headPerson                Person?                @relation("DepartmentHead", fields: [headPersonId], references: [id], onDelete: SetNull)
  roles                     Role[]
  persons                   Person[]               @relation("PersonPrimaryDepartment")
  /// SBA α-8 wave 3 — Appointment[] (current/historical назначения в отделе).
  appointments              Appointment[]
  /// SBA α-8 wave 3 — Metric'ы, привязанные к этому отделу (KPI).
  attachedMetrics           Metric[]               @relation("MetricToDepartment")
  /// SBA α-8 wave 2 — обратная связь Interaction.
  interactionsAsCounterpart Interaction[]          @relation("InteractionCounterpartDept")
  /// SBA α-9 wave 2 — m:n с FunctionalDomain.
  domainLinks               DepartmentDomainLink[]

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@index([tenantId, parentDepartmentId])
  @@index([tenantId, headPersonId])
  @@map("departments")
}

/// Role — должность в компании клиента (бизнес-сущность).
/// **НЕ ПУТАТЬ** с `Membership.role` (owner/admin/manager) — это права доступа
/// в Z. `Role` (эта модель) — бизнес-должность ("Менеджер по продажам", "QA Engineer").
model Role {
  id               String    @id @default(cuid())
  tenantId         String
  name             String    @db.VarChar(200)
  departmentId     String?
  /// Свободные теги для поиска и фильтрации.
  tags             String[]  @default([])
  /// SBA α-8 wave 2 (2026-05-23) — расширение Role Map.
  /// Краткое описание миссии должности (1-2 предложения).
  missionStatement String?   @db.Text
  /// Зрелость роли: 0..1, рассчитывается MaturityScorerCron как
  /// произведение completeness × #observations × age. NULL до первого подсчёта.
  maturityScore    Decimal?  @db.Decimal(4, 3)
  /// Опц. линковка с Entity{type=role} (если нужна для графа знаний).
  entityId         String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  org               Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        Department?      @relation(fields: [departmentId], references: [id])
  entity            Entity?          @relation("RoleEntity", fields: [entityId], references: [id], onDelete: SetNull)
  jobDescriptions   JobDescription[]
  roleProfile       RoleProfile?
  personRoles       PersonRole[]
  /// SBA α-8 wave 3 — Appointment[] (replacement для PersonRole).
  appointments      Appointment[]
  /// SBA α-8 wave 3 — Metric'ы, привязанные к этой роли (KPI).
  attachedMetrics   Metric[]         @relation("MetricToRole")
  /// IdeaBlock-и с пометкой role_relevant=true для RoleProfileAgent (Фаза 0d).
  ideaBlocks        IdeaBlock[]
  /// Документы, явно загруженные на эту должность через wizard или /structure.
  attachedDocuments Document[]       @relation("DocumentAttachedRole")
  /// Процессы, owner которых — эта роль (Фаза 0b, наполняется extraction'ом).
  ownedProcesses    Process[]        @relation("ProcessOwnerRole")

  /// SBA α-7 wave 2 — обратные связи новых моделей.
  ownedProcessTemplates     ProcessTemplate[]       @relation("ProcessTemplateOwnerRole")
  decisionPointsAsDecider   DecisionPoint[]         @relation("DecisionPointDecider")
  handoffsFrom              ProcessHandoff[]        @relation("HandoffFromRole")
  handoffsTo                ProcessHandoff[]        @relation("HandoffToRole")
  /// SBA α-8 wave 2 — Role Map нормализованные таблицы.
  responsibilityElements    ResponsibilityElement[]
  authorityBoundaries       AuthorityBoundary[]     @relation("AuthorityBoundaryRole")
  approvedBoundaries        AuthorityBoundary[]     @relation("AuthorityBoundaryApprover")
  requiredKnowledge         RequiredKnowledge[]
  decisionPolicies          DecisionPolicy[]
  interactions              Interaction[]           @relation("InteractionRole")
  interactionsAsCounterpart Interaction[]           @relation("InteractionCounterpartRole")

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId, departmentId])
  @@map("roles")
}

/// Person — сотрудник компании клиента (Фаза 0).
///
/// Отличие от Entity{type=person}: `Entity` — это упоминание персоны в графе
/// знаний (knowledge-core); `Person` — это сущность ЛК со связями с
/// Role/Department/User. `Person.entityId` — линковка, заполняется
/// EntityResolutionService (Фаза 0b §8.3).
///
/// `userId` NULL до accept'а приглашения. Membership создаётся атомарно с
/// `Person.userId = currentUserId` в `POST /api/v1/orgs/:orgId/invitations/:token/accept`.
model Person {
  id                  String             @id @default(cuid())
  tenantId            String
  /// NULL до accept'а приглашения. После accept'а — атомарно линкуется с User.
  userId              String?
  name                String             @db.VarChar(200)
  email               String             @db.VarChar(320)
  /// Основной отдел для UI; для графовых связей `member_of` — через PersonRole.
  primaryDepartmentId String?
  /// Линковка с Entity{type=person} (см. EntityResolutionService, Фаза 0b §8.3).
  entityId            String?
  /// SBA α-3 (2026-05-21) §4.3 — отношение Person ↔ Org. По умолчанию
  /// `external` (создан как контакт); patch-script проставит `employee`
  /// тем, у кого есть активный Membership.
  relationship        PersonRelationship @default(external)
  /// SBA β-2 (2026-05-21) — Knowledge Clone (Specialist 3.2). Структурированный
  /// кеш «что человек знает / опыт / типовые ответы по областям».
  /// Заполняется воркером `knowledge-clone-rebuild`. См. sub-TZ §4.
  knowledgeProfile    Json?
  /// SBA β-2 — момент последней успешной пересборки `knowledgeProfile`.
  lastProfileBuildAt  DateTime?
  /// SBA β-2 — версия профиля (инкремент при каждой успешной пересборке).
  profileBuildVersion Int                @default(0)
  /// SBA β-8 (2026-05-23) — таймзона пользователя в формате IANA
  /// (например, "Europe/Moscow", "Asia/Yekaterinburg"). Используется
  /// `DailyCheckInPromptCron` для определения локального утра/вечера.
  /// Default `Europe/Moscow` — для NULL-ов проставляется
  /// `patch-person-timezone-default.ts`. Person может править через
  /// `/me/settings` (когда появится UI).
  timezone            String?            @default("Europe/Moscow") @db.VarChar(64)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  org                   Org                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?              @relation("UserPersons", fields: [userId], references: [id], onDelete: SetNull)
  primaryDepartment     Department?        @relation("PersonPrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  entity                Entity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  personRoles           PersonRole[]
  /// SBA α-8 wave 3 — Appointment[] (replacement для PersonRole).
  appointments          Appointment[]
  uploadedDocuments     Document[]         @relation("DocumentUploader")
  decisionsMade         Decision[]         @relation("DecisionDecidedBy")
  ownedProcesses        Process[]          @relation("ProcessOwnerPerson")
  /// SBA α-7 — Person как owner регламента / политики (см. sub-TZ §4, §6).
  ownedRegulations      Regulation[]       @relation("RegulationOwnerPerson")
  ownedPolicies         Policy[]           @relation("PolicyOwnerPerson")
  /// SBA α-7 wave 2 — Person как owner ProcessTemplate.
  ownedProcessTemplates ProcessTemplate[]  @relation("ProcessTemplateOwnerPerson")
  memberships           Membership[]       @relation("MembershipPerson")
  invitations           OrgInvitation[]    @relation("OrgInvitationPerson")
  /// SBA γ-1 — Specialist 3.7 (SkillProfile). 1:1 — у одного Person ровно один профиль.
  skillProfile          SkillProfile?      @relation("SkillProfilePerson")
  /// SBA β-8 — DailyCheckIn записи сотрудника.
  dailyCheckIns         DailyCheckIn[]     @relation("DailyCheckInPerson")
  /// SBA β-8.2 — обратная связь для обещаний, адресованных этому человеку
  /// (`IdeaBlock.commitmentRecipientPersonId`).
  commitmentsToMe       IdeaBlock[]        @relation("CommitmentRecipient")
  /// ТЗ 2026-05-25 Фаза 3 — отделы, где этот Person — глава.
  headOfDepartments     Department[]       @relation("DepartmentHead")
  /// Calendar MVP (2026-05-25) — участие как Person (external контакт).
  eventParticipations   EventParticipant[] @relation("EventParticipantPerson")
  /// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 4 — Семантический
  /// индекс категорий профиля знаний (для запросов «кто разбирается в X»).
  knowledgeCategoryEmbeddings PersonKnowledgeCategoryEmbedding[]

  @@unique([tenantId, email, deletedAt])
  @@index([tenantId, userId])
  @@index([tenantId, primaryDepartmentId])
  @@index([tenantId, entityId])
  @@map("persons")
}

/// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 4 — Семантический индекс
/// категорий профиля знаний для запросов «кто разбирается в X».
/// Тонкий индекс над JSON Person.knowledgeProfile.categories[]:
/// дублирует name+confidence + кладёт embedding для векторного поиска.
model PersonKnowledgeCategoryEmbedding {
  id                  String   @id @default(cuid())
  tenantId            String
  personId            String
  /// = knowledgeProfile.categories[].name (для отображения).
  categoryName        String   @db.VarChar(200)
  /// 'low' | 'medium' | 'high' — копия, чтобы фильтровать без чтения JSON.
  confidence          String   @db.VarChar(16)
  embedding           Unsupported("vector(1536)")?
  builtAt             DateTime @default(now())
  /// = Person.profileBuildVersion на момент построения этого embedding.
  profileBuildVersion Int

  person              Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, confidence])
  @@index([personId])
  @@map("person_knowledge_category_embeddings")
}

/// @deprecated SBA α-8 wave 3 (2026-05-23) — use `Appointment`.
/// PersonRole оставлена для legacy consumers и backward-compat;
/// `PersonsService` через feature-flag USE_APPOINTMENT_FOR_PERSON_ROLES
/// читает Appointment (по умолчанию false до flip'а в prod). Удаление —
/// отдельный sub-ТЗ через 1 месяц после прод-миграции.
///
/// PersonRole — many-to-many Person ↔ Role с временным интервалом.
/// Зеркало AGE-ребра `executes_role` (Фаза 0a). Открытая роль = validTo IS NULL.
/// Закрытие старой роли при переназначении: validTo = now() + создание новой записи.
model PersonRole {
  id        String    @id @default(cuid())
  tenantId  String
  personId  String
  roleId    String
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())

  org    Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([personId, roleId, validFrom])
  @@index([tenantId, roleId])
  @@index([tenantId, personId])
  @@index([tenantId, validTo])
  @@map("person_roles")
}

/// SBA α-8 wave 3 (2026-05-23) — Appointment.
///
/// Replacement for `PersonRole` с расширенными полями (departmentId,
/// loadPercent, status). Создаётся вручную через `/api/v1/appointments`
/// или агентом `appointment-detector` (опционально, флаг
/// APPOINTMENT_DETECTOR_ENABLED). Для backward-compat PersonRole
/// сохраняется; PersonsService читает Appointment если
/// USE_APPOINTMENT_FOR_PERSON_ROLES=true. См. sub-ТЗ
/// plans/tz/2026-05-23-sba-alpha-8-wave3-appointment-kpi.md.
///
/// status: 'active' | 'former' | 'acting'
///   active  — действующее назначение (validTo IS NULL).
///   former  — историческое (validTo < now()).
///   acting  — временное «исполняющий обязанности» (admin выставляет руками).
model Appointment {
  id             String    @id @default(cuid())
  tenantId       String
  personId       String
  roleId         String
  departmentId   String?
  loadPercent    Int       @default(100)
  status         String    @default("active") @db.VarChar(20)
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  /// IdeaBlock-источники назначения (provenance для агентских записей).
  sourceBlockIds String[]  @default([])
  /// Confidence от агента-извлекателя (1.0 для ручных).
  confidence     Decimal   @default(1.0) @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org        Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person     Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, personId, roleId, validFrom])
  @@index([tenantId, personId, status])
  @@index([tenantId, roleId, status])
  @@index([tenantId, departmentId, status])
  @@map("appointments")
}

/// JobDescription — declared-форма должности (что прописано в инструкции,
/// в отличие от observed-картины в RoleProfile).
model JobDescription {
  id               String    @id @default(cuid())
  tenantId         String
  roleId           String
  contentMd        String    @db.Text
  sourceDocumentId String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  org            Org       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([tenantId, roleId])
  @@map("job_descriptions")
}

/// Skill — переиспользуемая компетенция (одна Skill — много Role/Person).
model Skill {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    @db.VarChar(200)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@map("skills")
}

/// Document — загруженный файл (PDF / DOCX / Markdown / text). Фаза 0b.
///
/// inline ≤ 10 MiB кладётся в `inlineContent`; больше — в S3 (`s3Key`).
/// `parsedText` заполняется `document.adapter` / `text.adapter` (Фаза 0b).
/// `attachedRoleId` — если документ привязан к конкретной должности (из
/// wizard step-4 или `/structure?tab=roles → Загрузить должностную`).
model Document {
  id             String         @id @default(cuid())
  tenantId       String
  /// Person.id (НЕ User.id) — кто загрузил.
  uploaderId     String
  kind           DocumentKind
  name           String         @db.VarChar(500)
  mimeType       String         @db.VarChar(100)
  /// S3-ключ; null если используется inlineContent (file ≤ 10 MiB).
  s3Key          String?        @db.VarChar(500)
  /// Inline-байты; null если использован S3.
  inlineContent  Bytes?
  originalSize   Int
  /// Заполняется парсером (Фаза 0b).
  parsedText     String?        @db.Text
  /// Если status=failed — текст ошибки парсера.
  parseError     String?        @db.Text
  status         DocumentStatus @default(uploaded)
  /// Если документ привязан к Role — wizard step-4 или /structure → Загрузить должностную.
  attachedRoleId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  /// SBA α-3 — линковка с Entity{type=document} для графа знаний. Заполняется
  /// patch-backfill-entity-id-document.ts.
  entityId String? @unique
  entity   Entity? @relation("DocumentEntity", fields: [entityId], references: [id], onDelete: SetNull)

  /// SBA β-7 — multi-faceted назначение документа. Один документ может одновременно
  /// быть «опорным материалом процесса» (use_in_process), «генерационным
  /// шаблоном» (use_for_generation), «справочным» (reference) и/или «корпусом
  /// бренда» (brand_corpus). Префиксы — open enum: значения валидируются на
  /// API-уровне в `DocumentUseCasesController`, чтобы расширение новыми use-case
  /// не требовало миграций. Backfill дефолтного значения 'reference' — через
  /// `backend/scripts/patch-document-use-cases-default.ts`.
  useCases String[] @default([])

  org             Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader        Person           @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  attachedRole    Role?            @relation("DocumentAttachedRole", fields: [attachedRoleId], references: [id], onDelete: SetNull)
  jobDescriptions JobDescription[]

  @@index([tenantId, status])
  @@index([tenantId, uploaderId])
  @@index([tenantId, attachedRoleId])
  @@map("documents")
}

/// SBA β-7 — BrandVoiceProfile. 1:1 на Org-запись «голоса бренда».
///
///   - `toneJson` — мерные оси тона: { formal, technical, casual, energetic, ... }
///     в диапазоне 0..1. До 10 dimensions. Структура валидируется в сервисе.
///   - `valuesJson` — ценности бренда: Array<{ value, weight 0..1,
///     exampleBlockIds }>.
///   - `taboosJson` — табу-фразы: Array<{ phrase, alternative?, reason }>.
///   - `exampleArtifactIds` — Document.id'ы (useCases includes 'brand_corpus'),
///     которые послужили опорой.
///   - `completeness` — 0..1, доля заполненных секций (tone, values, taboos,
///     examples).
///   - `builderAgentVersion` — версия экстрактора (для воспроизводимости).
///
/// Daily-cron `brand-voice-extractor.cron` пересобирает профиль из brand_corpus
/// документов + brand_principle блоков. Профиль extract'ится только при
/// ≥ BRAND_VOICE_MIN_CORPUS_SIZE документов в корпусе.
model BrandVoiceProfile {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  toneJson            Json?
  valuesJson          Json?
  taboosJson          Json?
  exampleArtifactIds  String[]  @default([])
  version             Int       @default(1)
  lastBuiltAt         DateTime?
  builderAgentVersion String?   @db.VarChar(40)
  completeness        Decimal   @default(0) @db.Decimal(4, 3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("brand_voice_profiles")
}

/// RoleProfile — материализованный кеш "карта должности" (observed-форма).
/// Один RoleProfile на Role. Создаётся автоматически при создании Role
/// (через RolesService); наполняется RoleProfileAgent (Фаза 0d).
model RoleProfile {
  id                  String            @id @default(cuid())
  tenantId            String
  roleId              String            @unique
  /// `{ responsibilities[], skills[], decision_patterns[], common_pitfalls[], style_profile }`.
  /// Schema валидируется zod'ом в `role-profile.service.ts` (Фаза 0d).
  /// SBA α-8 wave 2: summaryCache остаётся как быстрый JSON-кеш для UI;
  /// канонические данные живут в нормализованных таблицах ResponsibilityElement /
  /// AuthorityBoundary / RequiredKnowledge / DecisionPolicy / Interaction.
  summaryCache        Json              @default("{}")
  status              RoleProfileStatus @default(forming)
  lastBuildAt         DateTime?
  /// Инкрементируется при каждой успешной пересборке. Используется в
  /// idempotency-key BullMQ ('role-profile:${roleId}:${buildVersion}').
  buildVersion        Int               @default(0)
  /// SBA α-8 wave 2 (2026-05-23) — метаданные сборки.
  /// Когда RoleProfileAgent последний раз построил профиль (отличается от
  /// `updatedAt` — последнее изменение записи, например ручная правка summaryCache).
  builtAt             DateTime?
  /// Версия билдера (для воспроизводимости и поэтапного re-build).
  builderAgentVersion String?           @db.VarChar(40)
  /// Сколько IdeaBlock-наблюдений использовалось для последнего билда.
  observationCount    Int               @default(0)
  /// 0..1 — насколько полно заполнены 9 слотов профиля. NULL до первого билда.
  completeness        Decimal?          @db.Decimal(4, 3)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  org  Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("role_profiles")
}

// ──────────────────────────── SBA α-8 wave 2 — Role Map нормализованные таблицы ────────────────────────────

/// ResponsibilityElement — элемент ответственности роли (Кора v2 §α-8).
/// Самореференция через parentId позволяет иерархию outcome → function →
/// activity. На верхнем уровне — outcome (что должно случиться), глубже —
/// function (какую работу делает), листья — activity (конкретные действия).
model ResponsibilityElement {
  id             String    @id @default(cuid())
  tenantId       String
  roleId         String
  parentId       String?
  /// kind: 'outcome' | 'function' | 'activity'. Строкой для расширения.
  kind           String    @db.VarChar(20)
  /// Краткое название элемента (1-7 слов).
  name           String    @db.VarChar(300)
  /// Полное описание (что/зачем/как измеряется).
  description    String?   @db.Text
  /// Порядок отображения в карте роли.
  order          Int       @default(0)
  /// IdeaBlock-источники последнего извлечения (provenance).
  sourceBlockIds String[]  @default([])
  /// Confidence от RoleProfileAgent (0..1).
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org             Org                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            Role                    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  parent          ResponsibilityElement?  @relation("ResponsibilityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        ResponsibilityElement[] @relation("ResponsibilityHierarchy")
  /// SBA α-8 wave 3 — Metric'ы, привязанные к этому элементу ответственности (KPI).
  attachedMetrics Metric[]

  @@index([tenantId, roleId])
  @@index([tenantId, roleId, kind])
  @@index([parentId])
  @@map("responsibility_elements")
}

/// AuthorityBoundary — границы полномочий должности: «что разрешено» и «что
/// требует согласования». Используется в γ-2 Concierge и β-3 Decisions для
/// validate «может ли этот человек принять X решение».
model AuthorityBoundary {
  id             String    @id @default(cuid())
  tenantId       String
  roleId         String
  /// kind: 'allowed' | 'requires_approval' | 'forbidden'.
  kind           String    @db.VarChar(40)
  /// Что разрешено/запрещено (бизнес-описание).
  scope          String    @db.Text
  /// Если requires_approval — кто approver (roleId).
  approverRoleId String?
  /// Пороги (например, бюджет в рублях). JSON для гибкости.
  thresholdsJson Json?
  sourceBlockIds String[]  @default([])
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org          Org   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role  @relation("AuthorityBoundaryRole", fields: [roleId], references: [id], onDelete: Cascade)
  approverRole Role? @relation("AuthorityBoundaryApprover", fields: [approverRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId, roleId])
  @@index([tenantId, kind])
  @@map("authority_boundaries")
}

/// RequiredKnowledge — что должен знать человек на этой должности (γ-1 SkillProfile
/// сверяется с этим для gap-detection). Различает «обязательно» и «желательно».
model RequiredKnowledge {
  id             String    @id @default(cuid())
  tenantId       String
  roleId         String
  /// Тема знания (например «SQL», «техника продаж SPIN», «бюджетирование»).
  topic          String    @db.VarChar(300)
  description    String?   @db.Text
  /// 'mandatory' | 'preferred' | 'nice_to_have'.
  importance     String    @db.VarChar(20)
  /// Уровень владения: 'beginner' | 'intermediate' | 'expert'.
  expectedLevel  String?   @db.VarChar(20)
  sourceBlockIds String[]  @default([])
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org  Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId, roleId])
  @@index([tenantId, roleId, importance])
  @@map("required_knowledge")
}

/// DecisionPolicy — правило принятия решения, привязанное к роли. Когда β-3
/// Specialist Decisions фиксирует решение, он может ссылаться на эту policy
/// через Decision.appliedPolicyId — для аудита соответствия.
model DecisionPolicy {
  id                   String    @id @default(cuid())
  tenantId             String
  roleId               String
  /// Краткое имя политики (например «лимит на скидку», «утверждение KP > 500к»).
  name                 String    @db.VarChar(300)
  /// Условия применения (когда срабатывает).
  conditionDescription String?   @db.Text
  /// Что делать (как принимать решение).
  ruleDescription      String    @db.Text
  /// Опц. ссылка на Regulation, формализующий эту политику.
  regulationId         String?
  sourceBlockIds       String[]  @default([])
  confidence           Decimal?  @db.Decimal(4, 3)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  org                Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role               Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  regulation         Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  /// SBA β-3 доделка: Decisions, применившие эту политику.
  appliedToDecisions Decision[]  @relation("DecisionAppliedPolicy")

  @@index([tenantId, roleId])
  @@map("decision_policies")
}

/// Interaction — типовое взаимодействие роли с другими ролями / отделами /
/// внешними участниками. Используется в γ-3 CrossFunctional для построения
/// карты handoff'ов и в β-8 для PersonalRelation patterns.
model Interaction {
  id                      String    @id @default(cuid())
  tenantId                String
  roleId                  String
  /// С кем взаимодействует: ровно одно из них заполнено.
  counterpartRoleId       String?
  counterpartDepartmentId String?
  /// Free-text если counterpart — внешний (клиент, поставщик, регулятор).
  counterpartExternal     String?   @db.VarChar(300)
  /// Тип взаимодействия: 'reports_to' | 'collaborates_with' | 'delegates_to' |
  /// 'receives_handoff_from' | 'escalates_to' | 'customer_facing' | …
  kind                    String    @db.VarChar(40)
  /// Частота: 'daily' | 'weekly' | 'monthly' | 'ad_hoc'.
  frequency               String?   @db.VarChar(20)
  description             String?   @db.Text
  sourceBlockIds          String[]  @default([])
  confidence              Decimal?  @db.Decimal(4, 3)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  org                   Org         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                  Role        @relation("InteractionRole", fields: [roleId], references: [id], onDelete: Cascade)
  counterpartRole       Role?       @relation("InteractionCounterpartRole", fields: [counterpartRoleId], references: [id], onDelete: SetNull)
  counterpartDepartment Department? @relation("InteractionCounterpartDept", fields: [counterpartDepartmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, roleId])
  @@index([tenantId, counterpartRoleId])
  @@index([tenantId, kind])
  @@map("interactions")
}

// ──────────────────────────── группа Б: каркас 5 уровней (без UI в Фазе 0) ────────────────────────────

/// Mission — «зачем» компании (Фаза 0a, группа Б). UI в Фазе γ.
/// Наполняется UI-формой в γ; в Фазе 0 поле существует, extraction отключен
/// флагом `EXTRACTION_ENABLE_TOP_LEVEL=false` (зонтичный ТЗ §6 решение #11).
model Mission {
  id         String      @id @default(cuid())
  tenantId   String
  contentMd  String      @db.Text
  markets    Json?
  bets       Json?
  horizon    GoalHorizon @default(strategic)
  targetDate DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("missions")
}

/// Vision — образ будущего компании (Фаза 0a, группа Б). UI в Фазе γ.
model Vision {
  id           String    @id @default(cuid())
  tenantId     String
  contentMd    String    @db.Text
  horizonYears Int?
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("visions")
}

/// Strategy — стратегия (рынки + ставки) (Фаза 0a, группа Б). UI в Фазе γ.
model Strategy {
  id         String      @id @default(cuid())
  tenantId   String
  contentMd  String      @db.Text
  markets    Json        @default("[]")
  bets       Json        @default("[]")
  horizon    GoalHorizon @default(strategic)
  targetDate DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("strategies")
}

// ──────────────────────────── SBA α-9 wave 2 — Company Foundation ────────────────────────────

/// CompanyProfile — единая 1:1 запись о компании (Org). Заменяет тройку
/// Mission/Vision/Strategy: контент остаётся в JSON-полях для гибкости (UI в γ),
/// но точкой правды становится этот профиль.
///
/// Старые модели Mission/Vision/Strategy остаются для backward-compat
/// (deprecated). Миграция данных — patch-script в α-9 wave 3.
model CompanyProfile {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  /// Краткое имя компании (для UI).
  displayName        String?   @db.VarChar(300)
  /// Миссия: { contentMd, horizon, targetDate? }. JSON для упрощения миграции
  /// из Mission и расширения новыми полями без alter table.
  missionJson        Json?
  /// Видение: { contentMd, horizonYears, targetDate? }.
  visionJson         Json?
  /// Стратегия: { contentMd, markets[], bets[], horizon, targetDate? }.
  strategyJson       Json?
  /// Target markets (Market.id[]) — для δ-1 Orchestrator и β-7 BrandVoice.
  targetMarketIds    String[]  @default([])
  /// Уровень зрелости (0..1) — рассчитывается MaturityScorerCron как
  /// взвешенное completeness по 8 базовым FunctionalDomain'ам.
  maturityScore      Decimal?  @db.Decimal(4, 3)
  /// Когда последний раз пересчитывался maturityScore.
  lastMaturityCalcAt DateTime?
  /// Краткое описание стадии (early-stage / growth / scale / enterprise).
  stage              String?   @db.VarChar(40)
  sourceBlockIds     String[]  @default([])
  /// Confidence от extraction-LLM (для агентского билда из встреч).
  confidence         Decimal?  @db.Decimal(4, 3)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("company_profiles")
}

/// FunctionalDomain — функциональная область деятельности компании
/// (Маркетинг, Продажи, Разработка, HR, Финансы, …). Дерево через parentDomainId.
/// Авто-расширяется domain-expander.cron при обнаружении unmatched тем.
///
/// Используется как ось FUNCTIONAL в AxisClassifierService (α-3 wave 3) и
/// для MaturityScorerCron (взвешенное completeness по доменам).
model FunctionalDomain {
  id             String    @id @default(cuid())
  tenantId       String
  parentDomainId String?
  name           String    @db.VarChar(200)
  /// Краткое описание области.
  description    String?   @db.Text
  /// Иконка для UI (lucide icon name).
  iconName       String?   @db.VarChar(60)
  /// `slug` — нормализованный идентификатор для запросов (`sales`, `r-and-d`).
  slug           String    @db.VarChar(80)
  /// Системные дефолтные домены (seed) vs пользовательские (auto-expanded).
  isSystem       Boolean   @default(false)
  /// 0..1 — насколько у компании прокачана эта область (по объёму извлечённых
  /// знаний / процессов / решений в этом домене).
  completeness   Decimal?  @db.Decimal(4, 3)
  /// Порядок отображения.
  order          Int       @default(0)
  /// Confidence для auto-expanded доменов (от LLM-классификатора).
  confidence     Decimal?  @db.Decimal(4, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  org             Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          FunctionalDomain?      @relation("FunctionalDomainHierarchy", fields: [parentDomainId], references: [id], onDelete: SetNull)
  children        FunctionalDomain[]     @relation("FunctionalDomainHierarchy")
  departmentLinks DepartmentDomainLink[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentDomainId])
  @@index([tenantId, isSystem])
  @@map("functional_domains")
}

/// DepartmentDomainLink — m:n связь Department ↔ FunctionalDomain.
/// Один отдел может покрывать несколько доменов (HR-отдел: «найм» + «обучение»);
/// один домен может быть распределён между несколькими отделами (BizDev в Sales
/// и в Marketing).
model DepartmentDomainLink {
  id            String   @id @default(cuid())
  tenantId      String
  departmentId  String
  domainId      String
  /// Какая доля domain-активности приходится на этот отдел (0..1). Сумма по
  /// всем отделам для одного домена должна быть ~1; на расхождения реагирует
  /// MaturityScorerCron.
  coverageRatio Decimal? @db.Decimal(4, 3)
  /// 'primary' (главный owner) | 'secondary' | 'supporting'.
  role          String   @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org        Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  domain     FunctionalDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([departmentId, domainId])
  @@index([tenantId, domainId])
  @@index([tenantId, departmentId])
  @@map("department_domain_links")
}

/// Process — бизнес-процесс компании (Фаза 0a, группа Б). UI в Фазе γ.
///
/// Наполняется BlockExtractionService (Фаза 0b) с дедупом через
/// EntityResolutionService. `confidence` — точность LLM-классификации;
/// `ambiguousTypes` — если LLM колебалась (например, Process vs Regulation),
/// сохраняем оба варианта для CuratorAgent в Фазе δ.
model Process {
  id                 String                       @id @default(cuid())
  tenantId           String
  name               String                       @db.VarChar(300)
  description        String?                      @db.Text
  ownerRoleId        String?
  ownerPersonId      String?
  triggerDescription String?                      @db.Text
  slaMinutes         Int?
  status             ProcessStatus                @default(active)
  /// 0..1 — confidence от extraction-LLM (Фаза 0b §6.2).
  confidence         Float?
  /// Если LLM колеблется (Process vs Regulation/Policy) — список альтернатив.
  ambiguousTypes     String[]                     @default([])
  /// SBA α-7 — расширение Фазы 0b (in-place, без новой таблицы Regulation.kind).
  /// `entityId` — связка с графом (опц., создаётся, когда специалист 3.1 канонизирует процесс).
  entityId           String?                      @unique
  /// `scope` — область действия: 'org' | 'department:<id>' | 'role:<id>' | 'project:<id>'.
  scope              String?                      @db.VarChar(120)
  /// `currentVersionId` → CardVersion, последняя одобренная триажем версия.
  currentVersionId   String?
  /// `sourceBlockIds[]` — IdeaBlock-источники последнего извлечения / merge'а.
  sourceBlockIds     String[]                     @default([])
  /// `personSubjectIds[]` — Person'ы, которым процесс присвоен как subject (для γ-1 SkillProfile).
  personSubjectIds   String[]                     @default([])
  dataClass          DataClass                    @default(internal)
  /// Эмбеддинг (name + первый абзац description) — для KNN-дедупа в Specialist31Service.
  embedding          Unsupported("vector(1536)")?
  /// Когда последний раз процесс подтверждался (auto после canonical или вручную куратором).
  lastConfirmedAt    DateTime?
  /// SBA α-7 — структурированный ввод/вывод процесса (см. sub-TZ §4).
  /// `inputs/outputs/metricsJson` — JSON-массивы / объекты, заполняются LLM
  /// `process-steps-extract` или вручную через `POST /regulations/:id/edit` (γ).
  /// `metricsJson` намеренно НЕ называется `metrics`, чтобы не конфликтовать с
  /// доменной моделью `Metric` (отдельная Phase 0b сущность).
  inputs             Json?
  outputs            Json?
  metricsJson        Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  /// SBA α-7 wave 2 (2026-05-23) — instance может ссылаться на canonical template.
  templateId String?

  org            Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerRole      Role?            @relation("ProcessOwnerRole", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  ownerPerson    Person?          @relation("ProcessOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  steps          ProcessStep[]
  /// SBA α-7 — связь с CardVersion (текущая активная версия).
  currentVersion CardVersion?     @relation("ProcessCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// SBA α-7 wave 2 — опц. библиотечный template, из которого instance создан.
  template       ProcessTemplate? @relation("ProcessFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  /// Уникальность гарантируется EntityResolutionService + cosine + LLM-arbiter (0b §8).
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, ownerRoleId])
  @@index([tenantId, scope])
  @@index([tenantId, templateId])
  @@index([currentVersionId])
  @@map("processes")
}

/// ProcessTemplate — библиотечный шаблон процесса (SBA α-7).
///
/// Решение «template vs instance»: существующий `Process` остаётся как
/// runtime-instance конкретного процесса компании; `ProcessTemplate` — это
/// канонический шаблон (например, «стандартный sales cycle», «hire process»).
/// `Process.templateId` — опц. ссылка из instance на template.
///
/// Источники: специалист 3.1 Regulations извлекает template'ы из документов
/// и встреч; куратор апрувит публикацию в библиотеку.
model ProcessTemplate {
  id                   String                       @id @default(cuid())
  tenantId             String
  name                 String                       @db.VarChar(300)
  summary              String?                      @db.Text
  /// Категория шаблона: 'hire' | 'sales' | 'incident' | 'onboarding' | 'release' | 'custom'.
  /// Строкой, чтобы расширять без миграций.
  category             String?                      @db.VarChar(60)
  /// Где применяется: 'org' | 'department:<id>' | 'role:<id>'.
  scope                String?                      @db.VarChar(120)
  status               ProcessStatus                @default(active)
  /// Последняя одобренная версия (Editor → Curator → publish).
  currentVersionId     String?
  ownerRoleId          String?
  ownerPersonId        String?
  /// IdeaBlock-источники последнего обновления template (provenance).
  sourceBlockIds       String[]                     @default([])
  dataClass            DataClass                    @default(internal)
  embedding            Unsupported("vector(1536)")?
  lastConfirmedAt      DateTime?
  metadata             Json?
  /// SBA γ-3 — флаг «сквозного» процесса (cross-functional). Auto-computed
  /// детектором: `crossFunctionalScore = unique_departments / total_steps >= threshold`.
  isCrossFunctional    Boolean                      @default(false)
  /// SBA γ-3 — числовая метрика «сквозности» (0..1). NULL до первого расчёта.
  crossFunctionalScore Decimal?                     @db.Decimal(4, 3)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?

  org                            Org                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentVersion                 ProcessTemplateVersion?         @relation("TemplateCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions                       ProcessTemplateVersion[]        @relation("TemplateVersions")
  ownerRole                      Role?                           @relation("ProcessTemplateOwnerRole", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  ownerPerson                    Person?                         @relation("ProcessTemplateOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  instances                      Process[]                       @relation("ProcessFromTemplate")
  decisionPoints                 DecisionPoint[]
  handoffsFrom                   ProcessHandoff[]                @relation("HandoffFromTemplate")
  handoffsTo                     ProcessHandoff[]                @relation("HandoffToTemplate")
  /// SBA γ-3 — отчёты «process_friction» по этому шаблону.
  crossFunctionalFrictionReports CrossFunctionalFrictionReport[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, scope])
  @@index([tenantId, isCrossFunctional])
  @@map("process_templates")
}

/// SBA γ-3 — CrossFunctionalFrictionReport. Сворачивает `process_friction`
/// блоки + ProcessHandoff с slaViolations в единый отчёт по cross-functional
/// процессу. Создаётся cron'ом (daily 05:00) и при manual resolve обновляется.
model CrossFunctionalFrictionReport {
  id                    String    @id @default(cuid())
  tenantId              String
  processTemplateId     String
  /// Severity: 'low' | 'medium' | 'high' — текстом, чтобы расширять без миграций.
  severity              String    @db.VarChar(20)
  /// Человекочитаемое описание friction (что именно тормозит и где).
  description           String    @db.Text
  /// Источники: IdeaBlock-id'ы с signalType='process_friction'.
  sourceBlockIds        String[]  @default([])
  /// Какие отделы вовлечены (Department.id[]) — для UI-визуализации.
  involvedDepartmentIds String[]  @default([])
  /// Рекомендованное действие (LLM-summary или manual). Опц.
  recommendedAction     String?   @db.Text
  /// Когда закрыли отчёт. NULL → активный.
  resolvedAt            DateTime?
  /// Кто закрыл (User.id).
  resolvedByUserId      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org             Org             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processTemplate ProcessTemplate @relation(fields: [processTemplateId], references: [id], onDelete: Cascade)

  @@index([tenantId, severity, resolvedAt])
  @@index([tenantId, processTemplateId])
  @@map("cross_functional_friction_reports")
}

/// ProcessTemplateVersion — версионируемый snapshot шаблона. Содержит полное
/// определение (шаги + decision points + handoffs) в JSON. Версии иммутабельны
/// после публикации; обновление = новая версия.
model ProcessTemplateVersion {
  id             String    @id @default(cuid())
  tenantId       String
  templateId     String
  /// Версия: монотонно возрастающее целое от 1 на template.
  version        Int
  /// Полное определение версии: { steps: [...], decisionPoints: [...], handoffs: [...] }.
  definitionJson Json
  /// Кто опубликовал.
  publishedById  String?
  publishedAt    DateTime?
  /// Источник: 'manual' | 'agent' (auto-extracted by Specialist 3.1) | 'imported'.
  source         String    @db.VarChar(40)
  /// Краткие changelog/diff'ы к предыдущей версии.
  changeNote     String?   @db.Text
  createdAt      DateTime  @default(now())

  org         Org               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template    ProcessTemplate   @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentOf   ProcessTemplate[] @relation("TemplateCurrentVersion")
  publishedBy User?             @relation("ProcessTemplateVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([templateId, version])
  @@index([tenantId, templateId])
  @@map("process_template_versions")
}

/// DecisionPoint — точка принятия решения внутри процесса. Связана с конкретным
/// `ProcessTemplate` (или с `ProcessStep` в legacy instance — поле опц.).
/// Используется специалистом 3.3 Decisions для cross-link «принятое решение в
/// рамках этого DecisionPoint».
model DecisionPoint {
  id              String   @id @default(cuid())
  tenantId        String
  templateId      String?
  /// Опц. ссылка на legacy ProcessStep (если решение зафиксировано в инстансе).
  processStepId   String?
  name            String   @db.VarChar(300)
  /// Условие, по которому проходит ветвление (естественный язык + опц. JSON).
  condition       String?  @db.Text
  /// Возможные ветви: [{name, description, leadsToStepId?}, …].
  branchesJson    Json
  /// Опц. дефолтная Role/Person, принимающая решение в этой точке.
  decidedByRoleId String?
  /// Порядок в process flow.
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      ProcessTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  processStep   ProcessStep?     @relation(fields: [processStepId], references: [id], onDelete: Cascade)
  decidedByRole Role?            @relation("DecisionPointDecider", fields: [decidedByRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId, templateId])
  @@index([tenantId, processStepId])
  @@map("decision_points")
}

/// ProcessHandoff — передача результата между процессами / шагами / ролями.
/// Используется специалистом γ-3 CrossFunctional Process для трекинга
/// межотдельных handoff'ов.
model ProcessHandoff {
  id                 String   @id @default(cuid())
  tenantId           String
  /// Опц. ссылки на источник передачи (template ИЛИ конкретный шаг).
  fromTemplateId     String?
  fromProcessStepId  String?
  fromRoleId         String?
  /// Опц. ссылки на получателя.
  toTemplateId       String?
  toProcessStepId    String?
  toRoleId           String?
  /// Тип handoff'а: 'document' | 'data' | 'decision' | 'physical' | 'notification'.
  kind               String   @db.VarChar(40)
  /// Что именно передаётся (артефакт, событие, документ).
  payloadDescription String?  @db.Text
  /// Ожидаемое SLA передачи (в часах).
  expectedSlaHours   Int?
  /// Зафиксированные конфликты handoff'а (через γ-3 process-friction signals).
  knownFrictionCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org             Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromTemplate    ProcessTemplate? @relation("HandoffFromTemplate", fields: [fromTemplateId], references: [id], onDelete: Cascade)
  toTemplate      ProcessTemplate? @relation("HandoffToTemplate", fields: [toTemplateId], references: [id], onDelete: Cascade)
  fromProcessStep ProcessStep?     @relation("HandoffFromStep", fields: [fromProcessStepId], references: [id], onDelete: SetNull)
  toProcessStep   ProcessStep?     @relation("HandoffToStep", fields: [toProcessStepId], references: [id], onDelete: SetNull)
  fromRole        Role?            @relation("HandoffFromRole", fields: [fromRoleId], references: [id], onDelete: SetNull)
  toRole          Role?            @relation("HandoffToRole", fields: [toRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind])
  @@index([tenantId, fromTemplateId])
  @@index([tenantId, toTemplateId])
  @@index([tenantId, fromRoleId])
  @@index([tenantId, toRoleId])
  @@map("process_handoffs")
}

/// ProcessStep — шаг процесса (Фаза 0a, группа Б).
model ProcessStep {
  id          String   @id @default(cuid())
  tenantId    String
  processId   String
  name        String   @db.VarChar(300)
  order       Int
  description String?  @db.Text
  slaMinutes  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org            Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  process        Process          @relation(fields: [processId], references: [id], onDelete: Cascade)
  /// SBA α-7 wave 2 — обратные связи DecisionPoint и ProcessHandoff.
  decisionPoints DecisionPoint[]
  handoffsFrom   ProcessHandoff[] @relation("HandoffFromStep")
  handoffsTo     ProcessHandoff[] @relation("HandoffToStep")

  @@unique([processId, order])
  @@index([tenantId, processId])
  @@map("process_steps")
}

/// Regulation — регламент / стандарт (Фаза 0a, группа Б).
/// `category=standard` через AGE-ребро `applies_to` ссылается на тип
/// артефакта (строка, динамическая онтология — γ).
model Regulation {
  id               String                       @id @default(cuid())
  tenantId         String
  name             String                       @db.VarChar(300)
  contentMd        String                       @db.Text
  category         RegulationCategory           @default(regulation)
  status           ProcessStatus                @default(active)
  version          Int                          @default(1)
  confidence       Float?
  /// SBA α-7 — расширение Фазы 0b (in-place; см. sub-TZ §14.3).
  /// `entityId` — связка с графом.
  entityId         String?                      @unique
  /// `statement` — структурированная суть регламента / стандарта.
  /// Альтернатива `contentMd` (markdown остаётся для отображения, statement —
  /// для дедупа / chat-v2 retrieval). На α-7 заполняется LLM `regulation-extract`.
  statement        String?                      @db.Text
  /// `scope` — область действия: 'org' | 'department:<id>' | 'role:<id>' | 'project:<id>'.
  scope            String?                      @db.VarChar(120)
  /// FK на Person — назначенный ответственный за регламент.
  ownerPersonId    String?
  /// Self-relation для версионирования (новая запись «заменяет» старую).
  supersedesId     String?
  /// FK на CardVersion (последняя активная версия после triage).
  currentVersionId String?
  /// `sourceBlockIds[]` — IdeaBlock-источники последнего извлечения.
  sourceBlockIds   String[]                     @default([])
  /// `personSubjectIds[]` — Person'ы, которым регламент присвоен как subject (для γ-1 SkillProfile).
  personSubjectIds String[]                     @default([])
  dataClass        DataClass                    @default(internal)
  /// Эмбеддинг (name + statement) — для KNN-дедупа.
  embedding        Unsupported("vector(1536)")?
  lastConfirmedAt  DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  org              Org              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerPerson      Person?          @relation("RegulationOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  supersedes       Regulation?      @relation("RegulationSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     Regulation[]     @relation("RegulationSupersedes")
  currentVersion   CardVersion?     @relation("RegulationCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// SBA α-8 wave 2 — обратная связь DecisionPolicy.
  decisionPolicies DecisionPolicy[]

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([tenantId, scope])
  @@index([tenantId, ownerPersonId])
  @@index([currentVersionId])
  @@map("regulations")
}

/// Policy — политика (Фаза 0a, группа Б). UI в Фазе α-7.
model Policy {
  id               String                       @id @default(cuid())
  tenantId         String
  name             String                       @db.VarChar(300)
  contentMd        String                       @db.Text
  severity         PolicySeverity               @default(advisory)
  status           ProcessStatus                @default(active)
  confidence       Float?
  /// SBA α-7 — расширение Фазы 0b (in-place).
  entityId         String?                      @unique
  scope            String?                      @db.VarChar(120)
  ownerPersonId    String?
  currentVersionId String?
  sourceBlockIds   String[]                     @default([])
  personSubjectIds String[]                     @default([])
  dataClass        DataClass                    @default(internal)
  /// Эмбеддинг (name + contentMd preview) — для KNN-дедупа.
  embedding        Unsupported("vector(1536)")?
  lastConfirmedAt  DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  org            Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerPerson    Person?      @relation("PolicyOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  currentVersion CardVersion? @relation("PolicyCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId, severity])
  @@index([tenantId, status])
  @@index([tenantId, scope])
  @@index([tenantId, ownerPersonId])
  @@index([currentVersionId])
  @@map("policies")
}

/// Tool — инструмент / система / шаблон (Фаза 0a, группа Б).
model Tool {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   @db.VarChar(200)
  kind        ToolKind @default(software)
  externalUrl String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tools")
}

/// Metric — метрика (Фаза 0a, группа Б).
model Metric {
  id          String          @id @default(cuid())
  tenantId    String
  name        String          @db.VarChar(200)
  description String?         @db.Text
  unit        String          @db.VarChar(50)
  target      Float?
  valueType   MetricValueType @default(count)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  /// SBA α-8 wave 3 (2026-05-23) — KPI расширение Metric.
  /// Metric становится KPI, когда заполнен хотя бы один из `attachedTo*Id`.
  /// См. sub-ТЗ plans/tz/2026-05-23-sba-alpha-8-wave3-appointment-kpi.md §5.
  attachedToResponsibilityElementId String?
  attachedToRoleId                  String?
  attachedToDepartmentId            String?
  /// Текущее значение KPI (последнее измерение). Обновляется через PATCH /kpi/:id/measurement.
  currentValue                      Decimal?  @db.Decimal(18, 4)
  /// Единица текущего значения (может отличаться от `unit` базы, например % vs шт.).
  currentValueUnit                  String?   @db.VarChar(50)
  /// Когда последний раз обновляли currentValue.
  lastMeasuredAt                    DateTime?
  /// Периодичность обновления: 'daily' | 'weekly' | 'monthly' | 'quarterly' | 'adhoc'.
  frequency                         String?   @db.VarChar(20)

  org                   Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SBA α-8 wave 3 — KPI relations.
  responsibilityElement ResponsibilityElement? @relation(fields: [attachedToResponsibilityElementId], references: [id], onDelete: SetNull)
  attachedRole          Role?                  @relation("MetricToRole", fields: [attachedToRoleId], references: [id], onDelete: SetNull)
  attachedDepartment    Department?            @relation("MetricToDepartment", fields: [attachedToDepartmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId])
  /// SBA α-8 wave 3 — KPI lookup-индексы.
  @@index([tenantId, attachedToRoleId])
  @@index([tenantId, attachedToDepartmentId])
  @@index([tenantId, attachedToResponsibilityElementId])
  @@map("metrics")
}

/// Decision — решение, принятое в компании.
///
/// Фаза 0a (legacy): простая запись со `text`, `decidedByPersonId`, `sourceIdeaBlockId`.
///
/// SBA β-3 — расширение in-place до полноценного «реестра решений» с rationale,
/// alternatives, supersede-цепочками, evolving-конфликтами и probe-triggers.
/// См. plans/tz/2026-05-21-sba-beta-3-specialist-3-3-decisions.md §4.
///
/// Все новые Decision'ы создаются специалистом 3.3 (decision-detector worker)
/// со `statement` (структурированная суть решения), `rationale` (почему),
/// `alternatives` (рассмотренные варианты), `decidedByPersonIds[]` (авторы),
/// `affectsEntityIds[]` (Project/Customer/Vendor/Product на которые влияет),
/// `supersedesId` (если новая версия старого), `validFrom/validUntil` (для
/// evolving-резолюции).
///
/// Legacy-поля (text, decidedByPersonId, sourceMeetingId, sourceIdeaBlockId)
/// оставлены nullable для обратной совместимости. Новые Decision'ы пишут
/// `statement` (а `text` дублирует первые 1000 символов для legacy-чтения).
model Decision {
  id       String @id @default(cuid())
  tenantId String

  // ── legacy Фазы 0a (оставлены для совместимости; в β-3 необязательны) ──
  /// @deprecated SBA β-3: используй `statement`. Заполняется автоматически
  /// для обратной совместимости (первые 1000 символов из `statement`).
  text              String? @db.Text
  /// Legacy: один decidedByPerson. В β-3 — `decidedByPersonIds[]` (массив).
  decidedByPersonId String?
  /// Legacy: один источник встречи. В β-3 — берём из sourceBlockIds + RawEvent.
  sourceMeetingId   String?
  /// Legacy: один блок-источник. В β-3 — `sourceBlockIds[]` (массив).
  sourceIdeaBlockId String? @unique

  // ── SBA β-3 — Specialist 3.3 (Decisions Registry) ──
  /// Связка с графом (создаётся при canonical). Уникален — один Entity на Decision.
  entityId           String?                      @unique
  /// Структурированная суть решения. Главное поле для дедупа и retrieval'а.
  statement          String?                      @db.Text
  /// Почему так решили — главный источник для Skill (γ-1) и Insights (β-4).
  rationale          String?                      @db.Text
  /// Json-массив рассмотренных альтернатив: [{ option: '...', reasonRejected: '...' }, ...].
  /// Решение по §14.2: массив Json пока, отдельная таблица — γ+.
  alternatives       Json?
  /// Авторы решения (Person.id[]). Решение по §14.1: массив с GIN, join-таблица — γ+.
  decidedByPersonIds String[]                     @default([])
  /// Когда решение было принято (отдельно от createdAt — может быть исторический import).
  decidedAt          DateTime?
  /// Срок исполнения. probe `decision.overdue` если deadline < now AND status NOT IN
  /// ('implemented','cancelled').
  deadline           DateTime?
  /// Self-relation supersede: если этот Decision — новая версия старого.
  supersedesId       String?
  /// Entities (Customer/Project/Vendor/Product/Process), на которые влияет решение.
  /// Массив с GIN — §14.1 (миграция в join-таблицу γ+).
  affectsEntityIds   String[]                     @default([])
  /// IdeaBlock'и, на которых построено решение.
  sourceBlockIds     String[]                     @default([])
  /// Person'ы, упомянутые в блоках как subject (для γ-1 SkillProfile).
  personSubjectIds   String[]                     @default([])
  /// Уверенность извлечения [0..1] (Decimal(4,3) — 3 знака после точки).
  confidence         Decimal?                     @db.Decimal(4, 3)
  /// Класс данных. Default 'sensitive' — решения чаще всего стратегические.
  dataClass          DataClass                    @default(sensitive)
  /// Последняя активная CardVersion (после triage).
  currentVersionId   String?
  /// Эмбеддинг (statement + rationale preview) — для KNN-дедупа.
  embedding          Unsupported("vector(1536)")?
  /// Для evolving: с какого момента решение действительно.
  validFrom          DateTime?
  /// Для evolving: до какого момента (если superseded — заполняется в момент supersede).
  validUntil         DateTime?
  /// Фактические результаты (заполняется ретроспективно).
  /// probe `decision.outcome_unknown` если implemented + null + > 3 мес.
  actualOutcomes     String?                      @db.Text
  /// SBA β-3 доделка (2026-05-23): FK на DecisionPolicy (α-8 wave 2).
  /// Если решение применяет конкретную политику — ссылка для аудита соответствия.
  appliedPolicyId    String?

  status          DecisionStatus @default(approved)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Когда решение последний раз подтверждали (актуально, не устарело).
  lastConfirmedAt DateTime?

  org             Org             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decidedBy       Person?         @relation("DecisionDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: SetNull)
  sourceMeeting   Meeting?        @relation("DecisionSourceMeeting", fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  sourceIdeaBlock IdeaBlock?      @relation(fields: [sourceIdeaBlockId], references: [id], onDelete: SetNull)
  // SBA β-3: self-relation supersede + CardVersion-current.
  supersedes      Decision?       @relation("DecisionSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    Decision[]      @relation("DecisionSupersedes")
  currentVersion  CardVersion?    @relation("DecisionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  appliedPolicy   DecisionPolicy? @relation("DecisionAppliedPolicy", fields: [appliedPolicyId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, decidedAt])
  @@index([tenantId, decidedByPersonId])
  // SBA β-3 — для overdue probe.
  @@index([tenantId, deadline])
  // SBA β-3 — для supersede-chain lookup.
  @@index([supersedesId])
  // SBA β-3 — для currentVersionId.
  @@index([currentVersionId])
  @@map("decisions")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA β-4 — Specialist 3.5 (Insights Radar)
// Источник: plans/tz/2026-05-21-sba-beta-4-specialist-3-5-insights.md §4
//
// Idea: повторяющиеся pain/risk/churn_risk/objection блоки кластеризуются в
// Insight (KNN cosine). Динамика считается по rolling-окнам (7d vs 30d).
// Linking с Decision: «эта проблема — следствие решения X» (relatedDecisionIds[]).
// ─────────────────────────────────────────────────────────────────────────
model Insight {
  id       String  @id @default(cuid())
  tenantId String
  /// Опциональная связка с графом (создаётся при canonical). Уникален.
  entityId String? @unique

  /// Тип сигнала. Сопоставляется с signalType блоков-источников.
  kind      InsightKind
  /// Суть сигнала одной строкой («Клиенты жалуются на медленную загрузку отчётов»).
  statement String          @db.Text
  /// Острота сигнала. severity='critical' → triage с заведомо низкой confidence
  /// (force deep review).
  severity  InsightSeverity @default(medium)

  /// Частота упоминаний за окно (нормализованная 0..1; считает Specialist35Service.recalcMetrics).
  frequencyScore Decimal        @default(0) @db.Decimal(6, 3)
  /// Сырое значение ratio 7d_count / 30d_avg_weekly. > spike-порога → spike.
  dynamicScore   Decimal        @default(0) @db.Decimal(6, 3)
  /// Текстовая метка динамики (для UI и сортировки радара).
  dynamicLabel   InsightDynamic @default(stable)

  /// Entities (Customer/Project/Vendor/Product/Process/...) на которые влияет сигнал.
  affectedEntityIds  String[] @default([])
  /// Decision'ы, которые могли спровоцировать сигнал (linking через LLM и
  /// существующий IdeaBlockLink.relationType='consequences_of').
  relatedDecisionIds String[] @default([])
  /// Текстовый план реагирования (в β-4 — текст; структурируем в γ+).
  mitigationPlan     String?  @db.Text
  /// SBA β-4 доделка (2026-05-23): категория первопричины (LLM ставит,
  /// curator подтверждает). Строкой для гибкости. Примеры:
  /// 'process_gap' | 'tooling' | 'role_skill' | 'communication' | 'priority' |
  /// 'resource_constraint' | 'external' | 'unknown'.
  /// Используется в δ-2 ProactiveWatcher для приоритизации alert'ов и в
  /// γ-2 Concierge для агрегации «частые причины проблем».
  causeCategory      String?  @db.VarChar(40)

  /// Первое и последнее упоминание (для probe.no_mitigation_plan по age > 7d).
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())

  /// Статус карточки.
  status InsightStatus @default(active)

  /// IdeaBlock'и, на которых построен сигнал.
  sourceBlockIds   String[]                     @default([])
  /// Person'ы, упомянутые в блоках как subject (например, кто жаловался).
  personSubjectIds String[]                     @default([])
  /// Уверенность extraction [0..1] (Decimal(4,3)).
  confidence       Decimal                      @default(0.5) @db.Decimal(4, 3)
  /// Класс данных. Default 'internal' (sub-ТЗ — Insight чаще про процесс,
  /// чем про конкретного человека).
  dataClass        DataClass                    @default(internal)
  /// Последняя активная CardVersion (после triage).
  currentVersionId String?
  /// Эмбеддинг (statement) — для KNN-кластеризации.
  embedding        Unsupported("vector(1536)")?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Когда последний раз подтверждали актуальность.
  lastConfirmedAt DateTime?

  org            Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentVersion CardVersion? @relation("InsightCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  // SBA β-4 — частые фильтры радара.
  @@index([tenantId, status, severity])
  @@index([tenantId, kind])
  @@index([tenantId, dynamicLabel])
  @@index([tenantId, lastObservedAt])
  // SBA β-4 wave 2 (2026-05-23) — фильтр виджета «Топ-5» Director Dashboard
  // и master-detail радара по категории первопричины.
  @@index([tenantId, causeCategory])
  // SBA β-4 — для currentVersionId.
  @@index([currentVersionId])
  @@map("insights")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA β-5 — Specialist 3.6 (Ideas Collector) + Layer 6 (Probe-Agent)
// Источник: plans/tz/2026-05-21-sba-beta-5-specialist-3-6-ideas-and-layer6-probe.md
//
// Idea: блоки signalType ∈ {idea, feature_request} кластеризуются в Idea
// (kind='internal' если предложил сотрудник, 'client_request' — если клиент).
// Cosine-KNN дедуп. Кластеры идей (IdeaCluster) — следующий уровень
// группировки смежных идей.
// ─────────────────────────────────────────────────────────────────────────

/// Вид идеи. `internal` — предложение сотрудника. `client_request` — запрос
/// клиента / партнёра, извлечённый из встречи / переписки.
enum IdeaKind {
  internal
  client_request
}

/// Статус Idea. Lifecycle: captured → in_discussion → accepted → in_progress →
/// shipped. Альтернативные исходы: rejected (отказались), archived (автор
/// withdrew или нерелевантно).
enum IdeaStatus {
  captured
  in_discussion
  accepted
  in_progress
  shipped
  rejected
  archived
}

/// Статус ProbeEvent. `pending` — создано, ждёт dispatcher'а. `dispatched` —
/// отправлено через ConversationalService. `dropped_dedup` / `dropped_rate_limit`
/// / `dropped_cold_start` — отброшено по соответствующей причине. `expired` —
/// истёк срок жизни (probe.expiresAt в прошлом).
enum ProbeStatus {
  pending
  dispatched
  dropped_dedup
  dropped_rate_limit
  expired
  dropped_cold_start
  /// W4.3 — outbound canEmit заблокировал доставку (и in_app fallback тоже rejected).
  /// Видно в `/admin/policy/dataclass` → «История нарушений».
  dropped_dataclass_gate
}

/// Idea — карточка идеи / запроса. SBA β-5 §4.1.
///
/// Аггрегирует supporter'ов (Person — сотрудники, Customer — клиенты) через
/// JSON-массив `supporters`. `weight` — композитный score:
/// `supporterCount * 1.0 + recency_factor * 0.5 + specificity_factor (0.5..1)`.
///
/// Closing loop: при изменении `status` (через REST API) специалист эмитит
/// EventEmitter событие 'idea.status_changed' → handler уведомляет supporter'ов.
model Idea {
  id                    String                       @id @default(cuid())
  tenantId              String
  /// Опц. связка с графом (создаётся при canonical). Уникален.
  entityId              String?                      @unique
  kind                  IdeaKind
  statement             String                       @db.Text
  rationale             String?                      @db.Text
  weight                Decimal                      @default(0) @db.Decimal(6, 3)
  supporterCount        Int                          @default(1)
  /// JSON-массив supporter'ов: `[{ kind: 'person'|'customer', entityId,
  /// firstSupportedAt: ISO, blockId? }, ...]`.
  supporters            Json                         @default("[]")
  firstProposedAt       DateTime                     @default(now())
  lastDiscussedAt       DateTime                     @default(now())
  status                IdeaStatus                   @default(captured)
  statusChangedAt       DateTime?
  statusChangedByUserId String?
  statusReason          String?                      @db.Text
  clusterId             String?
  sourceBlockIds        String[]                     @default([])
  personSubjectIds      String[]                     @default([])
  confidence            Decimal                      @default(0.5) @db.Decimal(4, 3)
  dataClass             DataClass                    @default(internal)
  currentVersionId      String?
  embedding             Unsupported("vector(1536)")?
  /// Author User.id — кто первый запостил блок-источник (если идея от
  /// сотрудника). NULL — клиентская идея или не определилось.
  createdByUserId       String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  org            Org          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cluster        IdeaCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  currentVersion CardVersion? @relation("IdeaCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, kind])
  @@index([tenantId, weight])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, clusterId])
  @@index([currentVersionId])
  @@map("ideas")
}

/// IdeaCluster — кластер смежных идей (как Theme для блоков). SBA β-5 §4.1.
///
/// Кластеризация через `idea-clusterer.cron`: KNN cosine на embedding'е
/// existing IdeaCluster'ов; на miss — LLM-арбитр (`idea-cluster-merge`).
/// Минимальный размер — `IDEA_MIN_SUPPORTERS_FOR_CLUSTER` (default 2).
model IdeaCluster {
  id            String                       @id @default(cuid())
  tenantId      String
  name          String
  description   String?                      @db.Text
  ideaIds       String[]                     @default([])
  clusterWeight Decimal                      @default(0) @db.Decimal(6, 3)
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  org   Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ideas Idea[]

  @@index([tenantId])
  @@map("idea_clusters")
}

/// ProbeEvent — запись очереди Probe-Agent (Слой 6). SBA β-5 §4.2.
///
/// Создаётся `ProbeService.suggest(...)` — внутренний API для специалистов
/// Слоя 3. После dedup / rate-limit / cold-start checks попадает в БД с
/// `status='pending'` и job в `core.probe-events`. Dispatcher выбирает
/// recipient'а, формулирует вопрос через LLM `probe-formulate`, отправляет
/// через `ConversationalService.sendNotification(eventType='probe.question')`.
///
/// `contentHash` — sha256(reason + JSON.stringify(payload.contextIds)) для
/// дедупа (Redis-кеш TTL=72h + DB-уникальность хеша в рамках tenant).
model ProbeEvent {
  id                       String      @id @default(cuid())
  tenantId                 String
  emittedByService         String      @db.VarChar(80)
  reason                   String      @db.VarChar(100)
  payload                  Json
  recipientCandidates      String[]    @default([])
  selectedRecipientId      String?
  status                   ProbeStatus @default(pending)
  dispatchedNotificationId String?
  contentHash              String      @db.VarChar(80)
  priority                 Int         @default(50)
  createdAt                DateTime    @default(now())
  dispatchedAt             DateTime?
  expiresAt                DateTime?
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass probe-payload'а
  /// (для compliance — мы храним вопрос-предложение, иногда чувствительный).
  dataClassAudit           Json?

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, emittedByService])
  @@index([contentHash])
  @@map("probe_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Фаза A.1 — Prompt Registry
// Источник: plans/tz/2026-05-21-phase-A-prompt-registry-admin.md §4
//
// Идея: все 9 системных промптов AI-отчёта (по типам встреч) + tasks /
// chapters / follow-up / card-rollup переезжают в БД как `PromptTemplate`
// с версионированием через `PromptTemplateVersion`. Файлы
// `backend/src/modules/ai/services/prompts/type-*.ts` остаются в коде
// как fallback и НЕ удаляются. Резолв и выбор источника промпта живёт
// в `PromptResolverService`.
// ─────────────────────────────────────────────────────────────────────────

/// Шаблон промпта AI-отчёта. Может быть системным (поставляется с Z) или
/// созданным Org-Admin'ом. В рамках Org `key` уникален; для system orgId=null
/// и `key` уникален глобально.
///
/// `activeVersionId` ссылается на текущую активную `PromptTemplateVersion`.
/// Менять активную версию — через `POST /admin/prompt-templates/:id/activate-version/:versionId`
/// (см. A.2). В A.1 endpoint'ов нет — только модель + seed.
model PromptTemplate {
  id              String               @id @default(cuid())
  scope           PromptTemplateScope
  /// NULL для scope='system'; обязателен для scope='org' (валидируется в сервисе).
  orgId           String?
  /// Уникальный slug, e.g. 'type-sales', 'tasks-default', 'custom-sales-deep-dive'.
  key             String
  name            String
  description     String?              @db.Text
  /// Если задан — шаблон используется только для этого типа встречи.
  /// NULL = универсальный (например, tasks/chapters/follow-up для всех типов).
  meetingType     MeetingType?
  /// Legacy LLM taskType: 'summary' | 'tasks' | 'chapters' | 'follow-up' | 'card-rollup'.
  /// Хранится как String, чтобы расширяться без миграций enum'а.
  taskType        String
  status          PromptTemplateStatus @default(draft)
  /// Текущая активная версия (FK на PromptTemplateVersion). NULL до первого save.
  activeVersionId String?              @unique
  /// Флаг safe-seed: true = шаблон редактировался админом, при повторном запуске seed'а
  /// не перезаписываем содержимое. Защита от потери ручных правок (skill `safe-seed-rules`).
  editedByAdmin   Boolean              @default(false)
  createdById     String
  createdBy       User                 @relation("PromptTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  org            Org?                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions       PromptTemplateVersion[] @relation("PromptTemplateVersions")
  activeVersion  PromptTemplateVersion?  @relation("PromptTemplateActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  /// Фаза E — дополнительные («custom») отчёты встреч, созданные по этому шаблону.
  /// onDelete=Restrict на стороне MeetingReport: история отчётов жива даже после
  /// архивирования шаблона.
  meetingReports MeetingReport[]         @relation("MeetingReportTemplate")

  @@unique([orgId, key])
  @@index([scope, status])
  @@index([orgId, status])
  @@index([taskType, meetingType, status])
}

/// Версия шаблона промпта. На каждое «Сохранить как новую версию» в UI A.2
/// создаётся новая запись. История версий используется для отката и
/// сравнения через diff в UI.
model PromptTemplateVersion {
  id            String   @id @default(cuid())
  templateId    String
  /// Целочисленный номер версии (1, 2, 3...). Уникален в рамках шаблона.
  versionNumber Int
  /// Общая часть промпта (шапка system-message).
  systemPrompt  String   @db.Text
  /// Ожидаемая JSON-схема ответа (для structured-вывода через tool_use).
  /// Может включать `properties`, `required` — формат совместим с LlmTool.input_schema.
  outputSchema  Json
  /// Имя tool'а, который будет передан LLM при вызове (например, 'extract_sales').
  /// Используется для парсинга `toolCalls[].name` в analyze.worker. NULL = вызов без tool_use.
  toolName      String?
  createdById   String
  createdBy     User     @relation("PromptTemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  /// Свободный changelog от автора версии (см. ТЗ A §4.1).
  notes         String?  @db.Text

  template       PromptTemplate          @relation("PromptTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  asActiveOf     PromptTemplate?         @relation("PromptTemplateActiveVersion")
  sections       PromptTemplateSection[]
  aiResults      AiResult[]              @relation("from_prompt_version")
  experimentsAsA PromptExperiment[]      @relation("experiment_a")
  experimentsAsB PromptExperiment[]      @relation("experiment_b")
  /// Фаза E — snapshot этой версии в MeetingReport: какая именно версия была
  /// использована при генерации (для воспроизводимости/диффа).
  meetingReports MeetingReport[]         @relation("MeetingReportVersion")

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

/// Раздел отчёта в рамках версии шаблона. До 30 разделов на версию
/// (валидируется в сервисе). В A.1 секции создаются seed'ом из существующих
/// type-*.ts: каждое поле SCHEMA = одна секция с outputType.
model PromptTemplateSection {
  id          String  @id @default(cuid())
  versionId   String
  /// Порядковый номер 1..30. Уникален в рамках версии.
  order       Int
  /// Slug секции для маппинга на ключ в JSON-ответе LLM.
  key         String
  title       String
  /// Инструкция LLM «что писать в этой секции».
  instruction String  @db.Text
  /// 'text' | 'bullet_list' | 'table' | 'json_object'. Хранится как String для расширяемости.
  outputType  String
  required    Boolean @default(true)
  /// Опциональный лимит maxTokens на секцию (см. валидатор в A.2).
  maxTokens   Int?

  version PromptTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@unique([versionId, order])
  @@index([versionId])
}

/// A/B-эксперимент между двумя версиями шаблонов. Реализация A.3.
/// В A.1 модель заводится только для FK-целостности и future-proof'а — резолвер
/// уже умеет читать experimentGroup, но активных экспериментов в A.1 не будет.
model PromptExperiment {
  id           String    @id @default(cuid())
  /// NULL = эксперимент системного шаблона (только super_admin); иначе Org-эксперимент.
  orgId        String?
  /// Версия A (control).
  templateAId  String
  /// Версия B (variant).
  templateBId  String
  /// Доля трафика на B, 0..100.
  splitPercent Int
  /// 'draft' | 'running' | 'stopped' | 'completed'.
  status       String    @default("draft")
  startedAt    DateTime?
  endsAt       DateTime?
  createdById  String
  createdBy    User      @relation("PromptExperimentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  notes        String?   @db.Text

  org       Org?                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateA PromptTemplateVersion @relation("experiment_a", fields: [templateAId], references: [id], onDelete: Restrict)
  templateB PromptTemplateVersion @relation("experiment_b", fields: [templateBId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@index([status])
}

/// Реакция пользователя (👍/👎) на AI-результат встречи. Заполняется
/// эндпоинтом A.3 `POST /api/v1/meetings/:meetingId/result/feedback`.
/// В A.1 модель заводится только для FK-целостности; UI/endpoint появляется в A.3.
model AiResultFeedback {
  id         String   @id @default(cuid())
  aiResultId String
  userId     String
  /// 'positive' | 'negative'.
  reaction   String
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  aiResult AiResult @relation(fields: [aiResultId], references: [id], onDelete: Cascade)
  user     User     @relation("AiResultFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([aiResultId, userId])
  @@index([aiResultId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Фаза E — несколько AI-отчётов на одну встречу
// ─────────────────────────────────────────────────────────────────────────
// Источник: plans/tz/2026-05-21-phase-E-multi-report-per-meeting.md §4.
//
// Primary-отчёт (`AiResult`, под `Meeting.type`) остаётся как есть. `MeetingReport`
// хранит «дополнительные» отчёты, генерируемые on-demand по выбранному шаблону.
// Partial unique index `(meeting_id, prompt_template_id) WHERE status IN
// ('pending','running')` создаётся вручную через apply-postgres-init.sql —
// Prisma partial unique не поддерживает.

enum MeetingReportStatus {
  pending
  running
  ready
  failed
  archived
}

/// Дополнительный («custom») AI-отчёт встречи. Генерируется воркером
/// `ai.custom-report` по выбранному `PromptTemplate` + `PromptTemplateVersion`.
/// Снимок версии шаблона хранится в `promptTemplateVersionId` для
/// воспроизводимости: если шаблон позже изменили или архивировали — отчёт всё
/// равно показывает то, что было в момент генерации.
model MeetingReport {
  id                      String @id @default(cuid())
  meetingId               String
  /// tenant: Org, в которой принадлежит отчёт. Дублирует `meeting.tenantId`,
  /// чтобы admin-выборки/аудит не делали join.
  tenantId                String
  promptTemplateId        String
  promptTemplateVersionId String

  /// 'primary' | 'additional'. В рамках E все записи — 'additional';
  /// primary-отчёт показывается из `AiResult` синтетически. Колонка введена
  /// сразу, чтобы при будущей миграции primary в `MeetingReport` ничего не
  /// ломать в API-контракте.
  kind  String @default("additional")
  /// Снимок `PromptTemplate.name` в момент генерации (защита от ребрендинга
  /// шаблона позже).
  title String

  status        MeetingReportStatus @default(pending)
  /// JSON-вывод LLM по `PromptTemplateVersion.outputSchema`. NULL пока не ready.
  output        Json?
  /// Фактическая стоимость в USD (precision 4 знака после запятой).
  llmCostUsd    Decimal?            @db.Decimal(10, 4)
  llmDurationMs Int?
  errorMessage  String?

  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  /// Soft-delete: при DELETE выставляем `status='archived'` + `deletedAt=now()`.
  deletedAt   DateTime?

  meeting               Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  promptTemplate        PromptTemplate        @relation("MeetingReportTemplate", fields: [promptTemplateId], references: [id], onDelete: Restrict)
  promptTemplateVersion PromptTemplateVersion @relation("MeetingReportVersion", fields: [promptTemplateVersionId], references: [id], onDelete: Restrict)

  @@index([meetingId, status])
  @@index([meetingId, deletedAt])
  @@index([tenantId, createdAt])
  @@index([promptTemplateId])
  @@index([promptTemplateVersionId])
}

// ─────────────────────────────────────────────────────────────────────────
// SBA α-1 — Conversational Channels Foundation
// ─────────────────────────────────────────────────────────────────────────
// Источник: plans/tz/2026-05-21-sba-alpha-1-channels-foundation.md
//
// Двунаправленный омниканальный слой общения с человеком. InApp + Email
// — фундамент α-1. Telegram/MAX добавляются в β-1 расширением `ChannelKind`
// без правки моделей.

/// Тип канала. На α-1: `in_app`, `email_smtp`, `email_imap`. На β-1
/// добавляются `telegram_bot`, `max_bot`. На γ+: `slack`, `mattermost`,
/// `vk_messenger`, `whatsapp_business`, `web_push`, `voice_via_asr`.
enum ChannelKind {
  in_app
  email_smtp
  email_imap
  telegram_bot
  max_bot
}

/// Направление канала. Большинство каналов — bidirectional. Outbound-only
/// (`email_smtp`) есть; inbound-only (`email_imap`) появится с β-1.
enum ChannelDirection {
  inbound_only
  outbound_only
  bidirectional
}

enum ChannelStatus {
  active
  disabled
  broken
  /// β-9 (2026-05-25) — kill-switch для глобального Telegram-канала
  /// (только для строки с `tenantId IS NULL`). Главный администратор Z
  /// выключает бота для всех клиентов одной кнопкой в `/admin/system/telegram-bot`.
  global_disabled
}

/// Жизненный цикл `Notification`.
/// `queued` → `sent_partial` (часть доставок ушла, часть в очереди) →
/// `delivered` (хотя бы один канал доставил) → `read` (хотя бы один отметил
/// прочитанным) → `responded` (получен ответ). `failed` — ни одна доставка
/// не прошла, retry'и исчерпаны.
enum NotificationStatus {
  queued
  sent_partial
  delivered
  read
  responded
  failed
}

/// Статус ожидания ответа на probe-нотификацию. Для не-probe (например,
/// `curation.pending` без явного respond-flow) — `null`.
enum NotificationResponseStatus {
  pending
  answered
  dismissed
  expired
}

/// Статус одной попытки доставки в конкретный `ChannelBinding`. Отдельный
/// enum от webhook'ового `DeliveryStatus`, потому что семантика другая
/// (read/responded состояния значимы для conversational, не для webhook).
enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  read
  responded
  failed
}

/// Channel — настроенный per-Org канал общения.
///
/// Конкретные секреты (botToken, IMAP password и т.п.) лежат в `config`
/// в зашифрованном виде через `CryptoService.encrypt(...)`. Для `in_app`
/// `config` пустой (`{}`). Для `email_smtp` — переиспользуем общий SMTP
/// из `cfg.mail` (per-Org переопределение появится позже), но запись
/// в `Channel` всё равно нужна, чтобы маршрутизатор знал, что Org
/// разрешила email-доставку.
model Channel {
  id           String           @id @default(cuid())
  /// β-9 (2026-05-25): nullable для глобальных каналов (один на всю платформу,
  /// прим. — глобальный Telegram-бот @kora_bot). Per-tenant строки сохраняют
  /// `tenantId` как раньше. Ровно одна глобальная строка на `kind` гарантируется
  /// partial unique index'ом `channels_global_unique` в `postgres-init.sql`
  /// (Prisma не поддерживает partial unique декларативно). Postgres трактует
  /// `NULL != NULL`, поэтому `@@unique([tenantId, kind])` ниже остаётся
  /// корректным для per-tenant пары и не мешает глобальной NULL-строке.
  tenantId     String?
  kind         ChannelKind
  direction    ChannelDirection
  /// Зашифрованные секреты (botToken, etc). Для `in_app` = `{}`.
  config       Json             @default("{}")
  status       ChannelStatus    @default(active)
  /// Верхний потолок класса данных, который разрешено отправлять в этот
  /// канал. `internal` по умолчанию — `sensitive`/`private` не уходят
  /// во внешние каналы без явного апгрейда настройки.
  maxDataClass DataClass        @default(internal)
  brokenReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  org      Org?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings ChannelBinding[]

  @@unique([tenantId, kind])
  @@index([tenantId, kind])
  @@index([tenantId, status])
  @@map("channels")
}

/// ChannelBinding — привязка конкретного пользователя к конкретному каналу.
/// Для `in_app` `externalId = userId` (равенство сохраняется ради
/// единообразия). Для `email_smtp/imap` — email. Для `telegram_bot/max_bot`
/// — внешний user_id мессенджера (после verify через одноразовый код).
model ChannelBinding {
  id          String    @id @default(cuid())
  userId      String
  channelId   String
  /// Внешний идентификатор адресата: userId (in_app), email
  /// (email_smtp/imap), tg/max user_id (β-1). Уникален на канал.
  externalId  String
  /// Preferences пользователя per-binding: quiet hours, rate limits,
  /// фильтры eventType. См. ChannelBindingPreferences (zod-схема).
  preferences Json      @default("{}")
  /// W4.3 (KC-Temporal) — потолок чувствительности per-binding (per-user-per-channel).
  /// Заполняется пользователем в `/me/channels` («макс. чувствительность»:
  /// public / internal / sensitive). `private` через UI недоступен — личные
  /// факты доставляются только в `in_app` и только subject'у. Эффективный
  /// потолок = `min(Channel.maxDataClass, ChannelBinding.maxDataClass)`.
  maxDataClass DataClass @default(internal)
  linkedAt    DateTime  @default(now())
  /// Заполняется после проверки кода/верификации. Для in_app — равен
  /// `linkedAt` (auto-verified).
  verifiedAt  DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([channelId, externalId])
  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@map("channel_bindings")
}

/// Notification — событие, адресованное пользователю, доставляемое через
/// один или несколько `ChannelBinding`. Логическая единица — пожизненна,
/// `NotificationDelivery` — попытка доставки в конкретный канал.
///
/// `payload.schemaVersion`/`payload.body` — фактическая структура зависит
/// от `eventType`. Валидация — в `ConversationalService.sendNotification`
/// через `NotificationEventPayloadRegistry`.
model Notification {
  id              String                      @id @default(cuid())
  tenantId        String
  recipientUserId String
  /// Тип события, например `probe.question`, `curation.pending`,
  /// `idea.status_changed`. На α-1 — `probe.question`, `curation.pending`,
  /// `system.message`. Расширяется потребителями (α-4, β-5).
  eventType       String
  payload         Json
  dataClass       DataClass                   @default(internal)
  /// Опц. ссылка на исходный `IdeaBlock` (для probe'а на блок).
  contextBlockId  String?
  /// Опц. ссылка на карточку специалиста (Card, Decision, Regulation, ...).
  contextCardId   String?
  status          NotificationStatus          @default(queued)
  responseStatus  NotificationResponseStatus?
  responsePayload Json?
  expiresAt       DateTime?
  createdAt       DateTime                    @default(now())
  respondedAt     DateTime?

  org        Org                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient  User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([tenantId, recipientUserId, status])
  @@index([tenantId, eventType, status])
  @@index([recipientUserId, status])
  @@index([expiresAt])
  @@map("notifications")
}

/// NotificationDelivery — одна попытка доставки в конкретный
/// `ChannelBinding`. На один `Notification` может быть несколько
/// доставок (по числу выбранных routing'ом каналов).
model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  channelBindingId  String
  status            NotificationDeliveryStatus @default(queued)
  /// Внешний id сообщения (smtp messageId, telegram message_id, …).
  externalMessageId String?
  errorReason       String?
  /// Сколько раз пробовали отправить (для retry-логики worker'а).
  attempts          Int                        @default(0)
  attemptedAt       DateTime                   @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  respondedAt       DateTime?

  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channelBinding ChannelBinding @relation(fields: [channelBindingId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channelBindingId, status])
  @@map("notification_deliveries")
}

// ──────────────────────────── SBA β-8 — Daily check-in (2026-05-23) ────────────────────────────

/// DailyCheckIn — утренний / вечерний чек-ин сотрудника.
/// Источник: plans/tz/2026-05-23-sba-beta-8-personal-relation-coo-checkin.md §5.
///
/// `kind`: 'morning' — план на день; 'evening' — что сделано + блокеры.
/// `dateLocal` — YYYY-MM-DD по локальной TZ Person'а (Person.timezone, default
/// 'Europe/Moscow'). Уникален с (tenantId, personId, kind) — anti-spam:
/// одна и та же пара (person, день, тип) не может быть продублирована.
///
/// `plansJson` / `donesJson` / `blockersJson` — массивы
/// Array<{ text, sourceBlockId?, priority? }>; формат хранится как Json,
/// чтобы можно было быстро расширить без миграции (priority/severity
/// эволюционируют).
///
/// `notificationId` — ссылка на исходный `Notification(eventType='checkin.prompt')`,
/// если чек-ин создан в ответ на cron-проб. Manual create (через POST
/// `/me/check-ins`) — NULL.
///
/// `parseConfidence` — уверенность LLM-парсера при автозаполнении из текста
/// ответа. < 0.6 → плейсхолдер `pendingCuration=true` (поле `curatorReview`),
/// raw текст ответа уезжает в `rawResponseText`. >= 0.6 → данные считаются
/// канонизированными.
model DailyCheckIn {
  id              String    @id @default(cuid())
  tenantId        String
  personId        String
  /// 'morning' | 'evening' — литералы строкой, чтобы не плодить enum
  /// под две конкретные строки (см. style schema для simple enums-as-string).
  kind            String    @db.VarChar(16)
  /// YYYY-MM-DD по локальной TZ Person'а.
  dateLocal       String    @db.VarChar(10)
  /// Массив plans: Array<{ text, sourceBlockId?, priority? }>. NULL до ответа.
  plansJson       Json?
  /// Массив сделанного: Array<{ text, sourceBlockId?, evidenceLink? }>.
  donesJson       Json?
  /// Массив блокеров: Array<{ text, severity? ∈ {low|medium|high}, ownerHint? }>.
  blockersJson    Json?
  /// id исходной нотификации (cron probe). NULL для manual create.
  notificationId  String?
  /// Сырой текст ответа пользователя (если есть). Для аудита и curator review.
  rawResponseText String?   @db.Text
  /// 0..1 — уверенность LLM-парсера `checkin-parse`. NULL если нет ответа.
  parseConfidence Decimal?  @db.Decimal(4, 3)
  /// True если LLM-парсер не уверен (parseConfidence < 0.6) — нужен curator
  /// review. Соответствующие чек-ины поднимаются в `CurationItem` (будущая
  /// интеграция; пока только флаг, чтобы UI мог показать «требует проверки»).
  curatorReview   Boolean   @default(false)
  /// Заполнен в момент, когда пользователь прислал ответ или manual create
  /// прошёл успешно. NULL = чек-ин «пустой» (cron поставил, но человек не
  /// ответил до конца суток).
  completedAt     DateTime?

  /// SBA β-8.1 — настроение чек-ина (определяет LLM по тексту вечернего
  /// ответа). 'green' | 'yellow' | 'red'. NULL = анализ ещё не запускался
  /// или модель упала. Видимость поля — только для роли coo/owner/admin
  /// (фильтр в DTO-маппере; не показывается сотруднику в /me/check-ins).
  sentiment             String?   @db.VarChar(10)
  /// Короткое обоснование от LLM («почему зелёный/жёлтый/красный»). Для
  /// прозрачности перед админом.
  sentimentRationale    String?   @db.Text
  /// Версия промпта/модели, которой определили настроение. Формат свободный
  /// (например, `prompt-v1+deepseek-chat`).
  sentimentVersion      String?   @db.VarChar(120)
  /// Когда настроение было проставлено (после анализа).
  sentimentDeterminedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation("DailyCheckInPerson", fields: [personId], references: [id], onDelete: Cascade)
  tenant Org    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personId, kind, dateLocal])
  @@index([tenantId, personId, dateLocal])
  @@index([tenantId, kind, dateLocal])
  @@index([tenantId, curatorReview])
  /// SBA β-8.1 — индекс для виджета «Температура команды».
  @@index([tenantId, sentiment, dateLocal])
  @@map("daily_check_ins")
}

/// SBA β-8.1 — WeeklyOperationsDigest. Готовый недельный дайджест для
/// операционного директора. Источник: plans/tz/2026-05-24-sba-beta-8-1-coo-dobivka.md §5.
///
/// Генерируется `operations-weekly-digest.cron` каждый понедельник в 08:00
/// локального времени каждой Org (через фильтр по `Org.timezone`).
/// `WeeklyDigestService.generate` собирает агрегаты за 7 дней (чек-ины,
/// блокеры, инсайты, цели, висящие решения) и одним LLM-вызовом
/// `operations-weekly-digest` собирает связный текст комментария.
///
/// `metricsJson` — структурированные показатели (для виджетов на странице
/// /dashboard/operations/weekly). `sourcesJson` — провенанс: id блокеров,
/// инсайтов, целей, решений, использованных в дайджесте.
///
/// Идемпотентность — `@@unique([tenantId, weekStart])`. Если за неделю
/// дайджест уже сгенерирован — повторный запуск cron'а не создаёт второй.
model WeeklyOperationsDigest {
  id             String   @id @default(cuid())
  tenantId       String
  /// YYYY-MM-DD, понедельник недели в локальной TZ Org'а.
  weekStart      String   @db.VarChar(10)
  /// YYYY-MM-DD, воскресенье недели (weekStart + 6).
  weekEnd        String   @db.VarChar(10)
  /// Связный текст комментария от LLM. Markdown (5-7 коротких разделов).
  /// При неудаче LLM сохраняется «сухой» вариант со структурой без связного текста.
  bodyMarkdown   String   @db.Text
  /// Структурированные показатели для виджетов. Свободный JSON
  /// (greenShare/yellowShare/redShare/totalCheckIns/topBlockers/...).
  metricsJson    Json
  /// Провенанс: id блокеров, инсайтов, целей, решений, использованных
  /// в дайджесте. Для drill-down из UI.
  sourcesJson    Json
  /// Идентификатор маршрута/модели LLM (или `prompt-v1+<model>`), который
  /// реально отработал. NULL если LLM упал и сохранён «сухой» вариант.
  llmTaskRouteId String?
  createdAt      DateTime @default(now())

  tenant Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekStart])
  @@index([tenantId, weekStart])
  @@map("weekly_operations_digests")
}

/// SBA β-8.3 — DailyOperationsDigest. Ежедневный отчёт операционного директора.
/// Источник: plans/tz/2026-05-25-sba-beta-8-3-coo-daily-and-doelka.md §1.2.
///
/// Зеркало `WeeklyOperationsDigest` с окном «вчерашние сутки в МСК». Генерируется
/// глобальным cron'ом `operations-daily-digest.cron` каждый день в 01:00 МСК
/// (= 22:00 UTC). Не per-Org timezone — ICP РФ, к утру рабочего дня готово
/// во всех часовых поясах страны.
///
/// `DailyDigestService.generate` собирает агрегаты вчерашнего дня
/// (чек-ины, новые блокеры, просроченные обещания, цели, новые high-severity
/// инсайты, решения) и одним LLM-вызовом `operations-daily-digest` собирает
/// связный текст комментария (4-6 коротких разделов + shortSummary для
/// Telegram-рассылки и блока на главной).
///
/// Идемпотентность — `@@unique([tenantId, dateLocal])`. Если за день дайджест
/// уже сгенерирован — повторный запуск cron'а не создаёт второй.
///
/// `deliveredAt` — отметка успешной Telegram-рассылки. NULL — ещё не доставлено
/// (или тумблер `operations.daily_digest.deliver_to_telegram` выключен).
model DailyOperationsDigest {
  id             String    @id @default(cuid())
  tenantId       String
  /// YYYY-MM-DD — дата отчёта в МСК (день, ЗА который сделан отчёт).
  dateLocal      String    @db.VarChar(10)
  /// Связный текст комментария от LLM. Markdown (4-6 коротких разделов).
  /// При неудаче LLM — «сухой» вариант со структурой без связного текста.
  bodyMarkdown   String    @db.Text
  /// Структурированные показатели для виджетов: greenShare/yellowShare/redShare,
  /// topBlockers, openCommitments, completedGoals, missedGoals, ...
  metricsJson    Json
  /// Провенанс: id блокеров, чек-инов, обещаний, целей, инсайтов, решений.
  sourcesJson    Json
  /// Идентификатор маршрута/модели LLM (`prompt-v1+<model>`). NULL при сухом fallback.
  llmTaskRouteId String?
  /// Кратко (1 короткий параграф) — для Telegram-рассылки и блока на главной.
  shortSummary   String?   @db.Text
  /// Telegram-доставка прошла. NULL — ещё не доставлено или выключено.
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  tenant Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dateLocal])
  @@index([tenantId, dateLocal])
  @@map("daily_operations_digests")
}

// ──────────────────────────── SBA δ-2 — ProactiveWatcher (2026-05-23) ────────────────────────────

/// ProactiveNotification — инициативное уведомление от ProactiveWatcher.
/// Источник: plans/tz/2026-05-23-sba-delta-2-proactive-watcher.md §5.
///
/// Watcher (`proactive-watcher.cron`, @Cron('0 *‎/6 * * *')) каждые 6 часов
/// обходит 8 deterministic-правил над графом (Decision/Insight/Experiment/
/// Process/Role/Department/FunctionalDomain). На каждое сработавшее правило
/// для одного recipient'а создаём `ProactiveNotification` (audit-row) +
/// отправляем через `ConversationalService.sendNotification` (eventType
/// 'proactive.notification') c кратким friendly-сообщением, сгенерированным
/// через LLM-задачу 'proactive-message-craft'.
///
/// `notificationId` — FK на исходящий `Notification` после отправки (NULL,
/// если отправка ещё не произошла или упала).
///
/// `payloadJson` — структурированный контекст правила (например, decisionId,
/// insightId, ageDays, suggestedAction); схема не фиксирована, чтобы каждое
/// правило могло хранить свои поля без миграций.
///
/// Anti-spam: Redis SETNX dedup-key `proactive:dedup:{tenantId}:{userId}:{dateLocal}`
/// TTL 24h — максимум 1 proactive per user per day. `ProactiveNotification`-row
/// создаётся ТОЛЬКО при успешном захвате lock'а — так в БД нет «отброшенных»
/// мусорных записей.
///
/// `dismissedAt` — пользователь нажал «Скрыть» в `/me/notifications` (вкладка
/// «Проактивные»). После dismiss карточка не показывается в default-фильтре.
model ProactiveNotification {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  /// Код правила-инициатора (см. ProactiveWatcherService.RULES):
  /// 'decision_no_owner' | 'insight_no_mitigation' | 'experiment_running_too_long'
  /// | 'process_stale_review' | 'role_low_completeness' | 'department_no_domain'
  /// | 'insights_siloed_in_domain' | 'plan_item_overdue'.
  ruleType       String    @db.VarChar(60)
  /// Уровень важности — 'low' | 'medium' | 'high'. UI использует для бейджа.
  severity       String    @db.VarChar(10)
  /// Структурированный контекст правила (free-form per rule).
  payloadJson    Json
  /// FK на исходящий Notification (после успешной отправки через
  /// ConversationalService.sendNotification). NULL, если отправка не произошла.
  notificationId String?
  emittedAt      DateTime  @default(now())
  dismissedAt    DateTime?

  user   User @relation("ProactiveNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, emittedAt])
  @@index([tenantId, ruleType, emittedAt])
  @@map("proactive_notifications")
}

// ──────────────────────────── фаза B: поведенческие метрики встречи ────────────────────────────

/// MeetingBehaviorMetrics — общие (per-meeting) поведенческие метрики
/// (one-to-one с Meeting). Источник: ТЗ B (`plans/tz/2026-05-21-phase-B-meeting-behavior-metrics.md` §4).
///
/// Рассчитывается воркером `ai.behavior-metrics` параллельно `ai.analyze`
/// после `ai.merge`. Не зависит от готовности AiResult — может стать готовой
/// раньше/позже основного отчёта.
model MeetingBehaviorMetrics {
  id        String @id @default(cuid())
  meetingId String @unique
  tenantId  String

  /// Общая длительность встречи (по Meeting.endedAt - startedAt), мс.
  totalDurationMs Int
  /// Суммарное время речи всех участников (с учётом crosstalk дважды), мс.
  totalSpeechMs   Int
  /// Суммарная тишина (ни один спикер не говорит), мс.
  silenceMs       Int
  /// Доля тишины (0..100).
  silencePercent  Float
  /// Суммарное время одновременной речи 2+ участников, мс.
  crossTalkMs     Int
  /// Нормированный индекс доминирования: max(speakingTimeMs)/median(speakingTimeMs).
  /// При median=0 возвращаем 999 (моноспикер / низкая активность).
  dominanceIndex  Float

  /// Confidence диаризации (0..1) из Vox-ответа. <0.85 → lowConfidence=true.
  diarizationConfidence Float
  /// True, если метрики ориентировочные (низкое качество диаризации /
  /// короткая встреча / иные edge-кейсы из ТЗ B §5.4).
  lowConfidence         Boolean @default(false)

  computedAt DateTime @default(now())

  meeting      Meeting                      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participants MeetingParticipantBehavior[]

  @@index([tenantId])
}

/// MeetingParticipantBehavior — per-participant поведенческие метрики
/// (one-to-many от MeetingBehaviorMetrics). Источник: ТЗ B §4.
///
/// displayName хранит снимок имени на момент расчёта (для гостей, у которых
/// нет пользовательского профиля). isGuest повторяет Participant.role='guest'
/// для удобства фильтра без JOIN.
model MeetingParticipantBehavior {
  id                       String  @id @default(cuid())
  meetingBehaviorMetricsId String
  /// participantId NULL допустим только для синтезированных гостей без
  /// записи в Participant (edge-case из ТЗ B §5.4). На MVP всегда заполнен.
  participantId            String?
  tenantId                 String

  /// Снимок имени на момент расчёта (для гостей, у которых нет userId).
  displayName String
  /// True для гостей без аккаунта.
  isGuest     Boolean @default(false)

  speakingTimeMs             Int
  speakingTimePercent        Float
  turnsCount                 Int
  avgTurnDurationMs          Float
  /// Сколько turn'ов длительностью >= 60_000 мс.
  monologueCount             Int
  longestMonologueMs         Int
  questionCount              Int
  fillerWordsCount           Int
  interruptionsMadeCount     Int
  interruptionsReceivedCount Int

  metrics     MeetingBehaviorMetrics @relation(fields: [meetingBehaviorMetricsId], references: [id], onDelete: Cascade)
  participant Participant?           @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([meetingBehaviorMetricsId, participantId])
  @@index([tenantId])
  @@index([participantId])
}

// ──────────────────────────── фаза C: AI-оценка качества встречи ────────────────────────────

/// MeetingQualityScore — AI-оценка качества встречи (sub-TZ C §4).
///
/// Источник: plans/tz/2026-05-21-phase-C-meeting-quality-score.md §4.
///
/// One-to-one с `Meeting`. Создаётся воркером `ai.quality-score` после
/// `ai_ready` основного pipeline'а. Видит хост (`Meeting.ownerId`) и
/// Org-Admin (owner/admin). Гости и non-host members получают 403.
///
/// Категорий всегда 5: preparation/structure/clarity/outcomes/engagement
/// (0..100). `overallScore` — взвешенное среднее (вычисляет LLM).
///
/// `recommendations` — массив `{ text, severity, category, degradedMode? }`.
/// `degradedMode=true` появляется, когда LLM-router сработал на tertiary
/// (Ollama qwen3.5:9b — graceful-degradation по sub-TZ C §5.4).
///
/// `strengths` — массив строк (2-4 пункта «что было хорошо»).
///
/// `promptTemplateVersionId` — версия шаблона `meeting-quality-score`
/// (после A.2/A.3 — из БД; до этого — NULL = code-fallback).
model MeetingQualityScore {
  id        String @id @default(cuid())
  meetingId String @unique
  tenantId  String

  /// Общий балл качества встречи, 0..100. Взвешенное среднее категорий,
  /// рассчитывает LLM (см. промпт).
  overallScore     Int
  /// Подготовка: озвучена ли повестка / цель в первые 5 минут (0..100).
  preparationScore Int
  /// Структура: есть ли введение → обсуждение → итоги (0..100).
  structureScore   Int
  /// Чёткость формулировок vs «надо подумать», «как-то решим» (0..100).
  clarityScore     Int
  /// Итоги: есть ли конкретные решения с ответственными и сроками (0..100).
  outcomesScore    Int
  /// Вовлечённость участников (0..100). Не путать с behaviorMetrics — это
  /// LLM-оценка диалога, не статистика.
  engagementScore  Int

  /// Список рекомендаций «как сделать встречу лучше».
  /// Структура: [{ text: string, severity: 'info'|'warning'|'critical',
  ///   category: 'preparation'|'structure'|'clarity'|'outcomes'|'engagement',
  ///   degradedMode?: boolean }].
  recommendations Json
  /// Что было хорошо (2-4 пункта). Структура: string[].
  strengths       Json

  /// Версия шаблона `meeting-quality-score` (PromptTemplateVersion.id).
  /// NULL = code-fallback (`ai/services/prompts/meeting-quality-score.ts`).
  promptTemplateVersionId String?
  computedAt              DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, overallScore])
  @@index([tenantId, computedAt])
}

// ───────────────────────── SBA α-5 — Layer 5 Chat-v2 Omnichannel ─────────────────────────
//
// AI-чат компании поверх knowledge-core с conversation history и omnichannel
// inbound/outbound. См. plans/tz/2026-05-21-sba-alpha-5-layer5-chat-v2.md.
//
// ChatV2Conversation — диалог пользователя с AI (память за всё время).
// ChatV2Message — одно сообщение в диалоге (user или assistant). citations и
// retrievalMeta/llmMeta хранятся в Json — структура задокументирована в
// сервисах chat-v2 (см. ChatV2Output из knowledge-core/services/chat-v2.service.ts).
//
// `scope` — 5 «обычных» + 'personal' (личный диалог с AI без жёсткой
// привязки). `channelKindOrigin` — где был СОЗДАН диалог (web/in_app/
// telegram_bot/...); сами сообщения могут приходить и уходить через любой
// канал, к которому привязан пользователь.

/// Диалог пользователя с AI-чатом v2. Хранится вечно (cron auto-archive
/// после 90 дней без активности, см. workers/chat-v2-cleanup.cron.ts).
/// Pin через UI исключает диалог из auto-archive.
model ChatV2Conversation {
  id                String                   @id @default(uuid())
  tenantId          String
  tenant            Org                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String
  user              User                     @relation("ChatV2ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Авто-генерация после первого сообщения через LLM (taskType
  /// `chat-v2-conversation-title`). До генерации — NULL, фронт показывает
  /// «Новый диалог».
  title             String?
  scope             ChatV2Scope
  /// Для scope='meeting'/'card'/'theme'/'entity' — id соответствующей
  /// сущности; для scope='org'/'personal' — NULL.
  scopeRefId        String?
  /// Где был создан диалог. 'web' / 'in_app' / 'email_smtp' / 'telegram_bot' /
  /// 'max_bot'. Не валидируется enum'ом — расширяется новыми каналами без
  /// миграций.
  channelKindOrigin String?
  status            ChatV2ConversationStatus @default(active)
  /// NULL = не закреплён. Закреплённые диалоги не попадают в auto-archive.
  pinnedAt          DateTime?
  /// SBA α-5 dialog-layer — сжатое представление старой части диалога
  /// (создаётся ConversationSummarizerCron для диалогов с >12 сообщениями).
  /// В systemPrompt подмешивается `summary + last 6 messages`. Markdown 200-400 chars
  /// + JSON-секция «упомянутые сущности».
  summary           String?                  @db.Text
  summaryUpdatedAt  DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  messages          ChatV2Message[]

  @@index([tenantId, userId, updatedAt])
  @@index([tenantId, status])
}

/// Сообщение в диалоге chat-v2. role='user' — вопрос пользователя; role='assistant'
/// — ответ AI с citations/retrievalMeta/llmMeta.
model ChatV2Message {
  id             String             @id @default(uuid())
  conversationId String
  conversation   ChatV2Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatV2MessageRole
  /// Только для assistant. factual / synthetic / clone_style. NULL для user.
  mode           ChatV2Mode?
  text           String             @db.Text
  /// Структура: [{ blockId, evidenceId?, meetingId, meetingTitle, startMs,
  /// endMs, snippet }, ...]. Парсится из [BLOCK:id] маркеров ChatV2Service.
  citations      Json?
  /// Структура: { usedBlockIds: string[], inputTokens, outputTokens,
  /// candidateBlockIds?: string[] }.
  retrievalMeta  Json?
  /// Структура: { model: string, inputTokens: number, outputTokens: number,
  /// tier?: 'primary'|'secondary'|'tertiary', fallbackUsed?: boolean }.
  llmMeta        Json?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
}

/// 5 «обычных» scope (org/meeting/card/theme/entity) + 'personal' — личный
/// диалог пользователя с AI без жёсткой привязки. Personal заведено для
/// γ-1 (Employee Clone), на α-5 — общий org-доступ через retrieval.
/// Wave 2 polish T6-6b — добавлен `issue` как первоклассный scope для
/// чат-в-задаче (IssueChat). Маппинг на retrieval scope knowledge-core —
/// в `SynthesisService.mapScope` (issue → card, чтобы переиспользовать
/// существующий card-retrieval + CardSpecialistRegistry/IssueCardHandler).
enum ChatV2Scope {
  org
  meeting
  card
  theme
  entity
  personal
  issue
}

enum ChatV2MessageRole {
  user
  assistant
}

/// factual — ответ только по найденным блокам (с цитатами).
/// synthetic — синтез по нескольким источникам с маркировкой уверенности.
/// clone_style — стиль конкретной персоны (Persona), реализация в γ-1.
/// Имя clone_style выбрано вместо clone-style потому что Prisma enum не
/// допускает дефис.
enum ChatV2Mode {
  factual
  synthetic
  clone_style
}

enum ChatV2ConversationStatus {
  active
  archived
}

// ──────────────────────────── SBA γ-1 — Specialist 3.7 SkillProfile + ExecutablePersona ────────────────────────────

/// SkillProfileStatus — состояние навыкового профиля сотрудника.
///   - active: сотрудник работает, профиль активно перестраивается.
///   - archived: сотрудник перешёл в former — профиль заморожен, snapshots остаются.
///   - paused_relationship: текущий relationship не employee (например, candidate) —
///     профиль есть, но не достраивается до возвращения в employee.
enum SkillProfileStatus {
  active
  archived
  paused_relationship
}

/// SkillConfidence — качественная уверенность в trait (3 уровня).
enum SkillConfidence {
  low
  medium
  high
}

/// SkillTraitStatus — жизненный цикл черты профиля.
///   - active: черта активна и видна.
///   - superseded_by: заменена более новой формулировкой (см. supersededById).
///   - archived: давно не подтверждалась (>SKILL_ARCHIVE_MONTHS).
///   - misleading: пометил direct manager / admin как неверную.
enum SkillTraitStatus {
  active
  superseded_by
  archived
  misleading
}

/// PersonaScope — область охвата исполняемой персоны.
///   - person: персона конкретного сотрудника (profileId обязателен).
///   - role: агрегат по должности (scopeRefId=roleId, profileId=null).
enum PersonaScope {
  person
  role
}

/// PersonaStatus — статус снапшота персоны.
///   - active: используется ClonesService.
///   - superseded: заменён более новой версией.
///   - pending_rebuild: Clones=Roles Ф2 (2026-05-25) — создан при смене
///     носителя роли, ждёт пересборки `personaPrompt` через
///     `ExecutablePersonaBuildService.buildForRole`. Активным НЕ считается
///     (clone-API не использует), но виден в `/history`.
enum PersonaStatus {
  active
  superseded
  pending_rebuild
}

/// SkillProfile — навыковый профиль сотрудника. 1:1 с Person (только relationship='employee').
/// Источник информации — IdeaBlockEntity.role='subject' от Person с signalType
/// ∈ {reasoning, rationale, decision_basis}. Категории черт эмерджентные —
/// LLM сам формирует строковые имена (не enum). См. sub-TZ §4.
model SkillProfile {
  id           String             @id @default(uuid())
  tenantId     String
  /// 1:1 — у одного Person строго один SkillProfile.
  personId     String             @unique
  status       SkillProfileStatus @default(active)
  /// Момент последней успешной пересборки. null до первого rebuild'а.
  lastBuildAt  DateTime?
  /// Версия профиля (инкремент при каждом успешном rebuild).
  buildVersion Int                @default(0)
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (для всего профиля
  /// как агрегата traits + персонального субъекта).
  dataClassAudit Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant   Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person   Person              @relation("SkillProfilePerson", fields: [personId], references: [id], onDelete: Cascade)
  traits   SkillTrait[]
  personas ExecutablePersona[]

  @@index([tenantId, status])
  @@map("skill_profiles")
}

/// SkillTrait — отдельная черта рабочего поведения сотрудника. Эмерджентная
/// категория (string), гипотезная формулировка («похоже, склонен к …»), минимум
/// SKILL_MIN_OBSERVATIONS (5) наблюдений. См. sub-TZ §4 + зонтичный §3.4.
model SkillTrait {
  id                        String                       @id @default(uuid())
  profileId                 String
  /// @deprecated SBA γ-1 доделки — оставлено параллельно с `categoryId` на
  /// 1 месяц для миграции (см. patch-skill-trait-categories-from-strings.ts).
  /// Новые записи пишут `categoryId`; чтение поддерживает оба поля до полного
  /// dropping legacy column.
  category                  String                       @db.VarChar(200)
  /// SBA γ-1 доделки — FK на SkillTraitCategory (эмерджентная категория,
  /// поддерживает merge через CurationDecisionType.merge_categories).
  /// Может быть null временно — пока patch-script не отработал на проде.
  categoryId                String?
  /// Гипотезная формулировка: «похоже, …» / «склонен …» / «в большинстве случаев …».
  statement                 String                       @db.Text
  confidence                SkillConfidence
  observationCount          Int
  /// IdeaBlock.id, на которых построена черта.
  sourceBlockIds            String[]                     @default([])
  firstObservedAt           DateTime
  lastConfirmedAt           DateTime
  status                    SkillTraitStatus
  /// Если status='superseded_by' — id нового trait'а.
  supersededById            String?
  /// Если status='misleading' — обязательное обоснование от куратора.
  misleadingReason          String?                      @db.Text
  /// user.id куратора, пометившего trait как misleading.
  misleadingFlaggedByUserId String?
  misleadingFlaggedAt       DateTime?
  /// Эмбеддинг (category + statement) для KNN-merge при rebuild'е.
  embedding                 Unsupported("vector(1536)")?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  /// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 2 — ссылка на канонический
  /// «смысловой блок навыка» (SkillTraitConcept). Канонизация одинаковых по
  /// смыслу traits у разных сотрудников: «осторожен с оценками сроков»,
  /// «не любит давать сроки без данных», «откладывает оценку» → один концепт.
  /// Null временно — до прогона backfill-скрипта.
  conceptId                 String?
  concept                   SkillTraitConcept?           @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  profile    SkillProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  categoryFk SkillTraitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([profileId, status])
  @@index([profileId, category])
  @@index([profileId, categoryId])
  @@index([categoryId])
  @@index([conceptId])
  @@map("skill_traits")
}

/// ТЗ 2026-05-25 clone-reliability-hardening, Фаза 2 — Смысловой блок навыка.
/// Канонизирует одинаковые по смыслу SkillTrait у разных сотрудников
/// (напр. «осторожен с оценками сроков», «не любит давать сроки без данных»,
/// «откладывает оценку» — все указывают на один концепт).
model SkillTraitConcept {
  id              String   @id @default(cuid())
  tenantId        String
  /// Каноническое имя — берётся из category первого trait'а при создании,
  /// пересчитывается агентом `skill-trait-concept-name` при слиянии 2+ концептов.
  canonicalName   String   @db.VarChar(200)
  /// 1-2 предложения, поясняющие смысл, для админки (опционально).
  description     String?  @db.Text
  /// Все наблюдённые варианты названия (для прозрачности и debug).
  variants        String[] @default([])
  /// Семантический отпечаток canonicalName + description.
  embedding       Unsupported("vector(1536)")?
  status          SkillTraitConceptStatus @default(active)
  /// Куда слит, если status='merged_into'.
  mergedIntoId    String?
  mergedInto      SkillTraitConcept?  @relation("ConceptMerge", fields: [mergedIntoId], references: [id])
  mergedFrom      SkillTraitConcept[] @relation("ConceptMerge")
  /// Денормализованный счётчик активных traits с этим conceptId.
  traitCount      Int      @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org             Org @relation("SkillTraitConceptTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  traits          SkillTrait[]

  @@unique([tenantId, canonicalName])
  @@index([tenantId, status])
  @@map("skill_trait_concepts")
}

enum SkillTraitConceptStatus {
  active
  merged_into
  archived
}

/// SBA γ-1 доделки — SkillTraitCategory — эмерджентная категория группы
/// `SkillTrait`. Заменяет free-string `SkillTrait.category` first-class моделью
/// для следующих сценариев:
///   - Куратор может слить две дублирующиеся категории через CurationDecisionType
///     `merge_categories` (см. α-4 wave 2 enum-value).
///   - Категории получают slug для URL-safe ссылок (`/skills/categories/:slug`).
///   - Иерархия (parentCategoryId) — задел: можно сгруппировать «низкоуровневые»
///     категории в «высокоуровневые» (на γ-1 не используем активно).
/// См. plans/tz/2026-05-23-sba-gamma-1-finishing-skilltraitcategory-persona-versioning.md.
model SkillTraitCategory {
  id               String    @id @default(cuid())
  tenantId         String
  name             String    @db.VarChar(200)
  /// URL-safe slug (latinized + lowercased). Уникален per-tenant.
  slug             String    @db.VarChar(220)
  description      String?   @db.Text
  /// Иерархия категорий — задел; на γ-1 не используется.
  parentCategoryId String?
  /// Если категория была merge-источником (поглощена в target) — выставляется
  /// soft-delete момент. Сама запись остаётся для аудита и rollback.
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Org                  @relation("SkillTraitCategoryTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  parent   SkillTraitCategory?  @relation("SkillTraitCategoryToParent", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children SkillTraitCategory[] @relation("SkillTraitCategoryToParent")
  traits   SkillTrait[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
  @@index([parentCategoryId])
  @@map("skill_trait_categories")
}

/// ExecutablePersona — версионированный snapshot «думай как X» / «думай как Role».
/// Собирается раз в неделю cron'ом (ExecutablePersonaBuildCron) + on-demand
/// через admin API. Используется ClonesService при ответе в стиле сотрудника.
/// См. sub-TZ §4.
model ExecutablePersona {
  id                   String        @id @default(uuid())
  tenantId             String
  /// Для scope='person' — обязателен (SkillProfile сотрудника).
  /// Для scope='role' — null (используется scopeRefId=roleId).
  profileId            String?
  scope                PersonaScope
  /// Для scope='role' — Role.id. Для scope='person' — null (берём profileId).
  scopeRefId           String?
  version              Int
  snapshotAt           DateTime      @default(now())
  /// Сам persona prompt — структурированный текст «Думай как X. Тебя характеризует …».
  /// Длина 300–800 слов (TODO: на этапе γ-1 placeholder; финальную длину согласовать).
  personaPrompt        String        @db.Text
  /// SkillTrait.id[], попавшие в этот snapshot.
  includedTraitIds     String[]      @default([])
  status               PersonaStatus
  builtFromTraitsCount Int
  /// SBA γ-1 доделки — почему этот snapshot был собран.
  /// 'scheduled' — еженедельный cron; 'threshold' — ≥N новых traits с прошлого
  /// snapshot; 'critical' — mark_as_misleading (severity=critical); 'manual' —
  /// вручную через admin API; 'on_demand' — on-the-fly из ClonesService.
  triggerReason        String?       @db.VarChar(40)
  /// SBA γ-1 доделки — время триггерного события (создания N-го trait'а / mark_misleading);
  /// нужно для метрики `executable_persona_snapshot_lag_seconds`.
  triggerEventAt       DateTime?
  /// Clones=Roles Ф1 (2026-05-25) — версия клона роли (1, 2, 3...).
  /// При смене носителя роли создаётся новая версия. null — для scope='person'
  /// (legacy) и для записей до backfill.
  roleVersion          Int?          @default(1)
  /// Clones=Roles Ф1 — Person.id текущего носителя роли (для scope='role').
  /// null — для scope='person', для архивных версий и пока компания
  /// не назначила первого носителя.
  currentBearerPersonId String?
  /// Clones=Roles Ф1 — публичное имя клона: «Клон Маркетолога v2».
  /// Генерируется при build/backfill. null — для legacy persona.
  publicName           String?
  /// Clones=Roles Ф1 — id предыдущей версии ExecutablePersona в цепочке
  /// версий клона роли (succeed-link).
  succeedsPersonaId    String?
  /// W4.2 (2026-05-25) — audit-trail вычисления dataClass (как минимум 'internal'
  /// по правилу floor для executable_persona; private-trait'ы анонимизируются
  /// до sensitive по private-aggregation в DataClassPolicyService).
  dataClassAudit       Json?
  createdAt            DateTime      @default(now())

  tenant     Org                  @relation("ExecutablePersonaTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  profile    SkillProfile?        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Clones=Roles Ф1 — связь на предыдущую версию персоны.
  succeeds   ExecutablePersona?   @relation("PersonaSuccession", fields: [succeedsPersonaId], references: [id])
  /// Clones=Roles Ф1 — обратная связь: какие персоны заменили эту.
  succeededBy ExecutablePersona[] @relation("PersonaSuccession")

  @@unique([profileId, scope, scopeRefId, version])
  @@index([scope, scopeRefId, status])
  @@index([tenantId])
  /// Clones=Roles Ф1 — быстрый lookup «активная версия клона роли».
  @@index([scope, scopeRefId, status, roleVersion])
  @@map("executable_personas")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA β-6 — Experiment Tracker (Specialist 3.9)
// Источник: plans/tz/2026-05-23-sba-beta-6-experiment-tracker.md
//
// Идея: институциональная память «что мы пробовали и что вышло». Specialist 3.9
// собирает Experiment-карточки из signalType={hypothesis, result, lesson},
// отслеживает переходы Experiment ↔ Insight ↔ Decision через EntityLink
// predicates (см. EntityTransitionCron). Auto-status transitions только при
// confidence ≥ 0.7 (иначе probe куратору).
// ─────────────────────────────────────────────────────────────────────────

/// Эксперимент компании — гипотеза → выполнение → результат → урок.
/// First-class сущность (не extension Decision/Insight). Может быть автономной
/// (running без результата 90 дней) или закрытой (completed / dropped).
///
/// Status machine: `hypothesis → running → completed | dropped` (+ опц. `paused`).
/// Auto-status transitions выполняются `experiment-status-resolver.cron` каждые
/// 6 часов ТОЛЬКО при confidence ≥ 0.7; иначе оставляем текущий статус и эмитим
/// probe куратору (см. β-6 §3 решение #3).
model Experiment {
  id               String    @id @default(cuid())
  tenantId         String
  /// Краткое имя эксперимента (для UI и поиска).
  name             String
  /// Полный текст гипотезы — главный источник для retrieval и дедупа.
  hypothesisText   String    @db.Text
  /// Опц. владелец (Person.entityId, не Person.id — для согласованности с графом).
  ownerEntityId    String?
  /// Статус: hypothesis | running | completed | dropped | paused.
  /// Без enum — гибкость для будущих доделок (см. β-6 §3 решение #2).
  status           String    @default("hypothesis")
  /// Текущий результат (краткий summary). NULL = ещё нет результата.
  currentResult    String?   @db.Text
  /// Уроки — Array<{ text, sourceBlockId, type ∈ {what_worked|what_failed|next_time} }>.
  /// Multi-faceted (см. β-6 §3 решение #5).
  lessonsJson      Json?
  /// Когда эксперимент стартовал (заполняется при status=running).
  startedAt        DateTime?
  /// Когда эксперимент завершён (заполняется при status ∈ {completed, dropped}).
  completedAt      DateTime?
  /// IdeaBlock'и, на которых построен Experiment (гипотеза + результаты + уроки).
  sourceBlockIds   String[]  @default([])
  /// Person'ы, упомянутые в блоках как subject (для атрибуции в γ-1 SkillProfile).
  personSubjectIds String[]  @default([])
  /// Последняя активная ExperimentVersion (snapshot перед каждым изменением).
  currentVersionId String?
  /// Уверенность extraction [0..1] (Decimal(4,3) — 3 знака после точки).
  /// Auto-status transition ТОЛЬКО при confidence ≥ 0.7 (см. §3 решение #3).
  confidence       Decimal   @default(0.500) @db.Decimal(4, 3)
  /// Опц. связка с Entity-графом (для отображения в graph view).
  entityId         String?
  /// Когда последний раз подтверждали актуальность (используется для probe «no_owner»).
  lastConfirmedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Org                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions ExperimentVersion[]

  // Частые фильтры master-detail UI + status-resolver cron.
  @@index([tenantId, status])
  @@index([tenantId, ownerEntityId])
  @@index([tenantId, updatedAt])
  @@map("experiments")
}

/// Immutable snapshot Experiment'а перед каждым существенным изменением (status
/// transition, добавление result/lessons). Хранит весь payload в snapshotJson.
/// Используется для audit-trail и rollback'а в UI (β-6 §5).
model ExperimentVersion {
  id            String   @id @default(cuid())
  /// FK на родительский Experiment.
  experimentId  String
  /// Tenant дублируется для cardinality-safe фильтров (Org-Admin / soft-delete).
  tenantId      String
  /// Возрастающий счётчик версий (1, 2, 3, ...). @@unique([experimentId, versionNumber]).
  versionNumber Int
  /// Сериализованный snapshot Experiment-поля (всё значимое: status, currentResult,
  /// lessonsJson, sourceBlockIds, confidence, etc.).
  snapshotJson  Json
  /// Краткая причина создания версии (для UI «история»).
  changeReason  String?  @db.VarChar(120)
  createdAt     DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  tenant     Org        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, versionNumber])
  @@index([tenantId, experimentId])
  @@map("experiment_versions")
}

// ─────────────────────────────────────────────────────────────────────────
// SBA γ-2 — Concierge Agent
//
// Сквозной UX-слой кабинета: floating button в AppShell + страница /assistant +
// <ConciergeSlot>. Понимает context страницы (route, currentEntityId), имеет
// доступ к whitelist REST-эндпоинтам через tool-use, может выполнить действие
// за пользователя. Поддерживает Undo через ConciergeUndoLog.
//
// См. plans/tz/2026-05-23-sba-gamma-2-concierge-agent.md §5.
// ─────────────────────────────────────────────────────────────────────────

/// Диалог пользователя с Concierge Agent. Один пользователь может иметь
/// множество параллельных диалогов (например, по контексту страницы).
model ConciergeConversation {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  /// Снимок pageContext на момент создания диалога (route, currentEntityId, …).
  pageContextJson Json?
  startedAt       DateTime  @default(now())
  lastMessageAt   DateTime?
  /// Сжатый summary длинного диалога (заполняется conversation-summarizer cron).
  summary         String?   @db.Text
  archivedAt      DateTime?

  user     User               @relation("ConciergeConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant   Org                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages ConciergeMessage[]
  undoLogs ConciergeUndoLog[]

  @@index([tenantId, userId, lastMessageAt])
  @@index([tenantId, archivedAt])
  @@map("concierge_conversations")
}

/// Сообщение диалога Concierge.
///   - role='user'      — пользовательский запрос.
///   - role='assistant' — текст ответа LLM.
///   - role='tool'      — результат tool call (для tool-use loop).
model ConciergeMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   @db.VarChar(16)
  content        String   @db.Text
  /// Запрошенные LLM tool calls — Array<{ id, name, arguments }>.
  toolCallsJson  Json?
  createdAt      DateTime @default(now())

  conversation ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("concierge_messages")
}

/// Лог выполненных tool calls с rollback-инструкциями. Используется для
/// «Готово. Отменить» action toast'ов.
model ConciergeUndoLog {
  id                  String    @id @default(cuid())
  tenantId            String
  conversationId      String
  toolName            String    @db.VarChar(120)
  paramsJson          Json
  resultJson          Json
  /// Описание, как откатить действие. Например:
  ///   { method: 'POST', path: '/api/v1/meetings/:id/cancel', params: {...} }
  /// NULL → действие нельзя отменить (concierge должен явно предупредить).
  undoInstructionJson Json?
  executedAt          DateTime  @default(now())
  rolledBackAt        DateTime?

  conversation ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Org                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, executedAt])
  @@index([conversationId, executedAt])
  @@map("concierge_undo_logs")
}

/// Anti-abuse: дневная / месячная квота сообщений Concierge на Org. Realtime-
/// счётчики живут в Redis, а БД — для durable snapshot и cron-reset.
model OrgConciergeQuota {
  tenantId             String    @id
  dailyMessagesLimit   Int       @default(100)
  monthlyMessagesLimit Int       @default(3000)
  currentDailyCount    Int       @default(0)
  currentMonthlyCount  Int       @default(0)
  resetDailyAt         DateTime?
  resetMonthlyAt       DateTime?
  updatedAt            DateTime  @updatedAt

  tenant Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("org_concierge_quotas")
}

// ──────────────────────────── SBA δ-1 — Orchestrator (multi-agent research) ────────────────────────────

/// Один запуск Orchestrator'а — multi-agent deep research для сложных
/// запросов («составь отчёт по X», «сравни Y и Z»). 4 шага:
///   planning → subagents_running → synthesizing → verifying → done|failed.
///
/// Hard limits (anti-cost-runaway):
///   - depth=1 (subagent не может spawn'ить subagent'ов);
///   - max 5 subagents per run;
///   - 15-min timeout;
///   - feature-flag ORCHESTRATOR_ENABLED default false.
///
/// `planJson`         — массив шагов { agentType, contextSlice }.
/// `synthesisJson`    — { text, citations[] }.
/// `verificationJson` — { confidence: 0..1, reasoning, retried: boolean }.
model OrchestratorRun {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  task             String    @db.Text
  /// planning | subagents_running | synthesizing | verifying | done | failed.
  status           String    @default("planning") @db.VarChar(32)
  planJson         Json?
  synthesisJson    Json?
  verificationJson Json?
  /// Сообщение об ошибке (для status='failed') — для UI и логов.
  errorMessage     String?   @db.Text
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  user   User @relation("OrchestratorRunUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant Org  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobs OrchestratorSubagentJob[]

  @@index([tenantId, userId, startedAt])
  @@index([status])
  @@map("orchestrator_runs")
}

/// Один subagent-job в рамках OrchestratorRun. Запускается параллельно
/// через BullMQ-очередь `orchestrator.subagents`.
///
/// `agentType` ∈ { 'entity_research', 'comparison', 'topic_summary',
/// 'timeline_construction' }.
/// `contextJson` — изолированный slice контекста (НЕ полная история run'а).
/// `resultJson`  — { text, citations[], confidence? }.
model OrchestratorSubagentJob {
  id           String    @id @default(cuid())
  runId        String
  stepIndex    Int
  agentType    String    @db.VarChar(64)
  contextJson  Json
  resultJson   Json?
  /// pending | running | done | failed.
  status       String    @default("pending") @db.VarChar(16)
  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?

  run OrchestratorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepIndex])
  @@index([status])
  @@map("orchestrator_subagent_jobs")
}

// ──────────────────────────── tracker: Phase 1 (Sprint 1, 2026-05-24) ────────────────────────────
// Полноценный таск-трекер Z/Кора поверх legacy `Task`. См. план:
// plans/tz/2026-05-23-tracker-phase-1-models-api.md.
//
// Все модели имеют `tenantId String` (multi-tenancy), `createdAt`, `updatedAt`
// (где нужно), soft-delete через `deletedAt` (для основных сущностей).
// `entityId String?` — связь с графом знаний (Entity) — opt.
// НЕ добавляем embedding pgvector в Issue — это Phase 3 (Sprint 6).

/// Проект трекера. Каждый проект имеет короткий идентификатор (префикс задач
/// `KORA-`, `SALES-` и т.д.) и slug, уникальные в рамках org.
model Project {
  id                String    @id @default(cuid())
  tenantId          String
  slug              String // короткий уникальный slug per tenant
  identifier        String // префикс задач: PROJ, SALES, DEV (до 5 симв.)
  name              String
  description       String?   @db.Text
  ownerId           String
  defaultAssigneeId String?
  defaultStateId    String?
  network           Int       @default(0) // 0=Private, 2=Public-внутри-org
  archivedAt        DateTime?
  timezone          String    @default("Europe/Moscow")

  // Feature flags per project
  cycleViewEnabled    Boolean @default(true)
  intakeViewEnabled   Boolean @default(true)
  gantViewEnabled     Boolean @default(false)
  timeTrackingEnabled Boolean @default(false)

  // Tracker Phase 4 (Email-to-task, T5) — уникальный alias для приёма писем.
  // Полный адрес = `${emailInboxAlias}@${MAIL_INBOX_DOMAIN}`.
  // - emailInboxAlias: nullable + @unique (одноимённый alias невозможен в принципе).
  // - emailInboxEnabled: kill-switch на проект (по умолчанию выключено).
  emailInboxAlias   String? @unique
  emailInboxEnabled Boolean @default(false)

  // Шаблон команды, из которого создан
  teamTemplateId String?
  teamTemplate   TeamTemplate? @relation(fields: [teamTemplateId], references: [id], onDelete: SetNull)

  // Связь с графом
  entityId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members         ProjectMember[]
  issues          Issue[]
  cycles          Cycle[]
  states          IssueState[]
  labels          Label[]
  mailInboundLogs MailInboundLog[]

  @@unique([tenantId, slug])
  @@index([tenantId, archivedAt])
  @@index([tenantId, identifier])
}

/// M:M между User и Project. Роль числовая: 20=Admin, 15=Member, 5=Guest.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Int // 20=Admin, 15=Member, 5=Guest
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// Статус задачи в проекте (Backlog / In Progress / Done / Cancelled и пр.).
/// Каждый проект имеет свой набор статусов с порядком (`sequence`) и категорией.
model IssueState {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String
  name      String // «Бэклог», «В работе», «Готово»
  color     String  @default("#94A3B8")
  category  String // backlog | unstarted | started | completed | cancelled
  sequence  Int
  isDefault Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, sequence])
  @@index([tenantId])
}

/// Цикл — «неделя работы» / спринт. Снимок прогресса обновляется cron'ом.
model Cycle {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  name        String // «Неделя 23», «Спринт продаж — июнь»
  startDate   DateTime
  endDate     DateTime
  ownedById   String?
  description String?  @db.Text

  /// Снимок прогресса (агрегированный, обновляется cron'ом).
  /// Формат: { total: N, completed: M, inProgress: K, ... }
  progressSnapshot Json?

  version  Int    @default(1)
  timezone String @default("Europe/Moscow")

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, startDate])
  @@index([tenantId])
}

/// Задача трекера. Расширение legacy `Task`. Самореферентная иерархия через
/// `parentId` (подзадачи). `identifier` уникален в рамках tenant (например
/// `KORA-123`), `sequenceId` — внутренний порядковый номер в проекте.
///
/// Phase 3 (Sprint 6, 2026-05-24): добавлен `embedding vector(1536)` для
/// KNN-поиска похожих задач + LLM-suggest goalId по семантике. HNSW-индекс
/// создаётся через `backend/scripts/postgres-init.sql` (cosine ops).
model Issue {
  id         String @id @default(cuid())
  tenantId   String
  projectId  String
  identifier String // PROJ-123 (уникален per tenant)
  sequenceId Int // 123 — внутренний порядковый номер per project

  title               String // ранее name
  description         String? @db.Text // rich-text JSON через TipTap
  descriptionHtml     String? @db.Text
  descriptionStripped String? @db.Text // plain text для поиска / индексации AI

  priority String  @default("none") // urgent | high | medium | low | none
  stateId  String?

  parentId String? // для иерархии подзадач

  estimatePoints Int?
  sortOrder      Int  @default(0)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  /// Sprint 3 B1-3.1 — момент последнего обнаружения просрочки
  /// `IssueOverdueDetectorCron`. Используется для дедупликации: не
  /// эмитим overdue-событие в knowledge-core повторно в течение 7 дней.
  /// null — никогда не было overdue-эмиссии.
  lastOverdueDetectedAt DateTime?

  // Циклы и модули
  cycleId String?

  // СВЯЗИ С ДРУГИМИ СИСТЕМАМИ — критично для второго мозга
  goalId           String? // связь с Goal! (FK opt.)
  meetingId        String? // legacy compatibility
  linkedMeetingIds String[] // видеовстречи из задачи

  // AI metadata
  sourceBlockIds  String[] // если задача создана AI — откуда вытащил
  confidence      Decimal? @db.Decimal(4, 3)
  createdManually Boolean  @default(true)

  /// Phase 3 — pgvector embedding (text-embedding-3-small, 1536 dim).
  /// Генерируется `issue-embed.worker` на create/update title+description.
  /// HNSW-индекс (cosine) создаётся через postgres-init.sql.
  embedding     Unsupported("vector(1536)")?
  embeddingHash String? // sha256(title + description) — чтобы не пересчитывать без изменений

  // Внешний источник
  externalSource String? // email | telegram | checkin | meeting | api | manual
  externalId     String?

  // Граф знаний
  entityId String?

  // RBAC и owner
  createdById String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state    IssueState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  cycle    Cycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  goal     Goal?       @relation("IssueGoal", fields: [goalId], references: [id], onDelete: SetNull)
  parent   Issue?      @relation("IssueSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[]     @relation("IssueSubtasks")

  assignees    IssueAssignee[]
  labels       IssueLabel[]
  subscribers  IssueSubscriber[]
  mentions     IssueMention[]
  comments     IssueComment[]
  attachments  IssueAttachment[]
  links        IssueLink[]
  relationsOut IssueRelation[]   @relation("IssueRelationSource")
  relationsIn  IssueRelation[]   @relation("IssueRelationTarget")
  activities   IssueActivity[]
  versions     IssueVersion[]

  /// Встречи, запущенные из этой задачи (см. `Meeting.linkedIssueId`).
  meetingsFromIssue Meeting[] @relation("MeetingLinkedIssue")

  /// Tracker Phase 4 (Email-to-task, T5) — логи входящих писем,
  /// из которых была создана эта задача. Обычно ≤1 запись на Issue.
  mailInboundLogs MailInboundLog[]

  @@unique([projectId, sequenceId])
  @@unique([tenantId, identifier])
  @@index([tenantId, stateId, deletedAt])
  @@index([tenantId, dueDate])
  @@index([tenantId, goalId])
  @@index([tenantId, cycleId])
  @@index([tenantId, projectId, deletedAt])
  @@index([parentId])
}

/// M:M задача↔исполнители. Несколько ассайнеров на одну задачу разрешено.
model IssueAssignee {
  id           String   @id @default(cuid())
  issueId      String
  userId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

/// Метка (label). `projectId` null — глобальная метка организации.
model Label {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String? // null = глобальная метка организации
  name      String
  color     String

  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@index([projectId])
  @@index([tenantId])
}

/// M:M задача↔метка.
model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([labelId])
}

/// Подписчик на задачу — получает уведомления об изменениях.
model IssueSubscriber {
  id           String   @id @default(cuid())
  issueId      String
  userId       String
  subscribedAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

/// @-упоминание пользователя (в описании задачи или комментарии).
/// `commentId` — если упоминание в комментарии; иначе null (упоминание в самой задаче).
model IssueMention {
  id                String   @id @default(cuid())
  issueId           String
  commentId         String? // упоминание в комментарии
  mentionedUserId   String
  mentionedByUserId String
  createdAt         DateTime @default(now())

  issue   Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment IssueComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId])
  @@index([issueId])
  @@index([commentId])
}

/// Комментарий к задаче. Rich-text JSON + опц. голосовое сообщение.
/// Поддерживает треды через `parentCommentId`. Гость может оставлять
/// комментарии типа `external`.
model IssueComment {
  id              String  @id @default(cuid())
  issueId         String
  authorId        String
  parentCommentId String? // для тредов

  content         String  @db.Text // rich-text JSON
  contentHtml     String? @db.Text
  contentStripped String? @db.Text // plain для поиска / AI

  access String @default("internal") // internal | external (гость)

  // Голосовое сообщение
  voiceUrl        String?
  voiceDuration   Int? // секунды
  voiceTranscript String? @db.Text // транскрипт от Vox/GigaAM

  // Gamification (Wave 2): кто нажал «спасибо»
  thanksUserIds String[] @default([])

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  issue       Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  parent      IssueComment?     @relation("IssueCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  children    IssueComment[]    @relation("IssueCommentThread")
  mentions    IssueMention[]
  attachments IssueAttachment[]

  @@index([issueId, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
}

/// Вложение к задаче или комментарию.
model IssueAttachment {
  id           String   @id @default(cuid())
  issueId      String
  commentId    String? // если приложен к комментарию
  uploaderId   String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  thumbnailUrl String? // для картинок
  createdAt    DateTime @default(now())

  issue   Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment IssueComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([commentId])
}

/// Внешняя ссылка на задаче (URL + title).
model IssueLink {
  id        String   @id @default(cuid())
  issueId   String
  title     String
  url       String
  addedById String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

/// Tracker Phase 4 (Email-to-task, T5) — лог обработки входящих писем
/// в общем IMAP-ящике `MAIL_INBOX_*`. Используется для:
///   - идемпотентности по `messageId` (уникальный RFC822 Message-ID);
///   - аудита bounce/failed для отладки и UI «последние входящие письма»;
///   - связи Issue ← письмо (issueId nullable: bounce/failed).
enum MailInboundStatus {
  received // принято к обработке
  bounced // alias не найден / проект выключен
  failed // ошибка обработки (S3, Issue.create и т.п.)
  created // успешно создан Issue
}

model MailInboundLog {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// RFC822 Message-ID письма (с угловыми скобками снят). Идемпотентность —
  /// повторная обработка того же письма даёт `findUnique`-hit и skip.
  messageId String @unique

  fromEmail String
  subject   String

  status MailInboundStatus
  reason String? // human-readable код для bounced/failed

  issueId String?
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, status, createdAt])
  @@index([projectId, createdAt])
}

/// Связь между задачами: blocks / blocked_by / duplicates / relates_to.
model IssueRelation {
  id            String   @id @default(cuid())
  sourceIssueId String
  targetIssueId String
  relationType  String // blocks | blocked_by | duplicates | duplicated_by | relates_to
  createdById   String
  createdAt     DateTime @default(now())

  source Issue @relation("IssueRelationSource", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  target Issue @relation("IssueRelationTarget", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, relationType])
  @@index([targetIssueId])
}

/// Audit-trail задачи. `epoch` — микросекунды для строгой сортировки.
/// `actorType`: user | ai_agent | system. `agentName` заполнен только когда
/// `actorType='ai_agent'`.
model IssueActivity {
  id          String  @id @default(cuid())
  tenantId    String
  issueId     String
  actorUserId String?
  actorType   String // user | ai_agent | system
  agentName   String? // если actor — AI, какой именно

  verb     String // created | updated | status_changed | assigned | commented | linked | ...
  field    String? // если updated — какое поле
  oldValue Json?
  newValue Json?

  metadata Json? // доп. контекст (например, кто упомянут)
  epoch    BigInt // микросекунды для сортировки

  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, epoch])
  @@index([tenantId, createdAt])
}

/// Исторический снимок задачи (полный snapshot Json + связи на момент версии).
/// Создаётся при ключевых изменениях.
model IssueVersion {
  id              String   @id @default(cuid())
  issueId         String
  versionNumber   Int
  snapshot        Json // полный снимок Issue + связей на момент версии
  createdByUserId String
  createdAt       DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, versionNumber])
}

/// Входящая задача (inbox) перед триажем. AI-предложения по проекту,
/// исполнителю, цели, приоритету, дедлайну.
model IntakeIssue {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String? // если уже определён, иначе AI suggest

  status         String  @default("pending") // pending | snoozed | accepted | rejected | duplicate
  source         String // in_app | email | telegram | checkin | meeting | api | concierge
  sourceEmail    String?
  externalSource String?
  externalId     String?

  rawContent           String  @db.Text // исходный текст
  extractedTitle       String?
  extractedDescription String? @db.Text

  // AI-предложения
  suggestedProjectId  String?
  suggestedAssigneeId String?
  suggestedGoalId     String?
  suggestedPriority   String?
  suggestedDueDate    DateTime?
  suggestedLabels     String[]

  confidence Decimal? @db.Decimal(4, 3)

  // Триаж
  triagedByUserId String?
  triagedAt       DateTime?
  rejectedReason  String?
  snoozedUntil    DateTime?

  // Если принят — создаётся Issue
  createdIssueId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([source, createdAt])
}

/// Исходящий webhook для внешних интеграций. `secretKey` хранится с префиксом
/// `kora_wh_` + 32 случайных байта. Доставка через очередь с exp backoff.
model IssueWebhook {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  url       String
  secretKey String // с префиксом `kora_wh_` + 32 байта

  events String[] // issue.created, issue.updated, comment.created, cycle.completed, ...

  /// W4.3 (KC-Temporal) — какие классы данных webhook'у разрешено принимать.
  /// Пустой массив трактуется как `['public','internal']` (default). `sensitive`/`private`
  /// не уходят в outbound webhook без явного opt-in админом.
  allowedDataClasses DataClass[] @default([public, internal])

  isActive   Boolean @default(true)
  isInternal Boolean @default(false)
  version    Int     @default(1)

  createdByUserId String
  createdAt       DateTime @default(now())

  logs IssueWebhookLog[]

  @@index([tenantId, isActive])
}

/// Лог доставки исходящего webhook'а. Используется для аудита и retry.
model IssueWebhookLog {
  id        String @id @default(cuid())
  webhookId String
  eventType String

  requestMethod  String
  requestUrl     String
  requestHeaders Json
  requestBody    Json

  responseStatus Int?
  responseBody   String? @db.Text
  responseTime   Int? // мс

  retryCount   Int     @default(0)
  success      Boolean
  errorMessage String?

  createdAt DateTime @default(now())

  webhook IssueWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

/// Шаблон команды (sales / development / installation / marketing / management / …).
/// `tenantId=null` — системный (платформенный) шаблон. `definition` — Json со
/// структурой { roles[], states[], laneTemplates[], typicalTasks[],
/// regulationStubs[], kpiTemplates[] }.
model TeamTemplate {
  id          String  @id @default(cuid())
  tenantId    String? // null = системный шаблон (платформенный)
  slug        String // sales | development | installation | marketing | management | ...
  name        String // «Команда продаж», «Команда разработки», ...
  description String  @db.Text
  category    String

  definition Json // { roles[], states[], laneTemplates[], typicalTasks[], regulationStubs[], kpiTemplates[] }

  isPublic   Boolean @default(true)
  usageCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@unique([tenantId, slug])
}

/// ImportLog — лог импорта задач из внешних трекеров (Битрикс24 / Trello / Я.Трекер).
/// Tracker Phase 5 (Sprint 8, 2026-05-24). Каждый импорт — отдельная запись с
/// progress'ом, итоговой статистикой и (если случилось) массивом ошибок.
/// Идемпотентность импорта — через Issue.externalSource + externalId.
model ImportLog {
  id                String    @id @default(cuid())
  tenantId          String
  source            String // 'bitrix24' | 'trello' | 'yandex_tracker'
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  totalProjects     Int       @default(0)
  totalIssues       Int       @default(0)
  totalComments     Int       @default(0)
  totalAttachments  Int       @default(0)
  processedItems    Int       @default(0) // для progress
  errors            Json? // массив { stage, externalId?, message } ошибок
  status            String    @default("running") // 'running' | 'completed' | 'failed' | 'cancelled'
  /// Параметры запуска — какие проекты выбраны + email-mapping pairs (для replay).
  paramsJson        Json?
  /// User-маппинг unmatched email'ов: какие пригласили, какие игнорировали.
  unmatchedJson     Json?
  initiatedByUserId String

  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

/// Производственный календарь РФ (или per-tenant override).
/// Tracker Phase 4 (Sprint 7, 2026-05-24) — учёт праздников в dueDate / cycle.endDate.
/// Если задача попадает на праздник — авто-перенос на следующий рабочий день.
/// `tenantId = null` — глобальный платформенный календарь.
/// `isWorking = true` — для перенесённых рабочих суббот (производственный календарь РФ).
model HolidayCalendar {
  id        String   @id @default(cuid())
  tenantId  String? // null = глобальный РФ-календарь
  date      DateTime // YYYY-MM-DD (хранится как DateTime, но логически date-only)
  name      String // «Новый год», «8 марта», «Перенесённая суббота 04.05»
  isWorking Boolean  @default(false) // true для перенесённых рабочих суббот

  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([date])
}

// ──────────────────────────── Wave 2: Activity Feeds (2026-05-24) ────────────────────────────
// Sub-ТЗ: plans/tz/2026-05-23-activity-feeds.md
// Единая модель ленты активности — live-канал между AI-агентами и людьми.

/// Запись в ленте активности. Источник: AI-агент / пользователь / система.
/// 6 типов лент: probe_question | insight | decision | task | idea | conflict | knowledge_change.
model ActivityFeedItem {
  id       String @id @default(cuid())
  tenantId String

  feedType String // probe_question | insight | decision | task | idea | conflict | knowledge_change

  sourceType      String // ai_agent | system | user
  sourceAgentName String? // 'probe_agent' | 'insights_radar' | 'decisions_registry' | 'helpfulness_agent' | ...
  sourceUserId    String?

  relatedEntityType String? // probe_event | insight | decision | issue | idea | conflict_item | helpfulness_spotlight
  relatedEntityId   String?

  title    String
  summary  String? @db.Text
  iconType String? // question | bulb | check | warning | flame | thumbs
  severity String? @default("normal") // critical | high | normal | low

  status String // emitted | delivered | seen | responded | actioned | dismissed | expired

  visibility      String // public_org | team | role | private
  visibilityScope Json? // { teamIds: [], roleIds: [], userIds: [] }

  targetUserId  String?
  targetChannel String? // in_app | telegram | email | mobile_push

  teamId    String?
  projectId String?
  goalId    String?

  reactions Json? // { thanks: [userId, ...], votes: [userId, ...] }

  expiresAt DateTime?

  emittedAt   DateTime  @default(now())
  deliveredAt DateTime?
  seenAt      DateTime?
  respondedAt DateTime?
  actionedAt  DateTime?

  @@index([tenantId, feedType, emittedAt])
  @@index([tenantId, targetUserId, status])
  @@index([tenantId, teamId, emittedAt])
  @@index([tenantId, visibility, emittedAt])
  @@index([tenantId, expiresAt])
}

/// Подписка пользователя на конкретный тип ленты с фильтрами и режимом дайджеста.
model ActivityFeedSubscription {
  id         String   @id @default(cuid())
  userId     String
  feedType   String
  filters    Json // { teamIds, projectIds, severities, ... }
  digestMode String   @default("realtime") // realtime | daily_digest | weekly_digest | off
  channels   String[] @default(["in_app"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, feedType])
}

// ──────────────────────────── Wave 2: Specialist 3.8 Helpfulness (2026-05-24) ────────────────────────────
// Sub-ТЗ: plans/tz/2026-05-23-specialist-3-8-helpfulness-agent.md
// Этическая защита: question_unanswered + question_acknowledged_no_action — только private (admin + руководитель), никогда публично.

/// Сигнал помощи / mentoring / поддержки, извлечённый из IdeaBlock-ов.
/// 7 типов traitType: help_provided | proactive_hint | mentoring | emotional_support |
/// constructive_feedback | question_unanswered | question_acknowledged_no_action.
/// Последние два — visibility='restricted' (только админ + руководитель).
model HelpfulnessTrait {
  id       String @id @default(cuid())
  tenantId String

  helperUserId    String
  recipientUserId String?

  traitType String // help_provided | proactive_hint | mentoring | emotional_support | constructive_feedback | question_unanswered | question_acknowledged_no_action
  intensity Decimal @db.Decimal(4, 3) // 0..1

  topicHint String?

  sourceBlockIds String[]
  evidenceQuote  String?  @db.Text

  contextEntityType String? // issue_comment | meeting_transcript_chunk | checkin
  contextEntityId   String?

  embedding Unsupported("vector(1536)")?

  confidence Decimal @db.Decimal(4, 3)

  visibility String @default("internal") // public_team | internal | restricted

  lastObservedAt DateTime
  decayedAt      DateTime?
  status         String    @default("active") // active | decayed | mark_as_misleading

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, helperUserId])
  @@index([tenantId, recipientUserId])
  @@index([tenantId, traitType, status])
  @@index([tenantId, status, lastObservedAt])
}

/// Агрегат вклада в команду per person. Пересчитывается SocialContributionProfileCron (05:00 UTC).
/// contributionScoreCached — НЕ публично, НЕ как рейтинг. Только для дашборда руководителя.
model SocialContributionProfile {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  helpProvidedCount     Int @default(0)
  proactiveHintCount    Int @default(0)
  mentoringCount        Int @default(0)
  emotionalSupportCount Int @default(0)

  expertiseTopics String[] @default([])

  socialRoles String[] @default([]) // mentor | connector | problem_solver | mood_keeper | trainer

  lastWeekHelpCount  Int @default(0)
  lastMonthHelpCount Int @default(0)

  contributionScoreCached Decimal? @db.Decimal(6, 3)

  buildVersion Int      @default(1)
  lastBuiltAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Публичный «спасибо» для ленты — формулирует LLM на основе HelpfulnessTrait-ов за период.
/// Status: pending → approved (руководителем) → published. Hidden = скрыто.
model HelpfulnessSpotlight {
  id       String @id @default(cuid())
  tenantId String

  helperUserId String
  topicHint    String?
  message      String  @db.Text

  periodFrom DateTime
  periodTo   DateTime

  helpCount Int

  traitIds String[] @default([])

  status           String  @default("pending") // pending | approved | published | hidden
  approvedByUserId String?

  publishedAt DateTime?
  feedItemId  String? // ссылка на ActivityFeedItem

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([helperUserId, periodFrom])
}

// ──────────────────────────── Wave 2: Recognition + Gamification (2026-05-24) ────────────────────────────
// Sub-ТЗ: plans/tz/2026-05-23-gamification-and-motivation.md
// Никаких рейтингов «топ-10», никаких очков-валюты. Бейджи без сравнения между людьми.

/// Благодарность / признание от AI или от пользователя.
/// types: thanks_comment | thanks_helpfulness | mention_helped | idea_shipped | streak_milestone | weekly_summary.
model Recognition {
  id       String @id @default(cuid())
  tenantId String

  fromUserId String? // null если от AI / системы
  toUserId   String

  type String

  contextEntityType String? // issue_comment | insight | regulation | idea | checkin | helpfulness_spotlight
  contextEntityId   String?

  message String? @db.Text

  visibility String @default("private") // private | team | public_org

  createdAt DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([tenantId, type])
  @@index([tenantId, toUserId, visibility])
}

/// Каталог бейджей. 5 базовых: ideator | expert | helper | aligned | consistent.
model Badge {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String  @db.Text
  iconUrl     String?
  condition   Json // { type: 'ideas_in_dev', threshold: 5 } и т.д.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBadges UserBadge[]
}

/// M2M user ↔ badge. Бейдж выдаётся один раз.
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
}

/// Агрегированные показатели вклада per user — обновляются ContributionSnapshotCron (04:00 UTC).
model ContributionSnapshot {
  id     String @id @default(cuid())
  userId String

  ideasInDevelopment Int @default(0)
  ideasShipped       Int @default(0)
  thanksReceived     Int @default(0)
  thanksReceivedWeek Int @default(0)

  currentCheckinStreak Int @default(0)
  longestCheckinStreak Int @default(0)

  helpfulComments        Int @default(0)
  probeQuestionsAnswered Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId])
}

// ──────────────────────────── Wave 2 finishing — Web Push (2026-05-24) ────────────────────────────
// PushSubscription — подписка браузера на push (Push API + VAPID).
// Frontend через navigator.serviceWorker.pushManager.subscribe() получает
// { endpoint, keys: { p256dh, auth } }; backend хранит для отправки notifications.
// failureCount накапливается при 410/404 (RFC 8030 §7.3) → удаление после PUSH_MAX_FAILURES.
model PushSubscription {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  endpoint     String    @db.Text
  p256dh       String
  auth         String
  userAgent    String?
  expiresAt    DateTime?
  lastSeenAt   DateTime  @default(now())
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([userId, endpoint])
  @@index([tenantId, userId])
}

// ════════════════════════════════════════════════════════════════════════════
// Admin Redesign Фаза 0 — Foundation (2026-05-25)
// План: plans/tz/2026-05-25-admin-redesign-tz.md
// Цель: вынести ~140 тюнинг-ENV в БД, дать UI управления продуктом super_admin'у.
// ════════════════════════════════════════════════════════════════════════════

/// AdminSetting — динамическая настройка, перекрывающая ENV-default.
/// Чтение через TypedConfigService.getDynamic(key, envFallbackKey?, default?).
/// При записи через AdminSettingsService: история в AdminSettingHistory + Redis
/// pub/sub 'admin:setting:invalidate' для перечитки в воркер-процессах.
model AdminSetting {
  key         String   @id
  value       Json
  /// "ai" | "platform" | "content" | "tenants" | "media" | "integrations" | "analytics" | "operations"
  category    String
  /// внутри категории: "knowledge-core" | "crons" | "retention" | ...
  section     String
  /// "low" | "medium" | "high" | "destructive" — определяет, обязательна ли reason при изменении.
  severity    String   @default("low")
  /// Идентификатор Zod-схемы из registry (для валидации значения и автогенерации UI-поля).
  schemaId    String?
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  /// Последняя причина изменения (для high/destructive обязательна, минимум 10 символов).
  comment     String?

  @@index([category, section])
}

/// История изменений AdminSetting. Полный audit-trail для UI вкладки «История».
model AdminSettingHistory {
  id        String   @id @default(cuid())
  key       String
  prevValue Json
  newValue  Json
  changedBy String
  reason    String?
  changedAt DateTime @default(now())

  @@index([key, changedAt])
}

/// Plan — глобальный план продукта (basic/pro/enterprise/...). Содержит
/// фичи и квоты по умолчанию. Конкретная Org ссылается через OrgEntitlement.tier
/// (string, без foreign key — чтобы можно было soft-deactivate план).
model Plan {
  id              String   @id
  displayName     String
  description     String?
  /// { "ai_chat": true, "employee_clones": false, ... }
  features        Json
  /// { "max_meetings_per_day": 100, "max_chat_tokens_per_day": 2000000, ... }
  quotas          Json
  monthlyPriceRub Int?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// FeatureFlag — глобальный фиче-флаг с тремя уровнями: default → orgOverrides
/// → rolloutPercent (hash-based). Resolution: if key in orgOverrides → return;
/// if rolloutPercent && hash(orgId + key) % 100 < rolloutPercent → true; else default.
model FeatureFlag {
  key            String   @id
  description    String
  defaultValue   Boolean
  /// { "tenant_xxx": true, "tenant_yyy": false }
  orgOverrides   Json     @default("{}")
  rolloutPercent Int?
  /// "ai" | "ui" | "experimental" | "billing" | ...
  category       String
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

/// EmailTemplate — Handlebars-source plain text (как сейчас в mail.templates.ts).
/// htmlBody опционален — для маркетинговых писем в будущем.
model EmailTemplate {
  key       String   @id
  subject   String
  body      String   @db.Text
  htmlBody  String?  @db.Text
  /// { "name": "имя получателя", "magicLinkUrl": "ссылка на вход", ... }
  variables Json
  /// "transactional" | "marketing" | "system"
  category  String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// MeetingTypeConfig — конфигурация типов встреч (9 в MVP), редактируется
/// из админки. Сам enum MeetingType остаётся для type-safety, конфиг хранит
/// отображаемые поля и привязку к промпту отчёта. id матчится с MeetingType
/// enum-значением как строка.
/// reportPromptKey — FK на PromptTemplate.key (без явной relation, чтобы
/// можно было soft-rename промпта без миграции).
model MeetingTypeConfig {
  id              String   @id
  displayName     String
  description     String?
  icon            String?
  reportPromptKey String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

/// SystemMessage — баннеры пользователю / maintenance-режим / алерты.
/// targetOrgs пустой массив = показать всем; иначе — только перечисленным.
model SystemMessage {
  id         String    @id @default(cuid())
  /// "banner" | "maintenance" | "alert"
  type       String
  /// "info" | "warning" | "critical"
  severity   String
  body       String    @db.Text
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean   @default(true)
  /// Пустой массив = все Org.
  targetOrgs String[]
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([isActive, startsAt])
}

/// RetentionPolicy — глобальные сроки хранения данных по типу. Заменяет
/// *_RETENTION_DAYS ENV. type — стабильный идентификатор: "meeting_recording",
/// "share_view", "api_access_log", "webhook_delivery", "soft_delete_grace".
model RetentionPolicy {
  type        String   @id
  days        Int
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// CronSchedule — расписание @Cron-джоба, override'ит bootstrap-дефолт из
/// @Cron(EXPRESSION). CronManagerService.onModuleInit() читает таблицу и
/// перевешивает SchedulerRegistry. Pub/sub 'cron.schedule.updated' для
/// hot-reload без рестарта.
model CronSchedule {
  name              String    @id
  expression        String
  /// Bootstrap-дефолт из @Cron(...) — для сравнения и кнопки «Сбросить».
  defaultExpression String
  enabled           Boolean   @default(true)
  description       String?
  lastRunAt         DateTime?
  lastRunDurationMs Int?
  lastRunError      String?
  updatedBy         String?
  updatedAt         DateTime  @updatedAt
}

/// CronRunHistory — журнал запусков кронов (scheduled + manual). triggeredBy
/// null = scheduled, иначе userId super_admin'а который запустил вручную.
model CronRunHistory {
  id          String   @id @default(cuid())
  cronName    String
  startedAt   DateTime @default(now())
  durationMs  Int?
  /// "success" | "failed" | "running"
  status      String
  error       String?
  triggeredBy String?

  @@index([cronName, startedAt])
}

/// W2.3 KC-Temporal (2026-05-25) — LlmPreferenceSample.
///
/// Каждое исправление пользователя через CurationDecision (mark_as_misleading,
/// rejected, rolled_back, approved) фиксируется как пример для будущего
/// retraining'а few-shot'ов и оценки качества LLM-агентов.
///
/// Источник правды: plans/tz/2026-05-25-knowledge-core-temporal-and-graph-quality.md §W2.3.
///
/// `taskType` — LlmTaskType из ai/services/llm-router.service.ts (хранится строкой
/// для расширяемости без миграций enum'а).
/// `label` — 'correct' | 'wrong' | 'misleading' | 'partially_correct'.
/// `inputContext` — сырой вход LLM (segment / block / candidates).
/// `modelOutput` — что LLM вернул (для voting/comparison).
model LlmPreferenceSample {
  id           String   @id @default(cuid())
  tenantId     String
  taskType     String
  inputContext Json
  modelOutput  Json
  label        String   @db.VarChar(40)
  reason       String?  @db.Text
  recordedBy   String   @db.VarChar(80)
  decisionId   String?
  createdAt    DateTime @default(now())

  org Org @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, taskType, createdAt])
  @@map("llm_preference_samples")
}

// ───────────────────────────────────────────────────────────────────────────
// User Feedback with AI Clustering (2026-05-25)
// Источник: plans/tz/2026-05-25-user-feedback-with-ai-clustering.md
// Канал прямой обратной связи пользователей продукту Z с ночным AI-агентом,
// который кластеризует тезисы в смысловые блоки.
// ───────────────────────────────────────────────────────────────────────────

/// Сообщение, отправленное пользователем через форму «Ваши предложения».
/// Один FeedbackMessage = одна отправка из UI. Лимит 5 в сутки на userId.
/// Может породить несколько FeedbackItem (по одному на тезис) после
/// ночной обработки агентом.
model FeedbackMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Org, в контексте которой пользователь писал сообщение (если он залогинен
  /// в Org). Опционально, потому что фидбэк глобальный — мы храним для
  /// аналитики «из каких org приходят запросы».
  orgId       String?
  org         Org?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  text        String    @db.Text
  createdAt   DateTime  @default(now())
  /// Помечается, когда ночной digest-воркер обработал сообщение и создал
  /// items. NULL = ещё не обработано, ждёт следующий прогон.
  processedAt DateTime?
  /// Счётчик неудачных попыток обработки. После 3 — сообщение исключается
  /// из дальнейших прогонов и попадает в /admin/feedback/messages/failed
  /// для ручного разбора.
  failedRuns  Int       @default(0)

  items FeedbackItem[]

  @@index([processedAt])
  @@index([userId, createdAt])
}

/// Смысловой блок обратной связи. Создаётся либо AI-агентом во время
/// ночного digest'а, либо вручную super-admin'ом. Items группируются в блок
/// по тематической близости тезисов.
model FeedbackTopic {
  id           String              @id @default(cuid())
  title        String
  description  String              @db.Text
  status       FeedbackTopicStatus @default(ACTIVE)
  archivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  /// Если блок был объединён с другим — здесь id «целевого» блока.
  /// Сами items при merge переносятся в target, а source помечается
  /// status=MERGED. См. /admin/feedback/topics/:sourceId/merge.
  mergedIntoId String?
  mergedInto   FeedbackTopic?      @relation("FeedbackTopicMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   FeedbackTopic[]     @relation("FeedbackTopicMerge")

  items FeedbackItem[]

  @@index([status])
  @@index([createdAt])
}

enum FeedbackTopicStatus {
  ACTIVE
  ARCHIVED
  MERGED
}

/// Тезис, выделенный AI-агентом из FeedbackMessage. Один FeedbackMessage
/// может породить несколько items (если пользователь высказал несколько
/// тем в одном сообщении). discarded=true означает, что агент посчитал
/// тезис мусором (spam / unintelligible / off-topic) и не привязал к блоку.
model FeedbackItem {
  id            String           @id @default(cuid())
  messageId     String
  message       FeedbackMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// NULL если discarded=true (мусор/спам), либо если блок был удалён
  /// (onDelete: SetNull сохраняет item для аналитики).
  topicId       String?
  topic         FeedbackTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  text          String           @db.Text
  discarded     Boolean          @default(false)
  /// 'spam' | 'unintelligible' | 'off-topic' | 'agent_marked'.
  discardReason String?
  createdAt     DateTime         @default(now())

  @@index([topicId, createdAt])
  @@index([messageId])
  @@index([discarded])
}
