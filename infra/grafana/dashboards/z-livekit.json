{
  "title": "Z — LiveKit",
  "uid": "z-livekit",
  "schemaVersion": 38,
  "editable": true,
  "tags": ["z", "livekit"],
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Webhook events (rate, by type)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (type) (rate(livekit_webhook_events_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active rooms (LiveKit gauge)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "description": "Метрика `livekit_room_total` приходит из самого LiveKit Server (job=z-livekit).",
      "targets": [
        {
          "expr": "livekit_room_total",
          "legendFormat": "rooms"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active participants",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "livekit_participant_total",
          "legendFormat": "participants"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Recordings failed (rate, by reason)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(recordings_failed_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
